module

public import MixedFujita.ProjectiveClosureCharts
public import MixedFujita.LocallyStandardSmoothSpreading
public import Mathlib.AlgebraicGeometry.Morphisms.Smooth

/-!
The closure of a smooth projective variety over a large finitely generated subring is smooth
(step 10, R4-3).

Let `T` be a closed subscheme of projective space over a field `K`, smooth of relative dimension
`d` over `K`. There is a finitely generated subring `A₀ ⊆ K` such that for every subring
`A ⊇ A₀` the closure `T_A` of `T` in projective space over `A` (check 507) is smooth of relative
dimension `d` over `A` (`exists_fg_forall_smoothOfRelativeDimension_projectiveClosure`).

On each coordinate chart the functions of `T` form a `K`-algebra covered by standard smooth
localizations (Mathlib's `HasRingHomProperty` for `SmoothOfRelativeDimension`), generated by the
ratios of the coordinates; those of `T_A` embed into them compatibly with the ratios (check 507),
so check 506 covers the chart of `T_A` by standard smooth localizations for every large `A`.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

variable {n : ℕ}

section Generation

variable {R : Type u} [CommRing R] {Y : Scheme.{u}} (e : Y ⟶ polynomialProjectiveScheme n R)

theorem projectivePullbackCoordinateOpen_isAffineOpen_of_isClosedImmersion [IsClosedImmersion e]
    (k : Fin n) : IsAffineOpen (projectivePullbackCoordinateOpen e k) :=
  (Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin n) R) (MvPolynomial.X k)
    (MvPolynomial.isHomogeneous_X R k) Nat.zero_lt_one).preimage e

theorem iSup_projectivePullbackCoordinateOpen :
    ⨆ k : Fin n, projectivePullbackCoordinateOpen e k = ⊤ := by
  simp only [projectivePullbackCoordinateOpen]
  rw [← Scheme.Hom.preimage_iSup, polynomialProjective_coordinate_opens_cover n R,
    Scheme.Hom.preimage_top]

/-- The ratios generate the functions on a chart of a closed subscheme of projective space, for
any algebra structure whose constants are the chart constants. -/
theorem adjoin_projectiveChartRingMap_eq_top [IsClosedImmersion e] (k : Fin n)
    [Algebra R Γ(Y, projectivePullbackCoordinateOpen e k)]
    (hC : ∀ r, projectiveChartRingMap e k (MvPolynomial.C r) =
      algebraMap R Γ(Y, projectivePullbackCoordinateOpen e k) r) :
    Algebra.adjoin R (Set.range fun j : {j : Fin n // j ≠ k} =>
      projectiveChartRingMap e k (MvPolynomial.X j)) = ⊤ := by
  rw [eq_top_iff]
  intro a _
  obtain ⟨p, rfl⟩ := projectiveChartRingMap_surjective e k a
  induction p using MvPolynomial.induction_on with
  | C r =>
    rw [hC r]
    exact Subalgebra.algebraMap_mem _ r
  | add p q hp hq =>
    rw [map_add]
    exact Subalgebra.add_mem _ (hp Algebra.mem_top) (hq Algebra.mem_top)
  | mul_X p j hp =>
    rw [map_mul]
    exact Subalgebra.mul_mem _ (hp Algebra.mem_top) (Algebra.subset_adjoin ⟨j, rfl⟩)

end Generation

section Smooth

variable {K : Type u} [Field K] {T : Scheme.{u}} (π : T ⟶ Spec (CommRingCat.of K)) (d : ℕ)
  (e : T ⟶ polynomialProjectiveScheme n K)

/-- **The closure of a smooth projective variety over a large finitely generated subring is
smooth.** If the closed subscheme `T` of projective space over `K` is smooth of relative dimension
`d` over `K`, there is a finitely generated subring `A₀ ⊆ K` such that for every subring `A ⊇ A₀`
the closure of `T` in projective space over `A` is smooth of relative dimension `d` over `A`. -/
theorem exists_fg_forall_smoothOfRelativeDimension_projectiveClosure
    [SmoothOfRelativeDimension d π] [IsClosedImmersion e]
    (he : e ≫ polynomialProjectiveToBase n K = π) :
    ∃ A₀ : Subalgebra ℤ K, A₀.FG ∧ ∀ A : Subalgebra ℤ K, A₀ ≤ A →
      SmoothOfRelativeDimension d
        (projectiveClosureι (algebraMap A K) e ≫ polynomialProjectiveToBase n A) := by
  classical
  have hP : RingHom.RespectsIso (RingHom.IsStandardSmoothOfRelativeDimension d) :=
    RingHom.isStandardSmoothOfRelativeDimension_respectsIso
  have key : ∀ k : Fin n, ∃ A₁ : Subalgebra ℤ K, A₁.FG ∧ ∀ A : Subalgebra ℤ K, A₁ ≤ A →
      RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension d)
        ((projectiveClosureι (algebraMap A K) e ≫ polynomialProjectiveToBase n A).appLE ⊤
          (projectivePullbackCoordinateOpen (projectiveClosureι (algebraMap A K) e) k)
            le_top).hom := by
    intro k
    -- the chart of `T`
    let C := Γ(T, projectivePullbackCoordinateOpen e k)
    let gK : K →+* C := (π.appLE ⊤ (projectivePullbackCoordinateOpen e k) le_top).hom.comp
      (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom
    let _ : Algebra K C := gK.toAlgebra
    have hCK : ∀ r, projectiveChartRingMap e k (MvPolynomial.C r) = algebraMap K C r :=
      fun r => projectiveChartRingMap_C e π he k r
    have hloc : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension d)
        (algebraMap K C) := by
      have h := HasRingHomProperty.appLE (@SmoothOfRelativeDimension d) π inferInstance
        ⟨⊤, isAffineOpen_top _⟩
        ⟨_, projectivePullbackCoordinateOpen_isAffineOpen_of_isClosedImmersion e k⟩ le_top
      exact ((RingHom.locally_respectsIso hP).cancel_left_isIso
        (Scheme.ΓSpecIso (CommRingCat.of K)).inv _).2 h
    let Y : Finset C := Finset.univ.image fun j : {j : Fin n // j ≠ k} =>
      projectiveChartRingMap e k (MvPolynomial.X j)
    have hY : Algebra.adjoin K (Y : Set C) = ⊤ := by
      rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
      exact adjoin_projectiveChartRingMap_eq_top e k hCK
    obtain ⟨A₁, hA₁, h⟩ := exists_fg_forall_locally_isStandardSmooth (R := ℤ) d hloc Y hY
    refine ⟨A₁, hA₁, fun A hA => ?_⟩
    -- the chart of the closure
    let ι := projectiveClosureι (algebraMap A K) e
    let q := ι ≫ polynomialProjectiveToBase n A
    let B := Γ(projectiveClosure (algebraMap A K) e, projectivePullbackCoordinateOpen ι k)
    let gA : A →+* B := (q.appLE ⊤ (projectivePullbackCoordinateOpen ι k) le_top).hom.comp
      (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
    let _ : Algebra A B := gA.toAlgebra
    have hCA : ∀ r, projectiveChartRingMap ι k (MvPolynomial.C r) = algebraMap A B r :=
      fun r => projectiveChartRingMap_C ι q rfl k r
    let ρ := closureChartMap (algebraMap A K) e k
    have := polynomialProjectiveCoefficientMap_isAffineHom (n := n) (algebraMap A K)
    have hcomp : ρ.comp (algebraMap A B) = (algebraMap K C).comp (algebraMap A K) := by
      refine RingHom.ext fun a => ?_
      change ρ (algebraMap A B a) = algebraMap K C (algebraMap A K a)
      rw [← hCA, ← hCK, closureChartMap_projectiveChartRingMap, MvPolynomial.map_C]
    have hρY : ∀ j : {j : Fin n // j ≠ k},
        ρ (projectiveChartRingMap ι k (MvPolynomial.X j)) =
          projectiveChartRingMap e k (MvPolynomial.X j) := by
      intro j
      rw [closureChartMap_projectiveChartRingMap, MvPolynomial.map_X]
    have hYρ : (Y : Set C) ⊆ Set.range ρ := by
      intro y hy
      obtain ⟨j, -, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hy)
      exact ⟨_, hρY j⟩
    have hgen : Algebra.adjoin A (ρ ⁻¹' (Y : Set C)) = ⊤ := by
      refine top_unique ?_
      rw [← adjoin_projectiveChartRingMap_eq_top ι k hCA]
      refine Algebra.adjoin_mono ?_
      rintro _ ⟨j, rfl⟩
      change ρ _ ∈ (Y : Set C)
      rw [hρY j]
      exact Finset.mem_coe.2 (Finset.mem_image_of_mem _ (Finset.mem_univ j))
    obtain ⟨t, ht, hsm⟩ := h A hA B ρ hcomp (closureChartMap_injective (algebraMap A K) e k)
      hYρ hgen
    refine ⟨(t : Set B), ht, fun b hb => ?_⟩
    have := hsm b hb
    have hg : (q.appLE ⊤ (projectivePullbackCoordinateOpen ι k) le_top).hom =
        gA.comp (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom := by
      simp only [gA, RingHom.comp_assoc]
      rw [← CommRingCat.hom_comp, Iso.hom_inv_id, CommRingCat.hom_id, RingHom.comp_id]
    have heq : (algebraMap B (Localization.Away b)).comp
        (q.appLE ⊤ (projectivePullbackCoordinateOpen ι k) le_top).hom =
        (algebraMap A (Localization.Away b)).comp
          (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom := by
      rw [hg, ← RingHom.comp_assoc]
      exact congrArg (fun f => f.comp (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom)
        (IsScalarTower.algebraMap_eq A B (Localization.Away b)).symm
    rw [heq]
    exact (hP.cancel_left_isIso (Scheme.ΓSpecIso (CommRingCat.of A)).hom
      (CommRingCat.ofHom (algebraMap A (Localization.Away b)))).2
      ((RingHom.isStandardSmoothOfRelativeDimension_algebraMap d).2 this)
  choose A₁ hA₁ hA₁' using key
  choose u hu using fun k => hA₁ k
  let U : Finset K := Finset.univ.biUnion u
  refine ⟨Algebra.adjoin ℤ (U : Set K), ⟨U, rfl⟩, fun A hA => ?_⟩
  have hA₁A : ∀ k, A₁ k ≤ A := by
    intro k
    rw [← hu k, Algebra.adjoin_le_iff]
    intro z hz
    exact hA (Algebra.subset_adjoin (Finset.mem_coe.2
      (Finset.mem_biUnion.2 ⟨k, Finset.mem_univ _, hz⟩)))
  exact HasRingHomProperty.of_iSup_eq_top (P := @SmoothOfRelativeDimension d)
    (fun k => ⟨_, projectivePullbackCoordinateOpen_isAffineOpen_of_isClosedImmersion
      (projectiveClosureι (algebraMap A K) e) k⟩)
    (iSup_projectivePullbackCoordinateOpen _) (fun k => hA₁' k A (hA₁A k))

end Smooth

end MixedFujita
