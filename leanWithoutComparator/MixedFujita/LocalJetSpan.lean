module

public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.Algebra.MvPolynomial.Degrees
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.Algebra.Algebra.Operations

/-!
Jets in a local ring generated by translated coordinates. Suppose a ring map
ψ from a polynomial ring over K sends the translated variables X_i - a_i to
generators of the maximal ideal, and every element is a constant modulo the
maximal ideal. Then every element agrees with the image of a polynomial of
total degree at most m modulo the (m+1)-st power of the maximal ideal.
No dimension, regularity or Noetherian hypothesis is used.
-/

@[expose] public section

namespace MixedFujita

open MvPolynomial

variable {σ K S : Type*} [Fintype σ] [Field K] [CommRing S] [IsLocalRing S]
  (ψ : MvPolynomial σ K →+* S) (a : σ → K)

omit [Fintype σ] in
theorem totalDegree_X_sub_C_le (i : σ) (c : K) :
    (X i - C c : MvPolynomial σ K).totalDegree ≤ 1 :=
  (totalDegree_sub_C_le _ _).trans (totalDegree_X i).le

/-- One step of the jet induction: an element of the i-th power agrees with the
image of a polynomial of total degree at most i modulo the next power. -/
theorem localJet_pow_step
    (hmax : IsLocalRing.maximalIdeal S = Ideal.span (Set.range fun i ↦ ψ (X i - C (a i))))
    (hres : ∀ y : S, ∃ c : K, y - ψ (C c) ∈ IsLocalRing.maximalIdeal S)
    {i : ℕ} {z : S} (hz : z ∈ IsLocalRing.maximalIdeal S ^ i) :
    ∃ P : MvPolynomial σ K, P.totalDegree ≤ i ∧
      z - ψ P ∈ IsLocalRing.maximalIdeal S ^ (i + 1) := by
  set M := IsLocalRing.maximalIdeal S with hM
  have hgen : ∀ l, ψ (X l - C (a l)) ∈ M := fun l => by
    rw [hmax]
    exact Ideal.subset_span ⟨l, rfl⟩
  induction hz using Submodule.pow_induction_on_left' with
  | algebraMap r =>
    obtain ⟨c, hc⟩ := hres r
    refine ⟨C c, by rw [totalDegree_C], ?_⟩
    simpa only [Algebra.algebraMap_self, RingHom.id_apply, zero_add, pow_one] using hc
  | add x y i hx hy ihx ihy =>
    obtain ⟨P, hP, hxP⟩ := ihx
    obtain ⟨P', hP', hyP⟩ := ihy
    refine ⟨P + P', (totalDegree_add _ _).trans (max_le hP hP'), ?_⟩
    have h := Ideal.add_mem _ hxP hyP
    have heq : x + y - ψ (P + P') = (x - ψ P) + (y - ψ P') := by
      rw [map_add]
      ring
    rw [heq]
    exact h
  | mem_mul m hm i x hx ih =>
    obtain ⟨P, hPdeg, hxP⟩ := ih
    have hPmem : ψ P ∈ M ^ i := by
      have h1 : x - ψ P ∈ M ^ i := Ideal.pow_le_pow_right (Nat.le_succ i) hxP
      have h2 := Ideal.sub_mem _ hx h1
      simpa only [sub_sub_cancel] using h2
    have hm' : m ∈ Ideal.span (Set.range fun l ↦ ψ (X l - C (a l))) := by
      rw [← hmax]
      exact hm
    obtain ⟨c', hc'⟩ := (Submodule.mem_span_range_iff_exists_fun S).mp hm'
    choose b hb using fun l => hres (c' l)
    refine ⟨∑ l, C (b l) * (X l - C (a l)) * P, ?_, ?_⟩
    · apply (totalDegree_finsetSum _ _).trans
      apply Finset.sup_le
      intro l _
      have hlin : (C (b l) * (X l - C (a l))).totalDegree ≤ 1 := by
        calc (C (b l) * (X l - C (a l))).totalDegree ≤
              (C (b l) : MvPolynomial σ K).totalDegree + (X l - C (a l)).totalDegree :=
              totalDegree_mul _ _
          _ ≤ 0 + 1 := by
              rw [totalDegree_C]
              exact Nat.add_le_add_left (totalDegree_X_sub_C_le l (a l)) 0
          _ = 1 := by omega
      calc (C (b l) * (X l - C (a l)) * P).totalDegree ≤
            (C (b l) * (X l - C (a l))).totalDegree + P.totalDegree := totalDegree_mul _ _
        _ ≤ 1 + i := Nat.add_le_add hlin hPdeg
        _ = i.succ := by omega
    · have hsplit : m * x - ψ (∑ l, C (b l) * (X l - C (a l)) * P) =
          m * (x - ψ P) + ∑ l, (c' l - ψ (C (b l))) * ψ (X l - C (a l)) * ψ P := by
        rw [← hc']
        simp only [map_sum, map_mul, smul_eq_mul, Finset.sum_mul]
        rw [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro l _
        ring
      rw [hsplit]
      have hsucc : M ^ (i.succ + 1) = M * M ^ (i + 1) := by
        rw [← pow_succ']
      apply Ideal.add_mem
      · rw [hsucc]
        exact Ideal.mul_mem_mul hm hxP
      · apply Submodule.sum_mem
        intro l _
        have h3 : (c' l - ψ (C (b l))) * ψ (X l - C (a l)) * ψ P ∈ M * M * M ^ i :=
          Ideal.mul_mem_mul (Ideal.mul_mem_mul (hb l) (hgen l)) hPmem
        have hpow : M * M * M ^ i = M ^ (i.succ + 1) := by
          rw [← pow_two, ← pow_add]
          congr 1
          omega
        rw [← hpow]
        exact h3

/-- Every element of the local ring agrees with the image of a polynomial of total
degree at most m modulo the (m+1)-st power of the maximal ideal. -/
theorem localJet_exists_polynomial
    (hmax : IsLocalRing.maximalIdeal S = Ideal.span (Set.range fun i ↦ ψ (X i - C (a i))))
    (hres : ∀ y : S, ∃ c : K, y - ψ (C c) ∈ IsLocalRing.maximalIdeal S) :
    ∀ (m : ℕ) (y : S), ∃ P : MvPolynomial σ K, P.totalDegree ≤ m ∧
      y - ψ P ∈ IsLocalRing.maximalIdeal S ^ (m + 1) := by
  intro m
  induction m with
  | zero =>
    intro y
    obtain ⟨c, hc⟩ := hres y
    exact ⟨C c, by rw [totalDegree_C], by simpa only [zero_add, pow_one] using hc⟩
  | succ m ih =>
    intro y
    obtain ⟨P, hP, hy⟩ := ih y
    obtain ⟨P', hP', hz⟩ := localJet_pow_step ψ a hmax hres hy
    refine ⟨P + P', (totalDegree_add _ _).trans (max_le (hP.trans (Nat.le_succ m)) hP'), ?_⟩
    have heq : y - ψ (P + P') = (y - ψ P) - ψ P' := by
      rw [map_add]
      ring
    rw [heq]
    exact hz

end MixedFujita
