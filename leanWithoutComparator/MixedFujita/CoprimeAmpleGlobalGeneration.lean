module

public import MixedFujita.CoprimeAmpleNumericalBound
public import MixedFujita.AmpleDivisibleGlobalGeneration

/-!
All sufficiently large multiples of a coprime-ample divisor are globally generated (steps 4 and
15). A very ample divisor in the projective sense is globally generated by the coordinate
sections. If k A and k' A are very ample with k, k' coprime, every j ≥ k k' is a k + b k', so
j A = a (k A) + b (k' A) is globally generated by products and powers of actual sections. This is
the form in which Lemma 2 chooses, for every large degree, a section that does not vanish at a
given point. No Serre vanishing is used; for a divisor with only one very ample multiple the
statement needs the bridge `AmpleCoprimeBridge`.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open TauCeti.AlgebraicGeometry.Scheme

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

variable {K : Type u} [Field K] {X : Scheme.{u}} [IsIntegral X] [X.Over (Spec (CommRingCat.of K))]

/-- A very ample divisor in the projective sense is globally generated. -/
theorem cartierIsVeryAmpleProj_isGloballyGenerated {A : CartierDivisor X}
    (hA : CartierIsVeryAmpleProj K A) : CartierIsGloballyGenerated A := by
  obtain ⟨n, e, _, _, g, hg, hggen, f, h⟩ := hA
  rw [h]
  exact cartierIsGloballyGenerated_principal_shift _ f
    (projectiveHyperplaneCartier_globallyGenerated e g hg hggen)

/-- All sufficiently large multiples of a coprime-ample divisor are globally generated. -/
theorem cartierIsAmpleCoprime_eventually_globallyGenerated {A : CartierDivisor X}
    (hA : CartierIsAmpleCoprime K A) :
    ∃ j₀ : ℕ, ∀ j : ℕ, j₀ ≤ j → CartierIsGloballyGenerated (j • A) := by
  obtain ⟨k, k', hk, -, hcop, hv, hv'⟩ := hA
  refine ⟨k * k', fun j hj => ?_⟩
  obtain ⟨a, b, hab, -⟩ := exists_coprime_representation hk hcop hj
  have h1 := cartierIsGloballyGenerated_nsmul _ (cartierIsVeryAmpleProj_isGloballyGenerated hv) a
  have h2 := cartierIsGloballyGenerated_nsmul _ (cartierIsVeryAmpleProj_isGloballyGenerated hv') b
  have h3 := cartierIsGloballyGenerated_add _ _ h1 h2
  have heq : a • (k • A) + b • (k' • A) = j • A := by
    rw [← mul_nsmul', ← mul_nsmul', ← add_nsmul, hab]
  rwa [heq] at h3

/-- For every point and every large degree some actual section of j A does not vanish there. -/
theorem cartierIsAmpleCoprime_eventually_exists_unit_section {A : CartierDivisor X}
    (hA : CartierIsAmpleCoprime K A) :
    ∃ j₀ : ℕ, ∀ j : ℕ, j₀ ≤ j → ∀ (x : X) (f : X.functionFieldˣ)
      (hf : (j • A).IsLocalEquationAt x f),
        ∃ s : Γ((j • A).sheaf, ⊤), IsUnit (cartierLocalCoefficient (j • A) x f hf s) := by
  obtain ⟨j₀, hj₀⟩ := cartierIsAmpleCoprime_eventually_globallyGenerated hA
  exact ⟨j₀, fun j hj x f hf =>
    (cartierIsGloballyGenerated_iff_local_frames (j • A)).mp (hj₀ j hj) x f hf⟩

end MixedFujita
