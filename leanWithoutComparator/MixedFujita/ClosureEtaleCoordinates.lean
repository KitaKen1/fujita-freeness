module

public import MixedFujita.ClosureCocycleSpreading
public import MixedFujita.EtaleCoordinateSpreading

/-!
Étale coordinates on the charts of the closure (step 10, R4-3).

* `subring_closure_basicOpen_eq_top`: if `G` generates the ring of functions on an affine open `V`
  and `W = D(s)`, the restrictions of `G` and an inverse of `s` generate the functions on `W`
  (`IsAffineOpen.isLocalization_basicOpen`).
* `subring_closure_projectiveChart_eq_top`: the functions on a standard chart of a closed subscheme
  of `ℙ_R` are generated by the constants and the ratios (`projectiveChartRingMap_surjective`).
* `closureTransition_appLE_projectiveChartRingMap`: the transition map `ρ : T_A → T_B` (check 533)
  sends ratios to ratios (both go to the ratios of `T`, and the chart maps are injective).
* `exists_fg_forall_etale_closureTransition`: for a model closure `T_B` (`T = T_B ×_B K`) and a
  basic open `W = D(s_B)` of a standard chart of `T_B`, étale coordinates `y` on `φ_B⁻¹W ⊆ T` come
  from étale coordinates `ψ` on `ρ⁻¹W ⊆ T_A` for all large `A`. This is check 512: the functions on
  `ρ⁻¹W` are generated by `A`, the pulled-back ratios and an inverse of `ρ^* s_B`, whose images
  together with `K` generate the functions on `φ_B⁻¹W` (check 497), and pulling back to `T` is
  injective (check 535).
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite TensorProduct
open TauCeti.AlgebraicGeometry TauCeti.AlgebraicGeometry.Scheme

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

attribute [local instance] MvPolynomial.gradedAlgebra structureSectionsAlgebra

universe u

/-- **The functions on a basic open are generated by restrictions and an inverse.** -/
theorem subring_closure_basicOpen_eq_top {X : Scheme.{u}} {V : X.Opens} (hV : IsAffineOpen V)
    (s : Γ(X, V)) {W : X.Opens} (hW : W = X.basicOpen s) (G : Set Γ(X, V))
    (hG : Subring.closure G = ⊤) (t : Γ(X, W))
    (ht : X.presheaf.map (homOfLE (hW.le.trans (X.basicOpen_le s))).op s * t = 1) :
    Subring.closure
      ((X.presheaf.map (homOfLE (hW.le.trans (X.basicOpen_le s))).op).hom '' G ∪ {t}) = ⊤ := by
  subst hW
  have := hV.isLocalization_basicOpen s
  rw [eq_top_iff]
  intro x _
  obtain ⟨⟨a, ⟨_, k, rfl⟩⟩, hx⟩ := IsLocalization.surj (Submonoid.powers s) x
  have hres : ∀ b : Γ(X, V), (X.presheaf.map (homOfLE (le_rfl.trans (X.basicOpen_le s))).op).hom b ∈
      Subring.closure ((X.presheaf.map (homOfLE (le_rfl.trans (X.basicOpen_le s))).op).hom '' G ∪
        {t}) := by
    intro b
    have hb : b ∈ Subring.closure G := hG ▸ Subring.mem_top b
    have hmap : (X.presheaf.map (homOfLE (le_rfl.trans (X.basicOpen_le s))).op).hom b ∈
        (Subring.closure G).map (X.presheaf.map (homOfLE
          (le_rfl.trans (X.basicOpen_le s))).op).hom :=
      Subring.mem_map.2 ⟨b, hb, rfl⟩
    rw [RingHom.map_closure] at hmap
    exact Subring.closure_mono Set.subset_union_left hmap
  have ht' : t ∈ Subring.closure ((X.presheaf.map (homOfLE
      (le_rfl.trans (X.basicOpen_le s))).op).hom '' G ∪ {t}) :=
    Subring.subset_closure (Set.mem_union_right _ rfl)
  have hx' : x = (X.presheaf.map (homOfLE (le_rfl.trans (X.basicOpen_le s))).op).hom a * t ^ k := by
    have hx2 : x * (X.presheaf.map (homOfLE (le_rfl.trans (X.basicOpen_le s))).op).hom (s ^ k) =
        (X.presheaf.map (homOfLE (le_rfl.trans (X.basicOpen_le s))).op).hom a := hx
    calc x = x * ((X.presheaf.map (homOfLE (le_rfl.trans (X.basicOpen_le s))).op).hom s * t) ^ k := by
          rw [ht, one_pow, mul_one]
      _ = x * (X.presheaf.map (homOfLE (le_rfl.trans (X.basicOpen_le s))).op).hom (s ^ k) * t ^ k := by
          rw [map_pow]; ring
      _ = _ := by rw [hx2]
  rw [hx']
  exact Subring.mul_mem _ (hres a) (Subring.pow_mem _ ht' k)

variable {n : ℕ}

/-- **The functions on a standard chart are generated by the constants and the ratios.** -/
theorem subring_closure_projectiveChart_eq_top {R : Type u} [CommRing R] {Y : Scheme.{u}}
    (e : Y ⟶ polynomialProjectiveScheme n R) [IsClosedImmersion e] (k : Fin n) :
    Subring.closure (Set.range ((projectiveChartRingMap e k).comp MvPolynomial.C) ∪
      Set.range (fun j => projectiveChartRingMap e k (MvPolynomial.X j))) = ⊤ := by
  have h1 : Subring.closure (Set.range (MvPolynomial.C : R →+* MvPolynomial {j : Fin n // j ≠ k} R) ∪
      Set.range (MvPolynomial.X : {j : Fin n // j ≠ k} → MvPolynomial {j : Fin n // j ≠ k} R)) =
        ⊤ := by
    rw [← MvPolynomial.algebraMap_eq, ← Algebra.adjoin_eq_ring_closure, MvPolynomial.adjoin_range_X,
      Algebra.top_toSubring]
  rw [eq_top_iff]
  intro x _
  obtain ⟨p, rfl⟩ := projectiveChartRingMap_surjective e k x
  have hp : p ∈ Subring.closure (Set.range (MvPolynomial.C : R →+* MvPolynomial _ R) ∪
      Set.range (MvPolynomial.X : {j : Fin n // j ≠ k} → MvPolynomial _ R)) := h1 ▸ Subring.mem_top p
  have hmap : projectiveChartRingMap e k p ∈ (Subring.closure (Set.range (MvPolynomial.C :
      R →+* MvPolynomial _ R) ∪ Set.range (MvPolynomial.X : {j : Fin n // j ≠ k} →
        MvPolynomial _ R))).map (projectiveChartRingMap e k) := Subring.mem_map.2 ⟨p, hp, rfl⟩
  rw [RingHom.map_closure, Set.image_union, ← Set.range_comp, ← Set.range_comp] at hmap
  exact hmap

section Closure

variable {K : Type u} [Field K] {T : Scheme.{u}} (e : T ⟶ polynomialProjectiveScheme n K)

/-- The closure over `A` lies over `Spec A`. -/
@[instance_reducible]
noncomputable def projectiveClosureOver {A : Type u} [CommRing A] (c : A →+* K) :
    (projectiveClosure c e).Over (Spec (CommRingCat.of A)) :=
  ⟨projectiveClosureι c e ≫ polynomialProjectiveToBase n A⟩

/-- **The transition map sends ratios to ratios.** -/
theorem closureTransition_appLE_projectiveChartRingMap [IsClosedImmersion e] {B A : Subalgebra ℤ K}
    (hBA : B ≤ A) (k : Fin n) (p : MvPolynomial {j : Fin n // j ≠ k} B) :
    (closureTransitionOfLE e hBA).appLE _ _
        (closureTransition_preimage_chart e _ _ _ _ k).ge
        (projectiveChartRingMap (projectiveClosureι (algebraMap B K) e) k p) =
      projectiveChartRingMap (projectiveClosureι (algebraMap A K) e) k
        (MvPolynomial.map (Subalgebra.inclusion hBA).toRingHom p) := by
  have := polynomialProjectiveCoefficientMap_isAffineHom (n := n) (algebraMap A K)
  apply closureChartMap_injective (algebraMap A K) e k
  have hc : (algebraMap A K).comp (Subalgebra.inclusion hBA).toRingHom = algebraMap B K :=
    RingHom.ext fun _ => rfl
  rw [closureChartMap_projectiveChartRingMap, MvPolynomial.map_map, hc,
    ← closureChartMap_projectiveChartRingMap (algebraMap B K) e k p, closureChartMap,
    closureChartMap, ← ConcreteCategory.comp_apply, Scheme.Hom.appLE_comp_appLE,
    appLE_congr_hom (projectiveClosureMap_comp_closureTransitionOfLE e hBA)]

/-- Constants on a standard chart of the closure. -/
theorem projectiveChartRingMap_C_eq_algebraMap {A : Type u} [CommRing A] (c : A →+* K) (k : Fin n)
    (a : A) :
    letI := projectiveClosureOver e c
    projectiveChartRingMap (projectiveClosureι c e) k (MvPolynomial.C a) =
      algebraMap A Γ(projectiveClosure c e,
        projectivePullbackCoordinateOpen (projectiveClosureι c e) k) a := by
  let _ := projectiveClosureOver e c
  rw [projectiveChartRingMap_C (projectiveClosureι c e)
    (projectiveClosureι c e ≫ polynomialProjectiveToBase n A) rfl k a]
  have h := ConcreteCategory.congr_hom (structureSections_algebraMap A (projectiveClosure c e)
    (projectivePullbackCoordinateOpen (projectiveClosureι c e) k)) a
  simp only [CommRingCat.hom_ofHom] at h
  exact h.symm

/-- **The functions on a basic open of a standard chart of the closure** are generated by the
constants, the ratios and an inverse of the function. -/
theorem subring_closure_projectiveClosure_basicOpen_eq_top [IsClosedImmersion e] {A : Type u}
    [CommRing A] (c : A →+* K) (k : Fin n)
    (s : Γ(projectiveClosure c e, projectivePullbackCoordinateOpen (projectiveClosureι c e) k))
    {W : (projectiveClosure c e).Opens} (hW : W = (projectiveClosure c e).basicOpen s)
    (t : Γ(projectiveClosure c e, W))
    (ht : (projectiveClosure c e).presheaf.map
      (homOfLE (hW.le.trans ((projectiveClosure c e).basicOpen_le s))).op s * t = 1) :
    letI := projectiveClosureOver e c
    Subring.closure (Set.range (algebraMap A Γ(projectiveClosure c e, W)) ∪
      Set.range (fun j => (projectiveClosure c e).presheaf.map
        (homOfLE (hW.le.trans ((projectiveClosure c e).basicOpen_le s))).op
        (projectiveChartRingMap (projectiveClosureι c e) k (MvPolynomial.X j))) ∪ {t}) = ⊤ := by
  let _ := projectiveClosureOver e c
  have hV := projectivePullbackCoordinateOpen_isAffineOpen_of_isClosedImmersion
    (projectiveClosureι c e) k
  have h := subring_closure_basicOpen_eq_top hV s hW _
    (subring_closure_projectiveChart_eq_top (projectiveClosureι c e) k) t ht
  rw [eq_top_iff, ← h, Subring.closure_le]
  rintro x (⟨y, (⟨a, rfl⟩ | ⟨j, rfl⟩), rfl⟩ | rfl)
  · apply Subring.subset_closure
    refine Or.inl (Or.inl ⟨a, ?_⟩)
    simp only [RingHom.coe_comp, Function.comp_apply]
    rw [projectiveChartRingMap_C_eq_algebraMap e c k a]
    exact ((structureRestrictAlgHom A (projectiveClosure c e)
      (hW.le.trans ((projectiveClosure c e).basicOpen_le s))).commutes a).symm
  · exact Subring.subset_closure (Or.inl (Or.inr ⟨j, rfl⟩))
  · exact Subring.subset_closure (Or.inr rfl)

/-- **The functions on the preimage in `T` of a basic open of a standard chart of the model** are
generated by `K`, the pulled-back ratios and the pulled-back inverse (check 497). -/
theorem subring_closure_preimage_basicOpen_eq_top [IsClosedImmersion e]
    [T.Over (Spec (CommRingCat.of K))] (B : Subalgebra ℤ K)
    (HB : IsPullback (projectiveClosureMap (algebraMap B K) e) (T ↘ Spec (CommRingCat.of K))
      (projectiveClosureι (algebraMap B K) e ≫ polynomialProjectiveToBase n B)
      (Spec.map (CommRingCat.ofHom (algebraMap B K)))) (k : Fin n)
    (sB : Γ(projectiveClosure (algebraMap B K) e,
      projectivePullbackCoordinateOpen (projectiveClosureι (algebraMap B K) e) k))
    (tB : Γ(projectiveClosure (algebraMap B K) e, (projectiveClosure (algebraMap B K) e).basicOpen sB))
    (htB : (projectiveClosure (algebraMap B K) e).presheaf.map
      (homOfLE ((projectiveClosure (algebraMap B K) e).basicOpen_le sB)).op sB * tB = 1) :
    Subring.closure (Set.range (algebraMap K Γ(T, projectiveClosureMap (algebraMap B K) e ⁻¹ᵁ
        (projectiveClosure (algebraMap B K) e).basicOpen sB)) ∪
      Set.range (fun j => (projectiveClosureMap (algebraMap B K) e).appLE _ _ le_rfl
        ((projectiveClosure (algebraMap B K) e).presheaf.map
          (homOfLE ((projectiveClosure (algebraMap B K) e).basicOpen_le sB)).op
          (projectiveChartRingMap (projectiveClosureι (algebraMap B K) e) k (MvPolynomial.X j)))) ∪
      {(projectiveClosureMap (algebraMap B K) e).appLE _ _ le_rfl tB}) = ⊤ := by
  let _ := projectiveClosureOver e (algebraMap B K)
  have hVB := projectivePullbackCoordinateOpen_isAffineOpen_of_isClosedImmersion
    (projectiveClosureι (algebraMap B K) e) k
  have hW := hVB.basicOpen sB
  have hgenB := subring_closure_projectiveClosure_basicOpen_eq_top e (algebraMap B K) k sB rfl tB htB
  rw [eq_top_iff]
  intro x _
  obtain ⟨z, rfl⟩ := (sectionsBaseChangeEquiv HB hW).surjective x
  induction z using TensorProduct.inductionOn with
  | tmul l b =>
    rw [sectionsBaseChangeEquiv_tmul]
    refine Subring.mul_mem _ (Subring.subset_closure (Or.inl (Or.inl ⟨l, rfl⟩))) ?_
    have hb := hgenB ▸ Subring.mem_top b
    have hmap := (Subring.mem_map (f := ((projectiveClosureMap (algebraMap B K) e).appLE
      ((projectiveClosure (algebraMap B K) e).basicOpen sB) _ le_rfl).hom)).2 ⟨b, hb, rfl⟩
    rw [RingHom.map_closure] at hmap
    refine Subring.closure_le.2 ?_ hmap
    rintro _ ⟨z, ((⟨b', rfl⟩ | ⟨j, rfl⟩) | rfl), rfl⟩
    · apply Subring.subset_closure
      exact Or.inl (Or.inl ⟨algebraMap B K b',
        (appLE_algebraMap_of_comp (projectiveClosureMap (algebraMap B K) e) HB.w le_rfl b').symm⟩)
    · exact Subring.subset_closure (Or.inl (Or.inr ⟨j, rfl⟩))
    · exact Subring.subset_closure (Or.inr rfl)
  | add x₁ x₂ h₁ h₂ =>
    rw [map_add]
    exact Subring.add_mem _ (h₁ trivial) (h₂ trivial)

/-- **The functions on the preimage in `T_A` of a basic open of a standard chart of `T_B`** are
generated by `A`, the pulled-back ratios and the pulled-back inverse. -/
theorem subring_closure_closureTransition_basicOpen_eq_top [IsClosedImmersion e]
    {B A : Subalgebra ℤ K} (hBA : B ≤ A) (k : Fin n)
    (sB : Γ(projectiveClosure (algebraMap B K) e,
      projectivePullbackCoordinateOpen (projectiveClosureι (algebraMap B K) e) k))
    (tB : Γ(projectiveClosure (algebraMap B K) e, (projectiveClosure (algebraMap B K) e).basicOpen sB))
    (htB : (projectiveClosure (algebraMap B K) e).presheaf.map
      (homOfLE ((projectiveClosure (algebraMap B K) e).basicOpen_le sB)).op sB * tB = 1) :
    letI := projectiveClosureOver e (algebraMap A K)
    Subring.closure (Set.range (algebraMap A Γ(projectiveClosure (algebraMap A K) e,
        closureTransitionOfLE e hBA ⁻¹ᵁ (projectiveClosure (algebraMap B K) e).basicOpen sB)) ∪
      Set.range (fun j => (closureTransitionOfLE e hBA).appLE _ _ le_rfl
        ((projectiveClosure (algebraMap B K) e).presheaf.map
          (homOfLE ((projectiveClosure (algebraMap B K) e).basicOpen_le sB)).op
          (projectiveChartRingMap (projectiveClosureι (algebraMap B K) e) k (MvPolynomial.X j)))) ∪
      {(closureTransitionOfLE e hBA).appLE _ _ le_rfl tB}) = ⊤ := by
  let _ := projectiveClosureOver e (algebraMap A K)
  have hpre := (closureTransition_preimage_chart e _ _ _
    (RingHom.ext fun _ => rfl : (algebraMap A K).comp (Subalgebra.inclusion hBA).toRingHom =
      algebraMap B K) k)
  have hle : closureTransitionOfLE e hBA ⁻¹ᵁ (projectiveClosure (algebraMap B K) e).basicOpen sB ≤
      projectivePullbackCoordinateOpen (projectiveClosureι (algebraMap A K) e) k := by
    rw [← hpre]
    exact (Opens.map (closureTransitionOfLE e hBA).base).monotone
      ((projectiveClosure (algebraMap B K) e).basicOpen_le sB)
  have hWA : closureTransitionOfLE e hBA ⁻¹ᵁ (projectiveClosure (algebraMap B K) e).basicOpen sB =
      (projectiveClosure (algebraMap A K) e).basicOpen
        ((closureTransitionOfLE e hBA).appLE _ _ hpre.ge sB) := by
    rw [Scheme.basicOpen_appLE]
    exact (inf_eq_right.2 hle).symm
  have htA : (projectiveClosure (algebraMap A K) e).presheaf.map (homOfLE (hWA.le.trans
      ((projectiveClosure (algebraMap A K) e).basicOpen_le _))).op
        ((closureTransitionOfLE e hBA).appLE _ _ hpre.ge sB) *
      (closureTransitionOfLE e hBA).appLE _ _ le_rfl tB = 1 := by
    rw [appLE_restrict_apply, ← appLE_of_restrict_apply (e := le_rfl)
      (h := (projectiveClosure (algebraMap B K) e).basicOpen_le sB), ← map_mul, htB, map_one]
  have hgenA := subring_closure_projectiveClosure_basicOpen_eq_top e (algebraMap A K) k _ hWA _ htA
  rw [eq_top_iff, ← hgenA, Subring.closure_le]
  rintro _ ((⟨a, rfl⟩ | ⟨j, rfl⟩) | rfl)
  · exact Subring.subset_closure (Or.inl (Or.inl ⟨a, rfl⟩))
  · apply Subring.subset_closure
    refine Or.inl (Or.inr ⟨j, ?_⟩)
    have h := closureTransition_appLE_projectiveChartRingMap e hBA k (MvPolynomial.X j)
    rw [MvPolynomial.map_X] at h
    dsimp only
    rw [← h, appLE_restrict_apply, appLE_of_restrict_apply]
  · exact Subring.subset_closure (Or.inr rfl)

/-- **Étale coordinates on a chart of the model spread to the closures.** -/
theorem exists_fg_forall_etale_closureTransition [IsIntegral T] [T.Over (Spec (CommRingCat.of K))]
    [IsClosedImmersion e]
    (he : e ≫ polynomialProjectiveToBase n K = T ↘ Spec (CommRingCat.of K)) (B : Subalgebra ℤ K)
    (HB : IsPullback (projectiveClosureMap (algebraMap B K) e) (T ↘ Spec (CommRingCat.of K))
      (projectiveClosureι (algebraMap B K) e ≫ polynomialProjectiveToBase n B)
      (Spec.map (CommRingCat.ofHom (algebraMap B K)))) (k : Fin n)
    (sB : Γ(projectiveClosure (algebraMap B K) e,
      projectivePullbackCoordinateOpen (projectiveClosureι (algebraMap B K) e) k))
    [Nonempty (projectiveClosureMap (algebraMap B K) e ⁻¹ᵁ
      (projectiveClosure (algebraMap B K) e).basicOpen sB)]
    {d : ℕ} (y : MvPolynomial (Fin d) K →ₐ[K] Γ(T, projectiveClosureMap (algebraMap B K) e ⁻¹ᵁ
      (projectiveClosure (algebraMap B K) e).basicOpen sB))
    (hy : y.toRingHom.Etale) :
    ∃ A₀ : Subalgebra ℤ K, A₀.FG ∧ ∀ (A : Subalgebra ℤ K) (hBA : B ≤ A), A₀ ≤ A →
      letI := projectiveClosureOver e (algebraMap A K)
      ∃ ψ : MvPolynomial (Fin d) A →ₐ[A] Γ(projectiveClosure (algebraMap A K) e,
          closureTransitionOfLE e hBA ⁻¹ᵁ (projectiveClosure (algebraMap B K) e).basicOpen sB),
        ψ.toRingHom.Etale ∧ ∀ j, (projectiveClosureMap (algebraMap A K) e).appLE _ _
          (projectiveClosureMap_preimage_closureTransitionOfLE e hBA _).ge
          (ψ (MvPolynomial.X j)) = y (MvPolynomial.X j) := by
  classical
  have hVB := projectivePullbackCoordinateOpen_isAffineOpen_of_isClosedImmersion
    (projectiveClosureι (algebraMap B K) e) k
  have hW := hVB.basicOpen sB
  obtain ⟨tB, htB⟩ : ∃ tB : Γ(projectiveClosure (algebraMap B K) e,
      (projectiveClosure (algebraMap B K) e).basicOpen sB),
      (projectiveClosure (algebraMap B K) e).presheaf.map
        (homOfLE ((projectiveClosure (algebraMap B K) e).basicOpen_le sB)).op sB * tB = 1 :=
    ⟨_, ((projectiveClosure (algebraMap B K) e).toRingedSpace.isUnit_res_basicOpen sB).mul_val_inv⟩
  -- generators of the functions on `φ_B⁻¹W`
  let γ : Finset Γ(T, projectiveClosureMap (algebraMap B K) e ⁻¹ᵁ
      (projectiveClosure (algebraMap B K) e).basicOpen sB) :=
    Finset.univ.image (fun j => (projectiveClosureMap (algebraMap B K) e).appLE _ _ le_rfl
      ((projectiveClosure (algebraMap B K) e).presheaf.map
        (homOfLE ((projectiveClosure (algebraMap B K) e).basicOpen_le sB)).op
        (projectiveChartRingMap (projectiveClosureι (algebraMap B K) e) k (MvPolynomial.X j)))) ∪
    {(projectiveClosureMap (algebraMap B K) e).appLE _ _ le_rfl tB}
  have hγ : Subring.closure (Set.range y.toRingHom ∪ (γ : Set Γ(T,
      projectiveClosureMap (algebraMap B K) e ⁻¹ᵁ
        (projectiveClosure (algebraMap B K) e).basicOpen sB))) = ⊤ := by
    rw [eq_top_iff, ← subring_closure_preimage_basicOpen_eq_top e B HB k sB tB htB,
      Subring.closure_le]
    rintro _ ((⟨l, rfl⟩ | ⟨j, rfl⟩) | rfl)
    · exact Subring.subset_closure (Or.inl ⟨MvPolynomial.C l, y.commutes l⟩)
    · exact Subring.subset_closure (Or.inr (Finset.mem_coe.2 (Finset.mem_union_left _
        (Finset.mem_image_of_mem _ (Finset.mem_univ j)))))
    · exact Subring.subset_closure (Or.inr (Finset.mem_coe.2 (Finset.mem_union_right _
        (Finset.mem_singleton_self _))))
  -- étaleness of the spread coordinates (check 512) and the spread coordinates (check 533)
  obtain ⟨A₂, hA₂, hA₂'⟩ := exists_fg_forall_etale_of_injective d y.toRingHom hy γ hγ
  obtain ⟨A₁, hA₁, hA₁'⟩ := exists_fg_forall_mem_range_closureTransition_appLE e he B HB hW
    (Finset.univ.image fun j => y (MvPolynomial.X j))
  refine ⟨A₁ ⊔ A₂, hA₁.sup hA₂, fun A hBA hA => ?_⟩
  let _ := projectiveClosureOver e (algebraMap A K)
  have := projectiveClosure_isIntegral_of_isClosedImmersion e (algebraMap A K)
  have := projectiveClosureMap_isDominant e (algebraMap A K)
  have hle := (projectiveClosureMap_preimage_closureTransitionOfLE e hBA
    ((projectiveClosure (algebraMap B K) e).basicOpen sB)).ge
  choose t ht using fun j => hA₁' A hBA (le_sup_left.trans hA) (y (MvPolynomial.X j))
    (Finset.mem_image_of_mem _ (Finset.mem_univ j))
  obtain ⟨ψ, hψ⟩ : ∃ ψ : MvPolynomial (Fin d) A →ₐ[A] Γ(projectiveClosure (algebraMap A K) e,
      closureTransitionOfLE e hBA ⁻¹ᵁ (projectiveClosure (algebraMap B K) e).basicOpen sB),
      ∀ j, ψ (MvPolynomial.X j) = t j :=
    ⟨MvPolynomial.aeval t, fun j => MvPolynomial.aeval_X t j⟩
  refine ⟨ψ, ?_, fun j => by rw [hψ]; exact ht j⟩
  have hneA : Nonempty (closureTransitionOfLE e hBA ⁻¹ᵁ
      (projectiveClosure (algebraMap B K) e).basicOpen sB) := by
    obtain ⟨⟨z, hz⟩⟩ := (inferInstance : Nonempty (projectiveClosureMap (algebraMap B K) e ⁻¹ᵁ
      (projectiveClosure (algebraMap B K) e).basicOpen sB))
    exact ⟨⟨projectiveClosureMap (algebraMap A K) e z, hle hz⟩⟩
  have hinj := appLE_injective_of_isDominant (projectiveClosureMap (algebraMap A K) e) hle
  have hρ'B : ∀ b, (projectiveClosureMap (algebraMap A K) e).appLE _ _ hle
      ((closureTransitionOfLE e hBA).appLE _ _ le_rfl b) =
      (projectiveClosureMap (algebraMap B K) e).appLE
        ((projectiveClosure (algebraMap B K) e).basicOpen sB) _ le_rfl b := by
    intro b
    rw [← ConcreteCategory.comp_apply, Scheme.Hom.appLE_comp_appLE,
      appLE_congr_hom (projectiveClosureMap_comp_closureTransitionOfLE e hBA)]
  refine hA₂' A (le_sup_right.trans hA) _ ψ.toRingHom
    ((projectiveClosureMap (algebraMap A K) e).appLE _ _ hle).hom ?_ hinj ?_ ?_
  · -- compatibility with the coordinates of `T`
    apply MvPolynomial.ringHom_ext
    · intro a
      change (projectiveClosureMap (algebraMap A K) e).appLE _ _ hle (ψ (MvPolynomial.C a)) =
        y (MvPolynomial.map (algebraMap A K) (MvPolynomial.C a))
      rw [MvPolynomial.map_C, ← MvPolynomial.algebraMap_eq, ← MvPolynomial.algebraMap_eq,
        ψ.commutes, y.commutes]
      exact appLE_algebraMap_of_comp _ (projectiveClosureMap_comp_toBase e (algebraMap A K) he)
        hle a
    · intro j
      change (projectiveClosureMap (algebraMap A K) e).appLE _ _ hle (ψ (MvPolynomial.X j)) =
        y (MvPolynomial.map (algebraMap A K) (MvPolynomial.X j))
      rw [MvPolynomial.map_X, hψ]
      exact ht j
  · -- the generators come from `T_A`
    intro z hz
    rcases Finset.mem_union.1 (Finset.mem_coe.1 hz) with hz | hz
    · obtain ⟨j, -, rfl⟩ := Finset.mem_image.1 hz
      exact ⟨_, hρ'B _⟩
    · rw [Finset.mem_singleton.1 hz]
      exact ⟨_, hρ'B tB⟩
  · -- generation of the functions on `ρ⁻¹W`
    rw [eq_top_iff, ← subring_closure_closureTransition_basicOpen_eq_top e hBA k sB tB htB,
      Subring.closure_le]
    rintro _ ((⟨a, rfl⟩ | ⟨j, rfl⟩) | rfl)
    · exact Subring.subset_closure (Or.inl ⟨MvPolynomial.C a, ψ.commutes a⟩)
    · apply Subring.subset_closure
      refine Or.inr ?_
      change (projectiveClosureMap (algebraMap A K) e).appLE _ _ hle
        ((closureTransitionOfLE e hBA).appLE _ _ le_rfl _) ∈ (γ : Set _)
      rw [hρ'B]
      exact Finset.mem_coe.2 (Finset.mem_union_left _
        (Finset.mem_image_of_mem _ (Finset.mem_univ j)))
    · apply Subring.subset_closure
      refine Or.inr ?_
      change (projectiveClosureMap (algebraMap A K) e).appLE _ _ hle
        ((closureTransitionOfLE e hBA).appLE _ _ le_rfl tB) ∈ (γ : Set _)
      rw [hρ'B]
      exact Finset.mem_coe.2 (Finset.mem_union_right _ (Finset.mem_singleton_self _))

end Closure

end MixedFujita
