module

public import MixedFujita.CartierSectionsEmbedding

/-!
A closed immersion into projective space from an atlas of ratios, with no divisor. Let V_β be
opens covering a scheme Y proper over a field, each with a chosen coordinate index, and let
c_β(q), q < M, be functions on V_β with c_β(β) = 1 and c_γ(q) = c_γ(β) c_β(q) on V_β ∩ V_γ.
These glue to a morphism from Y to the projective space with M coordinates, over the base field.
If moreover c_γ(β) vanishes on V_γ outside V_β, the preimage of the coordinate open of β is V_β;
and if each V_β is affine with functions generated by the c_β(q), the morphism is a closed
immersion. The gluing is the coordinate atlas of the pinned openai/math, and the closed immersion
is checked on the charts V_β as for the morphism defined by sections of a divisor.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open OAI.PiExponentSeshadri.Projective

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

variable {K : Type u} [Field K] {Y : Scheme.{u}} [Y.Over (Spec (CommRingCat.of K))]
  {M : ℕ} {ι : Type u} (idx : ι → Fin M) (V : ι → Y.Opens) (hV : (⨆ β, V β) = ⊤)
  (c : ∀ β, Fin M → Γ(Y, V β)) (hnorm : ∀ β, c β (idx β) = 1)
  (hcocycle : ∀ β γ q,
    Y.presheaf.map (homOfLE (inf_le_right : V β ⊓ V γ ≤ V γ)).op (c γ q) =
      Y.presheaf.map (homOfLE (inf_le_right : V β ⊓ V γ ≤ V γ)).op (c γ (idx β)) *
        Y.presheaf.map (homOfLE (inf_le_left : V β ⊓ V γ ≤ V β)).op (c β q))

include hnorm hcocycle in
/-- On an overlap the transition ratio of two charts has the opposite ratio as inverse. -/
theorem ratioAtlas_transition_mul (β γ : ι) :
    Y.presheaf.map (homOfLE (inf_le_right : V β ⊓ V γ ≤ V γ)).op (c γ (idx β)) *
      Y.presheaf.map (homOfLE (inf_le_left : V β ⊓ V γ ≤ V β)).op (c β (idx γ)) = 1 := by
  rw [← hcocycle β γ (idx γ), hnorm, map_one]

include hnorm hcocycle in
/-- On the fibre product of two charts the coordinates differ by a unit. -/
theorem ratioAtlas_pullback_overlap (β γ : ι) :
    ∃ u : Γ(pullback (V β).ι (V γ).ι, ⊤)ˣ, ∀ q,
      (pullback.snd (V β).ι (V γ).ι).appTop (opensSectionToTop _ (c γ q)) =
        (u : Γ(pullback (V β).ι (V γ).ι, ⊤)) *
          (pullback.fst (V β).ι (V γ).ι).appTop (opensSectionToTop _ (c β q)) := by
  have hone : opensInterSectionToPullback (V β) (V γ)
        (Y.presheaf.map (homOfLE (inf_le_right : V β ⊓ V γ ≤ V γ)).op (c γ (idx β))) *
      opensInterSectionToPullback (V β) (V γ)
        (Y.presheaf.map (homOfLE (inf_le_left : V β ⊓ V γ ≤ V β)).op (c β (idx γ))) = 1 := by
    rw [← map_mul, ratioAtlas_transition_mul idx V c hnorm hcocycle β γ, map_one]
  refine ⟨Units.mkOfMulEqOne _ _ hone, fun q => ?_⟩
  rw [pullback_snd_appTop_opensSectionToTop, pullback_fst_appTop_opensSectionToTop,
    Units.val_mkOfMulEqOne, ← map_mul, ← hcocycle β γ q]

variable (K) in
/-- The coordinate atlas of a family of ratios on a cover. -/
noncomputable def ratioAtlas :=
  ({ cover := Y.openCoverOfIsOpenCover V (IsOpenCover.mk hV)
     scalars := fun β : ι => (V β).ι.appTop.hom.comp (schemeBaseScalars K Y)
     coordinates := fun (β : ι) (q : Fin M) => opensSectionToTop _ (c β q)
     index := idx
     normalized := fun β : ι => by rw [hnorm, map_one]
     scalarOverlap := fun β γ : ι =>
        pullbackOpens_scalars_comp (V β) (V γ) (schemeBaseScalars K Y)
     coordinateOverlap := fun β γ : ι =>
        ratioAtlas_pullback_overlap idx V c hnorm hcocycle β γ } :
    CoordinateAtlas (K := K) (σ := Fin M) Y)

variable (K) in
/-- The morphism to projective space defined by an atlas of ratios. -/
noncomputable def ratioAtlasMap : Y ⟶ polynomialProjectiveScheme M K :=
  (ratioAtlas K idx V hV c hnorm hcocycle).morphism

/-- On a chart the morphism is given by the ratios of that chart. -/
theorem ratioAtlasMap_ι (β : ι) :
    (V β).ι ≫ ratioAtlasMap K idx V hV c hnorm hcocycle =
      coordinatesMap (V β).toScheme ((V β).ι.appTop.hom.comp (schemeBaseScalars K Y))
        (fun q => opensSectionToTop _ (c β q)) (idx β) (by rw [hnorm, map_one]) :=
  CoordinateAtlas.cover_morphism (ratioAtlas K idx V hV c hnorm hcocycle) β

/-- The morphism of an atlas of ratios is a morphism over the base field. -/
theorem ratioAtlasMap_over :
    ratioAtlasMap K idx V hV c hnorm hcocycle ≫ polynomialProjectiveToBase M K =
      Y ↘ Spec (CommRingCat.of K) := by
  rw [polynomialProjectiveToBase_eq_projectiveBase]
  refine Eq.trans ?_ (toSpec_scalarMap (Y ↘ Spec (CommRingCat.of K)))
  apply (Y.openCoverOfIsOpenCover V (IsOpenCover.mk hV)).hom_ext
  intro β
  change (V β).ι ≫ _ = (V β).ι ≫ Y.toSpecΓ ≫ _
  rw [← Category.assoc, ratioAtlasMap_ι, coordinatesMap_over]
  rw [← Category.assoc, Scheme.toSpecΓ_naturality, Category.assoc, ← Spec.map_comp]
  rfl

include hnorm hcocycle in
/-- The transition ratio of two charts does not vanish exactly on their overlap, when it
vanishes outside the chart of its index. -/
theorem ratioAtlas_basicOpen_transition
    (hbasic : ∀ β γ, Y.basicOpen (c γ (idx β)) ≤ V β) (β γ : ι) :
    Y.basicOpen (c γ (idx β)) = V γ ⊓ V β := by
  apply le_antisymm (le_inf (Y.basicOpen_le _) (hbasic β γ))
  have hunit : IsUnit (Y.presheaf.map (homOfLE (inf_le_right : V β ⊓ V γ ≤ V γ)).op
      (c γ (idx β))) :=
    IsUnit.of_mul_eq_one _ (ratioAtlas_transition_mul idx V c hnorm hcocycle β γ)
  have h := Y.basicOpen_res (c γ (idx β)) (homOfLE (inf_le_right : V β ⊓ V γ ≤ V γ)).op
  rw [Y.basicOpen_of_isUnit hunit] at h
  intro x hx
  have hx' : x ∈ V β ⊓ V γ := ⟨hx.2, hx.1⟩
  rw [h] at hx'
  exact hx'.2

/-- The preimage of a chosen coordinate open is the corresponding chart. -/
theorem ratioAtlasMap_preimage (hbasic : ∀ β γ, Y.basicOpen (c γ (idx β)) ≤ V β) (β : ι) :
    ratioAtlasMap K idx V hV c hnorm hcocycle ⁻¹ᵁ
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin M) K) (MvPolynomial.X (idx β)) =
      V β := by
  ext x
  have hx : x ∈ ⨆ γ, V γ := by
    rw [hV]
    trivial
  obtain ⟨γ, hγ⟩ := Opens.mem_iSup.mp hx
  have H : (V γ).ι ⁻¹ᵁ (ratioAtlasMap K idx V hV c hnorm hcocycle ⁻¹ᵁ
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin M) K)
          (MvPolynomial.X (idx β))) = (V γ).ι ⁻¹ᵁ V β := by
    rw [← Scheme.Hom.comp_preimage, ratioAtlasMap_ι, coordinatesMap_preimage]
    change (V γ).toScheme.basicOpen
      ((V γ).ι.appLE (V γ) ⊤ (V γ).ι_preimage_self.ge (c γ (idx β))) = _
    rw [Scheme.basicOpen_appLE, ratioAtlas_basicOpen_transition idx V c hnorm hcocycle hbasic,
      Scheme.Hom.preimage_inf, Scheme.Opens.ι_preimage_self, top_inf_eq, top_inf_eq]
  exact Set.ext_iff.mp (congrArg SetLike.coe H) (⟨x, hγ⟩ : (V γ).toScheme)

/-- The morphism of an atlas of ratios is proper when the scheme is proper over the base field. -/
theorem ratioAtlasMap_isProper [IsProper (Y ↘ Spec (CommRingCat.of K))] :
    IsProper (ratioAtlasMap K idx V hV c hnorm hcocycle) := by
  have h : IsProper (ratioAtlasMap K idx V hV c hnorm hcocycle ≫
      projectiveBase (K := K) (σ := Fin M)) := by
    rw [← polynomialProjectiveToBase_eq_projectiveBase, ratioAtlasMap_over]
    infer_instance
  exact IsProper.of_comp _ (projectiveBase (K := K) (σ := Fin M))

/-- The morphism of an atlas of ratios is a closed immersion when the charts are affine, their
functions are generated by the ratios, and each transition ratio vanishes outside the chart of
its index. -/
theorem ratioAtlasMap_isClosedImmersion [IsProper (Y ↘ Spec (CommRingCat.of K))]
    (hbasic : ∀ β γ, Y.basicOpen (c γ (idx β)) ≤ V β)
    (haff : ∀ β, IsAffineOpen (V β))
    (hgen : ∀ β, Function.Surjective (MvPolynomial.eval₂Hom
      ((Y.presheaf.map (homOfLE (le_top : V β ≤ ⊤)).op).hom.comp (schemeBaseScalars K Y))
      (c β))) :
    IsClosedImmersion (ratioAtlasMap K idx V hV c hnorm hcocycle) := by
  have := ratioAtlasMap_isProper (K := K) idx V hV c hnorm hcocycle
  have hn (β : ι) : opensSectionToTop (V β) (c β (idx β)) = 1 := by rw [hnorm, map_one]
  let g (β : ι) := (V β).toScheme.toSpecΓ ≫
    Spec.map (CommRingCat.ofHom
      (evalAway (𝒜 := MvPolynomial.homogeneousSubmodule (Fin M) K)
        (MvPolynomial.eval₂Hom ((V β).ι.appTop.hom.comp (schemeBaseScalars K Y))
          (fun q => opensSectionToTop _ (c β q)))
        (MvPolynomial.X (idx β))
        (by simpa only [MvPolynomial.eval₂Hom_X', hn β]
          using (isUnit_one : IsUnit (1 : Γ((V β).toScheme, ⊤))))))
  let ep (β : ι) := Proj.basicOpenIsoSpec (MvPolynomial.homogeneousSubmodule (Fin M) K)
    (MvPolynomial.X (idx β)) (MvPolynomial.isHomogeneous_X K (idx β)) (by decide : 0 < (1 : ℕ))
  apply OAI.PiExponentSeshadri.Geometry.closedImmersion_of_source_charts
    (ratioAtlasMap K idx V hV c hnorm hcocycle) V
    (fun β => Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin M) K)
      (MvPolynomial.X (idx β))) hV (fun β => g β ≫ (ep β).inv)
  · intro β
    have : IsAffine (V β).toScheme := haff β
    have : IsClosedImmersion (g β) := normalized_coordinates_closed
      ((V β).ι.appTop.hom.comp (schemeBaseScalars K Y))
      (fun q => opensSectionToTop _ (c β q)) (idx β) (hn β)
      (eval₂Hom_opensSectionToTop_surjective _ _ _ (hgen β))
    infer_instance
  · intro β
    rw [ratioAtlasMap_ι]
    rfl
  · intro β
    exact ratioAtlasMap_preimage idx V hV c hnorm hcocycle hbasic β

include hV hnorm hcocycle in
/-- An atlas of ratios with affine charts, generated functions and exact transition loci embeds
a scheme proper over a field into projective space over that field. -/
theorem exists_closedImmersion_of_ratioAtlas [IsProper (Y ↘ Spec (CommRingCat.of K))]
    (hbasic : ∀ β γ, Y.basicOpen (c γ (idx β)) ≤ V β)
    (haff : ∀ β, IsAffineOpen (V β))
    (hgen : ∀ β, Function.Surjective (MvPolynomial.eval₂Hom
      ((Y.presheaf.map (homOfLE (le_top : V β ≤ ⊤)).op).hom.comp (schemeBaseScalars K Y))
      (c β))) :
    ∃ (e : Y ⟶ polynomialProjectiveScheme M K) (_ : IsClosedImmersion e),
      e ≫ polynomialProjectiveToBase M K = Y ↘ Spec (CommRingCat.of K) :=
  ⟨ratioAtlasMap K idx V hV c hnorm hcocycle,
    ratioAtlasMap_isClosedImmersion idx V hV c hnorm hcocycle hbasic haff hgen,
    ratioAtlasMap_over idx V hV c hnorm hcocycle⟩

end MixedFujita
