module

public import MixedFujita.EtaleChartTaylorCoordinates
public import MixedFujita.SmoothAffineCompletion
public import MixedFujita.LocalJetSpan
public import Mathlib.RingTheory.Unramified.LocalRing

/-!
Regular systems of parameters from étale charts (step 11). Let g : K[X_1, …, X_n] → A be étale
with a K-point α of A at which g is centred, and S the localization of A at the kernel of α. The
map from T = K[X]_(X) to S is formally étale, essentially of finite type and local, hence formally
unramified, so the maximal ideal of S is generated by the image of the maximal ideal (X_1, …, X_n)
of T. On a scheme: at a point x of an étale chart with a K-valued point of the stalk, the chart
coordinates centred at x generate the maximal ideal of the stalk; they are a regular system of
parameters. In particular, at a smooth closed point of the closure W of a point, an étale chart of
W with dim W coordinates gives generators of the maximal ideal, and every germ agrees with a
polynomial of degree at most m in the centred coordinates modulo the (m+1)-st power of the maximal
ideal.
-/

@[expose] public section

set_option backward.isDefEq.respectTransparency false

namespace MixedFujita

attribute [local instance] polynomialVariableIdeal_isMaximal rationalPoint_ker_isMaximal

section Algebra

variable {σ K A : Type*} [Finite σ] [Field K] [CommRing A] [Algebra K A]

omit [Finite σ] in
/-- The centred coordinates of an étale chart generate the maximal ideal of the local ring at the
centre. -/
theorem centeredEtaleChart_maximalIdeal_eq_span
    (g : MvPolynomial σ K →ₐ[K] A) (hg : g.Etale)
    (α : A →ₐ[K] K)
    (hc : ∀ p, α (g p) = MvPolynomial.constantCoeff p)
    (S : Type*) [CommRing S] [Algebra K S] [Algebra A S] [IsScalarTower K A S]
    [IsLocalization.AtPrime S (RingHom.ker α.toRingHom)] [IsLocalRing S] :
    IsLocalRing.maximalIdeal S =
      Ideal.span (Set.range fun i => algebraMap A S (g (MvPolynomial.X i))) := by
  let P := MvPolynomial σ K
  let T := Localization.AtPrime (MvPolynomial.idealOfVars σ K)
  let : Algebra P A := g.toRingHom.toAlgebra
  let : IsScalarTower K P A := IsScalarTower.of_algHom g
  let : Algebra P S := Algebra.compHom S g.toRingHom
  let : IsScalarTower P A S := IsScalarTower.of_algebraMap_eq' rfl
  let : IsScalarTower K P S := IsScalarTower.to₁₂₄ K P A S
  let β := rationalPointLocalization α S
  let f : P →ₐ[K] S := (IsScalarTower.toAlgHom K A S).comp g
  have hf : ∀ y : (MvPolynomial.idealOfVars σ K).primeCompl, IsUnit (f y) := by
    intro y
    apply (rationalLocalPoint_isUnit_iff β _).mpr
    have hy : β (f y) = MvPolynomial.constantCoeff (y : P) := by
      exact (rationalPointLocalization_algebraMap α S (g y)).trans (hc y)
    rw [hy]
    exact (polynomialOrigin_notMem_iff (y : P)).mp y.property
  let φ : T →ₐ[K] S := IsLocalization.liftAlgHom hf
  have hφ (p : P) : φ (algebraMap P T p) = algebraMap A S (g p) :=
    IsLocalization.lift_eq hf p
  let : Algebra T S := φ.toRingHom.toAlgebra
  let : IsScalarTower K T S := IsScalarTower.of_algHom φ
  let : IsScalarTower P T S := IsScalarTower.of_algebraMap_eq (fun p => (hφ p).symm)
  let : Algebra.Etale P A := hg
  let : Algebra.FormallyEtale A S :=
    Algebra.FormallyEtale.of_isLocalization (RingHom.ker α.toRingHom).primeCompl
  let : Algebra.FormallyEtale P S := Algebra.FormallyEtale.comp P A S
  let : Algebra.FormallyEtale P T :=
    Algebra.FormallyEtale.of_isLocalization (MvPolynomial.idealOfVars σ K).primeCompl
  let : Algebra.FormallyEtale T S := Algebra.FormallyEtale.of_restrictScalars (R := P)
  let : Algebra.EssFiniteType A S :=
    Algebra.EssFiniteType.of_isLocalization S (RingHom.ker α.toRingHom).primeCompl
  let : Algebra.EssFiniteType P S := Algebra.EssFiniteType.comp P A S
  let : Algebra.EssFiniteType T S := Algebra.EssFiniteType.of_comp P T S
  have hβ (p : P) :
      β (algebraMap T S (algebraMap P T p)) = MvPolynomial.constantCoeff p := by
    change β (φ (algebraMap P T p)) = _
    rw [hφ, rationalPointLocalization_algebraMap, hc]
  have : IsLocalHom (algebraMap T S) :=
    compatibleRationalPoints_isLocalHom (polynomialOriginLocalPoint (σ := σ) (K := K) T) β
      (rationalPolynomialPoint_compatible T S β hβ)
  rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := T) (S := S),
    ← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map, Ideal.map_span, ← Set.range_comp]
  congr 2
  funext i
  exact hφ (MvPolynomial.X i)

end Algebra

section Scheme

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

set_option backward.isDefEq.respectTransparency.types false

universe u

variable {K : Type u} [Field K] {X : Scheme.{u}} [X.Over (Spec (CommRingCat.of K))] {n : ℕ}

attribute [local instance] cartierGlobalStalkAlgebra cartierGlobalStalkFunctionFieldTower
  cartierBaseGlobalAlgebra cartierBaseLocalAlgebra cartierBaseLocalScalarTower
  cartierBaseOpenAlgebra

variable [LocallyOfFiniteType (X ↘ Spec (CommRingCat.of K))]

/-- At a point of an étale chart with a K-valued point of the stalk, the centred chart coordinates
generate the maximal ideal of the stalk: they are a regular system of parameters. -/
theorem etaleChart_maximalIdeal_eq_span (c : EtaleChart K X n) (x : X) (hx : x ∈ c.U)
    (β : X.presheaf.stalk x →ₐ[K] K) :
    IsLocalRing.maximalIdeal (X.presheaf.stalk x) =
      Ideal.span (Set.range fun i =>
        etaleChartCenteredStalkCoords c x hx β (MvPolynomial.X i)) := by
  let := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hx⟩ : c.U)
  let := cartierBaseOpenLocalScalarTower (K := K) x hx
  let α := rationalAffineGermPoint x hx β
  have hα : RingHom.ker α.toRingHom = (c.isAffine.primeIdealOf ⟨x, hx⟩).asIdeal :=
    rationalAffineGermPoint_ker x hx β c.isAffine
  let : IsLocalization.AtPrime (X.presheaf.stalk x) (RingHom.ker α.toRingHom) := by
    have H := c.isAffine.isLocalization_stalk (⟨x, hx⟩ : c.U)
    simpa only [hα] using H
  rw [centeredEtaleChart_maximalIdeal_eq_span (centeredPolynomialChart c.coords α)
    (centeredPolynomialChart_etale c.coords α (etaleChart_coords_etale c)) α
    (centeredPolynomialChart_constantCoeff c.coords α) (X.presheaf.stalk x)]
  rfl

/-- The same generators, as translates of the uncentred chart coordinates. -/
theorem etaleChart_maximalIdeal_eq_span_translates (c : EtaleChart K X n) (x : X)
    (hx : x ∈ c.U) (β : X.presheaf.stalk x →ₐ[K] K) :
    IsLocalRing.maximalIdeal (X.presheaf.stalk x) =
      Ideal.span (Set.range fun i => (etaleChartStalkCoords c x hx).toRingHom
        (MvPolynomial.X i - MvPolynomial.C
          (rationalAffineGermPoint x hx β (c.coords (MvPolynomial.X i))))) := by
  rw [etaleChart_maximalIdeal_eq_span c x hx β]
  congr 2
  funext i
  rw [etaleChartCenteredStalkCoords_variable]
  change _ = etaleChartStalkCoords c x hx (MvPolynomial.X i - MvPolynomial.C _)
  rw [map_sub, ← MvPolynomial.algebraMap_eq, AlgHom.commutes]

/-- Jets at a point of an étale chart: every germ agrees with a polynomial of degree at most m in
the centred chart coordinates modulo the (m+1)-st power of the maximal ideal. -/
theorem etaleChart_exists_jetPolynomial (c : EtaleChart K X n) (x : X) (hx : x ∈ c.U)
    (β : X.presheaf.stalk x →ₐ[K] K) (m : ℕ) (y : X.presheaf.stalk x) :
    ∃ P : MvPolynomial (Fin n) K, P.totalDegree ≤ m ∧
      y - (etaleChartStalkCoords c x hx).toRingHom P ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ (m + 1) := by
  refine localJet_exists_polynomial (etaleChartStalkCoords c x hx).toRingHom
    (fun i => rationalAffineGermPoint x hx β (c.coords (MvPolynomial.X i)))
    (etaleChart_maximalIdeal_eq_span_translates c x hx β) (fun z => ⟨β z, ?_⟩) m y
  rw [← rationalLocalPoint_ker β, RingHom.mem_ker]
  change β (z - etaleChartStalkCoords c x hx (MvPolynomial.C (β z))) = 0
  rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, map_sub, AlgHom.commutes,
    Algebra.algebraMap_self, RingHom.id_apply, sub_self]

end Scheme

end MixedFujita
