/-!
Simple normal crossing charts of the fibres (step 10, R4-3).

* `isSNCChart_normalize`: a simple normal crossing chart stays one when the components missing the
  chart are given no coordinate; afterwards every component with a coordinate meets the chart.
* `range_boundaryClosureInclusion`: the closure `E_{k,A}` of a boundary component is, inside the
  closure `T_A`, the closure of the image of the generic point `ξ_k` (closed embeddings commute with
  closures).
* `closure_image_inter_eq_zeroLocus`: let `V` be an affine open of `X` over `A` with étale coordinates
  `y`, of finite presentation over `A`, and `Y = X ×_A K` with `A ⊆ K`. If the base-changed chart of
  `Y` is simple normal crossing for `ξ` with coordinate `a` for `ξ_k ∈ g⁻¹V`, then the closure of
  `g(ξ_k)` meets `V` exactly in the zero locus of `y_a`. A function on `V` vanishing at `g(ξ_k)`
  pulls back into the prime of `ξ_k`, which is generated by the coordinate
  (`span_coordinate_eq_primeIdealOf_of_isSNCChart`), so it is a multiple of `y_a` by check 524.
* `preimage_zeroLocus_inter`, `closure_inter_eq_empty_of_notMem`: zero loci pull back, and the
  closure of a point outside an open set misses it.
* `closure_fibrePoint_inter`, `closure_fibrePoint_inter_eq_empty`: a point of a fibre whose closure
  is the preimage of a closed set `R` meets a pulled-back chart in the zero locus of the pulled-back
  coordinate when `R` meets the chart in the zero locus of the coordinate (resp. not at all).

With check 523 (the closure of the fibre boundary point is the preimage of `E_{k,A}`) and check 522
(the fibre charts) these give the simple normal crossing conditions on the charts of the fibre
`T_κ`.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite Limits TensorProduct

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

section Normalize

attribute [local instance] Classical.propDecidable

variable {K : Type u} [Field K] {X : Scheme.{u}} [X.Over (Spec (CommRingCat.of K))] {d r : ℕ}

/-- The closure of a point outside an open set misses it. -/
theorem closure_inter_eq_empty_of_notMem {Z : Type*} [TopologicalSpace Z] {U : Set Z}
    (hU : IsOpen U) {x : Z} (hx : x ∉ U) : closure ({x} : Set Z) ∩ U = ∅ := by
  rw [Set.eq_empty_iff_forall_notMem]
  rintro z ⟨hz, hzU⟩
  exact hx ((specializes_iff_mem_closure.2 hz).mem_open hU hzU)

/-- **Normalizing a simple normal crossing chart**: components missing the chart get no
coordinate. -/
theorem isSNCChart_normalize {c : EtaleChart K X d}
    {ξ : Fin r → X} {σ : Fin r → Option (Fin d)} (hc : IsSNCChart c ξ σ) :
    IsSNCChart c ξ (fun k => if ξ k ∈ c.U then σ k else none) ∧
      ∀ k a, (if ξ k ∈ c.U then σ k else none) = some a → ξ k ∈ c.U := by
  refine ⟨⟨fun i j a hi hj => ?_, fun k => ?_⟩, fun k a h => ?_⟩
  · by_cases hi' : ξ i ∈ c.U
    · by_cases hj' : ξ j ∈ c.U
      · simp only [hi', hj', ↓reduceIte] at hi hj
        exact hc.1 i j a hi hj
      · simp only [hj', ↓reduceIte, reduceCtorEq] at hj
    · simp only [hi', ↓reduceIte, reduceCtorEq] at hi
  · by_cases hk : ξ k ∈ c.U
    · simp only [hk, ↓reduceIte]
      exact hc.2 k
    · simp only [hk, ↓reduceIte, Option.elim_none]
      exact closure_inter_eq_empty_of_notMem c.U.isOpen hk
  · by_contra hk
    simp only [hk, ↓reduceIte, reduceCtorEq] at h

end Normalize

section Range

variable {n r : ℕ} {K : Type u} [Field K] {T : Scheme.{u}} (e : T ⟶ polynomialProjectiveScheme n K)
  (ξ : Fin r → T) {A : Type u} [CommRing A] (c : A →+* K)

/-- **The closure of a boundary component is the closure of the image of its generic point.** -/
theorem range_boundaryClosureInclusion (k : Fin r)
    [QuasiCompact (((boundaryComponentIdeal ξ k).subschemeι ≫ e) ≫
      polynomialProjectiveCoefficientMap c)] :
    Set.range (boundaryClosureInclusion e ξ c k) =
      closure ({projectiveClosureMap c e (ξ k)} : Set (projectiveClosure c e)) := by
  have hι := (projectiveClosureι c e).isClosedEmbedding
  have h1 : projectiveClosureι c e '' Set.range (boundaryClosureInclusion e ξ c k) =
      Set.range (projectiveClosureι c ((boundaryComponentIdeal ξ k).subschemeι ≫ e)) := by
    rw [← boundaryClosureInclusion_ι, ← Set.range_comp]
    rfl
  have h2 : Set.range (projectiveClosureι c ((boundaryComponentIdeal ξ k).subschemeι ≫ e)) =
      projectiveClosureι c e '' closure ({projectiveClosureMap c e (ξ k)} :
        Set (projectiveClosure c e)) := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.Hom.support_ker]
    have h3 : Set.range (((boundaryComponentIdeal ξ k).subschemeι ≫ e) ≫
        polynomialProjectiveCoefficientMap c) =
        projectiveClosureι c e '' (projectiveClosureMap c e ''
          closure ({ξ k} : Set T)) := by
      rw [Category.assoc, ← projectiveClosureMap_comp_ι, Set.image_image]
      ext z
      constructor
      · rintro ⟨w, rfl⟩
        refine ⟨(boundaryComponentIdeal ξ k).subschemeι w, ?_, ?_⟩
        · have hw := Set.mem_range_self (f := (boundaryComponentIdeal ξ k).subschemeι) w
          rw [Scheme.IdealSheafData.range_subschemeι] at hw
          exact (Scheme.IdealSheafData.coe_support_vanishingIdeal _).le hw
        · simp only [Scheme.Hom.comp_apply]
      · rintro ⟨t, ht, rfl⟩
        have ht' : t ∈ Set.range (boundaryComponentIdeal ξ k).subschemeι := by
          rw [Scheme.IdealSheafData.range_subschemeι]
          exact (Scheme.IdealSheafData.coe_support_vanishingIdeal _).ge ht
        obtain ⟨w, rfl⟩ := ht'
        exact ⟨w, by simp only [Scheme.Hom.comp_apply]⟩
    rw [h3, hι.closure_image_eq, closure_image_closure (Scheme.Hom.continuous _),
      Set.image_singleton]
  rw [← h1] at h2
  exact hι.injective.image_injective h2

end Range

section Crux

attribute [local instance] structureSectionsAlgebra

variable {A K : Type u} [CommRing A] [Field K] [Algebra A K] {X Y : Scheme.{u}}
  [X.Over (Spec (CommRingCat.of A))] [Y.Over (Spec (CommRingCat.of K))] {g : Y ⟶ X}

/-- **Zero loci pull back.** -/
theorem preimage_zeroLocus_inter {V : X.Opens} (s : Γ(X, V)) :
    g ⁻¹' (X.zeroLocus ({s} : Set Γ(X, V)) ∩ V) =
      Y.zeroLocus ({g.appLE V (g ⁻¹ᵁ V) le_rfl s} : Set Γ(Y, g ⁻¹ᵁ V)) ∩ g ⁻¹ᵁ V := by
  ext t
  simp only [Set.mem_preimage, Set.mem_inter_iff, Scheme.zeroLocus_singleton, Set.mem_compl_iff,
    SetLike.mem_coe, Scheme.basicOpen_appLE, Opens.mem_inf, Scheme.Hom.mem_preimage]
  tauto

variable (H : IsPullback g (Y ↘ Spec (CommRingCat.of K)) (X ↘ Spec (CommRingCat.of A))
    (Spec.map (CommRingCat.ofHom (algebraMap A K))))
  [IsAffineHom g] [IsIntegral Y] [LocallyOfFiniteType (Y ↘ Spec (CommRingCat.of K))]
  {d : ℕ} {V : X.Opens} (hV : IsAffineOpen V) (y : MvPolynomial (Fin d) A →ₐ[A] Γ(X, V))
  (hy : y.toRingHom.FormallyEtale) (hne : Nonempty (g ⁻¹ᵁ V))

include hy in
/-- **The closure of a boundary point on a chart of the base is the zero locus of its
coordinate.** -/
theorem closure_image_inter_eq_zeroLocus [Algebra.FinitePresentation A Γ(X, V)]
    (hK : Function.Injective (algebraMap A K)) {r : ℕ} (ξ : Fin r → Y)
    (σ : Fin r → Option (Fin d)) (hc : IsSNCChart (fibreEtaleChart H hV y hy hne) ξ σ)
    (k : Fin r) (a : Fin d) (hσ : σ k = some a) (hξ : ξ k ∈ g ⁻¹ᵁ V) :
    closure ({g (ξ k)} : Set X) ∩ V = X.zeroLocus ({y (MvPolynomial.X a)} : Set Γ(X, V)) ∩ V := by
  classical
  let c' := fibreEtaleChart H hV y hy hne
  have hcoord : c'.coords (MvPolynomial.X a) = g.appLE V (g ⁻¹ᵁ V) le_rfl (y (MvPolynomial.X a)) :=
    fibreEtaleChart_coords_X H hV y hy hne a
  have hgξ : g (ξ k) ∈ V := hξ
  -- the point `ξ k` lies on the zero locus of its coordinate
  have hξzero : ξ k ∈ Y.zeroLocus ({c'.coords (MvPolynomial.X a)} : Set Γ(Y, c'.U)) := by
    have h := hc.2 k
    rw [hσ, Option.elim_some] at h
    have hmem : ξ k ∈ closure ({ξ k} : Set Y) ∩ c'.U := ⟨subset_closure rfl, hξ⟩
    rw [h] at hmem
    exact hmem.1
  -- functions vanishing at `g (ξ k)` pull back to functions vanishing at `ξ k`
  have hpull : ∀ b : Γ(X, V), g (ξ k) ∈ X.zeroLocus ({b} : Set Γ(X, V)) →
      ξ k ∈ Y.zeroLocus ({g.appLE V (g ⁻¹ᵁ V) le_rfl b} : Set Γ(Y, g ⁻¹ᵁ V)) := by
    intro b hb
    have := (preimage_zeroLocus_inter (g := g) b).le (show ξ k ∈ g ⁻¹' _ from ⟨hb, hgξ⟩)
    exact this.1
  apply subset_antisymm
  · -- the zero locus is closed and contains `g (ξ k)`
    rintro z ⟨hz, hzV⟩
    refine ⟨closure_minimal (Set.singleton_subset_iff.2 ?_)
      (X.zeroLocus_isClosed _) hz, hzV⟩
    have h := (preimage_zeroLocus_inter (g := g) (y (MvPolynomial.X a))).ge
      (show ξ k ∈ _ from ⟨by rw [← hcoord]; exact hξzero, hξ⟩)
    exact h.1
  · rintro z ⟨hz, hzV⟩
    refine ⟨?_, hzV⟩
    -- the prime of `g (ξ k)` lies in the prime of `z`
    have hle : (hV.primeIdealOf ⟨g (ξ k), hgξ⟩).asIdeal ≤ (hV.primeIdealOf ⟨z, hzV⟩).asIdeal := by
      intro b hb
      rw [mem_primeIdealOf_iff_mem_zeroLocus] at hb
      have hb' := hpull b hb
      -- the pullback lies in the prime of `ξ k`, generated by the coordinate
      have hprime := span_coordinate_eq_primeIdealOf_of_isSNCChart c' ξ σ hc k a hσ hξ
      have hmem : g.appLE V (g ⁻¹ᵁ V) le_rfl b ∈ Ideal.span {c'.coords (MvPolynomial.X a)} := by
        rw [hprime, mem_primeIdealOf_iff_mem_zeroLocus]
        exact hb'
      rw [hcoord] at hmem
      -- descend along `K ⊗_A Γ(X, V) ≅ Γ(Y, g⁻¹V)`
      let eb := sectionsBaseChangeEquiv H hV
      have htmul : ∀ w : Γ(X, V), eb ((1 : K) ⊗ₜ[A] w) = g.appLE V (g ⁻¹ᵁ V) le_rfl w := by
        intro w
        rw [sectionsBaseChangeEquiv_tmul, map_one, one_mul]
      have hmem' : (1 : K) ⊗ₜ[A] b ∈ Ideal.span {(1 : K) ⊗ₜ[A] y (MvPolynomial.X a)} := by
        obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.1 hmem
        refine Ideal.mem_span_singleton'.2 ⟨eb.symm w, ?_⟩
        apply eb.injective
        rw [map_mul, AlgEquiv.apply_symm_apply, htmul, htmul]
        exact hw
      let _ : Algebra (MvPolynomial (Fin d) A) Γ(X, V) := y.toRingHom.toAlgebra
      have : IsScalarTower A (MvPolynomial (Fin d) A) Γ(X, V) :=
        IsScalarTower.of_algebraMap_eq fun a => (y.commutes a).symm
      have : Algebra.FormallyEtale (MvPolynomial (Fin d) A) Γ(X, V) := hy
      have hdiv := mem_span_coordinate_of_tmul_mem_span_of_formallyEtale (K := K) hK a b hmem'
      have hza : y (MvPolynomial.X a) ∈ (hV.primeIdealOf ⟨z, hzV⟩).asIdeal := by
        rw [mem_primeIdealOf_iff_mem_zeroLocus]
        exact hz
      exact (Ideal.span_le.2 (Set.singleton_subset_iff.2 hza)) hdiv
    have hsp : (⟨g (ξ k), hgξ⟩ : V) ⤳ ⟨z, hzV⟩ :=
      hV.isoSpec.hom.isOpenEmbedding.isInducing.specializes_iff.1
        ((PrimeSpectrum.le_iff_specializes _ _).1 hle)
    exact specializes_iff_mem_closure.1 ((subtype_specializes_iff _ _).1 hsp)

end Crux

section Fibre

variable {X Y : Scheme.{u}} {g : Y ⟶ X} {V : X.Opens} {R : Set X}

/-- **The closure of a fibre point on a pulled-back chart.** -/
theorem closure_fibrePoint_inter {η : Y} (hη : closure ({η} : Set Y) = g ⁻¹' R) (s : Γ(X, V))
    (hR : R ∩ V = X.zeroLocus ({s} : Set Γ(X, V)) ∩ V) :
    closure ({η} : Set Y) ∩ g ⁻¹ᵁ V =
      Y.zeroLocus ({g.appLE V (g ⁻¹ᵁ V) le_rfl s} : Set Γ(Y, g ⁻¹ᵁ V)) ∩ g ⁻¹ᵁ V := by
  rw [← preimage_zeroLocus_inter, ← hR, hη]
  rfl

/-- The closure of a fibre point misses a pulled-back chart missed by its image closure. -/
theorem closure_fibrePoint_inter_eq_empty {η : Y} (hη : closure ({η} : Set Y) = g ⁻¹' R)
    (hR : R ∩ V = ∅) : closure ({η} : Set Y) ∩ g ⁻¹ᵁ V = ∅ := by
  rw [hη]
  change g ⁻¹' R ∩ g ⁻¹' V = ∅
  rw [← Set.preimage_inter, hR, Set.preimage_empty]

end Fibre

end MixedFujita
