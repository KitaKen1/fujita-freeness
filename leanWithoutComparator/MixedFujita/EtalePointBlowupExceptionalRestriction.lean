module

public import MixedFujita.EtalePointBlowupCharts
public import MixedFujita.PointBlowupExceptionalBaseChange
public import Hironaka.Scheme.BlowUp.AffineBlowUp.Universal.Admissible

/-!
Exceptional restriction on actual étale point-blow-up charts. On every affine open of the
chart, the actual exceptional ideal is generated by the image of X_k. The polynomial strict
transform in its actual quotient ring is the evaluation of the dehomogenized leading form.
The sections treated here are coordinate polynomials; arbitrary Cartier-section germs and
their chosen completed coordinates require a further comparison.
-/

@[expose] public section
open AlgebraicGeometry CategoryTheory Limits
namespace MixedFujita
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
universe u
variable {K : Type u} [Field K] {X : Scheme.{u}} {n : ℕ}
  {f : X ⟶ Spec (.of K)} {Z : X.IdealSheafData} {x : X}

theorem sectionsHom_comp_specMap {R S : Type u} [CommRing R] [CommRing S]
    {Y : Scheme.{u}} (ψ : Y ⟶ Spec (.of S)) (c : R →+* S) (V : Y.Opens) :
    sectionsHom (ψ ≫ Spec.map (CommRingCat.ofHom c)) V = (sectionsHom ψ V).comp c := by
  have hcomp := Scheme.Hom.appLE_comp_appLE ψ (Spec.map (CommRingCat.ofHom c))
    ⊤ ⊤ V le_top le_top
  have h : (Scheme.ΓSpecIso (.of R)).inv ≫
        (ψ ≫ Spec.map (CommRingCat.ofHom c)).appLE ⊤ V le_top =
      CommRingCat.ofHom c ≫ (Scheme.ΓSpecIso (.of S)).inv ≫ ψ.appLE ⊤ V le_top := by
    rw [← hcomp, ← Category.assoc]
    change ((Scheme.ΓSpecIso (.of R)).inv ≫
      (Spec.map (CommRingCat.ofHom c)).appTop) ≫ _ = _
    rw [← Scheme.ΓSpecIso_inv_naturality, Category.assoc]
  exact congrArg (fun q : CommRingCat.of R ⟶ Γ(Y, V) => q.hom) h

theorem etalePointBlowupChart_exceptionalIdeal_affine
    (E : EtaleCoordinatesAdapted f n n Z x) (k : Fin n)
    (V : (etalePointBlowupChart E k).affineOpens) :
    (((Z.comap E.U.1.ι).comap
        (Scheme.IdealSheafData.blowUpπ (Z.comap E.U.1.ι))).comap
      (pullback.fst (etalePointBlowupModelMap E)
        (CoordinateSubspace.modelChart K n n k k.isLt))).ideal V =
      Ideal.span {(sectionsHom
        (pullback.snd (etalePointBlowupModelMap E)
          (CoordinateSubspace.modelChart K n n k k.isLt)) V.1 (MvPolynomial.X k))} := by
  rw [etalePointBlowupChart_exceptionalIdeal]
  change ((specIdealSheaf (Ideal.span {(MvPolynomial.X k : MvPolynomial (Fin n) K)})).comap
    (pullback.snd (etalePointBlowupModelMap E)
      (CoordinateSubspace.modelChart K n n k k.isLt))).ideal V = _
  erw [ideal_comap_specIdealSheaf]
  rw [Ideal.map_span, Set.image_singleton]

theorem etalePointBlowupChart_polynomial_factor
    (E : EtaleCoordinatesAdapted f n n Z x) (k : Fin n)
    (V : (etalePointBlowupChart E k).Opens) (m : ℕ) (g : MvPolynomial (Fin n) K)
    (hg : (m : ℕ∞) ≤ (g : MvPowerSeries (Fin n) K).order) :
    let τ := sectionsHom (pullback.snd (etalePointBlowupModelMap E)
      (CoordinateSubspace.modelChart K n n k k.isLt)) V
    τ (polynomialPointBlowupMap k g) =
      τ (MvPolynomial.X k) ^ m * τ (polynomialPointBlowupStrictTransform k m g) :=
  polynomialPointBlowupStrictTransform_baseChange_factor _ k m g hg

theorem etalePointBlowupChart_coordinatePolynomial_pullback
    (E : EtaleCoordinatesAdapted f n n Z x) (k : Fin n)
    (V : (etalePointBlowupChart E k).Opens) (g : MvPolynomial (Fin n) K) :
    sectionsHom (pullback.fst (etalePointBlowupModelMap E)
        (CoordinateSubspace.modelChart K n n k k.isLt) ≫
      Scheme.IdealSheafData.blowUpπ (Z.comap E.U.1.ι) ≫ toAffineSpace f E.U.1 E.v) V g =
    sectionsHom (pullback.snd (etalePointBlowupModelMap E)
      (CoordinateSubspace.modelChart K n n k k.isLt)) V (polynomialPointBlowupMap k g) := by
  rw [etalePointBlowupChart_projection, sectionsHom_comp_specMap]
  rfl

theorem etalePointBlowupChart_coordinatePolynomial_factor
    (E : EtaleCoordinatesAdapted f n n Z x) (k : Fin n)
    (V : (etalePointBlowupChart E k).Opens) (m : ℕ) (g : MvPolynomial (Fin n) K)
    (hg : (m : ℕ∞) ≤ (g : MvPowerSeries (Fin n) K).order) :
    let τ := sectionsHom (pullback.snd (etalePointBlowupModelMap E)
      (CoordinateSubspace.modelChart K n n k k.isLt)) V
    sectionsHom (pullback.fst (etalePointBlowupModelMap E)
        (CoordinateSubspace.modelChart K n n k k.isLt) ≫
      Scheme.IdealSheafData.blowUpπ (Z.comap E.U.1.ι) ≫ toAffineSpace f E.U.1 E.v) V g =
      τ (MvPolynomial.X k) ^ m * τ (polynomialPointBlowupStrictTransform k m g) := by
  dsimp only
  rw [etalePointBlowupChart_coordinatePolynomial_pullback]
  exact etalePointBlowupChart_polynomial_factor E k V m g hg

set_option maxHeartbeats 800000 in
theorem etalePointBlowupChart_strictTransform_exceptional_quotient
    (E : EtaleCoordinatesAdapted f n n Z x) (k : Fin n)
    (V : (etalePointBlowupChart E k).affineOpens) (m : ℕ) (g : MvPolynomial (Fin n) K)
    (hg : (m : ℕ∞) ≤ (g : MvPowerSeries (Fin n) K).order) :
    let I := (((Z.comap E.U.1.ι).comap
        (Scheme.IdealSheafData.blowUpπ (Z.comap E.U.1.ι))).comap
      (pullback.fst (etalePointBlowupModelMap E)
        (CoordinateSubspace.modelChart K n n k k.isLt))).ideal V
    let τ := sectionsHom (pullback.snd (etalePointBlowupModelMap E)
      (CoordinateSubspace.modelChart K n n k k.isLt)) V.1
    ∃ θ : MvPolynomial {i : Fin n // i ≠ k} K →+* Γ(etalePointBlowupChart E k, V.1) ⧸ I,
      (∀ c : K, θ (MvPolynomial.C c) = Ideal.Quotient.mk I (τ (MvPolynomial.C c))) ∧
      (∀ i, θ (MvPolynomial.X i) = Ideal.Quotient.mk I (τ (MvPolynomial.X i.1))) ∧
      Ideal.Quotient.mk I (τ (polynomialPointBlowupStrictTransform k m g)) =
        θ (projectiveDehomogenize K k (homogeneousTaylorForm m (g : MvPowerSeries (Fin n) K))) := by
  dsimp only
  rw [etalePointBlowupChart_exceptionalIdeal_affine]
  let τ := sectionsHom (pullback.snd (etalePointBlowupModelMap E)
    (CoordinateSubspace.modelChart K n n k k.isLt)) V.1
  exact ⟨pointBlowupExceptionalEvaluation τ k,
    pointBlowupExceptionalEvaluation_C τ k, pointBlowupExceptionalEvaluation_X τ k,
    polynomialPointBlowupStrictTransform_baseChange_exceptional τ k m g hg⟩

end MixedFujita
