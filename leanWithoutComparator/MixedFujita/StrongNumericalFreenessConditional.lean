/-!
S-NF and F1 from two explicit statements (steps 12 and 14).

For an ample sum A (a positive multiple is linearly equivalent to a positive combination of
hyperplane divisors) on an integral scheme over an infinite field: one of the hyperplane divisors
is ample, the multiples of a multiple of A are globally generated, and A is big.

`SmoothMinimizerDataStatement` states that under the hypotheses of S-NF for ample sums, at every
closed point at which P = K_X + A + N is not generated by its global sections, the data of the
minimizer exist for the smooth variety X with zero boundary and sections of multiples of A (the
content of sections 2 to 5 and 8 of the manuscript in the form used by section 6).

* The sum form of the Kawamata–Viehweg statement and `SmoothMinimizerDataStatement` imply S-NF for
  ample sums.
* Hence they imply F1, the mixed Fujita freeness, since F1 follows from S-NF for ample sums and
  the numerical lower bound, which is proved.

Neither of the two statements is proved here.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite Filter
open TauCeti.AlgebraicGeometry
open TauCeti.AlgebraicGeometry.Scheme

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true

universe u

attribute [local instance] Classical.propDecidable

attribute [local instance] cartierGlobalStalkAlgebra cartierGlobalStalkFunctionFieldTower
  cartierBaseGlobalAlgebra cartierBaseLocalAlgebra cartierBaseLocalScalarTower
  cartierBaseSectionScalarTower cartierBaseOpenAlgebra functionFieldBaseAlgebra

attribute [local instance] MvPolynomial.gradedAlgebra

section AmpleSum

variable {K : Type u} [Field K] {Y : Scheme.{u}} [IsIntegral Y]
  [Y.Over (Spec (CommRingCat.of K))]

/-- A Cartier divisor with a big positive multiple is big. -/
theorem cartierIsBig_of_nsmul {D : CartierDivisor Y} (m : ℕ) (hm : 1 ≤ m)
    (h : CartierIsBig K (m • D)) : CartierIsBig K D := by
  obtain ⟨d, hd, c, hc, hfreq⟩ := h
  have hmpos : (0 : ℝ) < (m : ℝ) := by exact_mod_cast hm
  refine ⟨d, hd, c / (m : ℝ) ^ d, div_pos hc (pow_pos hmpos d), ?_⟩
  have htend : Tendsto (fun k : ℕ => k * m) atTop atTop :=
    tendsto_atTop_mono (fun k => Nat.le_mul_of_pos_right k hm) tendsto_id
  refine htend.frequently (hfreq.mono fun k hk => ?_)
  have hcast : c / (m : ℝ) ^ d * ((k * m : ℕ) : ℝ) ^ d = c * (k : ℝ) ^ d := by
    push_cast
    field_simp
    ring
  rw [hcast, mul_nsmul']
  exact hk

/-- One of the hyperplane divisors of an ample sum is an ample divisor. -/
theorem cartierIsAmpleSum_exists_ample {A : CartierDivisor Y} (hA : CartierIsAmpleSum K A) :
    ∃ H : CartierDivisor Y, CartierIsAmpleProj K H := by
  obtain ⟨m, hm, s, hs, Nn, e, hcl, hbase, g, hg, hggen, c, hc, f, hmA⟩ := hA
  exact ⟨projectiveHyperplaneCartier (e ⟨0, hs⟩) (g ⟨0, hs⟩) (hg ⟨0, hs⟩) (hggen ⟨0, hs⟩), 1,
    le_rfl, Nn ⟨0, hs⟩, e ⟨0, hs⟩, hcl ⟨0, hs⟩, hbase ⟨0, hs⟩, g ⟨0, hs⟩, hg ⟨0, hs⟩,
    hggen ⟨0, hs⟩, 1, by rw [one_smul, principalCartierDivisor_one, add_zero]⟩

/-- All multiples of a suitable multiple of an ample sum are globally generated. -/
theorem cartierIsAmpleSum_exists_globallyGenerated_divisible_sequence {A : CartierDivisor Y}
    (hA : CartierIsAmpleSum K A) :
    ∃ p : ℕ, 1 ≤ p ∧ ∀ t : ℕ, CartierIsGloballyGenerated ((t * p) • A) := by
  obtain ⟨m, hm, s, hs, Nn, e, hcl, hbase, g, hg, hggen, c, hc, f, hmA⟩ := hA
  have hgg : ∀ i, CartierIsGloballyGenerated
      (projectiveHyperplaneCartier (e i) (g i) (hg i) (hggen i)) := fun i =>
    projectiveHyperplaneCartier_globallyGenerated (e i) (g i) (hg i) (hggen i)
  have hzero : CartierIsGloballyGenerated (0 : CartierDivisor Y) := by
    simpa only [zero_nsmul] using cartierIsGloballyGenerated_nsmul _ (hgg ⟨0, hs⟩) 0
  have hgen : CartierIsGloballyGenerated (m • A) := by
    rw [hmA]
    apply cartierIsGloballyGenerated_principal_shift
    exact Finset.sum_induction _ CartierIsGloballyGenerated
      (fun a b ha hb => cartierIsGloballyGenerated_add a b ha hb) hzero
      (fun i _ => cartierIsGloballyGenerated_nsmul _ (hgg i) (c i))
  exact ⟨m, hm, fun t => by
    simpa only [smul_smul] using cartierIsGloballyGenerated_nsmul _ hgen t⟩

/-- An ample sum on an integral scheme of dimension at least one over an infinite field is
big. -/
theorem cartierIsAmpleSum_isBig [Infinite K] {d : ℕ} (hn : topologicalKrullDim Y = d)
    (hd : 1 ≤ d) {A : CartierDivisor Y} (hA : CartierIsAmpleSum K A) : CartierIsBig K A := by
  obtain ⟨m, hm, s, hs, Nn, e, hcl, hbase, g, hg, hggen, c, hc, f, hmA⟩ := hA
  obtain ⟨H, hHdef⟩ : ∃ H : Fin s → CartierDivisor Y,
      ∀ i, H i = projectiveHyperplaneCartier (e i) (g i) (hg i) (hggen i) := ⟨_, fun i => rfl⟩
  have hmA' : m • A = ∑ i, c i • H i + principalCartierDivisor Y f := by
    rw [hmA]
    congr 1
    exact Finset.sum_congr rfl fun i _ => by rw [hHdef i]
  have hgg : ∀ i, CartierIsGloballyGenerated (H i) := fun i => by
    rw [hHdef i]
    exact projectiveHyperplaneCartier_globallyGenerated (e i) (g i) (hg i) (hggen i)
  have hH₀ : CartierIsAmpleProj K (H ⟨0, hs⟩) := by
    rw [hHdef ⟨0, hs⟩]
    exact ⟨1, le_rfl, Nn ⟨0, hs⟩, e ⟨0, hs⟩, hcl ⟨0, hs⟩, hbase ⟨0, hs⟩, g ⟨0, hs⟩, hg ⟨0, hs⟩,
      hggen ⟨0, hs⟩, 1, by rw [one_smul, principalCartierDivisor_one, add_zero]⟩
  have hzero : CartierIsGloballyGenerated (0 : CartierDivisor Y) := by
    simpa only [zero_nsmul] using cartierIsGloballyGenerated_nsmul _ (hgg ⟨0, hs⟩) 0
  -- the remainder after removing one copy of the first hyperplane divisor
  have hR : CartierIsGloballyGenerated (∑ i, c i • H i - H ⟨0, hs⟩) := by
    have hsplit : ∑ i, c i • H i - H ⟨0, hs⟩ = (c ⟨0, hs⟩ - 1) • H ⟨0, hs⟩ +
        ∑ i ∈ Finset.univ.erase (⟨0, hs⟩ : Fin s), c i • H i := by
      rw [← Finset.add_sum_erase Finset.univ (fun i => c i • H i)
        (Finset.mem_univ (⟨0, hs⟩ : Fin s))]
      obtain ⟨c', hc'⟩ : ∃ c', c ⟨0, hs⟩ = c' + 1 := ⟨c ⟨0, hs⟩ - 1, by
        have := hc ⟨0, hs⟩
        omega⟩
      rw [hc', Nat.add_sub_cancel, succ_nsmul]
      abel
    rw [hsplit]
    refine cartierIsGloballyGenerated_add _ _
      (cartierIsGloballyGenerated_nsmul _ (hgg ⟨0, hs⟩) _) ?_
    exact Finset.sum_induction _ CartierIsGloballyGenerated
      (fun a b ha hb => cartierIsGloballyGenerated_add a b ha hb) hzero
      (fun i _ => cartierIsGloballyGenerated_nsmul _ (hgg i) (c i))
  obtain ⟨t, ht⟩ := exists_section_ne_zero_of_isGloballyGenerated _ hR
  have hbig1 : CartierIsBig K (H ⟨0, hs⟩ + (∑ i, c i • H i - H ⟨0, hs⟩)) :=
    cartierIsBig_add_of_section (cartierIsAmpleProj_isBig hn hd hH₀) t ht
      (fun k => cartier_finiteDimensional_sections_of_ample hn hd hH₀ _)
  have hbig2 : CartierIsBig K (m • A) := by
    have hsum : ∑ i, c i • H i = H ⟨0, hs⟩ + (∑ i, c i • H i - H ⟨0, hs⟩) := by abel
    rw [hmA', hsum]
    exact cartierIsBig_add_principal hbig1 f
  exact cartierIsBig_of_nsmul m hm hbig2

end AmpleSum

/-- The statement that, under the hypotheses of S-NF for ample sums, the data of the minimizer
exist, for every m₀, at every closed point at which P = K_X + A + N is not generated by its global
sections: the smooth variety X with zero boundary (denominator 1), sections of multiples of A. The
content of sections 2 to 5 and 8 of the manuscript in the form used by section 6. -/
def SmoothMinimizerDataStatement : Prop :=
  ∀ (K : Type u) [Field K] [IsAlgClosed K] [CharZero K] [Uncountable K] (X : Scheme.{u})
    [IsIntegral X] [X.Over (Spec (CommRingCat.of K))] (n : ℕ),
    topologicalKrullDim X = n → 1 ≤ n →
    ∀ [SmoothOfRelativeDimension n (X ↘ Spec (CommRingCat.of K))] [IsLocallyNoetherian X]
      (c₀ : EtaleChart K X n) (A N : CartierDivisor X), CartierIsAmpleSum K A →
      CartierIsNef K N →
      (∀ (η : X) (d : ℕ), topologicalKrullDim (closure ({η} : Set X)) = d → 1 ≤ d →
        ∀ ε : ℝ, 0 < ε → ∀ᶠ j : ℕ in atTop, ∃ V : Submodule K Γ((j • A).sheaf, ⊤),
          FiniteDimensional K V ∧ ((n + 1 : ℝ) ^ d - ε) * (j : ℝ) ^ d / d.factorial ≤
            cartierRestrictedSubspaceDim K (j • A) η V) →
      ∀ m₀ : ℕ, 1 ≤ m₀ → ∀ x : X, IsClosed ({x} : Set X) →
        (¬ ∃ (f : X.functionFieldˣ)
          (hf : (smoothCanonicalDivisor c₀ + A + N).IsLocalEquationAt x f)
          (t : Γ((smoothCanonicalDivisor c₀ + A + N).sheaf, ⊤)),
          IsUnit (cartierLocalCoefficient (smoothCanonicalDivisor c₀ + A + N) x f hf t)) →
        KltIsolationMinimizerData c₀ (1 : X.functionFieldˣ) 1
          (1 • (smoothCanonicalDivisor c₀ + principalCartierDivisor X (1 : X.functionFieldˣ)))
          A m₀ x

/-- S-NF for ample sums follows from the sum form of the Kawamata–Viehweg statement and the
existence of the data of the minimizer. -/
theorem strongNumericalFreenessSum_of_kawamataViehwegSum_of_minimizerData
    (hKV : ∀ (K : Type u) [Field K] [IsAlgClosed K] [CharZero K] (n : ℕ),
      KawamataViehwegVanishingSNCSum K n)
    (hmin : SmoothMinimizerDataStatement.{u}) : StrongNumericalFreenessSum.{u} := by
  intro K _ _ _ _ X _ _ n hdim hn _ c₀ A N hA hN hnum
  obtain ⟨H, hH⟩ := cartierIsAmpleSum_exists_ample hA
  have hsm : Smooth (X ↘ Spec (CommRingCat.of K)) := SmoothOfRelativeDimension.smooth n _
  have hprop : IsProper (X ↘ Spec (CommRingCat.of K)) := by
    obtain ⟨m, hm, v, e, hcl, he, -⟩ := hH
    have := polynomialProjectiveToBase_isProper v K
    rw [← he]
    infer_instance
  have hXN : IsLocallyNoetherian X :=
    LocallyOfFiniteType.isLocallyNoetherian (X ↘ Spec (CommRingCat.of K))
  have hcompact : CompactSpace X :=
    QuasiCompact.compactSpace_of_compactSpace (X ↘ Spec (CommRingCat.of K))
  have hnorm : ∀ z : X, IsIntegrallyClosed (X.presheaf.stalk z) := fun z =>
    smooth_stalk_isIntegrallyClosed (K := K) z
  have hcov : CodimOneChartCovered n K X := fun ξ _ =>
    Opens.mem_iSup.mp ((etaleCharts_cover (K := K) (X := X) (n := n)).symm ▸ Opens.mem_top ξ)
  obtain ⟨m₀, hm₀, hLgg⟩ := cartierIsAmpleSum_exists_globallyGenerated_divisible_sequence hA
  have hLbig : CartierIsBig K A := cartierIsAmpleSum_isBig hdim hn hA
  have hLN : 1 • (smoothCanonicalDivisor c₀ + A + N) -
      1 • (smoothCanonicalDivisor c₀ + principalCartierDivisor X (1 : X.functionFieldˣ)) =
      A + N := by
    rw [one_smul, one_smul, principalCartierDivisor_one]
    abel
  apply cartierIsGloballyGenerated_of_forall_isClosed
  intro x hx
  by_contra hgen
  obtain ⟨j, Ns, s, hs, X', hXi, hXN', hXo, hXp, hXs, π, hdom, hover, hprop', hπ, cX, r, ξ, y, c,
    q, hjm₀, hinj, hξ, hsnc, hBsupp, hDsupp, hy, hc, hcq, hqy, hpolyΦ, hcentre, hbudget⟩ :=
    hmin K X n hdim hn c₀ A N hA hN hnum m₀ hm₀ x hx hgen
  exact hgen (klt_exists_section_generating_of_minimizer_data_nef (hKV K n) hn hnorm hcov c₀ 1 1
    le_rfl _ (smooth_logPairBoundaryEffective_zero c₀ 1 1)
    (smooth_logPairIsKlt_boundary_zero c₀ 1 1 le_rfl) _ A N hLN hH hN m₀ hm₀ hLgg hLbig x hx j
    hjm₀ s hs π hπ cX ξ hinj hξ hsnc hBsupp hDsupp y hy hc hcq hqy hpolyΦ hcentre hbudget)

/-- F1, the mixed Fujita freeness, follows from the sum form of the Kawamata–Viehweg statement and
the existence of the data of the minimizer: S-NF for ample sums implies F1 by the numerical lower
bound, which is proved. -/
theorem mixedFujitaFreeness_of_kawamataViehwegSum_of_minimizerData
    (hKV : ∀ (K : Type u) [Field K] [IsAlgClosed K] [CharZero K] (n : ℕ),
      KawamataViehwegVanishingSNCSum K n)
    (hmin : SmoothMinimizerDataStatement.{u}) : MixedFujitaFreeness.{u} :=
  mixedFujitaFreeness_of_strongNumericalFreenessSum_unconditional
    (strongNumericalFreenessSum_of_kawamataViehwegSum_of_minimizerData hKV hmin)

end MixedFujita
