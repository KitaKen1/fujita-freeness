module

public import MixedFujita.PrincipalizedGlobalGeneration
public import MixedFujita.CartierSectionBaseIdeal
public import MixedFujita.NondegenerateFunctionSNCModel

/-!
Principalizing an ideal generated by global regular functions makes the negative
fixed divisor globally generated. This supplies nefness on the actual model,
without projectivity over the field or a separate relative-nefness assumption.
The conclusion persists after any principal Cartier shift.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace
open TauCeti.AlgebraicGeometry TauCeti.AlgebraicGeometry.Scheme

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true

universe u

section Principal

variable {X T : Scheme.{u}} [IsIntegral X] [IsIntegral T]
  (ρ : T ⟶ X) [IsDominant ρ] {J : Type*} [Finite J]
  (f : J → X.functionFieldˣ)
  (hf : ∀ j, (principalCartierDivisor X (f j)).IsEffective)
  (G : CartierDivisor T) (hG : G.IsEffective)
  (hI : effectiveCartierIdealSheaf G hG =
    (⨆ j, effectiveCartierIdealSheaf (principalCartierDivisor X (f j)) (hf j)).comap ρ)

include hI in
/-- Global functions give global generation of the negative principalized fixed part. -/
theorem principalized_principal_neg_globallyGenerated : CartierIsGloballyGenerated (-G) := by
  have hgen (j : J) : CartierIsGloballyGenerated (0 - principalCartierDivisor X (f j)) := by
    rw [zero_sub, ← principalCartierDivisor_inv]
    exact cartierIsGloballyGenerated_principal _
  simpa only [cartierPullback_zero, zero_sub] using
    cartierIsGloballyGenerated_cartierPullback_sub_of_principalized ρ 0
      (fun j => principalCartierDivisor X (f j)) hf hgen G hG hI

include hI in
/-- Principal shifts do not lose the actual generating sections. -/
theorem principalized_principal_neg_shift_globallyGenerated (v : T.functionFieldˣ) :
    CartierIsGloballyGenerated (-G + principalCartierDivisor T v) :=
  cartierIsGloballyGenerated_principal_shift _ v
    (principalized_principal_neg_globallyGenerated ρ f hf G hG hI)

include hI in
/-- The negative fixed part is nef on the actual model over the field. -/
theorem principalized_principal_neg_isNef {K : Type u} [Field K]
    [T.Over (Spec (CommRingCat.of K))] : CartierIsNef K (-G) :=
  cartierIsGloballyGenerated_isNef (principalized_principal_neg_globallyGenerated ρ f hf G hG hI)

end Principal

/-- Apply the global-generation shortcut to the original finite family, retaining its
zero generators in the input and removing them only when taking principal divisors. -/
theorem original_function_principalized_neg_globallyGenerated
    {A : Type u} [CommRing A] [IsDomain A] {T : Scheme.{u}} [IsIntegral T]
    (ρ : T ⟶ Spec (CommRingCat.of A)) [IsDominant ρ] {J : Type*} [Finite J]
    (g : J → A) (G : CartierDivisor T) (hG : G.IsEffective)
    (hI : effectiveCartierIdealSheaf G hG = (⨆ j : {j : J // g j ≠ 0},
      effectiveCartierIdealSheaf (principalCartierDivisor (Spec (CommRingCat.of A))
        (specFunctionRationalUnit (g j.1) j.2)) (specFunctionRationalUnit_effective (g j.1) j.2)).comap ρ) :
    CartierIsGloballyGenerated (-G) :=
  principalized_principal_neg_globallyGenerated ρ
    (fun j : {j : J // g j ≠ 0} => specFunctionRationalUnit (g j.1) j.2)
    (fun j => specFunctionRationalUnit_effective (g j.1) j.2) G hG hI

end MixedFujita
