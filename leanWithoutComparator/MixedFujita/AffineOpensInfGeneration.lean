module

public import Mathlib.AlgebraicGeometry.Morphisms.Separated
public import Mathlib.AlgebraicGeometry.Morphisms.Affine
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.Algebra.Category.Ring.Constructions

/-!
The functions on the intersection of two affine opens of a separated scheme are generated by the
restrictions of the functions on the two opens (step 4, for the product of two embeddings).

* A pushout in the category of commutative rings is generated by the images of its two legs: the
  inclusion of the subring generated by the images has a retraction by the universal property.
* Let U and W be affine opens of a scheme X separated over an affine scheme S. The intersection
  U ∩ W is the fibre product U ×_X W, and the map U ×_X W → U ×_S W is a base change of the
  diagonal of X over S, hence a closed immersion. The fibre product U ×_S W of affine schemes is
  affine with functions the pushout of the functions on U and W over those on S. So U ∩ W is
  affine and its functions are the images of those on U ×_S W, which are generated by the
  functions on U and W.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Limits Opposite TopologicalSpace

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true

universe u

/-- A pushout of commutative rings is generated by the images of its two legs. -/
theorem commRingCat_isPushout_range_sup_eq_top {R A B P : CommRingCat.{u}} {f : R ⟶ A}
    {g : R ⟶ B} {inl : A ⟶ P} {inr : B ⟶ P} (h : IsPushout f g inl inr) :
    inl.hom.range ⊔ inr.hom.range = (⊤ : Subring P) := by
  let S : Subring P := inl.hom.range ⊔ inr.hom.range
  have hSl : inl.hom.range ≤ S := le_sup_left
  have hSr : inr.hom.range ≤ S := le_sup_right
  let ι : CommRingCat.of S ⟶ P := CommRingCat.ofHom S.subtype
  let inl' : A ⟶ CommRingCat.of S := CommRingCat.ofHom
    (inl.hom.codRestrict S fun a => hSl (RingHom.mem_range_self _ a))
  let inr' : B ⟶ CommRingCat.of S := CommRingCat.ofHom
    (inr.hom.codRestrict S fun b => hSr (RingHom.mem_range_self _ b))
  have hw : f ≫ inl' = g ≫ inr' := by
    ext r
    exact congr($(h.w).hom r)
  have hl : inl' ≫ ι = inl := by
    ext a
    rfl
  have hr : inr' ≫ ι = inr := by
    ext b
    rfl
  have hd : h.desc inl' inr' hw ≫ ι = 𝟙 P := by
    apply h.hom_ext
    · rw [IsPushout.inl_desc_assoc, hl, Category.comp_id]
    · rw [IsPushout.inr_desc_assoc, hr, Category.comp_id]
  rw [eq_top_iff]
  intro x _
  have hx : ι (h.desc inl' inr' hw x) = x := congr($(hd).hom x)
  have hmem : ι (h.desc inl' inr' hw x) ∈ S := (h.desc inl' inr' hw x).2
  rwa [hx] at hmem

/-- The intersection of two opens U and W of a scheme separated over S maps to the fibre product
U ×_S W by a closed immersion compatible with the two inclusions: the map U ×_X W → U ×_S W is a
base change of the diagonal of X over S. -/
theorem exists_closedImmersion_inf_to_pullback {X S : Scheme.{u}} (p : X ⟶ S) [IsSeparated p]
    (U W : X.Opens) :
    ∃ ψ : (U ⊓ W).toScheme ⟶ pullback (U.ι ≫ p) (W.ι ≫ p), IsClosedImmersion ψ ∧
      ψ ≫ pullback.fst (U.ι ≫ p) (W.ι ≫ p) = X.homOfLE (inf_le_left : U ⊓ W ≤ U) ∧
      ψ ≫ pullback.snd (U.ι ≫ p) (W.ι ≫ p) = X.homOfLE (inf_le_right : U ⊓ W ≤ W) := by
  have hsq := pullback_map_diagonal_isPullback U.ι W.ι p
  have hcl : IsClosedImmersion (pullback.map U.ι W.ι (U.ι ≫ p) (W.ι ≫ p) (𝟙 _) (𝟙 _) p
      (by simp) (by simp)) :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @IsClosedImmersion) hsq
      inferInstance
  refine ⟨(isPullback_opens_inf U W).isoPullback.hom ≫
      pullback.map U.ι W.ι (U.ι ≫ p) (W.ι ≫ p) (𝟙 _) (𝟙 _) p (by simp) (by simp),
    inferInstance, ?_, ?_⟩
  · simp
  · simp

/-- The intersection of two affine opens of a scheme separated over an affine scheme is affine. -/
theorem isAffineOpen_inf_of_isSeparated {X S : Scheme.{u}} [IsAffine S] (p : X ⟶ S)
    [IsSeparated p] {U W : X.Opens} (hU : IsAffineOpen U) (hW : IsAffineOpen W) :
    IsAffineOpen (U ⊓ W) := by
  have : IsAffine U.toScheme := hU
  have : IsAffine W.toScheme := hW
  obtain ⟨ψ, hψ, -, -⟩ := exists_closedImmersion_inf_to_pullback p U W
  exact (IsClosedImmersion.isAffine_surjective_of_isAffine ψ).1

/-- The functions on the intersection of two affine opens of a scheme separated over an affine
scheme are generated by the restrictions of the functions on the two opens, in the global sections
of the open subschemes. -/
theorem homOfLE_inf_appTop_range_sup_eq_top {X S : Scheme.{u}} [IsAffine S] (p : X ⟶ S)
    [IsSeparated p] {U W : X.Opens} (hU : IsAffineOpen U) (hW : IsAffineOpen W) :
    (X.homOfLE (inf_le_left : U ⊓ W ≤ U)).appTop.hom.range ⊔
      (X.homOfLE (inf_le_right : U ⊓ W ≤ W)).appTop.hom.range =
      (⊤ : Subring Γ((U ⊓ W).toScheme, ⊤)) := by
  have : IsAffine U.toScheme := hU
  have : IsAffine W.toScheme := hW
  obtain ⟨ψ, hψ, hψfst, hψsnd⟩ := exists_closedImmersion_inf_to_pullback p U W
  have hsurj := (IsClosedImmersion.isAffine_surjective_of_isAffine ψ).2
  -- the functions on the fibre product are generated by those on U and W
  have hpush := isPushout_appTop_of_isPullback (IsPullback.of_hasPullback (U.ι ≫ p) (W.ι ≫ p))
  have hgen := commRingCat_isPushout_range_sup_eq_top hpush
  rw [eq_top_iff]
  intro x _
  obtain ⟨b, rfl⟩ := hsurj x
  have hb : b ∈ (pullback.fst (U.ι ≫ p) (W.ι ≫ p)).appTop.hom.range ⊔
      (pullback.snd (U.ι ≫ p) (W.ι ≫ p)).appTop.hom.range := by
    rw [hgen]
    exact Subring.mem_top b
  have hmap : ψ.appTop.hom b ∈ (pullback.fst (U.ι ≫ p) (W.ι ≫ p)).appTop.hom.range.map
      ψ.appTop.hom ⊔ (pullback.snd (U.ι ≫ p) (W.ι ≫ p)).appTop.hom.range.map ψ.appTop.hom := by
    rw [← Subring.map_sup]
    exact Subring.mem_map.mpr ⟨b, hb, rfl⟩
  rw [RingHom.map_range, RingHom.map_range] at hmap
  have h1 : ψ.appTop.hom.comp (pullback.fst (U.ι ≫ p) (W.ι ≫ p)).appTop.hom =
      (X.homOfLE (inf_le_left : U ⊓ W ≤ U)).appTop.hom := by
    rw [← hψfst]
    rfl
  have h2 : ψ.appTop.hom.comp (pullback.snd (U.ι ≫ p) (W.ι ≫ p)).appTop.hom =
      (X.homOfLE (inf_le_right : U ⊓ W ≤ W)).appTop.hom := by
    rw [← hψsnd]
    rfl
  rw [h1, h2] at hmap
  exact hmap

/-- The functions on the intersection of two affine opens of a scheme separated over an affine
scheme are generated by the restrictions of the functions on the two opens. -/
theorem affineOpens_inf_res_range_sup_eq_top {X S : Scheme.{u}} [IsAffine S] (p : X ⟶ S)
    [IsSeparated p] {U W : X.Opens} (hU : IsAffineOpen U) (hW : IsAffineOpen W) :
    (X.presheaf.map (homOfLE (inf_le_left : U ⊓ W ≤ U)).op).hom.range ⊔
      (X.presheaf.map (homOfLE (inf_le_right : U ⊓ W ≤ W)).op).hom.range =
      (⊤ : Subring Γ(X, U ⊓ W)) := by
  have hsch := homOfLE_inf_appTop_range_sup_eq_top p hU hW
  -- the squares between the global sections of the open subschemes and the sections on X
  have hsqU : (X.homOfLE (inf_le_left : U ⊓ W ≤ U)).appTop ≫ (U ⊓ W).topIso.hom =
      U.topIso.hom ≫ X.presheaf.map (homOfLE (inf_le_left : U ⊓ W ≤ U)).op := by
    rw [Scheme.homOfLE_appTop, Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom,
      ← Functor.map_comp, ← Functor.map_comp]
    rfl
  have hsqW : (X.homOfLE (inf_le_right : U ⊓ W ≤ W)).appTop ≫ (U ⊓ W).topIso.hom =
      W.topIso.hom ≫ X.presheaf.map (homOfLE (inf_le_right : U ⊓ W ≤ W)).op := by
    rw [Scheme.homOfLE_appTop, Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom,
      ← Functor.map_comp, ← Functor.map_comp]
    rfl
  rw [eq_top_iff]
  intro x _
  have hx' : (U ⊓ W).topIso.inv x ∈ (X.homOfLE (inf_le_left : U ⊓ W ≤ U)).appTop.hom.range ⊔
      (X.homOfLE (inf_le_right : U ⊓ W ≤ W)).appTop.hom.range := by
    rw [hsch]
    exact Subring.mem_top _
  have hmap : (U ⊓ W).topIso.hom.hom ((U ⊓ W).topIso.inv x) ∈
      (X.homOfLE (inf_le_left : U ⊓ W ≤ U)).appTop.hom.range.map (U ⊓ W).topIso.hom.hom ⊔
        (X.homOfLE (inf_le_right : U ⊓ W ≤ W)).appTop.hom.range.map (U ⊓ W).topIso.hom.hom := by
    rw [← Subring.map_sup]
    exact Subring.mem_map.mpr ⟨_, hx', rfl⟩
  have hxx : (U ⊓ W).topIso.hom.hom ((U ⊓ W).topIso.inv x) = x :=
    congr($((U ⊓ W).topIso.inv_hom_id).hom x)
  rw [hxx, RingHom.map_range, RingHom.map_range] at hmap
  have h1 : (U ⊓ W).topIso.hom.hom.comp (X.homOfLE (inf_le_left : U ⊓ W ≤ U)).appTop.hom =
      (X.presheaf.map (homOfLE (inf_le_left : U ⊓ W ≤ U)).op).hom.comp U.topIso.hom.hom := by
    rw [← CommRingCat.hom_comp, hsqU, CommRingCat.hom_comp]
  have h2 : (U ⊓ W).topIso.hom.hom.comp (X.homOfLE (inf_le_right : U ⊓ W ≤ W)).appTop.hom =
      (X.presheaf.map (homOfLE (inf_le_right : U ⊓ W ≤ W)).op).hom.comp W.topIso.hom.hom := by
    rw [← CommRingCat.hom_comp, hsqW, CommRingCat.hom_comp]
  rw [h1, h2] at hmap
  have hle : ∀ {A B C : Type u} [Ring A] [Ring B] [Ring C] (φ : B →+* C) (χ : A →+* B),
      (φ.comp χ).range ≤ φ.range := by
    rintro A B C _ _ _ φ χ _ ⟨a, rfl⟩
    exact ⟨χ a, rfl⟩
  exact (sup_le_sup (hle _ _) (hle _ _)) hmap


/-- The functions on an open V equal to the intersection of two affine opens U and W of a scheme
separated over an affine scheme are generated by the restrictions of the functions on U and W. -/
theorem affineOpens_res_range_sup_eq_top_of_eq_inf {X S : Scheme.{u}} [IsAffine S] (p : X ⟶ S)
    [IsSeparated p] {U W V : X.Opens} (hU : IsAffineOpen U) (hW : IsAffineOpen W)
    (hV : V = U ⊓ W) (hVU : V ≤ U) (hVW : V ≤ W) :
    (X.presheaf.map (homOfLE hVU).op).hom.range ⊔ (X.presheaf.map (homOfLE hVW).op).hom.range =
      (⊤ : Subring Γ(X, V)) := by
  subst hV
  exact affineOpens_inf_res_range_sup_eq_top p hU hW

end MixedFujita
