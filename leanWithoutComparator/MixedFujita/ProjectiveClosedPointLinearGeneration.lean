module

public import MixedFujita.ProjectiveClosedPointCoordinates
public import MixedFujita.PointedProjectiveLinearAvoidance

/-!
Over an algebraically closed field, the actual homogeneous ideal of every
closed point of polynomial projective space is generated by linear forms.
Normalized coordinates come from the actual affine-chart residue field.
The explicit substitution kernel contains each homogeneous component of
the point's ideal. The converse follows from chart evaluation of the linear
relations. This discharges the linear-generation premise of pointed degree-one
finite avoidance; smooth integral pointed Bertini flags remain separate.
-/

@[expose] public section
open AlgebraicGeometry TopologicalSpace
namespace MixedFujita
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
attribute [local instance] MvPolynomial.gradedAlgebra
universe u
variable {K : Type u} [Field K] [IsAlgClosed K] {n : ℕ}

theorem polynomialProjectiveClosedPointCoordinates_ideal_eq_linearIdeal (k : Fin n)
    (x : polynomialProjectiveScheme n K)
    (hxi : x ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin n) K) (MvPolynomial.X k))
    (hx : IsClosed {x}) :
    x.asHomogeneousIdeal.toIdeal =
      normalizedProjectiveLinearIdeal (polynomialProjectiveClosedPointCoordinates k x hxi hx) k := by
  classical
  apply le_antisymm
  · intro f hf
    have hcomponents := x.asHomogeneousIdeal.isHomogeneous.mem_iff.mp hf
    rw [← DirectSum.sum_support_decompose (MvPolynomial.homogeneousSubmodule (Fin n) K) f]
    apply Ideal.sum_mem
    intro d hd
    let g : MvPolynomial.homogeneousSubmodule (Fin n) K d :=
      DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin n) K) f d
    exact normalizedProjectiveLinearIdeal_mem_of_homogeneous_eval_zero _ k
      (polynomialProjectiveClosedPointCoordinates_self k x hxi hx) g.val g.property
      ((polynomialProjectiveClosedPointCoordinates_homogeneous_mem_iff k x hxi hx
        g.val g.property).mpr (hcomponents d))
  · rw [normalizedProjectiveLinearIdeal, Ideal.span_le]
    rintro f ⟨j, rfl⟩
    exact polynomialProjectiveClosedPointCoordinates_linearRelation_mem k j x hxi hx

theorem polynomialProjectiveClosedPointCoordinates_linear_generated (k : Fin n)
    (x : polynomialProjectiveScheme n K)
    (hxi : x ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin n) K) (MvPolynomial.X k))
    (hx : IsClosed {x}) :
    Ideal.span {f : MvPolynomial (Fin n) K |
      f ∈ MvPolynomial.homogeneousSubmodule (Fin n) K 1 ∧
      f ∈ x.asHomogeneousIdeal} = x.asHomogeneousIdeal.toIdeal := by
  apply le_antisymm
  · exact Ideal.span_le.mpr fun _ hf ↦ hf.2
  · rw [polynomialProjectiveClosedPointCoordinates_ideal_eq_linearIdeal k x hxi hx,
      normalizedProjectiveLinearIdeal, Ideal.span_le]
    rintro f ⟨j, rfl⟩
    exact Ideal.subset_span ⟨normalizedProjectiveLinearRelation_homogeneous _ k j,
      polynomialProjectiveClosedPointCoordinates_linearRelation_mem k j x hxi hx⟩

theorem polynomialProjective_closedPoint_linear_generated
    (x : polynomialProjectiveScheme n K) (hx : IsClosed {x}) :
    Ideal.span {f : MvPolynomial (Fin n) K |
      f ∈ MvPolynomial.homogeneousSubmodule (Fin n) K 1 ∧
      f ∈ x.asHomogeneousIdeal} = x.asHomogeneousIdeal.toIdeal := by
  obtain ⟨k, hk⟩ := polynomialProjective_exists_coordinate_chart n K x
  exact polynomialProjectiveClosedPointCoordinates_linear_generated k x hk hx

theorem polynomialProjective_closedPoint_linearForm_separates_of_isAlgClosed
    (x : polynomialProjectiveScheme n K) (hx : IsClosed {x})
    (y : polynomialProjectiveScheme n K) (hy : y ≠ x) :
    ∃ f : MvPolynomial.homogeneousSubmodule (Fin n) K 1,
      (f : MvPolynomial (Fin n) K) ∈ x.asHomogeneousIdeal ∧
      (f : MvPolynomial (Fin n) K) ∉ y.asHomogeneousIdeal :=
  polynomialProjective_closedPoint_linearForm_separates x hx
    (polynomialProjective_closedPoint_linear_generated x hx) y hy

theorem polynomialProjective_closedPoint_linear_zeroLocus
    (x : polynomialProjectiveScheme n K) (hx : IsClosed {x}) :
    ProjectiveSpectrum.zeroLocus (MvPolynomial.homogeneousSubmodule (Fin n) K)
      {f : MvPolynomial (Fin n) K |
        f ∈ MvPolynomial.homogeneousSubmodule (Fin n) K 1 ∧ f ∈ x.asHomogeneousIdeal} =
      ({x} : Set (polynomialProjectiveScheme n K)) := by
  ext y
  simp only [ProjectiveSpectrum.mem_zeroLocus, Set.mem_singleton_iff]
  constructor
  · intro hy
    by_contra hyx
    obtain ⟨f, hfx, hfy⟩ :=
      polynomialProjective_closedPoint_linearForm_separates_of_isAlgClosed x hx y hyx
    exact hfy (hy ⟨f.property, hfx⟩)
  · rintro rfl
    exact fun _ hf ↦ hf.2

theorem polynomialProjective_closedPoint_finiteSubset_linearForm_of_isAlgClosed
    (x : polynomialProjectiveScheme n K) (hx : IsClosed {x})
    (Z : Set (polynomialProjectiveScheme n K)) (hZ : Z.Finite) (hxZ : x ∉ Z) :
    ∃ f : MvPolynomial.homogeneousSubmodule (Fin n) K 1,
      (f : MvPolynomial (Fin n) K) ∈ x.asHomogeneousIdeal ∧
      ∀ y ∈ Z, (f : MvPolynomial (Fin n) K) ∉ y.asHomogeneousIdeal :=
  polynomialProjective_closedPoint_finiteSubset_linearForm x hx
    (polynomialProjective_closedPoint_linear_generated x hx) Z hZ hxZ

theorem polynomialProjective_closedPoint_linear_affine_excluding_of_isAlgClosed
    (x : polynomialProjectiveScheme n K) (hx : IsClosed {x})
    (Z : Set (polynomialProjectiveScheme n K)) (hZ : Z.Finite) (hxZ : x ∉ Z) :
    ∃ f : MvPolynomial.homogeneousSubmodule (Fin n) K 1,
      let U := Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin n) K) f.val
      IsAffineOpen U ∧ x ∉ U ∧ Z ⊆ U :=
  polynomialProjective_closedPoint_linear_affine_excluding x hx
    (polynomialProjective_closedPoint_linear_generated x hx) Z hZ hxZ

theorem polynomialProjective_closedImmersion_pointed_linearForm_of_isAlgClosed
    {Y : Scheme.{u}} (e : Y ⟶ polynomialProjectiveScheme n K) [IsClosedImmersion e]
    (x : Y) (hx : IsClosed {x}) (Z : Set Y) (hZ : Z.Finite) (hxZ : x ∉ Z) :
    ∃ f : MvPolynomial.homogeneousSubmodule (Fin n) K 1,
      (f : MvPolynomial (Fin n) K) ∈ (e x).asHomogeneousIdeal ∧
      ∀ y ∈ Z, (f : MvPolynomial (Fin n) K) ∉ (e y).asHomogeneousIdeal := by
  have hex : IsClosed {e x} := by
    simpa only [Set.image_singleton] using e.isClosedEmbedding.isClosedMap {x} hx
  have hexZ : e x ∉ e '' Z := by
    rintro ⟨y, hy, he⟩
    exact hxZ (e.isClosedEmbedding.injective he ▸ hy)
  obtain ⟨f, hfx, hfy⟩ := polynomialProjective_closedPoint_finiteSubset_linearForm_of_isAlgClosed
    (e x) hex (e '' Z) (hZ.image e) hexZ
  exact ⟨f, hfx, fun y hy ↦ hfy (e y) ⟨y, hy, rfl⟩⟩

theorem polynomialProjective_closedImmersion_pointed_linear_affine_of_isAlgClosed
    {Y : Scheme.{u}} (e : Y ⟶ polynomialProjectiveScheme n K) [IsClosedImmersion e]
    (x : Y) (hx : IsClosed {x}) (Z : Set Y) (hZ : Z.Finite) (hxZ : x ∉ Z) :
    ∃ f : MvPolynomial.homogeneousSubmodule (Fin n) K 1,
      let U := e ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin n) K) f.val
      IsAffineOpen U ∧ x ∉ U ∧ Z ⊆ U := by
  obtain ⟨f, hfx, hfy⟩ :=
    polynomialProjective_closedImmersion_pointed_linearForm_of_isAlgClosed e x hx Z hZ hxZ
  exact ⟨f, (Proj.isAffineOpen_basicOpen _ _ f.property Nat.zero_lt_one).preimage e,
    fun h ↦ h hfx, hfy⟩

theorem polynomialProjective_closedImmersion_pointed_linear_zeroLocus
    {Y : Scheme.{u}} (e : Y ⟶ polynomialProjectiveScheme n K) [IsClosedImmersion e]
    (x : Y) (hx : IsClosed {x}) :
    e ⁻¹' ProjectiveSpectrum.zeroLocus (MvPolynomial.homogeneousSubmodule (Fin n) K)
      {f : MvPolynomial (Fin n) K |
        f ∈ MvPolynomial.homogeneousSubmodule (Fin n) K 1 ∧ f ∈ (e x).asHomogeneousIdeal} =
      {x} := by
  have hex : IsClosed {e x} := by
    simpa only [Set.image_singleton] using e.isClosedEmbedding.isClosedMap {x} hx
  rw [polynomialProjective_closedPoint_linear_zeroLocus (e x) hex]
  ext y
  simp only [Set.mem_preimage, Set.mem_singleton_iff, e.isClosedEmbedding.injective.eq_iff]

end MixedFujita
