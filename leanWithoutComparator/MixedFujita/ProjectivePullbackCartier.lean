module
public import MixedFujita.ProjectivePullbackEquations
public import MixedFujita.EffectiveCartierIdealSheaf

/-!
A homogeneous equation avoiding the generic point of an integral source
defines an actual effective Cartier divisor. Empty coordinate charts are
discarded before gluing. On an affine morphism's source, its actual ideal
sheaf is generated by the pulled-back equation on every nonempty chart.
The support is exactly the pulled-back homogeneous zero locus.
This does not assert smoothness, integrality of the cut, or a fixed-class
comparison between different homogeneous equations.
-/

@[expose] public section
open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open TauCeti.AlgebraicGeometry.Scheme
namespace MixedFujita
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
attribute [local instance] MvPolynomial.gradedAlgebra
universe u
variable {n : ℕ} {R : Type u} [CommRing R] {Y : Scheme.{u}} [IsIntegral Y]
  (e : Y ⟶ polynomialProjectiveScheme n R)
  (d : ℕ) (f : MvPolynomial (Fin n) R) (hf : f.IsHomogeneous d) (hd : 0 < d)
  (hgeneric : f ∉ (e (genericPoint Y)).asHomogeneousIdeal)

instance (k : {k : Fin n // Nonempty (projectivePullbackCoordinateOpen e k)}) :
    Nonempty (projectivePullbackCoordinateOpen e k.val) := k.property

theorem projectivePullbackHomogeneousCartier_existsUnique :
    ∃! D : CartierDivisor Y,
      (∀ k : {k : Fin n // Nonempty (projectivePullbackCoordinateOpen e k)},
        D |_ projectivePullbackNonemptyCoordinateOpen e k =
          rationalUnitClass Y (projectivePullbackNonemptyCoordinateOpen e k)
            (Additive.ofMul (regularEquationRationalUnit Y _
              (projectivePullbackHomogeneousEquation e k.val d f hf)
              (projectivePullbackHomogeneousEquation_ne_zero e k.val d f hf hd hgeneric)))) ∧
      D.IsEffective := by
  exact cartier_existsUnique_effective_of_regularEquations Y
    (projectivePullbackNonemptyCoordinateOpen e)
    (projectivePullbackNonemptyCoordinateOpen_cover e)
    (fun k => projectivePullbackHomogeneousEquation e k.val d f hf)
    (fun k => projectivePullbackHomogeneousEquation_ne_zero e k.val d f hf hd hgeneric)
    (fun k j => projectivePullbackHomogeneousEquation_overlap e k.val j.val d f hf)

noncomputable def projectivePullbackHomogeneousCartier : CartierDivisor Y :=
  (projectivePullbackHomogeneousCartier_existsUnique e d f hf hd hgeneric).choose

theorem projectivePullbackHomogeneousCartier_restrict
    (k : {k : Fin n // Nonempty (projectivePullbackCoordinateOpen e k)}) :
    (projectivePullbackHomogeneousCartier e d f hf hd hgeneric) |_
        projectivePullbackNonemptyCoordinateOpen e k =
      rationalUnitClass Y (projectivePullbackNonemptyCoordinateOpen e k)
        (Additive.ofMul (regularEquationRationalUnit Y _
          (projectivePullbackHomogeneousEquation e k.val d f hf)
          (projectivePullbackHomogeneousEquation_ne_zero e k.val d f hf hd hgeneric))) :=
  (projectivePullbackHomogeneousCartier_existsUnique e d f hf hd hgeneric).choose_spec.1.1 k

theorem projectivePullbackHomogeneousCartier_isEffective :
    (projectivePullbackHomogeneousCartier e d f hf hd hgeneric).IsEffective :=
  (projectivePullbackHomogeneousCartier_existsUnique e d f hf hd hgeneric).choose_spec.1.2

noncomputable def projectivePullbackCartierIdealSheaf : Y.IdealSheafData :=
  effectiveCartierIdealSheaf (projectivePullbackHomogeneousCartier e d f hf hd hgeneric)
    (projectivePullbackHomogeneousCartier_isEffective e d f hf hd hgeneric)

noncomputable def projectivePullbackCartierIdealPresentation :
    InvertibleIdealPresentation (projectivePullbackCartierIdealSheaf e d f hf hd hgeneric) :=
  effectiveCartierIdealPresentation _ _

theorem projectivePullbackCartierIdealModule_isInvertible :
    TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible Y
      (idealSheafDataModule (projectivePullbackCartierIdealSheaf e d f hf hd hgeneric)) :=
  effectiveCartierIdealModule_isInvertible _ _

variable [IsAffineHom e]

noncomputable def projectivePullbackNonemptyCoordinateAffineOpen
    (k : {k : Fin n // Nonempty (projectivePullbackCoordinateOpen e k)}) : Y.affineOpens :=
  ⟨projectivePullbackNonemptyCoordinateOpen e k,
    (Proj.isAffineOpen_basicOpen _ _ (MvPolynomial.isHomogeneous_X R k.val)
      Nat.zero_lt_one).preimage e⟩

theorem projectivePullbackCartierIdealSheaf_coordinate_ideal
    (k : {k : Fin n // Nonempty (projectivePullbackCoordinateOpen e k)}) :
    (projectivePullbackCartierIdealSheaf e d f hf hd hgeneric).ideal
        (projectivePullbackNonemptyCoordinateAffineOpen e k) =
      Ideal.span ({projectivePullbackHomogeneousEquation e k.val d f hf} :
        Set Γ(Y, projectivePullbackNonemptyCoordinateOpen e k)) := by
  apply SetLike.coe_injective
  ext s
  rw [projectivePullbackCartierIdealSheaf, ← effectiveCartierIdealSheaf_affine_image]
  exact (negativeCartierToUnit_range_iff Y _ _ _ s).trans
    (negativeCartier_regularSection_mem_iff Y _ _ _
      (projectivePullbackHomogeneousEquation_ne_zero e k.val d f hf hd hgeneric)
      (projectivePullbackHomogeneousCartier_restrict e d f hf hd hgeneric k).symm s)

theorem projectivePullbackCartierIdealSheaf_mem_support_iff (y : Y) :
    y ∈ (projectivePullbackCartierIdealSheaf e d f hf hd hgeneric).support ↔
      f ∈ (e y).asHomogeneousIdeal := by
  obtain ⟨k, hk⟩ := polynomialProjective_exists_coordinate_chart n R (e y)
  let j : {k : Fin n // Nonempty (projectivePullbackCoordinateOpen e k)} := ⟨k, ⟨⟨y, hk⟩⟩⟩
  rw [Scheme.IdealSheafData.mem_support_iff_of_mem
    (I := projectivePullbackCartierIdealSheaf e d f hf hd hgeneric)
    (U := projectivePullbackNonemptyCoordinateAffineOpen e j) hk,
    projectivePullbackCartierIdealSheaf_coordinate_ideal,
    Scheme.zeroLocus_span, Scheme.zeroLocus_singleton,
    projectivePullbackHomogeneousEquation_basicOpen e k d f hf hd]
  change (¬ (y ∈ projectivePullbackCoordinateOpen e k ∧
    f ∉ (e y).asHomogeneousIdeal)) ↔ f ∈ (e y).asHomogeneousIdeal
  have hy : y ∈ projectivePullbackCoordinateOpen e k := hk
  simp only [hy, true_and, not_not]

theorem projectivePullbackCartierIdealSheaf_support :
    ((projectivePullbackCartierIdealSheaf e d f hf hd hgeneric).support : Set Y) =
      e ⁻¹' ProjectiveSpectrum.zeroLocus (MvPolynomial.homogeneousSubmodule (Fin n) R)
        ({f} : Set (MvPolynomial (Fin n) R)) := by
  ext y
  change y ∈ (projectivePullbackCartierIdealSheaf e d f hf hd hgeneric).support ↔
    ∀ g ∈ ({f} : Set (MvPolynomial (Fin n) R)), g ∈ (e y).asHomogeneousIdeal
  rw [projectivePullbackCartierIdealSheaf_mem_support_iff]
  simp only [Set.mem_singleton_iff, forall_eq]

theorem projectivePullbackCartierCut_range :
    Set.range (projectivePullbackCartierIdealSheaf e d f hf hd hgeneric).subschemeι =
      e ⁻¹' ProjectiveSpectrum.zeroLocus (MvPolynomial.homogeneousSubmodule (Fin n) R)
        ({f} : Set (MvPolynomial (Fin n) R)) := by
  rw [Scheme.IdealSheafData.range_subschemeι, projectivePullbackCartierIdealSheaf_support]

end MixedFujita
