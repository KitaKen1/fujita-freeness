module
public import MixedFujita.SmoothQuotientJacobian

/-! 正則主商の実余法微分完全列。 check-277：実際の正則主商 A→B について、ker=(g)、gの非零因子性、A/Bの形式的滑らかさから、B·dg→B⊗Ω_A→Ω_B の単射・完全性・全射性を内部証明。既存OpenAIの行列式随伴を再利用して、Ω_Bの有限自由基底の下で局所標準随伴同型と正確な楔積公式を構成し、その一意性と基底・分裂選択からの独立性を証明。実方程式gを単元倍ugへ変える際の微分・楔積の変換を計算し、二つの局所留数同型と分子の単元倍の整合性を元の商データから内部構成。大域の層同型や元lc中心の数値随伴を証明済みとはしない。 -/

@[expose] public section
set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true
open scoped TensorProduct
open KaehlerDifferential
namespace MixedFujita


/-- For an actual regular principal quotient, the conormal class is freely
generated by its actual equation, and its differential is a split kernel. -/
theorem regular_smooth_principal_quotient_differential_exact
    {K A B : Type*} [CommRing K] [CommRing A] [CommRing B]
    [Algebra K A] [Algebra A B] [Algebra K B] [IsScalarTower K A B]
    [Algebra.FormallySmooth K A] [Algebra.FormallySmooth K B]
    (g : A) (hg : ∀ a : A, a * g = 0 → a = 0)
    (hsurj : Function.Surjective (algebraMap A B))
    (hker : RingHom.ker (algebraMap A B) = Ideal.span {g}) :
    let j := LinearMap.toSpanSingleton B (B ⊗[A] Ω[A⁄K]) ((1 : B) ⊗ₜ[A] D K A g)
    Function.Injective j ∧ Function.Exact j (mapBaseChange K A B) ∧
      Function.Surjective (mapBaseChange K A B) := by
  classical
  dsimp only
  let I := RingHom.ker (algebraMap A B)
  have hgI : g ∈ I := by change g ∈ RingHom.ker (algebraMap A B); rw [hker]; exact Ideal.mem_span_singleton_self g
  have hgen : ∀ y : I.Cotangent, ∃ a : A, y = a • I.toCotangent ⟨g, hgI⟩ := by
    intro y
    obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.toCotangent_surjective I y
    have hx' : x ∈ Ideal.span {g} := hker ▸ hx
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hx'
    refine ⟨a, ?_⟩
    rw [← map_smul]
    rfl
  obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection hsurj).mp
    (inferInstance : Algebra.FormallySmooth K B)
  have hk : kerCotangentToTensor K A B (I.toCotangent ⟨g, hgI⟩) = (1 : B) ⊗ₜ[A] D K A g :=
    kerCotangentToTensor_toCotangent K A B ⟨g, hgI⟩
  have hlj : l ((1 : B) ⊗ₜ[A] D K A g) = I.toCotangent ⟨g, hgI⟩ := by
    exact LinearMap.congr_fun hl (I.toCotangent ⟨g, hgI⟩)
  refine ⟨?_, ?_, mapBaseChange_surjective K A B hsurj⟩
  · apply LinearMap.ker_eq_bot.mp
    apply le_antisymm _ bot_le
    intro b hb
    obtain ⟨a, rfl⟩ := hsurj b
    change (algebraMap A B a) • ((1 : B) ⊗ₜ[A] D K A g) = 0 at hb
    have hz : a • I.toCotangent ⟨g, hgI⟩ = 0 := by
      have hb' : a • ((1 : B) ⊗ₜ[A] D K A g) = 0 := by
        simpa only [LinearMap.toSpanSingleton_apply, IsScalarTower.algebraMap_smul] using hb
      have h := congrArg l hb'
      simpa only [map_smul, map_zero, hlj] using h
    have hmem : a * g ∈ I ^ 2 := by
      have hcz : I.toCotangent (a • ⟨g, hgI⟩) = 0 := by
        simpa only [map_smul] using hz
      exact (Ideal.toCotangent_eq_zero I (a • ⟨g, hgI⟩)).mp hcz
    rw [show I = Ideal.span {g} from hker, Ideal.span_singleton_pow,
      Ideal.mem_span_singleton'] at hmem
    obtain ⟨c, hc⟩ := hmem
    have hac : a - c * g = 0 := hg _ (by linear_combination -hc)
    have haI : a ∈ I := by
      change a ∈ RingHom.ker (algebraMap A B)
      rw [hker, Ideal.mem_span_singleton']
      exact ⟨c, sub_eq_zero.mp hac |>.symm⟩
    exact RingHom.mem_ker.mp haI
  · intro w
    rw [show mapBaseChange K A B w = 0 ↔ ∃ y, kerCotangentToTensor K A B y = w from
      exact_kerCotangentToTensor_mapBaseChange K A B hsurj w]
    constructor
    · rintro ⟨y, rfl⟩
      obtain ⟨a, rfl⟩ := hgen y
      refine ⟨algebraMap A B a, ?_⟩
      simp only [LinearMap.toSpanSingleton_apply, map_smul,
        hk, IsScalarTower.algebraMap_smul]
    · rintro ⟨b, rfl⟩
      obtain ⟨a, rfl⟩ := hsurj b
      refine ⟨a • I.toCotangent ⟨g, hgI⟩, ?_⟩
      simp only [LinearMap.toSpanSingleton_apply, map_smul,
        hk, IsScalarTower.algebraMap_smul]

end MixedFujita
