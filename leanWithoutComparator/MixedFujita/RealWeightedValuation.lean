module

public import MixedFujita.ProjectiveRealWeightedMinimization
public import MixedFujita.FlagValuationConditions

/-!
Monomial valuations with nonnegative real weights are valuations, and the flag conditions of §2.2
for the test valuations. The parts of f and g of least u-weight multiply to the part of f g of
weight v_u(f) + v_u(g); this product is nonzero because power series over a field form a domain,
so v_u(f g) = v_u(f) + v_u(g). Hence v_u, with v_u(0) = ∞, is an additive valuation on K[[z]] with
values in ℝ ∪ {∞}, nonnegative. For sections of a Cartier divisor pulled back along ρ : T' → T,
the bounds v_u(ρ^* s_i) ≥ α_i A on an adapted basis are equivalent to v_u(a_α) ≥ M A for the ideal
a_α of K[[z]] generated by the powers of the flag ideals, as in §2.2.
-/

@[expose] public section

namespace MixedFujita

open MvPowerSeries Finset

section Valuation

variable {σ K : Type*} [Field K] [Fintype σ]

/-- The part of f of u-weight exactly a. -/
noncomputable def realWeightedPart (u : σ → ℝ) (a : ℝ) (f : MvPowerSeries σ K) :
    MvPowerSeries σ K :=
  fun e => if ∑ i, u i * (e i : ℝ) = a then coeff e f else 0

theorem coeff_realWeightedPart (u : σ → ℝ) (a : ℝ) (f : MvPowerSeries σ K) (e : σ →₀ ℕ) :
    coeff e (realWeightedPart u a f) = if ∑ i, u i * (e i : ℝ) = a then coeff e f else 0 :=
  rfl

theorem realWeightedPart_ne_zero (u : σ → ℝ) {f : MvPowerSeries σ K} (hf : f ≠ 0) :
    realWeightedPart u (realWeightedOrder u f) f ≠ 0 := by
  classical
  obtain ⟨β, hβ, hw⟩ := exists_coeff_realWeightedOrder u hf
  intro h
  have h' := congrArg (coeff β) h
  rw [coeff_realWeightedPart, ite_eq_left hw, map_zero] at h'
  exact hβ h'

/-- Monomial valuations with nonnegative real weights are multiplicative. -/
theorem realWeightedOrder_mul {u : σ → ℝ} (hu : ∀ i, 0 ≤ u i) {f g : MvPowerSeries σ K}
    (hf : f ≠ 0) (hg : g ≠ 0) :
    realWeightedOrder u (f * g) = realWeightedOrder u f + realWeightedOrder u g := by
  classical
  have hfg : f * g ≠ 0 := mul_ne_zero hf hg
  apply le_antisymm _ (realWeightedOrder_mul_ge hu hf hg hfg)
  set a := realWeightedOrder u f with ha
  set b := realWeightedOrder u g with hb
  have hprod : realWeightedPart u a f * realWeightedPart u b g ≠ 0 :=
    mul_ne_zero (realWeightedPart_ne_zero u hf) (realWeightedPart_ne_zero u hg)
  obtain ⟨γ, hγ⟩ := (MvPowerSeries.ne_zero_iff_exists_coeff_ne_zero _).mp hprod
  have hγ' := hγ
  rw [coeff_mul] at hγ'
  obtain ⟨⟨e₁, e₂⟩, hmem, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hγ'
  have hsum : ∀ x y : σ →₀ ℕ, x + y = γ →
      ∑ i, u i * (x i : ℝ) + ∑ i, u i * (y i : ℝ) = ∑ i, u i * (γ i : ℝ) := by
    intro x y hxy
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← hxy, Finsupp.add_apply, Nat.cast_add, mul_add]
  have hw₁ : ∑ i, u i * (e₁ i : ℝ) = a := by
    by_contra h
    apply hne
    rw [coeff_realWeightedPart, ite_eq_right h, zero_mul]
  have hw₂ : ∑ i, u i * (e₂ i : ℝ) = b := by
    by_contra h
    apply hne
    rw [coeff_realWeightedPart (e := e₂), ite_eq_right h, mul_zero]
  have hwγ : ∑ i, u i * (γ i : ℝ) = a + b := by
    rw [← hsum e₁ e₂ (Finset.mem_antidiagonal.mp hmem), hw₁, hw₂]
  have hcoef : coeff γ (f * g) = coeff γ (realWeightedPart u a f * realWeightedPart u b g) := by
    rw [coeff_mul, coeff_mul]
    refine Finset.sum_congr rfl ?_
    rintro ⟨x, y⟩ hxy
    have hxy' : x + y = γ := Finset.mem_antidiagonal.mp hxy
    by_cases hx : coeff x f = 0
    · rw [hx, zero_mul, coeff_realWeightedPart]
      split_ifs <;> simp [hx]
    by_cases hy : coeff y g = 0
    · rw [hy, mul_zero, coeff_realWeightedPart (e := y)]
      split_ifs <;> simp [hy]
    have h₁ := realWeightedOrder_le hu hf hx
    have h₂ := realWeightedOrder_le hu hg hy
    have h₃ := hsum x y hxy'
    have hx' : ∑ i, u i * (x i : ℝ) = a := by linarith
    have hy' : ∑ i, u i * (y i : ℝ) = b := by linarith
    rw [coeff_realWeightedPart, coeff_realWeightedPart (e := y), ite_eq_left hx', ite_eq_left hy']
  have hne' : coeff γ (f * g) ≠ 0 := by rw [hcoef]; exact hγ
  calc realWeightedOrder u (f * g) ≤ ∑ i, u i * (γ i : ℝ) := realWeightedOrder_le hu hfg hne'
    _ = a + b := hwγ

/-- The monomial valuation with nonnegative real weights, with v(0) = ∞. -/
noncomputable def realWeightedValuation (u : σ → ℝ) (hu : ∀ i, 0 ≤ u i) :
    AddValuation (MvPowerSeries σ K) (WithTop ℝ) := by
  classical
  refine AddValuation.of (fun f => if f = 0 then ⊤ else ((realWeightedOrder u f : ℝ) : WithTop ℝ))
    (by simp) ?_ ?_ ?_
  · rw [ite_eq_right one_ne_zero, realWeightedOrder_eq_zero_of_isUnit hu isUnit_one,
      WithTop.coe_zero]
  · intro x y
    by_cases hx : x = 0
    · subst hx
      rw [zero_add, ite_eq_left rfl]
      exact min_le_right _ _
    by_cases hy : y = 0
    · subst hy
      rw [add_zero, ite_eq_left rfl]
      exact min_le_left _ _
    by_cases hxy : x + y = 0
    · rw [ite_eq_left hxy]
      exact le_top
    rw [ite_eq_right hx, ite_eq_right hy, ite_eq_right hxy, ← WithTop.coe_min, WithTop.coe_le_coe]
    exact realWeightedOrder_add_ge hu hx hy hxy
  · intro x y
    by_cases hx : x = 0
    · subst hx
      rw [zero_mul, ite_eq_left rfl, top_add]
    by_cases hy : y = 0
    · subst hy
      rw [mul_zero, ite_eq_left rfl, add_top]
    rw [ite_eq_right (mul_ne_zero hx hy), ite_eq_right hx, ite_eq_right hy,
      realWeightedOrder_mul hu hx hy, WithTop.coe_add]

theorem realWeightedValuation_of_ne_zero {u : σ → ℝ} (hu : ∀ i, 0 ≤ u i)
    {f : MvPowerSeries σ K} (hf : f ≠ 0) :
    realWeightedValuation u hu f = ((realWeightedOrder u f : ℝ) : WithTop ℝ) := by
  classical
  change (if f = 0 then ⊤ else ((realWeightedOrder u f : ℝ) : WithTop ℝ)) = _
  rw [ite_eq_right hf]

theorem realWeightedValuation_nonneg {u : σ → ℝ} (hu : ∀ i, 0 ≤ u i) (f : MvPowerSeries σ K) :
    0 ≤ realWeightedValuation u hu f := by
  by_cases hf : f = 0
  · rw [hf, AddValuation.map_zero]
    exact le_top
  rw [realWeightedValuation_of_ne_zero hu hf, ← WithTop.coe_zero, WithTop.coe_le_coe]
  exact realWeightedOrder_nonneg hu f

end Valuation

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open TauCeti.AlgebraicGeometry.Scheme

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

section Flag

variable {K : Type u} [Field K] {T T' : Scheme.{u}} [T.Over (Spec (CommRingCat.of K))]
  [T'.Over (Spec (CommRingCat.of K))] [IsIntegral T]

attribute [local instance] cartierGlobalStalkAlgebra cartierGlobalStalkFunctionFieldTower
  cartierBaseGlobalAlgebra cartierBaseLocalAlgebra cartierBaseLocalScalarTower
  cartierBaseSectionScalarTower

/-- The pulled-back Taylor expansion as a K-linear map. -/
noncomputable def cartierPullbackTaylorLinear (D : CartierDivisor T) (ρ : T' ⟶ T)
    [ρ.IsOver (Spec (CommRingCat.of K))] (p : T') {n : ℕ}
    (ep : AdicCompletion (IsLocalRing.maximalIdeal (T'.presheaf.stalk p))
      (T'.presheaf.stalk p) ≃ₐ[K] MvPowerSeries (Fin n) K) :
    Γ(D.sheaf, ⊤) →ₗ[K] MvPowerSeries (Fin n) K where
  toFun := cartierPullbackTaylor D ρ p ep
  map_add' := cartierPullbackTaylor_add D ρ p ep
  map_smul' c s := by
    rw [cartierPullbackTaylor_smul, RingHom.id_apply, Algebra.smul_def]

/-- §2.2 for the test valuations: for an adapted basis whose pulled-back Taylor expansions are
nonzero, the bounds v_u(ρ^* s_i) ≥ α_i A are equivalent to the single bound v_u(a_α) ≥ M A for
the ideal a_α = Σ_{α_i > 0} b_i^{e_i} of K[[z]] generated by the powers of the flag ideals. -/
theorem cartierPullback_flag_iff_sumPowIdeal (D : CartierDivisor T) (ρ : T' ⟶ T)
    [ρ.IsOver (Spec (CommRingCat.of K))] (p : T') {n : ℕ}
    (ep : AdicCompletion (IsLocalRing.maximalIdeal (T'.presheaf.stalk p))
      (T'.presheaf.stalk p) ≃ₐ[K] MvPowerSeries (Fin n) K)
    {u : Fin n → ℝ} (hu : ∀ i, 0 ≤ u i) {N : ℕ} (s : Fin N → Γ(D.sheaf, ⊤))
    (hs : ∀ i, cartierPullbackTaylor D ρ p ep (s i) ≠ 0)
    {α : Fin N → ℝ} (hα : Antitone α) (hα0 : ∀ i, 0 ≤ α i) {A : ℝ} (hA : 0 ≤ A)
    {Mnat : ℕ} (hM : 0 < Mnat) (e : {i // 0 < α i} → ℕ) (he : ∀ i, (e i : ℝ) * α i = Mnat) :
    (∀ i, α i * A ≤ cartierPullbackRealValuation D ρ p ep u (s i)) ↔
      ∀ g ∈ ⨆ i : {i // 0 < α i}, flagIdeal (cartierPullbackTaylorLinear D ρ p ep) s i ^ e i,
        (((Mnat : ℝ) * A : ℝ) : WithTop ℝ) ≤ realWeightedValuation u hu g := by
  rw [← flag_basis_iff_sumPowIdeal (realWeightedValuation u hu) (realWeightedValuation_nonneg hu)
    (cartierPullbackTaylorLinear D ρ p ep) s hα hα0 hA hM e he]
  refine forall_congr' fun i => ?_
  change _ ↔ _ ≤ realWeightedValuation u hu (cartierPullbackTaylor D ρ p ep (s i))
  rw [realWeightedValuation_of_ne_zero hu (hs i), WithTop.coe_le_coe]
  rfl

end Flag

end MixedFujita
