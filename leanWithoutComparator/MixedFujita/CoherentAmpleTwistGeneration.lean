module
public import MixedFujita.ProjectiveCoherentTwistGeneration
public import MixedFujita.CoherentAmpleSerreVanishing

/-! 元ample因子の全高次数・全剰余類の実連接層生成。 See reports/check-259-ample-ideal-generators-natural-corrections.json for the verified scope. All sufficiently high ORIGINAL ample Cartier twists of any actual coherent module are quotients of finite free sheaves, in every residue class. Actual noninvertible ideal modules are internally coherent and get finite canonical actual global generators. The canonical ideal inclusion pulls back to ZERO on its own actual closed subscheme by the actual adjunction mate. Arbitrary module tensor and NATURAL section restriction preserve this zero; finite ideal corrections preserve exact natural restriction and nonzero restricted sections even for nonreduced closed subschemes. Comparison of the finite ambient Cartier image family with center-exterior basepointfreeness, exterior LC/Bertini, ambient non-LC from restricted concentration, original L nonvanishing, general KV, BPF and full F1/F2 remain unproved. -/

@[expose] public section
set_option autoImplicit false
open AlgebraicGeometry CategoryTheory TopologicalSpace Topology Opposite Limits MonoidalCategory Filter
open TauCeti.AlgebraicGeometry TauCeti.AlgebraicGeometry.Scheme
namespace MixedFujita
universe u
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true
set_option maxHeartbeats 600000
attribute [local instance] MvPolynomial.gradedAlgebra


/-- Every high power of an ORIGINAL ample Cartier divisor, in EVERY residue
class, makes an arbitrary actual coherent module generated by an internally
constructed epimorphism from a finite free sheaf. No supplied generation or
cohomological vanishing is assumed. -/
theorem cartierIsAmpleProj_coherent_tensor_all_high_finite_free_epi
    {K : Type u} [Field K] {X : Scheme.{u}} [IsIntegral X]
    [X.Over (Spec (CommRingCat.of K))]
    (A : CartierDivisor X) (hA : CartierIsAmpleProj K A)
    (M : X.Modules) [M.IsCoherent] :
    ∃ b₀ : ℕ, ∀ b ≥ b₀, ∃ (k : ℕ)
      (π : CohomologyAux.unitBiproduct X k ⟶ ((b • A).sheaf ⊗ M)), Epi π := by
  classical
  obtain ⟨m, hm, n, e, hec, he, g, hg, hgX, f, hmA⟩ := hA
  let := hec
  have hn : 0 < n := by
    obtain ⟨i, _⟩ := polynomialProjective_exists_coordinate_chart n K (e (genericPoint X))
    exact Nat.zero_lt_of_lt i.isLt
  obtain ⟨r, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
  let H := projectiveHyperplaneCartier e g hg hgX
  let a : (m • A).sheaf ≅ H.sheaf :=
    eqToIso (congrArg CartierDivisor.sheaf hmA) ≪≫ cartierSheafPrincipalShiftIso H f
  have hres (i : Fin m) : ∃ j₀ : ℕ, ∀ j ≥ j₀, ∃ (k : ℕ)
      (π : CohomologyAux.unitBiproduct X k ⟶
        ((j • (m • A)).sheaf ⊗ ((i.val • A).sheaf ⊗ M))), Epi π := by
    let := cartierTensorModule_isCoherent (i.val • A) M
    obtain ⟨j₀, hj₀⟩ := projectiveHyperplane_tensor_all_high_finite_free_epi e g hg hgX
      ((i.val • A).sheaf ⊗ M)
    refine ⟨j₀, fun j hj => ?_⟩
    obtain ⟨k, π, hπ⟩ := hj₀ j hj
    let := hπ
    let c := tensorIso (cartierNaturalMultiplesSheafIsoOfIso (m • A) H a j) (Iso.refl ((i.val • A).sheaf ⊗ M))
    exact ⟨k, π ≫ c.inv, inferInstance⟩
  choose B hB using hres
  let b₀ := Finset.univ.sup B
  refine ⟨b₀ * m, fun b hb => ?_⟩
  let i : Fin m := ⟨b % m, Nat.mod_lt b (by omega)⟩
  obtain ⟨k, π, hπ⟩ := hB i (b / m) ((Finset.le_sup (f := B) (Finset.mem_univ i)).trans
    ((Nat.le_div_iff_mul_le (by omega)).mpr hb))
  let := hπ
  let c : ((b / m) • (m • A)).sheaf ⊗ ((i.val • A).sheaf ⊗ M) ≅
      ((m * (b / m) + i.val) • A).sheaf ⊗ M :=
    (α_ _ _ _).symm ≪≫
      tensorIso (cartierTensorSheafIso ((b / m) • (m • A)) (i.val • A)) (Iso.refl M) ≪≫
      eqToIso (congrArg (fun D : CartierDivisor X => D.sheaf ⊗ M) (by
        rw [smul_smul, ← add_nsmul, Nat.mul_comm (b / m) m]))
  have heq : m * (b / m) + i.val = b := Nat.div_add_mod b m
  let c' := c ≪≫ eqToIso (congrArg (fun t : ℕ => (t • A).sheaf ⊗ M) heq)
  exact ⟨k, π ≫ c'.hom, inferInstance⟩

end MixedFujita
