module

public import MixedFujita.ProjectiveIdealDegeneration
public import Mathlib.RingTheory.MvPolynomial.EulerIdentity

/-!
A global homogeneous jet ideal: all partial derivatives of order below h of a family of forms.
Coefficient change commutes with the actual ideal, and homogeneous forms give a homogeneous
ideal even when their degrees differ. This constructs global equations, not a supplied closed
bad set. Their comparison with chart vanishing order is handled separately.
-/

@[expose] public section

namespace MixedFujita

attribute [local instance] MvPolynomial.gradedAlgebra

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable {σ J R S : Type*} [CommRing R] [CommRing S]

/-- Iterated polynomial partial derivatives in the same list order as iteratedPDeriv. -/
noncomputable def polynomialIteratedPDeriv : List σ → MvPolynomial σ R → MvPolynomial σ R
  | [], f => f
  | i :: L, f => MvPolynomial.pderiv i (polynomialIteratedPDeriv L f)

/-- Concatenation is composition of the iterated operators. -/
theorem polynomialIteratedPDeriv_append (L M : List σ) (f : MvPolynomial σ R) :
    polynomialIteratedPDeriv (L ++ M) f =
      polynomialIteratedPDeriv L (polynomialIteratedPDeriv M f) := by
  induction L with
  | nil => rfl
  | cons i L ih => simp only [List.cons_append, polynomialIteratedPDeriv, ih]

/-- Actual coefficient evaluation commutes with every iterated partial derivative. -/
theorem polynomialIteratedPDeriv_map (c : R →+* S) (L : List σ) (f : MvPolynomial σ R) :
    polynomialIteratedPDeriv L (MvPolynomial.map c f) =
      MvPolynomial.map c (polynomialIteratedPDeriv L f) := by
  induction L with
  | nil => rfl
  | cons i L ih => rw [polynomialIteratedPDeriv, ih, MvPolynomial.pderiv_map]; rfl

/-- Iterated partials of a homogeneous form have the expected truncated degree, including
zero derivatives when the list is longer than the original degree. -/
theorem polynomialIteratedPDeriv_isHomogeneous (L : List σ) (f : MvPolynomial σ R)
    (d : ℕ) (hf : f.IsHomogeneous d) :
    (polynomialIteratedPDeriv L f).IsHomogeneous (d - L.length) := by
  induction L with
  | nil => simpa only [polynomialIteratedPDeriv, List.length_nil, Nat.sub_zero] using hf
  | cons i L ih =>
    simpa only [polynomialIteratedPDeriv, List.length_cons, Nat.sub_sub] using ih.pderiv (i := i)

/-- The global ideal generated by all derivatives of order strictly below h. -/
noncomputable def polynomialJetIdeal (g : J → MvPolynomial σ R) (h : ℕ) :
    Ideal (MvPolynomial σ R) :=
  Ideal.span {p | ∃ (j : J) (L : List σ), L.length < h ∧ p = polynomialIteratedPDeriv L (g j)}

/-- An ideal contains the jet ideal exactly when it contains the displayed derivatives. -/
theorem polynomialJetIdeal_le_iff (g : J → MvPolynomial σ R) (h : ℕ)
    (I : Ideal (MvPolynomial σ R)) :
    polynomialJetIdeal g h ≤ I ↔
      ∀ j (L : List σ), L.length < h → polynomialIteratedPDeriv L (g j) ∈ I := by
  rw [polynomialJetIdeal, Ideal.span_le]
  constructor
  · intro hI j L hL
    exact hI ⟨j, L, hL, rfl⟩
  · intro hI
    rintro p ⟨j, L, hL, hp⟩
    rw [hp]
    exact hI j L hL

/-- The construction is monotone in the jet cutoff. -/
theorem polynomialJetIdeal_mono (g : J → MvPolynomial σ R) {h k : ℕ} (hhk : h ≤ k) :
    polynomialJetIdeal g h ≤ polynomialJetIdeal g k := by
  rw [polynomialJetIdeal_le_iff]
  intro j L hL
  exact Ideal.subset_span ⟨j, L, hL.trans_le hhk, rfl⟩

/-- The order-zero jet imposes no equations. -/
theorem polynomialJetIdeal_zero (g : J → MvPolynomial σ R) : polynomialJetIdeal g 0 = ⊥ := by
  apply le_antisymm
  · rw [polynomialJetIdeal_le_iff]
    exact fun _ _ hL => False.elim (Nat.not_lt_zero _ hL)
  · exact bot_le

/-- The first jet ideal is the ordinary base ideal of the forms. -/
theorem polynomialJetIdeal_one (g : J → MvPolynomial σ R) :
    polynomialJetIdeal g 1 = Ideal.span (Set.range g) := by
  apply le_antisymm
  · rw [polynomialJetIdeal_le_iff]
    intro j L hL
    have hnil : L = [] := by
      cases L with
      | nil => rfl
      | cons i L => simp only [List.length_cons] at hL; omega
    subst L
    exact Ideal.subset_span (Set.mem_range_self j)
  · apply Ideal.span_le.mpr
    rintro p ⟨j, rfl⟩
    exact Ideal.subset_span ⟨j, [], by simp, rfl⟩

/-- The actual jet ideal commutes with arbitrary coefficient ring homomorphisms. -/
theorem polynomialJetIdeal_map (c : R →+* S) (g : J → MvPolynomial σ R) (h : ℕ) :
    Ideal.map (MvPolynomial.map c) (polynomialJetIdeal g h) =
      polynomialJetIdeal (fun j => MvPolynomial.map c (g j)) h := by
  rw [polynomialJetIdeal, Ideal.map_span, polynomialJetIdeal]
  apply congrArg Ideal.span
  ext p
  constructor
  · rintro ⟨q, ⟨j, L, hL, rfl⟩, rfl⟩
    exact ⟨j, L, hL, (polynomialIteratedPDeriv_map c L (g j)).symm⟩
  · rintro ⟨j, L, hL, rfl⟩
    exact ⟨polynomialIteratedPDeriv L (g j), ⟨j, L, hL, rfl⟩,
      (polynomialIteratedPDeriv_map c L (g j)).symm⟩

/-- All jet equations are homogeneous when the original forms are homogeneous. Their degrees
may depend on the generator; no common degree or supplied overlap condition is needed. -/
theorem polynomialJetIdeal_isHomogeneous (g : J → MvPolynomial σ R) (d : J → ℕ)
    (hg : ∀ j, (g j).IsHomogeneous (d j)) (h : ℕ) :
    (polynomialJetIdeal g h).IsHomogeneous (MvPolynomial.homogeneousSubmodule σ R) := by
  apply Ideal.homogeneous_span
  rintro p ⟨j, L, _, rfl⟩
  exact ⟨d j - L.length, polynomialIteratedPDeriv_isHomogeneous L (g j) (d j) (hg j)⟩

end MixedFujita
