/-!
Successions of blow-ups of the vendored resolution library as birational models in the sense of
this project (step 7). For a succession of blow-ups of an integral locally Noetherian scheme whose
centres lie over a closed set Z not containing the generic point: the composite is an isomorphism
on the stalks at every point not over Z, the last stage is integral, the composite is dominant and
induces a bijection of function fields. If the last stage is regular and the base is locally of
finite type over a perfect field, it is smooth over the field, and it is smooth of the relative
dimension n as soon as a point where the composite is an isomorphism on stalks lies over an étale
chart with n coordinates. A generic point of the support of a closed subscheme with only normal
crossings has codimension one.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false

universe u

section Codimension

variable {X : Scheme.{u}}

/-- A generic point of the support of a closed subscheme with only normal crossings (Hironaka's
Definition 2) has codimension one: the maximal ideal of its local ring is a minimal prime of the
stalk of the ideal, hence generated by one parameter. -/
theorem coheight_eq_one_of_mem_genericPoints_of_isSncBoundary [IsLocallyNoetherian X]
    (E : X.IdealSheafData) (hE : E.IsSncBoundary) {η : X}
    (hη : η ∈ E.support.genericPoints) : Order.coheight η = 1 := by
  obtain ⟨m, z, hz, hmin, -⟩ := hE η (by rw [Scheme.IdealSheafData.support_bot]; trivial)
  have hmax : IsLocalRing.maximalIdeal (X.presheaf.stalk η) ∈
      (E.stalkIdeal η).minimalPrimes := by
    have h := Hironaka.Sequence.stalkIdeal_vanishingIdeal_mem_minimalPrimes E hη
      (specializes_refl η)
    rwa [Hironaka.BMO.stalkIdeal_vanishingIdeal_closure_self] at h
  obtain ⟨i, hi⟩ := hmin _ hmax
  -- the number of parameters is the codimension
  have hm : (m : ℕ∞) = Order.coheight η := by
    have h := hz.2
    rw [ringKrullDim_stalk_eq_coheight] at h
    exact_mod_cast h
  -- the maximal ideal is principal, so the codimension is at most one
  have hht : (IsLocalRing.maximalIdeal (X.presheaf.stalk η)).height ≤ 1 := by
    have hmem : IsLocalRing.maximalIdeal (X.presheaf.stalk η) ∈
        (Ideal.span {z i}).minimalPrimes := by
      rw [← hi, Ideal.minimalPrimes_eq_subsingleton_self]
      exact Set.mem_singleton _
    exact Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes (Ideal.span {z i}) _ hmem
  have hle : Order.coheight η ≤ 1 := by
    have h := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := X.presheaf.stalk η)
    rw [ringKrullDim_stalk_eq_coheight] at h
    have h' : (IsLocalRing.maximalIdeal (X.presheaf.stalk η)).height = Order.coheight η := by
      exact_mod_cast h
    rw [← h']
    exact hht
  have hge : (1 : ℕ∞) ≤ Order.coheight η := by
    rw [← hm]
    have h1 : 1 ≤ m := i.pos
    exact_mod_cast h1
  exact le_antisymm hle hge

end Codimension

section Sequences

variable {Y : Scheme.{u}}

/-- A succession of blow-ups whose centres lie over a closed set is an isomorphism on the stalks
at every point of the last stage not over that set. -/
theorem blowUpSequence_isIso_stalkMap_of_centers_over (S : Scheme.BlowUpSequence Y)
    (Z : Closeds Y)
    (hZ : ∀ (i : Fin S.length) (z : S.stage i.castSucc), z ∈ (S.center i).support →
      S.stageMap i.castSucc z ∈ (Z : Set Y))
    (t : S.last) (ht : S.composite t ∉ (Z : Set Y)) : IsIso (S.composite.stalkMap t) := by
  let U : Y.Opens := Z.compl
  have hiso : IsIso (S.composite ∣_ U) :=
    Hironaka.Sequence.isIso_composite_restrict_of_centers_disjoint S U fun i =>
      Set.disjoint_left.mpr fun z hz hzU => hzU (hZ i z hz)
  have h1 : IsIso ((S.composite ∣_ U).stalkMap ⟨t, ht⟩) := inferInstance
  exact ((MorphismProperty.isomorphisms _).arrow_mk_iso_iff
    (morphismRestrictStalkMap S.composite U ⟨t, ht⟩)).mp h1

/-- A point of the base not in a set over which all centres lie is the image of a point of the
last stage. -/
theorem blowUpSequence_exists_last_over (S : Scheme.BlowUpSequence Y) (Z : Closeds Y)
    (hZ : ∀ (i : Fin S.length) (z : S.stage i.castSucc), z ∈ (S.center i).support →
      S.stageMap i.castSucc z ∈ (Z : Set Y))
    (y : Y) (hy : y ∉ (Z : Set Y)) : ∃ t : S.last, S.composite t = y :=
  Hironaka.Resolution.exists_stage_point_over_of_forall_center_mem S (Z : Set Y) hZ y hy
    (Fin.last S.length)

variable [IsIntegral Y]

/-- The last stage of a succession of blow-ups of an integral locally Noetherian scheme whose
centres lie over a closed set not containing the generic point is integral: no centre is a whole
stage. -/
theorem blowUpSequence_isIntegral_last_of_centers_over [IsLocallyNoetherian Y]
    (S : Scheme.BlowUpSequence Y) (Z : Closeds Y)
    (hZ : ∀ (i : Fin S.length) (z : S.stage i.castSucc), z ∈ (S.center i).support →
      S.stageMap i.castSucc z ∈ (Z : Set Y))
    (hη : genericPoint Y ∉ (Z : Set Y)) : IsIntegral S.last := by
  refine Hironaka.Resolution.isIntegral_last_of_forall_support_ne_top S fun i htop => ?_
  obtain ⟨z, hz⟩ := Hironaka.Resolution.exists_stage_point_over_of_forall_center_mem S
    (Z : Set Y) hZ (genericPoint Y) hη i.castSucc
  have hzc : z ∈ (S.center i).support := by rw [htop]; trivial
  exact hη (hz ▸ hZ i z hzc)

/-- The composite of a succession of blow-ups whose centres lie over a closed set not containing
the generic point is dominant. -/
theorem blowUpSequence_isDominant_of_centers_over (S : Scheme.BlowUpSequence Y) (Z : Closeds Y)
    (hZ : ∀ (i : Fin S.length) (z : S.stage i.castSucc), z ∈ (S.center i).support →
      S.stageMap i.castSucc z ∈ (Z : Set Y))
    (hη : genericPoint Y ∉ (Z : Set Y)) : IsDominant S.composite := by
  obtain ⟨t, ht⟩ := blowUpSequence_exists_last_over S Z hZ (genericPoint Y) hη
  constructor
  rw [denseRange_iff_closure_range, ← Set.univ_subset_iff]
  have h : ({genericPoint Y} : Set Y) ⊆ Set.range S.composite := by
    rintro y rfl
    exact ⟨t, ht⟩
  simpa only [(genericPoint_spec Y).def] using closure_mono h

end Sequences

section FunctionFields

variable {X T : Scheme.{u}} [IsIntegral X] [IsIntegral T]

/-- A dominant morphism of integral schemes that is an isomorphism on the stalks at the generic
point induces a bijection of function fields. -/
theorem dominantFunctionFieldMap_bijective_of_isIso_stalkMap (ρ : T ⟶ X) [IsDominant ρ]
    (h : IsIso (ρ.stalkMap (genericPoint T))) :
    Function.Bijective (dominantFunctionFieldMap ρ).hom := by
  let e := X.presheaf.stalkCongr (Inseparable.of_eq (dominant_map_genericPoint ρ).symm)
  have : IsIso (dominantFunctionFieldMap ρ) := by
    change IsIso (e.hom ≫ ρ.stalkMap (genericPoint T))
    infer_instance
  exact ConcreteCategory.bijective_of_isIso (dominantFunctionFieldMap ρ)

end FunctionFields

section Smoothness

variable {K : Type u} [Field K] [PerfectField K]

/-- A regular last stage of a succession of blow-ups of a scheme locally of finite type over a
perfect field is smooth over the field. -/
theorem blowUpSequence_smooth_of_isRegular {Y : Scheme.{u}} [Y.Over (Spec (CommRingCat.of K))]
    [LocallyOfFiniteType (Y ↘ Spec (CommRingCat.of K))] (S : Scheme.BlowUpSequence Y)
    (hreg : IsRegular S.last) : Smooth (S.composite ≫ (Y ↘ Spec (CommRingCat.of K))) := by
  have hY : IsLocallyNoetherian Y :=
    LocallyOfFiniteType.isLocallyNoetherian (Y ↘ Spec (CommRingCat.of K))
  have hprop : IsProper S.composite := S.isProper_composite
  have hft : LocallyOfFiniteType (S.composite ≫ (Y ↘ Spec (CommRingCat.of K))) :=
    inferInstance
  exact (Scheme.smooth_iff_isRegular (S.composite ≫ (Y ↘ Spec (CommRingCat.of K)))).mpr hreg

/-- An integral scheme smooth over a perfect field is smooth of relative dimension n as soon as
some point of an open set, on which a universally closed morphism to a scheme locally of finite
type is an isomorphism on stalks, lies over an étale chart with n coordinates. -/
theorem smoothOfRelativeDimension_of_isIso_stalkMap_of_etaleChart {T Y : Scheme.{u}}
    [IsIntegral T] [T.Over (Spec (CommRingCat.of K))] [Y.Over (Spec (CommRingCat.of K))]
    [LocallyOfFiniteType (T ↘ Spec (CommRingCat.of K))]
    [LocallyOfFiniteType (Y ↘ Spec (CommRingCat.of K))]
    [Smooth (T ↘ Spec (CommRingCat.of K))] (ρ : T ⟶ Y) [UniversallyClosed ρ] {n : ℕ}
    (c : EtaleChart K Y n) (V : T.Opens) (hV : ∀ t ∈ V, IsIso (ρ.stalkMap t))
    (t₀ : T) (ht₀ : t₀ ∈ V) (ht₀c : ρ t₀ ∈ c.U) :
    SmoothOfRelativeDimension n (T ↘ Spec (CommRingCat.of K)) := by
  obtain ⟨m, hm⟩ := exists_smoothOfRelativeDimension_of_preconnectedSpace
    (T ↘ Spec (CommRingCat.of K))
  have hjac : JacobsonSpace T :=
    LocallyOfFiniteType.jacobsonSpace (T ↘ Spec (CommRingCat.of K))
  -- a closed point of the open set over the chart
  obtain ⟨t, ⟨htV, htc⟩, htcl⟩ := nonempty_inter_closedPoints
    (Z := (V : Set T) ∩ ρ ⁻¹' (c.U : Set Y)) ⟨t₀, ht₀, ht₀c⟩
    (V.isOpen.inter (c.U.isOpen.preimage ρ.continuous)).isLocallyClosed
  have htcl' : IsClosed ({t} : Set T) := htcl
  have hxcl : IsClosed ({ρ t} : Set Y) := by
    have h := ρ.isClosedMap _ htcl'
    rwa [Set.image_singleton] at h
  have h1 := Scheme.ringKrullDim_stalk_of_smoothOfRelativeDimension_of_isClosed
    (T ↘ Spec (CommRingCat.of K)) m htcl'
  have h2 := etaleChart_ringKrullDim_stalk c (ρ t) htc hxcl
  have hiso : IsIso (ρ.stalkMap t) := hV t htV
  have h3 : ringKrullDim (Y.presheaf.stalk (ρ t)) = ringKrullDim (T.presheaf.stalk t) :=
    ringKrullDim_eq_of_ringEquiv (asIso (ρ.stalkMap t)).commRingCatIsoToRingEquiv
  rw [h1, h2] at h3
  have hmn : n = m := by exact_mod_cast h3
  subst hmn
  exact hm

end Smoothness

end MixedFujita
