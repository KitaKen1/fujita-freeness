section Exponents

/-- Natural exponents e_i with e_i α_i = M ≥ 2 for the positive entries of a nonnegative
rational vector. -/
theorem exists_common_exponents {N : ℕ} (α : Fin N → ℚ) (hα : ∀ i, 0 ≤ α i) :
    ∃ (M : ℕ) (ex : Fin N → ℕ), 2 ≤ M ∧ (∀ i, 0 < α i → 1 ≤ ex i) ∧
      ∀ i, 0 < α i → ((ex i : ℕ) : ℝ) * ((α i : ℚ) : ℝ) = M := by
  classical
  set P : ℕ := ∏ i, (α i).den with hP
  have hP0 : 0 < P := Finset.prod_pos fun i _ => (α i).den_pos
  set a : Fin N → ℕ := fun i => (α i).num.toNat * (P / (α i).den) with ha
  have haq : ∀ i, ((a i : ℕ) : ℚ) = α i * P := by
    intro i
    have hden : (α i).den ∣ P := Finset.dvd_prod_of_mem _ (Finset.mem_univ i)
    have hnum : (0 : ℤ) ≤ (α i).num := Rat.num_nonneg.mpr (hα i)
    have hd0 : ((α i).den : ℚ) ≠ 0 := by exact_mod_cast (α i).den_pos.ne'
    have hPd : ((P / (α i).den : ℕ) : ℚ) * (α i).den = P := by
      exact_mod_cast Nat.div_mul_cancel hden
    simp only [ha, Nat.cast_mul]
    rw [show (((α i).num.toNat : ℕ) : ℚ) = ((α i).num : ℚ) by
      exact_mod_cast Int.toNat_of_nonneg hnum]
    conv_rhs => rw [← Rat.num_div_den (α i), ← hPd]
    field_simp
  have hapos : ∀ i, 0 < α i → 1 ≤ a i := by
    intro i hi
    have h1 : (0 : ℚ) < a i := by
      rw [haq i]
      exact mul_pos hi (by exact_mod_cast hP0)
    exact_mod_cast h1
  set S : Finset (Fin N) := Finset.univ.filter fun i => 0 < α i with hS
  set M : ℕ := ∏ i ∈ S, a i with hM
  have hM0 : 0 < M := Finset.prod_pos fun i hi => hapos i (Finset.mem_filter.mp hi).2
  refine ⟨2 * M, fun i => 2 * ((M / a i) * P), by omega, fun i hi => ?_, fun i hi => ?_⟩
  · have hdvd : a i ∣ M := Finset.dvd_prod_of_mem _ (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩)
    have hle : a i ≤ M := Nat.le_of_dvd hM0 hdvd
    have : 1 ≤ M / a i := (Nat.one_le_div_iff (by have := hapos i hi; omega)).mpr hle
    exact Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) (Nat.mul_ne_zero (by omega)
      (by omega)))
  · have hdvd : a i ∣ M := Finset.dvd_prod_of_mem _ (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩)
    have hq : (((M / a i) * P : ℕ) : ℚ) * α i = M := by
      have hdiv : ((M / a i : ℕ) : ℚ) * a i = M := by exact_mod_cast Nat.div_mul_cancel hdvd
      push_cast
      rw [mul_assoc, mul_comm (P : ℚ), ← haq i]
      exact hdiv
    have hq2 : ((2 * ((M / a i) * P) : ℕ) : ℚ) * α i = ((2 * M : ℕ) : ℚ) := by
      push_cast at hq ⊢
      rw [mul_assoc, hq]
    exact_mod_cast hq2

end Exponents

section Orders

variable {U : Scheme.{u}} [IsIntegral U] [IsLocallyNoetherian U]

/-- The order of a power of a nonzero rational function. -/
theorem scheme_ord_pow {a : U.functionField} (ha : a ≠ 0) (e : ℕ) (t : U) :
    U.ord (a ^ e) t = e * U.ord a t := by
  induction e with
  | zero => simp only [pow_zero, Nat.cast_zero, zero_mul, Scheme.ord_one]
  | succ e ih =>
    rw [pow_succ, Scheme.ord_mul (pow_ne_zero _ ha) ha, ih]
    push_cast
    ring

end Orders

variable {K : Type u} [Field K] {n : ℕ} {Y : Scheme.{u}} [IsIntegral Y]
  [Y.Over (Spec (CommRingCat.of K))]

/-- Along a prime divisor whose centre contains x, the coefficient of the pullback of the zero
divisor of a section is the order of the local coefficient of the section at x. -/
theorem cartierPullback_zeroDivisor_coefficient_eq_ord {U : Scheme.{u}} [IsIntegral U]
    [IsLocallyNoetherian U] (σ : U ⟶ Y) [IsDominant σ] (D : CartierDivisor Y) (x : Y)
    (f : Y.functionFieldˣ) (hf : D.IsLocalEquationAt x f) (s : Γ(D.sheaf, ⊤)) (hs : s ≠ 0) (e : U)
    (hx : x ∈ closure ({σ e} : Set Y)) :
    cartierCoefficient (cartierPullback σ (cartierSectionZeroDivisor D s hs)) e =
      U.ord ((dominantFunctionFieldMap σ).hom
        (algebraMap (Y.presheaf.stalk x) Y.functionField
          (cartierLocalCoefficient D x f hf s))) e := by
  have hspec : σ e ⤳ x := specializes_iff_mem_closure.mpr hx
  have hloc := isLocalEquationAt_of_specializes hspec
    (cartierSectionZeroDivisor_localEquation D s hs x f hf)
  rw [cartierCoefficient_eq_ord (cartierPullback_isLocalEquationAt σ _ e hloc), Units.coe_map,
    cartierLocalCoefficient_image, Units.val_mul, cartierSectionUnit_val]
  rfl

/-- The local coefficient of a linear combination of sections. -/
theorem cartierLocalCoefficient_sum_smul (D : CartierDivisor Y) (x : Y) (f : Y.functionFieldˣ)
    (hf : D.IsLocalEquationAt x f) {m : ℕ} (c : Fin m → K) (b : Fin m → Γ(D.sheaf, ⊤)) :
    cartierLocalCoefficient D x f hf (∑ k, c k • b k) =
      ∑ k, algebraMap K (Y.presheaf.stalk x) (c k) * cartierLocalCoefficient D x f hf (b k) := by
  rw [map_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [LinearMap.map_smul_of_tower, Algebra.smul_def]

/-- Lemma 3 at the fixed point x (§2.1), for the pair given by (c_Y, f_Y, d, D₀): for every
finite family of elements g_j(c) of the local ring at x depending polynomially on parameters
c ∈ K^ι, the set of parameters for which some prime divisor e of a smooth birational test model,
with centre containing x and positive log discrepancy, has ord_e(g_j(c)) ≥ M A(e) for every
nonzero g_j(c), that is lct_x(𝔞_c) ≤ 1/M for the ideal 𝔞_c generated by the g_j(c), is
Zariski closed. Only thresholds 1/M ≤ 1/2 are asked for, the range c < 1 of Lemma 3 in the
manuscript. It is a definition, used as a hypothesis; it is not proved here. -/
def IdealThresholdZariskiClosed (cY : EtaleChart K Y n) (fY : Y.functionFieldˣ) (d : ℕ)
    (D₀ : CartierDivisor Y) (x : Y) : Prop :=
  ∀ {ι J : Type} [Fintype ι] [Fintype J] (G : J → MvPolynomial ι (Y.presheaf.stalk x)) (M : ℕ),
    2 ≤ M → ∃ I : Ideal (MvPolynomial ι K),
      {c : ι → K | ∃ (U : Scheme.{u}) (_ : IsIntegral U) (_ : IsLocallyNoetherian U)
        (_ : U.Over (Spec (CommRingCat.of K)))
        (_ : SmoothOfRelativeDimension n (U ↘ Spec (CommRingCat.of K)))
        (σ : U ⟶ Y) (_ : IsDominant σ) (_ : σ.IsOver (Spec (CommRingCat.of K)))
        (hσ : Function.Bijective (dominantFunctionFieldAlgHom (K := K) σ))
        (cU : EtaleChart K U n) (e : CodimensionOnePoint U),
        x ∈ closure ({σ (e : U)} : Set Y) ∧
        0 < ((d : ℝ) + cartierCoefficient
          (logDiscrepancyDivisor n σ hσ cY fY d D₀ cU etaleCharts_cover) (e : U)) / d ∧
        ∀ j, MvPolynomial.eval (fun i => algebraMap K (Y.presheaf.stalk x) (c i)) (G j) ≠ 0 →
          (M : ℝ) * (((d : ℝ) + cartierCoefficient
            (logDiscrepancyDivisor n σ hσ cY fY d D₀ cU etaleCharts_cover) (e : U)) / d) ≤
            ((U.ord ((dominantFunctionFieldMap σ).hom
              (algebraMap (Y.presheaf.stalk x) Y.functionField
                (MvPolynomial.eval (fun i => algebraMap K (Y.presheaf.stalk x) (c i)) (G j))))
              (e : U) : ℤ) : ℝ)} = polynomialZeroSet I

/-- The closedness of the realization sets in the tuple at x follows from Lemma 3 at x. -/
theorem realizationSetsZariskiClosed_of_idealThreshold (cY : EtaleChart K Y n)
    (fY : Y.functionFieldˣ) (d : ℕ) (D₀ : CartierDivisor Y) (x : Y)
    (h : IdealThresholdZariskiClosed cY fY d D₀ x) (D : CartierDivisor Y) :
    RealizationSetsZariskiClosed cY fY d D₀ D x := by
  classical
  intro N m b α hα
  obtain ⟨f, hf⟩ := D.exists_isLocalEquationAt x
  set r : Fin m → Y.presheaf.stalk x := fun k => cartierLocalCoefficient D x f hf (b k) with hr
  obtain ⟨M, ex, hM2, hex1, hexM⟩ := exists_common_exponents α hα
  let G : {i : Fin N // 0 < α i} → MvPolynomial (Fin N × Fin m) (Y.presheaf.stalk x) :=
    fun i => (∑ k, MvPolynomial.X (i.1, k) * MvPolynomial.C (r k)) ^ (ex i.1)
  obtain ⟨I, hI⟩ := h G M hM2
  refine ⟨I, ?_⟩
  rw [← hI]
  ext c
  simp only [Set.mem_ofPred_eq]
  have heval : ∀ j : {i : Fin N // 0 < α i},
      MvPolynomial.eval (fun p => algebraMap K (Y.presheaf.stalk x) (c p)) (G j) =
        (cartierLocalCoefficient D x f hf (∑ k, c (j.1, k) • b k)) ^ (ex j.1) := by
    intro j
    rw [cartierLocalCoefficient_sum_smul]
    simp only [G, map_pow, map_sum, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_C, hr]
  have hne : ∀ j : {i : Fin N // 0 < α i},
      MvPolynomial.eval (fun p => algebraMap K (Y.presheaf.stalk x) (c p)) (G j) ≠ 0 ↔
        (∑ k, c (j.1, k) • b k) ≠ 0 := by
    intro j
    rw [heval, ← cartierLocalCoefficient_ne_zero_iff D x f hf]
    exact ⟨fun h0 h1 => h0 (by rw [h1, zero_pow (by have := hex1 j.1 j.2; omega)]),
      fun h0 => pow_ne_zero _ h0⟩
  have hord : ∀ {U : Scheme.{u}} [IsIntegral U] [IsLocallyNoetherian U] (σ : U ⟶ Y)
      [IsDominant σ] (e : U) (j : {i : Fin N // 0 < α i}) (hs : (∑ k, c (j.1, k) • b k) ≠ 0),
      U.ord ((dominantFunctionFieldMap σ).hom (algebraMap (Y.presheaf.stalk x) Y.functionField
        (MvPolynomial.eval (fun p => algebraMap K (Y.presheaf.stalk x) (c p)) (G j)))) e =
        (ex j.1 : ℤ) * U.ord ((dominantFunctionFieldMap σ).hom
          (algebraMap (Y.presheaf.stalk x) Y.functionField
            (cartierLocalCoefficient D x f hf (∑ k, c (j.1, k) • b k)))) e := by
    intro U _ _ σ _ e j hs
    have h0 : (dominantFunctionFieldMap σ).hom (algebraMap (Y.presheaf.stalk x) Y.functionField
        (cartierLocalCoefficient D x f hf (∑ k, c (j.1, k) • b k))) ≠ 0 := by
      rw [map_ne_zero_iff _ (dominantFunctionFieldMap σ).hom.injective]
      exact (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr
        ((cartierLocalCoefficient_ne_zero_iff D x f hf _).mpr hs)
    rw [heval, map_pow, map_pow, scheme_ord_pow h0]
  constructor
  · rintro ⟨U, h1, h2, h3, h4, σ, h5, h6, hσ, cU, e, hx, hA, hval⟩
    refine ⟨U, h1, h2, h3, h4, σ, h5, h6, hσ, cU, e, hx, hA, fun j hj => ?_⟩
    have hs := (hne j).mp hj
    have hv := hval j.1 hs
    beta_reduce at hv
    rw [cartierPullback_zeroDivisor_coefficient_eq_ord σ D x f hf _ hs (e : U) hx] at hv
    rw [hord σ (e : U) j hs, ← hexM j.1 j.2]
    push_cast
    have hex0 : (0 : ℝ) ≤ (ex j.1 : ℝ) := Nat.cast_nonneg _
    nlinarith
  · rintro ⟨U, h1, h2, h3, h4, σ, h5, h6, hσ, cU, e, hx, hA, hval⟩
    refine ⟨U, h1, h2, h3, h4, σ, h5, h6, hσ, cU, e, hx, hA, fun i hs => ?_⟩
    beta_reduce
    by_cases hαi : 0 < α i
    · have hv := hval ⟨i, hαi⟩ ((hne ⟨i, hαi⟩).mpr hs)
      rw [hord σ (e : U) ⟨i, hαi⟩ hs, ← hexM i hαi] at hv
      rw [cartierPullback_zeroDivisor_coefficient_eq_ord σ D x f hf _ hs (e : U) hx]
      have hex0 : (0 : ℝ) < (ex i : ℝ) := by exact_mod_cast hex1 i hαi
      push_cast at hv
      nlinarith
    · have h0 : α i = 0 := le_antisymm (not_lt.mp hαi) (hα i)
      rw [h0, Rat.cast_zero, zero_mul]
      exact_mod_cast cartierCoefficient_nonneg_of_isEffective _
        (cartierPullback_isEffective σ _ (cartierSectionZeroDivisor_isEffective _ _ hs)) _

/-- F1 from the sum form of the Kawamata–Viehweg statement, Lemma 3 at the closed points of the
smooth variety with zero boundary (which gives the closedness of the realization sets in the
tuple for every ample sum and degree), the closedness of the realization sets in the point,
Lemma 3 in its degeneration form and the local statement with the fixed part. -/
theorem mixedFujitaFreeness_of_kawamataViehwegSum_of_lemmaThree_of_thresholdBaseModel
    (hKV : ∀ (K : Type u) [Field K] [IsAlgClosed K] [CharZero K] (n : ℕ),
      KawamataViehwegVanishingSNCSum K n)
    (hlct : ∀ (K : Type u) [Field K] [IsAlgClosed K] [CharZero K] [Uncountable K]
      (X : Scheme.{u}) [IsIntegral X] [X.Over (Spec (CommRingCat.of K))] (n : ℕ)
      [SmoothOfRelativeDimension n (X ↘ Spec (CommRingCat.of K))] (c₀ : EtaleChart K X n)
      (x : X), IsClosed ({x} : Set X) →
      IdealThresholdZariskiClosed c₀ (1 : X.functionFieldˣ) 1
        (1 • (smoothCanonicalDivisor c₀ + principalCartierDivisor X (1 : X.functionFieldˣ))) x)
    (hpt : ∀ (K : Type u) [Field K] [IsAlgClosed K] [CharZero K] [Uncountable K] (X : Scheme.{u})
      [IsIntegral X] [X.Over (Spec (CommRingCat.of K))] (n : ℕ)
      [SmoothOfRelativeDimension n (X ↘ Spec (CommRingCat.of K))] (c₀ : EtaleChart K X n)
      (A : CartierDivisor X), CartierIsAmpleSum K A → ∀ x : X, IsClosed ({x} : Set X) →
      ∀ᶠ j : ℕ in atTop, ∀ α : Fin (Module.finrank K Γ((j • A).sheaf, ⊤)) → ℚ,
        IsClosed {y : X | (fun i => (α i : ℝ)) ∈ sncWeightNormalizedProfiles c₀
          (1 : X.functionFieldˣ) 1
          (1 • (smoothCanonicalDivisor c₀ + principalCartierDivisor X (1 : X.functionFieldˣ)))
          (j • A) (Module.finrank K Γ((j • A).sheaf, ⊤)) y})
    (hdeg : ∀ (K : Type u) [Field K] [IsAlgClosed K] [CharZero K] [DecidableEq K],
      ThresholdDegenerationStatement K)
    (hmodel : ThresholdBaseModelStatement.{u}) :
    MixedFujitaFreeness.{u} :=
  mixedFujitaFreeness_of_kawamataViehwegSum_of_closed_of_thresholdBaseModel hKV
    (fun K _ _ _ _ X _ _ n _ c₀ A hA x hx =>
      ⟨Filter.Eventually.of_forall fun j => realizationSetsZariskiClosed_of_idealThreshold c₀ 1 1 _
        x (hlct K X n c₀ x hx) (j • A), hpt K X n c₀ A hA x hx⟩)
    hdeg hmodel

end MixedFujita
