module

public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.Algebra.Module.Submodule.Equiv
public import Mathlib.Algebra.GroupWithZero.NonZeroDivisors
public import Mathlib.LinearAlgebra.TensorProduct.RightExactness

/-!
An actual principal ideal generated by a regular element is linearly
equivalent to the ambient ring, with the equivalence given by multiplication.
This is the local rank-one ideal input for Cartier geometry; no flatness of
the quotient over a coefficient ring is asserted.
-/

@[expose] public section

namespace MixedFujita

variable {R : Type*} [CommRing R]

theorem regular_multiplication_injective (f : R) (hf : f ∈ nonZeroDivisors R) :
    Function.Injective (LinearMap.mul R R f) := by
  intro x y hxy
  apply sub_eq_zero.mp
  apply (mem_nonZeroDivisors_iff_left.mp hf) (x - y)
  change f * x = f * y at hxy
  rw [mul_sub, hxy, sub_self]

noncomputable def regularPrincipalIdealEquiv (f : R) (hf : f ∈ nonZeroDivisors R) :
    R ≃ₗ[R] Ideal.span {f} :=
  (LinearEquiv.ofInjective (LinearMap.mul R R f) (regular_multiplication_injective f hf)).trans
    (LinearEquiv.ofEq _ _ (Ideal.range_mul' f))

theorem regularPrincipalIdealEquiv_apply (f : R) (hf : f ∈ nonZeroDivisors R) (r : R) :
    (regularPrincipalIdealEquiv f hf r : R) = f * r := rfl

theorem regularPrincipalIdealEquiv_one (f : R) (hf : f ∈ nonZeroDivisors R) :
    (regularPrincipalIdealEquiv f hf 1 : R) = f := by
  rw [regularPrincipalIdealEquiv_apply, mul_one]

theorem regularPrincipalIdeal_unique_factor (f : R) (hf : f ∈ nonZeroDivisors R)
    (z : Ideal.span ({f} : Set R)) : ∃! r : R, f * r = (z : R) := by
  refine ⟨(regularPrincipalIdealEquiv f hf).symm z, ?_, ?_⟩
  · exact congrArg Subtype.val ((regularPrincipalIdealEquiv f hf).apply_symm_apply z)
  · intro r hr
    apply regular_multiplication_injective f hf
    exact hr.trans (congrArg Subtype.val
      ((regularPrincipalIdealEquiv f hf).apply_symm_apply z)).symm

theorem principalIdeal_quotient_sequence_exact (f : R) :
    Function.Exact (LinearMap.mul R R f) (Ideal.span ({f} : Set R)).mkQ := by
  rw [LinearMap.exact_iff, Submodule.ker_mkQ, Ideal.range_mul']

theorem principalIdeal_quotient_sequence_tensor_exact (f : R)
    (M : Type*) [AddCommGroup M] [Module R M] :
    Function.Exact ((LinearMap.mul R R f).rTensor M)
      ((Ideal.span ({f} : Set R)).mkQ.rTensor M) :=
  rTensor_exact M (principalIdeal_quotient_sequence_exact f)
    (Submodule.mkQ_surjective _)

end MixedFujita
