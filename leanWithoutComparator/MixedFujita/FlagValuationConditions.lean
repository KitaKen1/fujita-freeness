module

public import Mathlib.RingTheory.Valuation.Basic
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.Algebra.Order.AddGroupWithTop
public import Mathlib.Basic.Real.Basic
public import Mathlib.Order.Interval.Set.Basic

/-!
The algebraic core of §2.2. Let v be an additive valuation with values in ℝ ∪ {∞}, nonnegative
on a K-algebra R (a valuation centred at x on the local ring at x), s_1, ..., s_N sections mapped
to R, F_i the span of s_1, ..., s_i (the flag) and b_i the ideal of R generated by F_i. For
decreasing thresholds c_i, the bounds v(s_i) ≥ c_i are equivalent to v(b_i) ≥ c_i for every i, so
the condition depends only on the flag, not on the adapted basis. If α is decreasing and
nonnegative and M = e_i α_i with e_i ∈ ℕ for α_i > 0, the bounds v(s_i) ≥ α_i A are equivalent
to the single bound v(a_α) ≥ M A for the ideal a_α = Σ_{α_i > 0} b_i^{e_i}, that is, to
A / v(a_α) ≤ 1/M: the threshold condition lct_x(a_α) ≤ 1/M of §2.2 once the threshold is
computed by a valuation.
-/

@[expose] public section

namespace MixedFujita

variable {R : Type*} [CommRing R] (v : AddValuation R (WithTop ℝ))

/-- A lower bound on the generators bounds every element of the ideal. -/
theorem addValuation_le_of_mem_span (hv : ∀ r, 0 ≤ v r) {S : Set R} {c : WithTop ℝ}
    (hS : ∀ g ∈ S, c ≤ v g) {g : R} (hg : g ∈ Ideal.span S) : c ≤ v g := by
  induction hg using Submodule.span_induction with
  | mem x hx => exact hS x hx
  | zero => rw [v.map_zero]; exact le_top
  | add x y _ _ hx hy => exact v.map_le_add hx hy
  | smul a x _ hx =>
    rw [smul_eq_mul, v.map_mul]
    calc c = 0 + c := (zero_add c).symm
      _ ≤ v a + v x := add_le_add (hv a) hx

/-- A lower bound c on an ideal gives the lower bound n • c on its n-th power. -/
theorem addValuation_nsmul_le_of_mem_pow (hv : ∀ r, 0 ≤ v r) {I : Ideal R} {c : WithTop ℝ}
    (hI : ∀ g ∈ I, c ≤ v g) : ∀ (n : ℕ) {g : R}, g ∈ I ^ n → n • c ≤ v g := by
  intro n
  induction n with
  | zero =>
    intro g _
    rw [zero_smul]
    exact hv g
  | succ n ih =>
    intro g hg
    rw [Submodule.pow_succ] at hg
    refine Submodule.mul_induction_on hg (fun a ha b hb => ?_) (fun x y hx hy => v.map_le_add hx hy)
    rw [v.map_mul, succ_nsmul]
    exact add_le_add (ih ha) (hI b hb)

theorem withTop_le_of_nsmul_le {n : ℕ} (hn : n ≠ 0) {t : ℝ} {x : WithTop ℝ}
    (h : (t : WithTop ℝ) ≤ n • x) : ((t / n : ℝ) : WithTop ℝ) ≤ x := by
  induction x using WithTop.recTopCoe with
  | top => exact le_top
  | coe r =>
    rw [← WithTop.coe_nsmul, WithTop.coe_le_coe, nsmul_eq_mul] at h
    rw [WithTop.coe_le_coe, div_le_iff₀ (by positivity : (0 : ℝ) < n), mul_comm]
    exact h

theorem withTop_nsmul_div_cast {n : ℕ} (hn : n ≠ 0) (t : ℝ) :
    n • ((t / n : ℝ) : WithTop ℝ) = (t : WithTop ℝ) := by
  rw [← WithTop.coe_nsmul, nsmul_eq_mul, mul_div_cancel₀ t (by exact_mod_cast hn)]

/-- §2.2: a lower bound t for a sum of powers of ideals is the same as the lower bounds t/e_i for
the ideals. -/
theorem addValuation_le_iSup_pow_iff (hv : ∀ r, 0 ≤ v r) {ι : Type*} (b : ι → Ideal R)
    (e : ι → ℕ) (he : ∀ i, e i ≠ 0) (t : ℝ) :
    (∀ g ∈ ⨆ i, b i ^ e i, (t : WithTop ℝ) ≤ v g) ↔
      ∀ i, ∀ g ∈ b i, ((t / e i : ℝ) : WithTop ℝ) ≤ v g := by
  constructor
  · intro h i g hg
    have hmem : g ^ e i ∈ ⨆ i, b i ^ e i :=
      (le_iSup (fun i => b i ^ e i) i) (Ideal.pow_mem_pow hg (e i))
    have hle := h _ hmem
    rw [v.map_pow] at hle
    exact withTop_le_of_nsmul_le (he i) hle
  · intro h g hg
    refine Submodule.iSup_induction (fun i => b i ^ e i)
      (motive := fun g => (t : WithTop ℝ) ≤ v g) hg (fun i x hx => ?_) ?_
      (fun x y hx hy => v.map_le_add hx hy)
    · have hx' := addValuation_nsmul_le_of_mem_pow v hv (h i) (e i) hx
      rwa [withTop_nsmul_div_cast (he i)] at hx'
    · rw [v.map_zero]
      exact le_top

section Flag

variable {K M : Type*} [Field K] [Algebra K R] [AddCommGroup M] [Module K M]

/-- The flag ideal b_i: the ideal generated by the images of s_1, ..., s_i. -/
def flagIdeal {N : ℕ} (φ : M →ₗ[K] R) (s : Fin N → M) (i : Fin N) : Ideal R :=
  Ideal.span (φ '' (Submodule.span K (s '' Set.Iic i) : Set M))

theorem mem_flagIdeal_self {N : ℕ} (φ : M →ₗ[K] R) (s : Fin N → M) (i : Fin N) :
    φ (s i) ∈ flagIdeal φ s i :=
  Ideal.subset_span ⟨s i, Submodule.subset_span ⟨i, Set.mem_Iic.mpr le_rfl, rfl⟩, rfl⟩

/-- §2.2: for decreasing thresholds, the bounds on an adapted basis are the bounds on the flag
ideals; the condition depends only on the flag. -/
theorem flag_basis_iff_flagIdeal (hv : ∀ r, 0 ≤ v r) {N : ℕ} (φ : M →ₗ[K] R) (s : Fin N → M)
    {c : Fin N → ℝ} (hc : Antitone c) :
    (∀ i, (c i : WithTop ℝ) ≤ v (φ (s i))) ↔
      ∀ i, ∀ g ∈ flagIdeal φ s i, (c i : WithTop ℝ) ≤ v g := by
  constructor
  · intro h i g hg
    apply addValuation_le_of_mem_span v hv _ hg
    rintro _ ⟨f, hf, rfl⟩
    induction hf using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨k, hk, rfl⟩ := hx
      exact (WithTop.coe_le_coe.mpr (hc (Set.mem_Iic.mp hk))).trans (h k)
    | zero => rw [map_zero, v.map_zero]; exact le_top
    | add x y _ _ hx hy => rw [map_add]; exact v.map_le_add hx hy
    | smul a x _ hx =>
      rw [map_smul, Algebra.smul_def, v.map_mul]
      calc (c i : WithTop ℝ) = 0 + c i := (zero_add _).symm
        _ ≤ v (algebraMap K R a) + v (φ x) := add_le_add (hv _) hx
  · intro h i
    exact h i _ (mem_flagIdeal_self φ s i)

/-- §2.2: for decreasing nonnegative α with M = e_i α_i (e_i ∈ ℕ) whenever α_i > 0, the bounds
v(s_i) ≥ α_i A on an adapted basis are equivalent to the single bound v(a_α) ≥ M A for the ideal
a_α = Σ_{α_i > 0} b_i^{e_i}. -/
theorem flag_basis_iff_sumPowIdeal (hv : ∀ r, 0 ≤ v r) {N : ℕ} (φ : M →ₗ[K] R)
    (s : Fin N → M) {α : Fin N → ℝ} (hα : Antitone α) (hα0 : ∀ i, 0 ≤ α i) {A : ℝ}
    (hA : 0 ≤ A) {Mnat : ℕ} (hM : 0 < Mnat) (e : {i // 0 < α i} → ℕ)
    (he : ∀ i, (e i : ℝ) * α i = Mnat) :
    (∀ i, ((α i * A : ℝ) : WithTop ℝ) ≤ v (φ (s i))) ↔
      ∀ g ∈ ⨆ i : {i // 0 < α i}, flagIdeal φ s i ^ e i,
        (((Mnat : ℝ) * A : ℝ) : WithTop ℝ) ≤ v g := by
  have he0 : ∀ i, e i ≠ 0 := by
    intro i h0
    have h := he i
    rw [h0, Nat.cast_zero, zero_mul] at h
    exact (Nat.cast_ne_zero.mpr hM.ne') h.symm
  have hdiv : ∀ i : {i // 0 < α i}, (Mnat : ℝ) * A / e i = α i * A := by
    intro i
    have hei : (e i : ℝ) ≠ 0 := by exact_mod_cast he0 i
    rw [← he i, mul_assoc, mul_div_cancel_left₀ _ hei]
  have hanti : Antitone fun i => α i * A := fun i j hij => mul_le_mul_of_nonneg_right (hα hij) hA
  rw [addValuation_le_iSup_pow_iff v hv _ e he0]
  simp only [hdiv]
  constructor
  · intro h i g hg
    exact (flag_basis_iff_flagIdeal v hv φ s hanti).mp h i g hg
  · intro h i
    by_cases hi : 0 < α i
    · exact h ⟨i, hi⟩ _ (mem_flagIdeal_self φ s i)
    · have h0 : α i = 0 := le_antisymm (not_lt.mp hi) (hα0 i)
      rw [h0, zero_mul, WithTop.coe_zero]
      exact hv _

end Flag

end MixedFujita
