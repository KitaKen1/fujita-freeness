module

public import MixedFujita.ProjectiveClosureSmooth
public import MixedFujita.ClosureBaseChangeAlgebra

/-!
The closure over a large finitely generated subring is a model (step 10, R4-3).

Let `T` be a closed subscheme of projective space over a field `K`. There is a finitely generated
subring `A₀ ⊆ K` such that for every subring `A ⊇ A₀` the square
```
T   ──→ T_A
│        │
Spec K → Spec A
```
with `T_A` the closure of `T` in projective space over `A` (check 507) is a pullback:
`T = T_A ×_A K` (`exists_fg_forall_isPullback_projectiveClosure`).

On the `k`-th chart, the functions of `T` are `K[X]/I_k`, with `I_k` finitely generated (the
polynomial ring is noetherian); once `A` contains the coefficients of the generators, the ring of
the chart of `T_A` (the image of `A[X]`) satisfies `K ⊗[A] B_k = C_k` (check 509), so the affine
square of the charts is a pullback (`isPullback_projectiveClosure_chart`). The charts of `T_A` are
the images of `Spec B_k`, and the squares glue (Mathlib's `Scheme.isPullback_of_openCover`).
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite Limits

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

variable {n : ℕ}

/-- The inclusion of an affine open followed by a map to a spectrum is the spectrum of the map
on functions over the open. -/
theorem fromSpec_comp_eq_SpecMap {X : Scheme.{u}} {R : CommRingCat.{u}} (q : X ⟶ Spec R)
    {V : X.Opens} (hV : IsAffineOpen V) :
    hV.fromSpec ≫ q = Spec.map ((Scheme.ΓSpecIso R).inv ≫ q.appLE ⊤ V le_top) := by
  rw [Spec.map_comp, ← Scheme.isoSpec_Spec_inv, ← IsAffineOpen.fromSpec_top]
  exact (IsAffineOpen.SpecMap_appLE_fromSpec q (isAffineOpen_top _) hV le_top).symm

section Closure

variable {K : Type u} [Field K] {T : Scheme.{u}} (π : T ⟶ Spec (CommRingCat.of K))
  (e : T ⟶ polynomialProjectiveScheme n K)

/-- **The charts of the closure are base changes.** If the kernel of the `k`-th chart map of `T` is
generated by polynomials with coefficients in `A`, the affine square of the `k`-th charts of `T`
and of its closure over `A` is a pullback. -/
theorem isPullback_projectiveClosure_chart [IsClosedImmersion e]
    (he : e ≫ polynomialProjectiveToBase n K = π) (A : Subalgebra ℤ K) (k : Fin n)
    (hker : RingHom.ker (projectiveChartRingMap e k) ≤
      Ideal.span (MvPolynomial.map (algebraMap A K) ''
        {p | projectiveChartRingMap e k (MvPolynomial.map (algebraMap A K) p) = 0})) :
    IsPullback
      (Spec.map ((projectiveClosureMap (algebraMap A K) e).appLE _ _
        (projectiveClosureMap_preimage_chart (algebraMap A K) e k).ge))
      (Spec.map ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
        π.appLE ⊤ (projectivePullbackCoordinateOpen e k) le_top))
      (Spec.map ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
        (projectiveClosureι (algebraMap A K) e ≫ polynomialProjectiveToBase n A).appLE ⊤
          (projectivePullbackCoordinateOpen (projectiveClosureι (algebraMap A K) e) k) le_top))
      (Spec.map (CommRingCat.ofHom (algebraMap A K))) := by
  let c := algebraMap A K
  let ι := projectiveClosureι c e
  let q := ι ≫ polynomialProjectiveToBase n A
  let B := Γ(projectiveClosure c e, projectivePullbackCoordinateOpen ι k)
  let C := Γ(T, projectivePullbackCoordinateOpen e k)
  let gA : CommRingCat.of A ⟶ B :=
    (Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ q.appLE ⊤ _ le_top
  let gK : CommRingCat.of K ⟶ C :=
    (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ π.appLE ⊤ _ le_top
  let ρ : B ⟶ C := (projectiveClosureMap c e).appLE _ _
    (projectiveClosureMap_preimage_chart c e k).ge
  let _ : Algebra A B := gA.hom.toAlgebra
  let _ : Algebra K C := gK.hom.toAlgebra
  let _ : Algebra B C := ρ.hom.toAlgebra
  let _ : Algebra A C := (gK.hom.comp c).toAlgebra
  have : IsScalarTower A K C := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hCA : ∀ r, projectiveChartRingMap ι k (MvPolynomial.C r) = gA.hom r :=
    fun r => projectiveChartRingMap_C ι q rfl k r
  have hCK : ∀ r, projectiveChartRingMap e k (MvPolynomial.C r) = gK.hom r :=
    fun r => projectiveChartRingMap_C e π he k r
  have hcompA : ∀ a : A, ρ.hom (gA.hom a) = gK.hom (c a) := by
    intro a
    rw [← hCA, ← hCK]
    exact (closureChartMap_projectiveChartRingMap c e k (MvPolynomial.C a)).trans
      (by rw [MvPolynomial.map_C])
  have : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq fun a => (hcompA a).symm
  let ψ : MvPolynomial {j : Fin n // j ≠ k} A →ₐ[A] B :=
    { projectiveChartRingMap ι k with commutes' := hCA }
  let φ : MvPolynomial {j : Fin n // j ≠ k} K →ₐ[K] C :=
    { projectiveChartRingMap e k with commutes' := hCK }
  have := polynomialProjectiveCoefficientMap_isAffineHom (n := n) c
  have hpush : Algebra.IsPushout A K B C :=
    isPushout_of_mvPolynomial_ker ψ (projectiveChartRingMap_surjective ι k) φ
      (projectiveChartRingMap_surjective e k) (closureChartMap_injective c e k)
      (fun p => closureChartMap_projectiveChartRingMap c e k p) hker
  exact isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_of_isPushout A K B C).flip

/-- **The closure over a large finitely generated subring is a model.** For a closed subscheme
`T` of projective space over a field `K`, there is a finitely generated subring `A₀ ⊆ K` such that
for every subring `A ⊇ A₀`, `T = T_A ×_A K` for the closure `T_A` of `T` over `A`. -/
theorem exists_fg_forall_isPullback_projectiveClosure [IsClosedImmersion e]
    (he : e ≫ polynomialProjectiveToBase n K = π) :
    ∃ A₀ : Subalgebra ℤ K, A₀.FG ∧ ∀ A : Subalgebra ℤ K, A₀ ≤ A →
      IsPullback (projectiveClosureMap (algebraMap A K) e) π
        (projectiveClosureι (algebraMap A K) e ≫ polynomialProjectiveToBase n A)
        (Spec.map (CommRingCat.ofHom (algebraMap A K))) := by
  classical
  have hfg : ∀ k : Fin n, ∃ G : Finset (MvPolynomial {j : Fin n // j ≠ k} K),
      Ideal.span (G : Set _) = RingHom.ker (projectiveChartRingMap e k) :=
    fun k => IsNoetherian.noetherian (RingHom.ker (projectiveChartRingMap e k))
  choose G hG using hfg
  let U : Finset K := Finset.univ.biUnion fun k => (G k).biUnion fun g => g.coeffs
  refine ⟨Algebra.adjoin ℤ (U : Set K), ⟨U, rfl⟩, fun A hA => ?_⟩
  let c := algebraMap A K
  let ι := projectiveClosureι c e
  let q := ι ≫ polynomialProjectiveToBase n A
  have hW : ∀ k, IsAffineOpen (projectivePullbackCoordinateOpen ι k) :=
    fun k => projectivePullbackCoordinateOpen_isAffineOpen_of_isClosedImmersion ι k
  have hV : ∀ k, IsAffineOpen (projectivePullbackCoordinateOpen e k) :=
    fun k => projectivePullbackCoordinateOpen_isAffineOpen_of_isClosedImmersion e k
  have hker : ∀ k, RingHom.ker (projectiveChartRingMap e k) ≤
      Ideal.span (MvPolynomial.map c ''
        {p | projectiveChartRingMap e k (MvPolynomial.map c p) = 0}) := by
    intro k
    rw [← hG k, Ideal.span_le]
    intro g hg
    have hcoef : (g.coeffs : Set K) ⊆ Set.range c := by
      intro z hz
      have hzA : z ∈ A := hA (Algebra.subset_adjoin (Finset.mem_coe.2 (Finset.mem_biUnion.2
        ⟨k, Finset.mem_univ _, Finset.mem_biUnion.2 ⟨g, hg, hz⟩⟩)))
      exact ⟨⟨z, hzA⟩, rfl⟩
    obtain ⟨g', rfl⟩ := MvPolynomial.mem_range_map_iff_coeffs_subset.2 hcoef
    refine Ideal.subset_span ⟨g', ?_, rfl⟩
    have h0 : MvPolynomial.map c g' ∈ RingHom.ker (projectiveChartRingMap e k) := by
      rw [← hG k]
      exact Ideal.subset_span hg
    exact h0
  let 𝒰 : (projectiveClosure c e).OpenCover :=
    Scheme.Cover.mkOfCovers (Fin n)
      (fun k => Spec Γ(projectiveClosure c e, projectivePullbackCoordinateOpen ι k))
      (fun k => (hW k).fromSpec) (fun x => by
        have hx : x ∈ (⨆ k, projectivePullbackCoordinateOpen ι k) := by
          rw [iSup_projectivePullbackCoordinateOpen]
          trivial
        obtain ⟨k, hk⟩ := Opens.mem_iSup.1 hx
        have hk' : x ∈ Set.range (hW k).fromSpec := by
          rw [(hW k).range_fromSpec]
          exact hk
        obtain ⟨y, hy⟩ := hk'
        exact ⟨k, y, hy⟩)
  refine Scheme.isPullback_of_openCover (projectiveClosureMap c e) π q
    (Spec.map (CommRingCat.ofHom c)) 𝒰 fun k => ?_
  have hM := isPullback_projectiveClosure_chart π e he A k (hker k)
  have hN : IsPullback (Spec.map ((projectiveClosureMap c e).appLE _ _
      (projectiveClosureMap_preimage_chart c e k).ge)) (hV k).fromSpec (hW k).fromSpec
      (projectiveClosureMap c e) :=
    IsOpenImmersion.isPullback _ _ _ _
      (IsAffineOpen.SpecMap_appLE_fromSpec _ (hW k) (hV k) _).symm
      (by rw [IsAffineOpen.opensRange_fromSpec, IsAffineOpen.opensRange_fromSpec]
          exact projectiveClosureMap_preimage_chart c e k)
  refine hM.of_iso hN.flip.isoPullback (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
  · rw [Iso.refl_hom, Category.comp_id]
    exact hN.flip.isoPullback_hom_snd.symm
  · rw [Iso.refl_hom, Category.comp_id]
    change _ = hN.flip.isoPullback.hom ≫ pullback.fst _ _ ≫ π
    rw [← Category.assoc, hN.flip.isoPullback_hom_fst, fromSpec_comp_eq_SpecMap]
  · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
    change _ = (hW k).fromSpec ≫ q
    rw [fromSpec_comp_eq_SpecMap]
  · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]

end Closure

end MixedFujita
