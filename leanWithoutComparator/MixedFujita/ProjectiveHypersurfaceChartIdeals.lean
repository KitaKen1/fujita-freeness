module

public import MixedFujita.ProjectiveEquationCartier
public import MixedFujita.CartierIdealIdentification

/-!
The actual global hypersurface ideal on a coordinate affine open is
generated by the actual structure-sheaf equation f/X_i^d.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

namespace MixedFujita

attribute [local instance] MvPolynomial.gradedAlgebra

variable {n : ℕ} (R : Type*) [CommRing R]

theorem projectiveHypersurfaceIdealSheaf_coordinate_ideal (k : Fin n) (d : ℕ)
    (f : MvPolynomial (Fin n) R) (hf : f.IsHomogeneous d) :
    (projectiveHypersurfaceIdealSheaf f d hf).ideal (polynomialProjectiveCoordinateAffineOpen R k) =
      Ideal.span ({projectiveHomogeneousEquation R k d f hf} :
        Set Γ(polynomialProjectiveScheme n R,
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin n) R) (MvPolynomial.X k))) := by
  let U := Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin n) R) (MvPolynomial.X k)
  let e := polynomialProjectiveCoordinateChartIso n R k
  have : IsAffine U.toScheme := polynomialProjectiveCoordinateChart_isAffine R k
  have : IsAffine (polynomialProjectiveCoordinateChart n R k) :=
    polynomialProjectiveCoordinateChart_isAffine R k
  have h := congrArg (fun J : U.toScheme.IdealSheafData =>
      J.ideal ⟨⊤, isAffineOpen_top U.toScheme⟩)
    (homogeneousProjectiveIdealSheaf_restrict ({()} : Finset Unit)
      (fun _ => f) d (fun _ _ => hf) k)
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
    projectiveChartIdealSheaf, specIdealSheaf, affineIdealSheaf_comap] at h
  simp [Scheme.IdealSheafData.ofIdealTop_ideal, Scheme.Opens.ι_appIso] at h
  dsimp only [U, polynomialProjectiveCoordinateChart, polynomialProjectiveScheme] at h
  erw [CommRingCat.hom_id, Ideal.comap_id, Ideal.map_id] at h
  change (homogeneousProjectiveIdealSheaf ({()} : Finset Unit) (fun _ => f) d
      (fun _ _ => hf)).ideal
        ⟨U.ι ''ᵁ ⊤, (isAffineOpen_top U.toScheme).image_of_isOpenImmersion U.ι⟩ =
    Ideal.map e.hom.appTop.hom (Ideal.map
      (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin n) R) (MvPolynomial.X k)))).inv.hom
      (homogeneousChartLocalizationIdeal ({()} : Finset Unit) (fun _ => f) d
        (fun _ _ => hf) k)) at h
  apply_fun Ideal.map U.topIso.hom.hom at h
  have hleft : Ideal.map U.topIso.hom.hom
      ((homogeneousProjectiveIdealSheaf ({()} : Finset Unit) (fun _ => f) d
        (fun _ _ => hf)).ideal
          ⟨U.ι ''ᵁ ⊤, (isAffineOpen_top U.toScheme).image_of_isOpenImmersion U.ι⟩) =
      (projectiveHypersurfaceIdealSheaf f d hf).ideal
        (polynomialProjectiveCoordinateAffineOpen R k) := by
    simpa only [Scheme.Opens.topIso_hom, projectiveHypersurfaceIdealSheaf] using
      (idealSheaf_map_eqToHom (polynomialProjectiveScheme n R)
        (homogeneousProjectiveIdealSheaf ({()} : Finset Unit) (fun _ => f) d
          (fun _ _ => hf))
        ⟨U.ι ''ᵁ ⊤, (isAffineOpen_top U.toScheme).image_of_isOpenImmersion U.ι⟩
        (polynomialProjectiveCoordinateAffineOpen R k) U.ι_image_top)
  rw [hleft] at h
  have hm : (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin n) R) (MvPolynomial.X k)))).inv ≫
      e.hom.appTop ≫ U.topIso.hom = Proj.awayToSection _ (MvPolynomial.X k) := by
    dsimp only [e, polynomialProjectiveCoordinateChartIso,
      polynomialProjectiveCoordinateChart, Scheme.Hom.appTop]
    rw [Proj.basicOpenIsoSpec_hom, Proj.basicOpenToSpec_app_top]
    simp only [Category.assoc, Iso.inv_hom_id_assoc]
    change Proj.awayToSection _ (MvPolynomial.X k) ≫ U.topIso.inv ≫ U.topIso.hom = _
    rw [Iso.inv_hom_id, Category.comp_id]
  rw [Ideal.map_map, Ideal.map_map] at h
  have hhom : (U.topIso.hom.hom.comp e.hom.appTop.hom).comp
      (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin n) R) (MvPolynomial.X k)))).inv.hom =
      (Proj.awayToSection _ (MvPolynomial.X k)).hom := by
    exact congrArg CommRingCat.Hom.hom hm
  rw [hhom] at h
  let z : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin n) R)
      (MvPolynomial.X k) := HomogeneousLocalization.Away.mk
    (MvPolynomial.homogeneousSubmodule (Fin n) R) (MvPolynomial.isHomogeneous_X R k) d f
    (by simpa using hf)
  have hc : homogeneousChartLocalizationIdeal ({()} : Finset Unit) (fun _ => f) d
      (fun _ _ => hf) k = Ideal.span ({z} : Set (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin n) R) (MvPolynomial.X k))) := by
    unfold homogeneousChartLocalizationIdeal
    apply congrArg Ideal.span
    ext q
    constructor
    · rintro ⟨l, rfl⟩
      rfl
    · rintro rfl
      exact ⟨⟨(), Finset.mem_singleton_self ()⟩, rfl⟩
  rw [hc, Ideal.map_span, Set.image_singleton] at h
  exact h

end MixedFujita
