module
public import MixedFujita.ClosedRationalPoints
public import MixedFujita.LocalAdicOrder
public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Square
import Mathlib.Tactic.Ring

/-!
Evaluation kernels are generated by the translated coordinate variables.
For an actual surjective polynomial presentation and localization at a
closed point, these variables generate the actual maximal ideal. Nakayama
then supplies one coordinate with actual local order one in positive dimension.
No regularity or smoothness of a hypersurface is asserted.
-/

@[expose] public section
namespace MixedFujita
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable {σ R : Type*} [CommRing R]

theorem polynomial_eval_remainder_mem_linearIdeal (a : σ → R) (f : MvPolynomial σ R) :
    f - MvPolynomial.C (MvPolynomial.eval a f) ∈
      Ideal.span (Set.range fun i ↦ MvPolynomial.X i - MvPolynomial.C (a i)) := by
  induction f using MvPolynomial.induction_on with
  | C r => simp
  | add f g hf hg =>
    rw [map_add, map_add]
    convert (Ideal.span _).add_mem hf hg using 1; ring
  | mul_X f i hf =>
    rw [map_mul, MvPolynomial.eval_X, map_mul]
    have h := (Ideal.span (Set.range fun i ↦
      MvPolynomial.X i - MvPolynomial.C (a i))).add_mem
      ((Ideal.span _).mul_mem_right (MvPolynomial.X i) hf)
      ((Ideal.span _).mul_mem_left (MvPolynomial.C (MvPolynomial.eval a f))
        (Ideal.subset_span (Set.mem_range_self i)))
    convert h using 1; ring

theorem polynomial_eval_kernel_eq_linearIdeal (a : σ → R) :
    RingHom.ker (MvPolynomial.eval a) =
      Ideal.span (Set.range fun i ↦ MvPolynomial.X i - MvPolynomial.C (a i)) := by
  apply le_antisymm
  · intro f hf
    have h := polynomial_eval_remainder_mem_linearIdeal a f
    have hz : MvPolynomial.eval a f = 0 := hf
    simpa only [hz, map_zero, sub_zero] using h
  · rw [Ideal.span_le]
    rintro f ⟨i, rfl⟩
    simp [RingHom.mem_ker]

theorem polynomial_algHom_kernel_eq_linearIdeal
    (α : MvPolynomial σ R →ₐ[R] R) :
    RingHom.ker α.toRingHom =
      Ideal.span (Set.range fun i ↦ MvPolynomial.X i - MvPolynomial.C (α (MvPolynomial.X i))) := by
  have h : α.toRingHom = MvPolynomial.eval (fun i ↦ α (MvPolynomial.X i)) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp
    · intro i
      simp
  rw [h]
  exact polynomial_eval_kernel_eq_linearIdeal _

variable {K A S : Type*} [Field K] [IsAlgClosed K] [Finite σ]
  [CommRing A] [CommRing S] [Algebra A S] [IsLocalRing S]
  (φ : MvPolynomial σ K →+* A) (hφ : Function.Surjective φ)
  (p : Ideal A) [p.IsMaximal] [IsLocalization.AtPrime S p]

include hφ p in
theorem polynomial_quotient_localization_maximalIdeal_generators :
    ∃ a : σ → K, IsLocalRing.maximalIdeal S =
      Ideal.span (Set.range fun i ↦
        algebraMap A S (φ (MvPolynomial.X i - MvPolynomial.C (a i)))) := by
  let q := p.comap φ
  let : q.IsMaximal := Ideal.comap_isMaximal_of_surjective φ hφ
  let α := closedPointEvaluation (K := K) q
  refine ⟨fun i ↦ α (MvPolynomial.X i), ?_⟩
  have hq : q = Ideal.span (Set.range fun i ↦
      MvPolynomial.X i - MvPolynomial.C (α (MvPolynomial.X i))) := by
    rw [← closedPointEvaluation_ker (K := K) q]
    exact polynomial_algHom_kernel_eq_linearIdeal α
  calc
    IsLocalRing.maximalIdeal S = p.map (algebraMap A S) :=
      (IsLocalization.AtPrime.map_eq_maximalIdeal (Rₚ := S) p).symm
    _ = (q.map φ).map (algebraMap A S) := by
      rw [Ideal.map_comap_of_surjective φ hφ p]
    _ = Ideal.span (Set.range fun i ↦
        algebraMap A S (φ (MvPolynomial.X i - MvPolynomial.C (α (MvPolynomial.X i))))) := by
      rw [hq, Ideal.map_span, Ideal.map_span, ← Set.image_comp, ← Set.range_comp]
      rfl

include hφ p in
theorem polynomial_quotient_localization_exists_order_one_coordinate [IsNoetherianRing S]
    (hdim : ringKrullDim S ≠ 0) :
    ∃ a : σ → K, ∃ i : σ,
      localAdicOrder S (algebraMap A S (φ (MvPolynomial.X i - MvPolynomial.C (a i)))) = 1 := by
  obtain ⟨a, ha⟩ := polynomial_quotient_localization_maximalIdeal_generators (S := S) φ hφ p
  have hm := IsLocalRing.maximalIdeal_sq_lt_of_ringKrullDim_ne_zero (R := S) hdim
  have hex : ∃ i : σ,
      algebraMap A S (φ (MvPolynomial.X i - MvPolynomial.C (a i))) ∉
        IsLocalRing.maximalIdeal S ^ 2 := by
    by_contra! h
    have hle : IsLocalRing.maximalIdeal S ≤ IsLocalRing.maximalIdeal S ^ 2 := by
      apply ha.le.trans
      apply Ideal.span_le.mpr
      rintro r ⟨i, rfl⟩
      exact h i
    exact (not_le_of_gt hm) hle
  obtain ⟨i, hi⟩ := hex
  refine ⟨a, i, (localAdicOrder_eq_nat_iff _ 1).mpr ⟨?_, hi⟩⟩
  rw [pow_one, ha]
  exact Ideal.subset_span (Set.mem_range_self i)

end MixedFujita
