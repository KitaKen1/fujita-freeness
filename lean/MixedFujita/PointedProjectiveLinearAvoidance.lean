module

public import MixedFujita.PointedProjectiveFormAvoidance

/-!
The fixed degree-one version of pointed form avoidance, assuming the
actual closed point's homogeneous ideal is generated by its linear forms.
This ideal-generation hypothesis is explicit; it is not derived here
from closedness, algebraic closedness, or rational coordinates.
These forms need not define smooth or integral hypersurfaces on a source.
-/

@[expose] public section
open AlgebraicGeometry TopologicalSpace
namespace MixedFujita
attribute [local instance] MvPolynomial.gradedAlgebra
universe u
variable {K : Type u} [Field K] {n : ℕ}

theorem polynomialProjective_closedPoint_linearForm_separates
    (x : polynomialProjectiveScheme n K) (hx : IsClosed {x})
    (hgenerated : Ideal.span {f : MvPolynomial (Fin n) K |
      f ∈ MvPolynomial.homogeneousSubmodule (Fin n) K 1 ∧
      f ∈ x.asHomogeneousIdeal} = x.asHomogeneousIdeal.toIdeal)
    (y : polynomialProjectiveScheme n K) (hy : y ≠ x) :
    ∃ f : MvPolynomial.homogeneousSubmodule (Fin n) K 1,
      (f : MvPolynomial (Fin n) K) ∈ x.asHomogeneousIdeal ∧
      (f : MvPolynomial (Fin n) K) ∉ y.asHomogeneousIdeal := by
  by_contra! h
  apply polynomialProjective_closedPoint_ideal_not_le x hx y hy
  rw [← hgenerated]
  exact Ideal.span_le.mpr fun f hf ↦ h ⟨f, hf.1⟩ hf.2

theorem polynomialProjective_closedPoint_finiteSubset_linearForm [Infinite K]
    (x : polynomialProjectiveScheme n K) (hx : IsClosed {x})
    (hgenerated : Ideal.span {f : MvPolynomial (Fin n) K |
      f ∈ MvPolynomial.homogeneousSubmodule (Fin n) K 1 ∧
      f ∈ x.asHomogeneousIdeal} = x.asHomogeneousIdeal.toIdeal)
    (Z : Set (polynomialProjectiveScheme n K)) (hZ : Z.Finite) (hxZ : x ∉ Z) :
    ∃ f : MvPolynomial.homogeneousSubmodule (Fin n) K 1,
      (f : MvPolynomial (Fin n) K) ∈ x.asHomogeneousIdeal ∧
      ∀ y ∈ Z, (f : MvPolynomial (Fin n) K) ∉ y.asHomogeneousIdeal := by
  exact polynomialProjective_fixedDegree_pointed_finite_avoidance 1 x Z hZ
    (fun y hy ↦ polynomialProjective_closedPoint_linearForm_separates x hx hgenerated y
      (fun h ↦ hxZ (h ▸ hy)))

theorem polynomialProjective_closedPoint_linear_affine_excluding [Infinite K]
    (x : polynomialProjectiveScheme n K) (hx : IsClosed {x})
    (hgenerated : Ideal.span {f : MvPolynomial (Fin n) K |
      f ∈ MvPolynomial.homogeneousSubmodule (Fin n) K 1 ∧
      f ∈ x.asHomogeneousIdeal} = x.asHomogeneousIdeal.toIdeal)
    (Z : Set (polynomialProjectiveScheme n K)) (hZ : Z.Finite) (hxZ : x ∉ Z) :
    ∃ f : MvPolynomial.homogeneousSubmodule (Fin n) K 1,
      let U := Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin n) K) f.val
      IsAffineOpen U ∧ x ∉ U ∧ Z ⊆ U := by
  obtain ⟨f, hfx, hfy⟩ :=
    polynomialProjective_closedPoint_finiteSubset_linearForm x hx hgenerated Z hZ hxZ
  exact ⟨f, Proj.isAffineOpen_basicOpen _ _ f.property Nat.zero_lt_one,
    fun h ↦ h hfx, hfy⟩

end MixedFujita
