module

public import MixedFujita.CartierSectionZeroIdeal
public import MixedFujita.CartierDivisorCoefficients
public import MixedFujita.InvertibleIdealCartier

/-!
The coefficients of an effective Cartier divisor vanish outside the support of its ideal sheaf
(step 7). An effective Cartier divisor has a regular equation on an affine neighbourhood of every
point; its ideal there is generated by this equation, so a point outside the support of the ideal
sheaf lies in the open set where the equation is invertible, and the order of a unit is zero.
Consequently an invertible ideal sheaf on a separated integral locally Noetherian scheme is the
ideal sheaf of an effective Cartier divisor whose prime components all lie in the support of the
ideal sheaf.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open TauCeti.AlgebraicGeometry.Scheme

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true

universe u

variable {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]

/-- A regular function has order zero at the points where it is invertible. -/
theorem ord_germToFunctionField_eq_zero_of_mem_basicOpen (U : X.Opens) [Nonempty U]
    (a : Γ(X, U)) (x : X) (hx : x ∈ X.basicOpen a) :
    X.ord (X.germToFunctionField U a) x = 0 := by
  have hle : X.basicOpen a ≤ U := X.basicOpen_le a
  have : Nonempty (X.basicOpen a : X.Opens) := ⟨⟨x, hx⟩⟩
  rw [← germToFunctionField_restrict X hle a]
  have hu : IsUnit (X.presheaf.map (homOfLE hle).op a) :=
    X.toRingedSpace.isUnit_res_basicOpen a
  exact X.ord_of_isUnit hu hx

/-- The coefficient of a Cartier divisor with a regular equation on an open set vanishes at the
points of the open set where the equation is invertible. -/
theorem cartierCoefficient_eq_zero_of_mem_basicOpen_regularEquation (D : CartierDivisor X)
    (U : X.Opens) [Nonempty U] (a : Γ(X, U)) (ha : a ≠ 0)
    (hEq : rationalUnitClass X U (Additive.ofMul (regularEquationRationalUnit X U a ha)) =
      D |_ U) (x : X) (hx : x ∈ X.basicOpen a) : cartierCoefficient D x = 0 := by
  rw [cartierCoefficient_eq_ord
      (CartierDivisor.isLocalEquationAt_of_rationalUnitClass_eq hEq (X.basicOpen_le a hx)),
    regularEquationRationalUnit_val]
  exact ord_germToFunctionField_eq_zero_of_mem_basicOpen U a x hx

omit [IsLocallyNoetherian X] in
/-- A regular equation of a Cartier divisor on an open set restricts to a regular equation on
every smaller nonempty open set. -/
theorem regularEquation_restrict (D : CartierDivisor X) {U V : X.Opens} [Nonempty U]
    [Nonempty V] (hVU : V ≤ U) (a : Γ(X, U)) (ha : a ≠ 0)
    (hEq : rationalUnitClass X U (Additive.ofMul (regularEquationRationalUnit X U a ha)) =
      D |_ U) :
    ∃ hb : X.presheaf.map (homOfLE hVU).op a ≠ 0,
      rationalUnitClass X V (Additive.ofMul (regularEquationRationalUnit X V
        (X.presheaf.map (homOfLE hVU).op a) hb)) = D |_ V := by
  have hval : X.germToFunctionField V (X.presheaf.map (homOfLE hVU).op a) =
      X.germToFunctionField U a := germToFunctionField_restrict X hVU a
  have hb : X.presheaf.map (homOfLE hVU).op a ≠ 0 := by
    intro h0
    apply ha
    apply X.germToFunctionField_injective U
    rw [← hval, h0, map_zero, map_zero]
  refine ⟨hb, ?_⟩
  have hunit : regularEquationRationalUnit X V (X.presheaf.map (homOfLE hVU).op a) hb =
      regularEquationRationalUnit X U a ha := Units.ext hval
  rw [hunit]
  exact CartierDivisor.rationalUnitClass_eq_of_le hVU hEq

omit [IsLocallyNoetherian X] in
/-- An effective Cartier divisor has a regular equation on an affine open neighbourhood of every
point. -/
theorem exists_affineOpen_regularEquation_of_isEffective (D : CartierDivisor X)
    (hD : D.IsEffective) (x : X) :
    ∃ (U : X.affineOpens) (_ : x ∈ U.1) (_ : Nonempty U.1) (a : Γ(X, U.1)) (ha : a ≠ 0),
      rationalUnitClass X U.1 (Additive.ofMul (regularEquationRationalUnit X U.1 a ha)) =
        D |_ U.1 := by
  obtain ⟨f, hfx, s, hs⟩ := CartierDivisor.isEffective_iff_exists.mp hD x
  obtain ⟨V, hxV, hV⟩ := CartierDivisor.isLocalEquationAt_iff.mp hfx
  obtain ⟨W, hWV, hxW, b, hb⟩ := X.presheaf.exists_le_germ_eq s hxV
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUW⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxW W.isOpen
  have hne : Nonempty U := ⟨⟨x, hxU⟩⟩
  have hneV : Nonempty V := ⟨⟨x, hxV⟩⟩
  have hneW : Nonempty W := ⟨⟨x, hxW⟩⟩
  have hUW' : U ≤ W := hUW
  obtain ⟨a, ha_def⟩ : ∃ a : Γ(X, U), a = X.presheaf.map (homOfLE hUW').op b := ⟨_, rfl⟩
  have hval : X.germToFunctionField U a = (f : X.functionField) := by
    rw [ha_def, germToFunctionField_restrict X hUW' b,
      ← X.algebraMap_germ_eq_germToFunctionField hxW b, hb, hs]
  have ha : a ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hval
    exact Units.ne_zero f hval.symm
  have hunit : regularEquationRationalUnit X U a ha = f := Units.ext hval
  refine ⟨⟨U, hU⟩, hxU, hne, a, ha, ?_⟩
  change rationalUnitClass X U (Additive.ofMul (regularEquationRationalUnit X U a ha)) = D |_ U
  rw [hunit]
  exact CartierDivisor.rationalUnitClass_eq_of_le (hUW'.trans hWV) hV

omit [IsLocallyNoetherian X] in
/-- Finitely many effective Cartier divisors have regular equations on a common affine open
neighbourhood of every point. -/
theorem exists_affineOpen_regularEquations_of_isEffective {ι : Type*} [Finite ι]
    (A : ι → CartierDivisor X) (hA : ∀ i, (A i).IsEffective) (x : X) :
    ∃ (U : X.affineOpens) (_ : x ∈ U.1) (_ : Nonempty U.1) (a : ι → Γ(X, U.1))
      (ha : ∀ i, a i ≠ 0), ∀ i, rationalUnitClass X U.1
        (Additive.ofMul (regularEquationRationalUnit X U.1 (a i) (ha i))) = A i |_ U.1 := by
  choose U₀ hx₀ hne₀ a₀ ha₀ hEq₀ using fun i =>
    exists_affineOpen_regularEquation_of_isEffective (A i) (hA i) x
  have hxW : x ∈ ⨅ i, (U₀ i).1 := by
    rw [← SetLike.mem_coe, Opens.coe_iInf]
    exact Set.mem_iInter.mpr hx₀
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUW⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxW (⨅ i, (U₀ i).1).isOpen
  have hne : Nonempty U := ⟨⟨x, hxU⟩⟩
  have hUW' : U ≤ ⨅ i, (U₀ i).1 := hUW
  have hle : ∀ i, U ≤ (U₀ i).1 := fun i => hUW'.trans (iInf_le _ i)
  choose hb hEq using fun i =>
    regularEquation_restrict (A i) (hle i) (a₀ i) (ha₀ i) (hEq₀ i)
  exact ⟨⟨U, hU⟩, hxU, hne, fun i => X.presheaf.map (homOfLE (hle i)).op (a₀ i), hb, hEq⟩

omit [IsLocallyNoetherian X] in
/-- The generic point does not lie in the support of the ideal sheaf of an effective Cartier
divisor. -/
theorem genericPoint_notMem_support_effectiveCartierIdealSheaf (D : CartierDivisor X)
    (hD : D.IsEffective) :
    genericPoint X ∉ (effectiveCartierIdealSheaf D hD).support := by
  obtain ⟨U, hxU, hne, a, ha, hEq⟩ :=
    exists_affineOpen_regularEquation_of_isEffective D hD (genericPoint X)
  rw [(effectiveCartierIdealSheaf D hD).mem_support_iff_of_mem (U := U) hxU,
    effectiveCartierIdealSheaf_ideal_eq_span D hD U a ha hEq, Scheme.zeroLocus_span,
    Scheme.zeroLocus_singleton]
  intro hnot
  apply hnot
  have hgerm : X.germToFunctionField U.1 a ≠ 0 := fun h =>
    ha (X.germToFunctionField_injective U.1 (by rw [h, map_zero]))
  exact (X.mem_basicOpen a (genericPoint X) hxU).mpr (isUnit_iff_ne_zero.mpr hgerm)

/-- The coefficient of an effective Cartier divisor vanishes at every point outside the support
of its ideal sheaf. -/
theorem cartierCoefficient_eq_zero_of_notMem_support_effectiveCartierIdealSheaf
    (D : CartierDivisor X) (hD : D.IsEffective) (x : X)
    (hx : x ∉ (effectiveCartierIdealSheaf D hD).support) : cartierCoefficient D x = 0 := by
  obtain ⟨U, hxU, hne, a, ha, hEq⟩ := exists_affineOpen_regularEquation_of_isEffective D hD x
  refine cartierCoefficient_eq_zero_of_mem_basicOpen_regularEquation D U.1 a ha hEq x ?_
  by_contra hnot
  apply hx
  rw [(effectiveCartierIdealSheaf D hD).mem_support_iff_of_mem (U := U) hxU,
    effectiveCartierIdealSheaf_ideal_eq_span D hD U a ha hEq, Scheme.zeroLocus_span,
    Scheme.zeroLocus_singleton]
  exact hnot

/-- An invertible ideal sheaf on a separated integral locally Noetherian scheme is the ideal
sheaf of an effective Cartier divisor whose coefficients vanish outside the support of the ideal
sheaf. -/
theorem exists_effectiveCartier_of_invertibleIdeal_coefficient [X.IsSeparated]
    (I : X.IdealSheafData) (hI : I.IsInvertible) :
    ∃ (D : CartierDivisor X) (hD : D.IsEffective), effectiveCartierIdealSheaf D hD = I ∧
      ∀ x : X, x ∉ I.support → cartierCoefficient D x = 0 := by
  obtain ⟨D, hD, hDI⟩ := exists_effectiveCartier_of_invertibleIdeal I hI
  refine ⟨D, hD, hDI, fun x hx => ?_⟩
  refine cartierCoefficient_eq_zero_of_notMem_support_effectiveCartierIdealSheaf D hD x ?_
  rw [hDI]
  exact hx

/-- The same over a field: it suffices that the structure morphism is separated. -/
theorem exists_effectiveCartier_of_invertibleIdeal_coefficient_of_overField {K : Type u}
    [Field K] [X.Over (Spec (CommRingCat.of K))] [IsSeparated (X ↘ Spec (CommRingCat.of K))]
    (I : X.IdealSheafData) (hI : I.IsInvertible) :
    ∃ (D : CartierDivisor X) (hD : D.IsEffective), effectiveCartierIdealSheaf D hD = I ∧
      ∀ x : X, x ∉ I.support → cartierCoefficient D x = 0 := by
  let : X.IsSeparated := ⟨by
    rw [← terminal.comp_from (X ↘ Spec (CommRingCat.of K))]
    infer_instance⟩
  exact exists_effectiveCartier_of_invertibleIdeal_coefficient I hI

end MixedFujita
