module

public import MixedFujita.HomogeneousDegeneration
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
public import Mathlib.RingTheory.Ideal.Maps

/-!
The actual homogeneous ideal generated by the parameter forms in K[T][X].
Its scalar base changes are the expected ideals, its special fiber is the
monomial ideal, and its nonzero fibers are diagonal images of the original
ideal. Projectivization, properness and lct specialization remain separate.
-/

@[expose] public section

namespace MixedFujita

attribute [local instance] MvPolynomial.gradedAlgebra

variable {n : ℕ} {K ι : Type*} [Field K]

noncomputable def homogeneousParameterIdeal (I : Finset ι) (w : Fin n → ℕ)
    (p : ι → Fin n →₀ ℕ) (f : ι → MvPolynomial (Fin n) K) :
    Ideal (MvPolynomial (Fin n) (Polynomial K)) :=
  Ideal.span (Set.range (fun l : I => homogeneousParameterFamily w (p l) (f l)))

theorem homogeneousParameterIdeal_isHomogeneous (I : Finset ι) (w : Fin n → ℕ)
    (p : ι → Fin n →₀ ℕ) (f : ι → MvPolynomial (Fin n) K) (d : ℕ)
    (hf : ∀ l ∈ I, (f l).IsHomogeneous d) :
    (homogeneousParameterIdeal I w p f).IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin n) (Polynomial K)) := by
  apply Ideal.homogeneous_span
  rintro g ⟨l, rfl⟩
  exact ⟨d, homogeneousParameterFamily_isHomogeneous w (p l) (hf l l.property)⟩

theorem homogeneousParameterIdeal_baseChange (I : Finset ι) (w : Fin n → ℕ)
    (p : ι → Fin n →₀ ℕ) (f : ι → MvPolynomial (Fin n) K) (t : K) :
    Ideal.map (MvPolynomial.map (Polynomial.evalRingHom t)) (homogeneousParameterIdeal I w p f) =
      Ideal.span (Set.range (fun l : I =>
        (weightedPolynomialFamily w (p l) (f l)).eval (MvPolynomial.C t))) := by
  rw [homogeneousParameterIdeal, Ideal.map_span, ← Set.range_comp']
  apply congrArg Ideal.span
  apply congrArg Set.range
  funext l
  exact homogeneousParameterFamily_baseChange w (p l) (f l) t

theorem homogeneousParameterIdeal_at_one (I : Finset ι) (w : Fin n → ℕ)
    (p : ι → Fin n →₀ ℕ) (f : ι → MvPolynomial (Fin n) K) :
    Ideal.map (MvPolynomial.map (Polynomial.evalRingHom 1)) (homogeneousParameterIdeal I w p f) =
      Ideal.span (Set.range (fun l : I => f l)) := by
  rw [homogeneousParameterIdeal_baseChange]
  simp only [map_one, weightedPolynomialFamily_at_one]

theorem polynomial_generator_span_scalar_units {α : Type*}
    (g : α → MvPolynomial (Fin n) K) (c : α → K) (hc : ∀ l, c l ≠ 0) :
    Ideal.span (Set.range (fun l => MvPolynomial.C (c l) * g l)) = Ideal.span (Set.range g) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro f ⟨l, rfl⟩
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_range_self l))
  · apply Ideal.span_le.mpr
    rintro f ⟨l, rfl⟩
    have hm := Ideal.mul_mem_left
      (Ideal.span (Set.range (fun l => MvPolynomial.C (c l) * g l)))
      (MvPolynomial.C ((c l)⁻¹)) (Ideal.subset_span (Set.mem_range_self l))
    have heq : MvPolynomial.C ((c l)⁻¹) * (MvPolynomial.C (c l) * g l) = g l := by
      rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ (hc l), map_one, one_mul]
    rwa [heq] at hm

theorem homogeneousParameterIdeal_at_zero (I : Finset ι) (w : Fin n → ℕ)
    (p : ι → Fin n →₀ ℕ) (f : ι → MvPolynomial (Fin n) K)
    (hp : ∀ l ∈ I, p l ∈ (f l).support)
    (hw : ∀ l ∈ I, ∀ q ∈ (f l).support, q ≠ p l →
      polynomialExponentWeight w (p l) < polynomialExponentWeight w q) :
    Ideal.map (MvPolynomial.map (Polynomial.evalRingHom 0)) (homogeneousParameterIdeal I w p f) =
      Ideal.span (Set.range (fun l : I => MvPolynomial.monomial (p l) (1 : K))) := by
  rw [homogeneousParameterIdeal_baseChange]
  have hforms : (fun l : I => (weightedPolynomialFamily w (p l) (f l)).eval (MvPolynomial.C 0)) =
      fun l : I => MvPolynomial.C ((f l).coeff (p l)) * MvPolynomial.monomial (p l) 1 := by
    funext l
    rw [map_zero, weightedPolynomialFamily_at_zero w (p l) (f l)
      (hp l l.property) (hw l l.property), MvPolynomial.C_mul_monomial, mul_one]
  rw [hforms]
  exact polynomial_generator_span_scalar_units _ _
    (fun l => MvPolynomial.mem_support_iff.mp (hp l l.property))

theorem homogeneousParameterIdeal_nonzero_fiber (I : Finset ι) (w : Fin n → ℕ)
    (p : ι → Fin n →₀ ℕ) (f : ι → MvPolynomial (Fin n) K) {t : K} (ht : t ≠ 0)
    (hw : ∀ l ∈ I, ∀ q ∈ (f l).support,
      polynomialExponentWeight w (p l) ≤ polynomialExponentWeight w q) :
    Ideal.map (MvPolynomial.map (Polynomial.evalRingHom t)) (homogeneousParameterIdeal I w p f) =
      Ideal.map (polynomialDiagonalHom w t) (Ideal.span (Set.range (fun l : I => f l))) := by
  rw [homogeneousParameterIdeal_baseChange, Ideal.map_span, ← Set.range_comp']
  have hforms : (fun l : I => polynomialDiagonalHom w t (f l)) =
      fun l : I => MvPolynomial.C (t ^ polynomialExponentWeight w (p l)) *
        (weightedPolynomialFamily w (p l) (f l)).eval (MvPolynomial.C t) := by
    funext l
    exact (weightedPolynomialFamily_scaled_parameter w (p l) (f l) t (hw l l.property)).symm
  rw [hforms]
  exact (polynomial_generator_span_scalar_units _ _ (fun _ => pow_ne_zero _ ht)).symm

end MixedFujita
