module

public import MixedFujita.FrobeniusCoordinateGeneration
public import MixedFujita.ChartCartierDecomposition
public import MixedFujita.PolynomialCartierBasis

/-!
Weight decomposition on étale charts (step 10, the explicit Cartier subspace of an étale chart).

Let `K` be a field of characteristic `p` and `S` a `K`-algebra of finite type with formally étale
coordinates `y`. By check-399 every element of `S` is `Φ(q) = Σ_β q_β y^β` with coefficients in the
subalgebra `K·S^p` generated by `p`-th powers. The Euler operators `E_j = y_j ∂_j` act on these
expansions as `X_j ∂/∂X_j` (`etaleEuler_aeval`), so `E_j (c y^β) = β_j c y^β`. The shifted weight
projectors `1 - (E_j + m)^{p-1}` keep exactly the monomials with `p ∣ β_j + m` (Fermat), and they
fix every `a` with `(E_j + m) a = 0`. Hence such an `a` is the sum of the monomials of its expansion
with `p ∣ β_j + m_j` for all `j` (`aeval_eq_sum_filter_of_shifted_weights`).

Consequences:
* **Cartier in degree 0.** An element with all `∂_j a = 0` lies in `K·S^p`
  (`mem_frobeniusSubalgebra_of_etaleCoordPartial_eq_zero`), and conversely.
* **The Cartier subspace.** A form `ω = Σ_s ω_s ⊗ e_s` of the coordinate de Rham complex is killed by
  all weight operators exactly when `ω_s = c_s · y_s^{p-1}` with `c_s ∈ K·S^p`, where
  `y_s^{p-1} = Π_{j ∈ s} y_j^{p-1}` (`etaleCartierSubspace_iff`).

With the Cartier decomposition of check-397, the de Rham cohomology of an étale chart is the sum of
the `K·S^p`-modules `K·S^p · y_s^{p-1} e_s`.
-/

@[expose] public section

open TensorProduct

namespace MixedFujita

universe u v

section Fermat

variable {K : Type u} [Field K]

/-- Fermat's little theorem in a field of characteristic `p`: `k^{p-1}` is `0` or `1`. -/
theorem natCast_pow_pred_char (p : ℕ) [hp : Fact p.Prime] [CharP K p] (k : ℕ) :
    (k : K) ^ (p - 1) = if p ∣ k then 0 else 1 := by
  split_ifs with h
  · rw [(CharP.cast_eq_zero_iff K p k).mpr h, zero_pow]
    have := hp.out.two_le
    omega
  · have hz : (k : ZMod p) ≠ 0 := by
      rwa [Ne, CharP.cast_eq_zero_iff (ZMod p) p]
    have h1 := ZMod.pow_card_sub_one_eq_one hz
    have h2 := congrArg (ZMod.castHom (dvd_refl p) K) h1
    simpa only [map_pow, map_natCast, map_one] using h2

/-- A projector `1 - A^{p-1}` fixes the kernel of `A`. -/
theorem one_sub_pow_pred_apply_of_eq_zero (p : ℕ) [hp : Fact p.Prime] {M : Type*} [AddCommGroup M]
    [Module K M] (A : M →ₗ[K] M) (s : M) (hs : A s = 0) : (1 - A ^ (p - 1)) s = s := by
  obtain ⟨q, hq⟩ : ∃ q, p - 1 = q + 1 := ⟨p - 2, by have := hp.out.two_le; omega⟩
  rw [LinearMap.sub_apply, Module.End.one_apply, hq, pow_succ, Module.End.mul_apply, hs, map_zero,
    sub_zero]

end Fermat

section Exterior

variable {K : Type u} [Field K] {S : Type v} [CommRing S] [Algebra K S] {n : ℕ}

theorem koszulDeRhamWeight_tmul_basis (D : Fin n → S →ₗ[K] S) (x : Fin n → S) (j : Fin n) (a : S)
    (s : Finset (Fin n)) :
    koszulDeRhamWeight D x j (a ⊗ₜ coordExteriorBasis K n s) =
      (eulerOperator D x j a + (if j ∈ s then (1 : K) else 0) • a) ⊗ₜ coordExteriorBasis K n s := by
  rw [koszulDeRhamWeight_eq_add, LinearMap.add_apply, TensorProduct.map_tmul, TensorProduct.map_tmul,
    LinearMap.id_apply, LinearMap.id_apply, coordWedgeContract_basis, ← TensorProduct.smul_tmul,
    ← TensorProduct.add_tmul]

/-- The vectors `1 ⊗ e_s` are linearly independent over `S`. -/
theorem sum_tmul_coordExteriorBasis_eq_zero_iff (a : Finset (Fin n) → S) :
    ∑ s, a s ⊗ₜ[K] coordExteriorBasis K n s = 0 ↔ ∀ s, a s = 0 := by
  have hli := (Algebra.TensorProduct.basis S (coordExteriorBasis K n)).linearIndependent
  rw [Fintype.linearIndependent_iff] at hli
  constructor
  · intro h
    apply hli a
    simpa only [Algebra.TensorProduct.basis_apply, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      using h
  · intro h
    simp [h]

/-- Every form is `Σ_s ω_s ⊗ e_s`. -/
theorem eq_sum_tmul_coordExteriorBasis (ω : S ⊗[K] CoordExterior K n) :
    ω = ∑ s, (Algebra.TensorProduct.basis S (coordExteriorBasis K n)).repr ω s ⊗ₜ[K]
      coordExteriorBasis K n s := by
  conv_lhs => rw [← (Algebra.TensorProduct.basis S (coordExteriorBasis K n)).sum_repr ω]
  simp only [Algebra.TensorProduct.basis_apply, TensorProduct.smul_tmul', smul_eq_mul, mul_one]

end Exterior

section Etale

variable {K : Type u} [Field K] {S : Type v} [CommRing S] [Algebra K S] {n : ℕ}
  (y : MvPolynomial (Fin n) K →ₐ[K] S) (hy : y.toRingHom.FormallyEtale)

theorem etaleCoordPartial_eq_zero_of_mem (p : ℕ) [CharP K p] (j : Fin n) {c : S}
    (hc : c ∈ frobeniusSubalgebra K S p) : etaleCoordPartial y hy j c = 0 :=
  derivation_eq_zero_of_mem_frobeniusSubalgebra p (etaleCoordinateDerivation y hy j) hc

theorem etaleEuler_coordinate (j i : Fin n) :
    eulerOperator (etaleCoordPartial y hy) (etaleCoordFun y) j (etaleCoordFun y i) =
      if i = j then etaleCoordFun y j else 0 := by
  rw [eulerOperator_apply]
  change etaleCoordFun y j * etaleCoordinateDerivation y hy j (y (MvPolynomial.X i)) = _
  rw [etaleCoordinateDerivation_coordinate]
  split_ifs <;> simp

/-- The Euler operators intertwine evaluation at the coordinates (with coefficients in `K·S^p`)
with `X_j ∂/∂X_j`. -/
theorem etaleEuler_aeval (p : ℕ) [CharP K p] (j : Fin n)
    (q : MvPolynomial (Fin n) (frobeniusSubalgebra K S p)) :
    eulerOperator (etaleCoordPartial y hy) (etaleCoordFun y) j
        (MvPolynomial.aeval (etaleCoordFun y) q) =
      MvPolynomial.aeval (etaleCoordFun y) (MvPolynomial.X j * MvPolynomial.pderiv j q) := by
  classical
  induction q using MvPolynomial.induction_on with
  | C c =>
    have hc : etaleCoordPartial y hy j (algebraMap (frobeniusSubalgebra K S p) S c) = 0 :=
      etaleCoordPartial_eq_zero_of_mem y hy p j c.2
    rw [MvPolynomial.aeval_C, MvPolynomial.pderiv_C, mul_zero, map_zero, eulerOperator_apply, hc,
      mul_zero]
  | add a b ha hb =>
    rw [map_add, map_add, ha, hb, map_add, mul_add, map_add]
  | mul_X a i ha =>
    have hX : MvPolynomial.pderiv j (a * MvPolynomial.X i) =
        a * (if i = j then 1 else 0) + MvPolynomial.X i * MvPolynomial.pderiv j a := by
      rw [Derivation.leibniz, MvPolynomial.pderiv_X, Pi.single_apply, smul_eq_mul, smul_eq_mul]
    have hL : MvPolynomial.aeval (etaleCoordFun y) (a * MvPolynomial.X i) =
        MvPolynomial.aeval (etaleCoordFun y) a * etaleCoordFun y i := by
      rw [map_mul, MvPolynomial.aeval_X]
    rw [hL, etaleEuler_leibniz, ha, etaleEuler_coordinate, hX]
    split_ifs with h
    · subst h
      simp only [mul_one, mul_add, map_add, map_mul, MvPolynomial.aeval_X]
      ring
    · simp only [mul_zero, zero_add, map_mul, MvPolynomial.aeval_X]
      ring

theorem etaleEuler_aeval_monomial (p : ℕ) [CharP K p] (j : Fin n) (β : Fin n →₀ ℕ)
    (c : frobeniusSubalgebra K S p) :
    eulerOperator (etaleCoordPartial y hy) (etaleCoordFun y) j
        (MvPolynomial.aeval (etaleCoordFun y) (MvPolynomial.monomial β c)) =
      ((β j : ℕ) : K) • MvPolynomial.aeval (etaleCoordFun y) (MvPolynomial.monomial β c) := by
  rw [etaleEuler_aeval y hy p, MvPolynomial.X_mul_pderiv_monomial, map_nsmul,
    Nat.cast_smul_eq_nsmul]

theorem etaleShiftedEuler_pow_aeval_monomial (p : ℕ) [CharP K p] (j : Fin n) (m k : ℕ)
    (β : Fin n →₀ ℕ) (c : frobeniusSubalgebra K S p) :
    ((eulerOperator (etaleCoordPartial y hy) (etaleCoordFun y) j + (m : K) • LinearMap.id : S →ₗ[K] S) ^ k)
        (MvPolynomial.aeval (etaleCoordFun y) (MvPolynomial.monomial β c)) =
      (((β j + m : ℕ) : K) ^ k) •
        MvPolynomial.aeval (etaleCoordFun y) (MvPolynomial.monomial β c) := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ', Module.End.mul_apply, ih, map_smul, LinearMap.add_apply,
      etaleEuler_aeval_monomial y hy p, LinearMap.smul_apply, LinearMap.id_apply, ← add_smul,
      ← Nat.cast_add, smul_smul, ← pow_succ]

/-- The shifted weight projector `1 - (E_j + m)^{p-1}` keeps exactly the monomials with
`p ∣ β_j + m`. -/
theorem etaleWeightProjector_aeval_monomial (p : ℕ) [hp : Fact p.Prime] [CharP K p] (j : Fin n)
    (m : ℕ) (β : Fin n →₀ ℕ) (c : frobeniusSubalgebra K S p) :
    (1 - (eulerOperator (etaleCoordPartial y hy) (etaleCoordFun y) j + (m : K) • LinearMap.id : S →ₗ[K] S) ^
        (p - 1)) (MvPolynomial.aeval (etaleCoordFun y) (MvPolynomial.monomial β c)) =
      if p ∣ β j + m then MvPolynomial.aeval (etaleCoordFun y) (MvPolynomial.monomial β c) else 0 := by
  rw [LinearMap.sub_apply, Module.End.one_apply, etaleShiftedEuler_pow_aeval_monomial y hy p,
    natCast_pow_pred_char p]
  split_ifs <;> simp

/-- **Weight decomposition.** If `(E_j + m_j) a = 0` for all `j`, then `a` is the sum of the
monomials `q_β y^β` of its expansion with `p ∣ β_j + m_j` for all `j`. -/
theorem aeval_eq_sum_filter_of_shifted_weights (p : ℕ) [hp : Fact p.Prime] [CharP K p]
    (m : Fin n → ℕ) (q : MvPolynomial (Fin n) (frobeniusSubalgebra K S p))
    (hq : ∀ j, (eulerOperator (etaleCoordPartial y hy) (etaleCoordFun y) j + ((m j : ℕ) : K) •
      LinearMap.id : S →ₗ[K] S) (MvPolynomial.aeval (etaleCoordFun y) q) = 0) :
    MvPolynomial.aeval (etaleCoordFun y) q =
      ∑ β ∈ q.support with ∀ j, p ∣ β j + m j,
        MvPolynomial.aeval (etaleCoordFun y) (MvPolynomial.monomial β (q.coeff β)) := by
  classical
  have key : ∀ T : Finset (Fin n), MvPolynomial.aeval (etaleCoordFun y) q =
      ∑ β ∈ q.support, if ∀ j ∈ T, p ∣ β j + m j then
        MvPolynomial.aeval (etaleCoordFun y) (MvPolynomial.monomial β (q.coeff β)) else 0 := by
    intro T
    induction T using Finset.induction_on with
    | empty =>
      simp only [Finset.notMem_empty, IsEmpty.forall_iff, implies_true, ite_true]
      conv_lhs => rw [MvPolynomial.as_sum q]
      rw [map_sum]
    | insert j T hj ih =>
      have h1 := one_sub_pow_pred_apply_of_eq_zero p _ _ (hq j)
      rw [← h1, ih, map_sum]
      refine Finset.sum_congr rfl fun β _ => ?_
      by_cases h2 : ∀ i ∈ T, p ∣ β i + m i
      · rw [ite_eq_left h2, etaleWeightProjector_aeval_monomial y hy p]
        by_cases h3 : p ∣ β j + m j
        · rw [ite_eq_left h3, ite_eq_left ((Finset.forall_mem_insert j T _).mpr ⟨h3, h2⟩)]
        · rw [ite_eq_right h3, ite_eq_right (fun h => h3 ((Finset.forall_mem_insert j T _).mp h).1)]
      · rw [ite_eq_right h2, ite_eq_right (fun h => h2 ((Finset.forall_mem_insert j T _).mp h).2), map_zero]
  rw [key Finset.univ, Finset.sum_filter]
  simp only [Finset.mem_univ, true_implies]

/-- A monomial whose exponents are all divisible by `p` evaluates into `K·S^p`. -/
theorem aeval_monomial_mem_frobeniusSubalgebra (p : ℕ) (β : Fin n →₀ ℕ) (hβ : ∀ j, p ∣ β j)
    (c : frobeniusSubalgebra K S p) :
    MvPolynomial.aeval (etaleCoordFun y) (MvPolynomial.monomial β c) ∈
      frobeniusSubalgebra K S p := by
  rw [MvPolynomial.aeval_monomial, Finsupp.prod]
  refine Subalgebra.mul_mem _ c.2 (Subalgebra.prod_mem _ fun j _ => ?_)
  show etaleCoordFun y j ^ β j ∈ frobeniusSubalgebra K S p
  obtain ⟨k, hk⟩ := hβ j
  rw [hk, pow_mul']
  exact pow_mem_frobeniusSubalgebra p _

/-- **The Cartier isomorphism in degree 0 on an étale chart.** An element all of whose coordinate
derivatives vanish lies in `K·S^p`. -/
theorem mem_frobeniusSubalgebra_of_etaleCoordPartial_eq_zero (p : ℕ) [hp : Fact p.Prime] [CharP K p]
    [Algebra.FiniteType K S] {s : S} (hs : ∀ j, etaleCoordPartial y hy j s = 0) :
    s ∈ frobeniusSubalgebra K S p := by
  obtain ⟨q, hq⟩ := exists_aeval_frobeniusSubalgebra_eq p y hy s
  have hq' : MvPolynomial.aeval (etaleCoordFun y) q = s := hq
  have hw : ∀ j, (eulerOperator (etaleCoordPartial y hy) (etaleCoordFun y) j +
      (((fun _ => 0 : Fin n → ℕ) j : ℕ) : K) • LinearMap.id : S →ₗ[K] S)
        (MvPolynomial.aeval (etaleCoordFun y) q) = 0 := by
    intro j
    rw [hq', LinearMap.add_apply, eulerOperator_apply, hs j, mul_zero, zero_add, LinearMap.smul_apply,
      Nat.cast_zero, zero_smul]
  rw [← hq', aeval_eq_sum_filter_of_shifted_weights y hy p (fun _ => 0) q hw]
  refine Subalgebra.sum_mem _ fun β hβ => aeval_monomial_mem_frobeniusSubalgebra y p β ?_ _
  intro j
  simpa using (Finset.mem_filter.mp hβ).2 j

/-- The coordinate derivatives of `S` vanish exactly on `K·S^p`. -/
theorem etaleCoordPartial_eq_zero_iff_mem_frobeniusSubalgebra (p : ℕ) [Fact p.Prime] [CharP K p]
    [Algebra.FiniteType K S] (s : S) :
    (∀ j, etaleCoordPartial y hy j s = 0) ↔ s ∈ frobeniusSubalgebra K S p :=
  ⟨mem_frobeniusSubalgebra_of_etaleCoordPartial_eq_zero y hy p,
    fun hs j => etaleCoordPartial_eq_zero_of_mem y hy p j hs⟩

/-- The exponent `(p - 1) 1_s` of `y_s^{p-1} = Π_{j ∈ s} y_j^{p-1}`. -/
noncomputable def cartierExponent (p : ℕ) (s : Finset (Fin n)) : Fin n →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm fun j => if j ∈ s then p - 1 else 0

theorem cartierExponent_apply (p : ℕ) (s : Finset (Fin n)) (j : Fin n) :
    cartierExponent p s j = if j ∈ s then p - 1 else 0 := by
  simp [cartierExponent]

theorem coordinate_monomial_eq_prod (β : Fin n →₀ ℕ) :
    y (MvPolynomial.monomial β 1) = β.prod fun i k => etaleCoordFun y i ^ k := by
  conv_lhs => rw [MvPolynomial.aeval_unique y]
  rw [MvPolynomial.aeval_monomial, map_one, one_mul]
  rfl

theorem mul_coordinate_monomial_eq_aeval (p : ℕ) (β : Fin n →₀ ℕ) {c : S}
    (hc : c ∈ frobeniusSubalgebra K S p) :
    c * y (MvPolynomial.monomial β 1) =
      MvPolynomial.aeval (etaleCoordFun y)
        (MvPolynomial.monomial β (⟨c, hc⟩ : frobeniusSubalgebra K S p)) := by
  rw [MvPolynomial.aeval_monomial, coordinate_monomial_eq_prod]
  rfl

/-- The forms `c · y_s^{p-1} e_s` with `c ∈ K·S^p` are killed by the weight operators. -/
theorem etaleEuler_cartierMonomial (p : ℕ) [hp : Fact p.Prime] [CharP K p] (s : Finset (Fin n))
    (j : Fin n) {c : S} (hc : c ∈ frobeniusSubalgebra K S p) :
    eulerOperator (etaleCoordPartial y hy) (etaleCoordFun y) j
        (c * y (MvPolynomial.monomial (cartierExponent p s) 1)) +
      (if j ∈ s then (1 : K) else 0) • (c * y (MvPolynomial.monomial (cartierExponent p s) 1)) = 0 := by
  rw [mul_coordinate_monomial_eq_aeval y p _ hc, etaleEuler_aeval_monomial y hy p, ← add_smul]
  convert zero_smul K _ using 2
  rw [cartierExponent_apply]
  split_ifs with h
  · rw [Nat.cast_sub hp.out.one_le, Nat.cast_one, sub_add_cancel, CharP.cast_eq_zero]
  · simp

/-- **Coefficients of the Cartier subspace.** If `(y_j ∂_j + [j ∈ s]) a = 0` for all `j`, then
`a = c · y_s^{p-1}` with `c ∈ K·S^p`. -/
theorem exists_mem_frobeniusSubalgebra_mul_cartierMonomial (p : ℕ) [hp : Fact p.Prime] [CharP K p]
    [Algebra.FiniteType K S] (s : Finset (Fin n)) (a : S)
    (ha : ∀ j, eulerOperator (etaleCoordPartial y hy) (etaleCoordFun y) j a +
      (if j ∈ s then (1 : K) else 0) • a = 0) :
    ∃ c ∈ frobeniusSubalgebra K S p, a = c * y (MvPolynomial.monomial (cartierExponent p s) 1) := by
  classical
  obtain ⟨q, hq⟩ := exists_aeval_frobeniusSubalgebra_eq p y hy a
  have hq' : MvPolynomial.aeval (etaleCoordFun y) q = a := hq
  set m : Fin n → ℕ := fun j => if j ∈ s then 1 else 0 with hm
  have hw : ∀ j, (eulerOperator (etaleCoordPartial y hy) (etaleCoordFun y) j + ((m j : ℕ) : K) •
      LinearMap.id : S →ₗ[K] S) (MvPolynomial.aeval (etaleCoordFun y) q) = 0 := by
    intro j
    rw [hq', LinearMap.add_apply, LinearMap.smul_apply, LinearMap.id_apply, hm]
    simpa only [Nat.cast_ite, Nat.cast_one, Nat.cast_zero] using ha j
  have hY : y (MvPolynomial.monomial (cartierExponent p s) 1) =
      ∏ i, etaleCoordFun y i ^ cartierExponent p s i := by
    rw [coordinate_monomial_eq_prod, Finsupp.prod_fintype _ _ (fun i => pow_zero _)]
  rw [← hq', aeval_eq_sum_filter_of_shifted_weights y hy p m q hw]
  refine Finset.sum_induction _
    (fun x => ∃ c ∈ frobeniusSubalgebra K S p, x = c * y (MvPolynomial.monomial (cartierExponent p s) 1))
    (fun x z ⟨c, hc, hx⟩ ⟨d, hd, hz⟩ => ⟨c + d, Subalgebra.add_mem _ hc hd, by rw [hx, hz, add_mul]⟩)
    ⟨0, Subalgebra.zero_mem _, by rw [zero_mul]⟩ fun β hβ => ?_
  obtain ⟨γ, hγ⟩ := (polynomialDeRhamWeightOf_dvd_iff p (β, s)).mp (Finset.mem_filter.mp hβ).2
  refine ⟨(q.coeff β : S) * ∏ i, (etaleCoordFun y i ^ γ i) ^ p,
    Subalgebra.mul_mem _ (q.coeff β).2
      (Subalgebra.prod_mem _ fun i _ => pow_mem_frobeniusSubalgebra p _), ?_⟩
  rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (fun i => pow_zero _), hY, mul_assoc,
    ← Finset.prod_mul_distrib]
  congr 1
  refine Finset.prod_congr rfl fun i _ => ?_
  have hγi : β i = p * γ i + if i ∈ s then p - 1 else 0 := hγ i
  rw [hγi, pow_add, ← pow_mul, mul_comm (γ i) p, cartierExponent_apply]

/-- **The Cartier subspace of an étale chart.** A form of the coordinate de Rham complex is killed
by all weight operators exactly when it is `Σ_s c_s y_s^{p-1} ⊗ e_s` with all `c_s ∈ K·S^p`. -/
theorem etaleCartierSubspace_iff (p : ℕ) [hp : Fact p.Prime] [CharP K p] [Algebra.FiniteType K S]
    (ω : S ⊗[K] CoordExterior K n) :
    (∀ j, koszulDeRhamWeight (etaleCoordPartial y hy) (etaleCoordFun y) j ω = 0) ↔
      ∃ c : Finset (Fin n) → S, (∀ s, c s ∈ frobeniusSubalgebra K S p) ∧
        ω = ∑ s, (c s * y (MvPolynomial.monomial (cartierExponent p s) 1)) ⊗ₜ[K]
          coordExteriorBasis K n s := by
  classical
  constructor
  · intro hω
    have hexp := eq_sum_tmul_coordExteriorBasis ω
    set b := Algebra.TensorProduct.basis S (coordExteriorBasis K n)
    have hcoef : ∀ s j, eulerOperator (etaleCoordPartial y hy) (etaleCoordFun y) j (b.repr ω s) +
        (if j ∈ s then (1 : K) else 0) • b.repr ω s = 0 := by
      intro s j
      have h := hω j
      rw [hexp, map_sum] at h
      simp only [koszulDeRhamWeight_tmul_basis] at h
      exact (sum_tmul_coordExteriorBasis_eq_zero_iff _).mp h s
    choose c hc hcω using fun s =>
      exists_mem_frobeniusSubalgebra_mul_cartierMonomial y hy p s (b.repr ω s) (hcoef s)
    refine ⟨c, hc, ?_⟩
    conv_lhs => rw [hexp]
    exact Finset.sum_congr rfl fun s _ => by rw [hcω s]
  · rintro ⟨c, hc, rfl⟩ j
    rw [map_sum]
    refine Finset.sum_eq_zero fun s _ => ?_
    rw [koszulDeRhamWeight_tmul_basis, etaleEuler_cartierMonomial y hy p s j (hc s),
      TensorProduct.zero_tmul]

end Etale

end MixedFujita
