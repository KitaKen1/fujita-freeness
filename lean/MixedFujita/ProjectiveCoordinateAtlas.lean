module

public import MixedFujita.BlowUpRatioAtlas
public import MixedFujita.PolynomialProjectiveCharts
public import SGA.Foundations.Cohomology.Extension
public import SGA.Foundations.Projective.Segre

/-!
The coordinate atlas of a closed subscheme of projective space. For a closed immersion of X into
the projective space with coordinates x_0, …, x_{n-1} over a field, the preimages U_i of the
standard charts are affine and cover X, and the pulled back ratios u_{i,k} = x_k/x_i are functions
on U_i with u_{i,i} = 1, u_{i,k'} = u_{i,k} u_{k,k'} on overlaps, vanishing loci outside U_k, and
generating the functions of U_i over the base field. The generation is the dehomogenization of
the degree-zero localization of the polynomial ring, and the constants are those of the structure
morphism, by the computation of the pinned SlopdeGeometrieAlgebrique.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite MvPolynomial
open HomogeneousLocalization

namespace MixedFujita

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

section Dehomogenization

variable {K : Type u} [CommRing K] {n : ℕ} (i : Fin n)

/-- The constants of the degree-zero localization at a variable. -/
noncomputable def projectiveAwayConstants :
    K →+* Away (homogeneousSubmodule (Fin n) K) (X i) :=
  (fromZeroRingHom (homogeneousSubmodule (Fin n) K) (.powers (X i))).comp
    (polynomialDegreeZeroEquiv n K).symm.toRingHom

/-- The ratio x_j/x_i in the degree-zero localization at x_i. -/
noncomputable def projectiveAwayRatio (j : Fin n) :
    Away (homogeneousSubmodule (Fin n) K) (X i) :=
  Away.mk _ (projectiveSpace.X_mem i) 1 (X j)
    (by rw [smul_eq_mul, mul_one]; exact projectiveSpace.X_mem j)

/-- A homogeneous polynomial evaluated at the ratios is its fraction by the power of x_i. -/
theorem projectiveAway_eval₂Hom_mk (m : ℕ) (a : MvPolynomial (Fin n) K)
    (ha : a ∈ homogeneousSubmodule (Fin n) K (m • 1)) :
    eval₂Hom (projectiveAwayConstants i) (projectiveAwayRatio i) a =
      Away.mk _ (projectiveSpace.X_mem i) m a ha := by
  apply HomogeneousLocalization.val_injective
  have hh : a.IsHomogeneous m := by simpa using ha
  rw [Away.val_mk, ← HomogeneousLocalization.algebraMap_apply, coe_eval₂Hom, eval₂_comp_left]
  have hc : (algebraMap (Away (homogeneousSubmodule (Fin n) K) (X i))
        (Localization.Away (X i : MvPolynomial (Fin n) K))).comp (projectiveAwayConstants i) =
      (algebraMap (MvPolynomial (Fin n) K)
        (Localization.Away (X i : MvPolynomial (Fin n) K))).comp C := by
    exact RingHom.ext fun c => rfl
  have hg : (algebraMap (Away (homogeneousSubmodule (Fin n) K) (X i))
        (Localization.Away (X i : MvPolynomial (Fin n) K))) ∘ projectiveAwayRatio i =
      fun j => IsLocalization.Away.invSelf (X i : MvPolynomial (Fin n) K) *
        algebraMap _ _ (X j : MvPolynomial (Fin n) K) := by
    funext j
    rw [Function.comp_apply, HomogeneousLocalization.algebraMap_apply, projectiveAwayRatio,
      Away.val_mk, Localization.mk_eq_mk', IsLocalization.mk'_eq_mul_mk'_one, mul_comm]
    simp only [pow_one]
    rfl
  have e : eval₂ ((algebraMap (MvPolynomial (Fin n) K)
        (Localization.Away (X i : MvPolynomial (Fin n) K))).comp C)
      (fun j => algebraMap _ _ (X j : MvPolynomial (Fin n) K)) a = algebraMap _ _ a := by
    exact (MvPolynomial.eval₂_comp_left _ C X a).symm.trans
      (congrArg _ (MvPolynomial.eval₂_eta a))
  rw [hc, hg, hh.eval₂_mul_left, e, eq_comm, Localization.mk_eq_mk',
    IsLocalization.mk'_eq_iff_eq_mul]
  simp only [map_pow]
  rw [mul_right_comm, ← mul_pow, mul_comm (IsLocalization.Away.invSelf _),
    IsLocalization.Away.mul_invSelf, one_pow, one_mul]

/-- The degree-zero localization at a variable is generated by the ratios over the constants. -/
theorem projectiveAway_eval₂Hom_surjective :
    Function.Surjective (eval₂Hom (projectiveAwayConstants (K := K) i) (projectiveAwayRatio i)) := by
  intro z
  obtain ⟨m, a, ha, rfl⟩ := Away.mk_surjective (homogeneousSubmodule (Fin n) K)
    (projectiveSpace.X_mem i) z
  exact ⟨a, projectiveAway_eval₂Hom_mk i m a ha⟩

end Dehomogenization

section ProjectiveSections

variable (K : Type u) [CommRing K] (n : ℕ)

/-- The constants of the base ring, as global functions of projective space. -/
noncomputable def polynomialProjectiveScalars : K →+* Γ(polynomialProjectiveScheme n K, ⊤) :=
  (polynomialProjectiveToBase n K).appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom

variable {K n}

/-- On a standard chart the constants of the structure morphism are the constants of the
degree-zero localization. -/
theorem polynomialProjectiveScalars_restrict (i : Fin n) (c : K) :
    (polynomialProjectiveScheme n K).presheaf.map
        (homOfLE (le_top : Proj.basicOpen (homogeneousSubmodule (Fin n) K) (X i) ≤ ⊤)).op
        (polynomialProjectiveScalars K n c) =
      Proj.awayToSection (homogeneousSubmodule (Fin n) K) (X i) (projectiveAwayConstants i c) := by
  have h := ConcreteCategory.congr_hom
    (CohomologyAux.toSpecZero_appTop_map (homogeneousSubmodule (Fin n) K) (f := X i)
      (projectiveSpace.X_mem i) one_pos)
    ((Scheme.ΓSpecIso _).inv ((polynomialDegreeZeroEquiv n K).symm c))
  rw [CommRingCat.comp_apply, CommRingCat.comp_apply, CommRingCat.comp_apply,
    Iso.inv_hom_id_apply] at h
  have h3 := ConcreteCategory.congr_hom (Scheme.ΓSpecIso_inv_naturality
    (polynomialDegreeZeroEquiv n K).symm.toCommRingCatIso.hom) c
  rw [CommRingCat.comp_apply, CommRingCat.comp_apply] at h3
  have h2 : polynomialProjectiveScalars K n c =
      (Proj.toSpecZero (homogeneousSubmodule (Fin n) K)).appTop
        ((Scheme.ΓSpecIso _).inv ((polynomialDegreeZeroEquiv n K).symm c)) := by
    change ((Proj.toSpecZero (homogeneousSubmodule (Fin n) K) ≫
      Spec.map (polynomialDegreeZeroEquiv n K).symm.toCommRingCatIso.hom).appTop)
        ((Scheme.ΓSpecIso (CommRingCat.of K)).inv c) = _
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
    exact congrArg _ h3.symm
  rw [h2]
  exact h

/-- The functions of a standard chart of projective space are generated by the ratios of the
coordinates over the constants. -/
theorem polynomialProjective_ratio_generate (i : Fin n) :
    Function.Surjective (eval₂Hom
      (((polynomialProjectiveScheme n K).presheaf.map
          (homOfLE (le_top : projectiveSpace.topStd (Fin n) K i ≤ ⊤)).op).hom.comp
        (polynomialProjectiveScalars K n))
      (fun k => projectiveSpace.ratio K k i)) := by
  intro s
  have hle : Proj.basicOpen (homogeneousSubmodule (Fin n) K) (X i) ≤
      projectiveSpace.topStd (Fin n) K i := le_inf le_top le_rfl
  have hge : projectiveSpace.topStd (Fin n) K i ≤
      Proj.basicOpen (homogeneousSubmodule (Fin n) K) (X i) := inf_le_right
  obtain ⟨z, hz⟩ := (ConcreteCategory.bijective_of_isIso
    (Proj.basicOpenIsoAway (homogeneousSubmodule (Fin n) K) (X i)
      (projectiveSpace.X_mem i) one_pos).hom).surjective
    ((polynomialProjectiveScheme n K).presheaf.map (homOfLE hle).op s)
  rw [Proj.basicOpenIsoAway_hom] at hz
  obtain ⟨p, rfl⟩ := projectiveAway_eval₂Hom_surjective i z
  refine ⟨p, ?_⟩
  have key : ((polynomialProjectiveScheme n K).presheaf.map (homOfLE hge).op).hom.comp
      ((Proj.awayToSection (homogeneousSubmodule (Fin n) K) (X i)).hom.comp
        (eval₂Hom (projectiveAwayConstants i) (projectiveAwayRatio i))) =
      eval₂Hom
        (((polynomialProjectiveScheme n K).presheaf.map
            (homOfLE (le_top : projectiveSpace.topStd (Fin n) K i ≤ ⊤)).op).hom.comp
          (polynomialProjectiveScalars K n))
        (fun k => projectiveSpace.ratio K k i) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      rw [RingHom.comp_apply, RingHom.comp_apply, eval₂Hom_C, eval₂Hom_C, RingHom.comp_apply]
      have h := polynomialProjectiveScalars_restrict i c
      change (polynomialProjectiveScheme n K).presheaf.map (homOfLE hge).op
        (Proj.awayToSection (homogeneousSubmodule (Fin n) K) (X i)
          (projectiveAwayConstants i c)) = _
      rw [← h]
      exact CohomologyAux.presheaf_map_map le_top hge _
    · intro j
      rw [RingHom.comp_apply, RingHom.comp_apply, eval₂Hom_X', eval₂Hom_X']
      change (polynomialProjectiveScheme n K).presheaf.map (homOfLE hge).op
        (Proj.awayToSection (homogeneousSubmodule (Fin n) K) (X i)
          (Away.mk _ (projectiveSpace.X_mem i) 1 (X j)
            (by rw [smul_eq_mul, mul_one]; exact projectiveSpace.X_mem j))) = _
      rw [Proj.awayToSection_mk, Proj.map_fracSection]
      exact Proj.fracSection_eq _ _ _ _ _ _ _ (by rw [pow_one])
  have h1 := congrArg (fun φ : MvPolynomial (Fin n) K →+*
    Γ(polynomialProjectiveScheme n K, projectiveSpace.topStd (Fin n) K i) => φ p) key
  rw [← h1]
  change (polynomialProjectiveScheme n K).presheaf.map (homOfLE hge).op
    (Proj.awayToSection (homogeneousSubmodule (Fin n) K) (X i)
      (eval₂Hom (projectiveAwayConstants i) (projectiveAwayRatio i) p)) = s
  rw [hz, CohomologyAux.presheaf_map_map]
  exact CohomologyAux.presheaf_map_self _ s

end ProjectiveSections

section AppRestriction

variable {X Y : Scheme.{u}}

/-- Restricting a pulled back function is pulling back its restriction. -/
theorem schemeHom_app_restrict_apply (f : X ⟶ Y) {U U' : Y.Opens} {V' : X.Opens}
    (hV : V' ≤ f ⁻¹ᵁ U) (hU : U' ≤ U) (e' : V' ≤ f ⁻¹ᵁ U') (s : Γ(Y, U)) :
    X.presheaf.map (homOfLE hV).op (f.app U s) =
      f.appLE U' V' e' (Y.presheaf.map (homOfLE hU).op s) := by
  have h := schemeHom_appLE_restrict_apply f (le_rfl : f ⁻¹ᵁ U ≤ f ⁻¹ᵁ U) hV hU e' s
  rw [Scheme.Hom.appLE_eq_app] at h
  exact h

end AppRestriction

section Atlas

variable {K : Type u} [Field K] {n : ℕ} {X : Scheme.{u}}
  (e : X ⟶ polynomialProjectiveScheme n K) [IsClosedImmersion e]

/-- The preimage of a standard chart under a closed immersion into projective space. -/
noncomputable abbrev projectiveAtlasOpen (i : Fin n) : X.affineOpens :=
  ⟨e ⁻¹ᵁ projectiveSpace.topStd (Fin n) K i,
    (projectiveSpace.isAffineOpen_topStd (σ := Fin n) (A := K) i).preimage e⟩

/-- The pulled back ratio x_k/x_i on the preimage of the chart of x_i. -/
noncomputable def projectiveAtlasRatio (i k : Fin n) : Γ(X, projectiveAtlasOpen e i) :=
  e.app (projectiveSpace.topStd (Fin n) K i) (projectiveSpace.ratio K k i)

theorem iSup_projectiveAtlasOpen : ⨆ i, (projectiveAtlasOpen e i).1 = ⊤ := by
  rw [eq_top_iff]
  intro x _
  obtain ⟨i, hi⟩ := polynomialProjective_exists_coordinate_chart n K (e x)
  exact Opens.mem_iSup.mpr
    ⟨i, (show e x ∈ projectiveSpace.topStd (Fin n) K i from ⟨trivial, hi⟩)⟩

theorem projectiveAtlasRatio_self (i : Fin n) : projectiveAtlasRatio e i i = 1 := by
  rw [projectiveAtlasRatio, projectiveSpace.ratio_self]
  exact map_one _

theorem basicOpen_projectiveAtlasRatio_le (i k : Fin n) :
    X.basicOpen (projectiveAtlasRatio e i k) ≤ (projectiveAtlasOpen e k).1 := by
  intro x hx
  have hx' : x ∈ e ⁻¹ᵁ (polynomialProjectiveScheme n K).basicOpen
      (projectiveSpace.ratio K k i) := by
    rw [Scheme.preimage_basicOpen]
    exact hx
  exact projectiveSpace.basicOpen_ratio_le k i hx'

/-- On an overlap of two charts, x_{k'}/x_i = (x_k/x_i)(x_{k'}/x_k). -/
theorem projectiveAtlasRatio_cocycle (i k k' : Fin n) :
    X.presheaf.map (homOfLE (inf_le_left :
        (projectiveAtlasOpen e i).1 ⊓ (projectiveAtlasOpen e k).1 ≤
          (projectiveAtlasOpen e i).1)).op (projectiveAtlasRatio e i k') =
      X.presheaf.map (homOfLE (inf_le_left :
          (projectiveAtlasOpen e i).1 ⊓ (projectiveAtlasOpen e k).1 ≤
            (projectiveAtlasOpen e i).1)).op (projectiveAtlasRatio e i k) *
        X.presheaf.map (homOfLE (inf_le_right :
          (projectiveAtlasOpen e i).1 ⊓ (projectiveAtlasOpen e k).1 ≤
            (projectiveAtlasOpen e k).1)).op (projectiveAtlasRatio e k k') := by
  have hP : (Proj (homogeneousSubmodule (Fin n) K)).presheaf.map (homOfLE (inf_le_left :
        projectiveSpace.topStd (Fin n) K i ⊓ projectiveSpace.topStd (Fin n) K k ≤
          projectiveSpace.topStd (Fin n) K i)).op (projectiveSpace.ratio K k' i) =
      (Proj (homogeneousSubmodule (Fin n) K)).presheaf.map (homOfLE (inf_le_left :
          projectiveSpace.topStd (Fin n) K i ⊓ projectiveSpace.topStd (Fin n) K k ≤
            projectiveSpace.topStd (Fin n) K i)).op (projectiveSpace.ratio K k i) *
        (Proj (homogeneousSubmodule (Fin n) K)).presheaf.map (homOfLE (inf_le_right :
          projectiveSpace.topStd (Fin n) K i ⊓ projectiveSpace.topStd (Fin n) K k ≤
            projectiveSpace.topStd (Fin n) K k)).op (projectiveSpace.ratio K k' k) := by
    simp only [projectiveSpace.ratio, Proj.map_fracSection]
    rw [Proj.fracSection_mul]
    exact Proj.fracSection_eq _ _ _ _ _ _ _ (by ring)
  have eW : (projectiveAtlasOpen e i).1 ⊓ (projectiveAtlasOpen e k).1 ≤
      e ⁻¹ᵁ (projectiveSpace.topStd (Fin n) K i ⊓ projectiveSpace.topStd (Fin n) K k) :=
    le_rfl
  have h1 := schemeHom_app_restrict_apply e
    (inf_le_left : (projectiveAtlasOpen e i).1 ⊓ (projectiveAtlasOpen e k).1 ≤
      (projectiveAtlasOpen e i).1)
    (inf_le_left : projectiveSpace.topStd (Fin n) K i ⊓ projectiveSpace.topStd (Fin n) K k ≤
      projectiveSpace.topStd (Fin n) K i) eW (projectiveSpace.ratio K k' i)
  have h2 := schemeHom_app_restrict_apply e
    (inf_le_left : (projectiveAtlasOpen e i).1 ⊓ (projectiveAtlasOpen e k).1 ≤
      (projectiveAtlasOpen e i).1)
    (inf_le_left : projectiveSpace.topStd (Fin n) K i ⊓ projectiveSpace.topStd (Fin n) K k ≤
      projectiveSpace.topStd (Fin n) K i) eW (projectiveSpace.ratio K k i)
  have h3 := schemeHom_app_restrict_apply e
    (inf_le_right : (projectiveAtlasOpen e i).1 ⊓ (projectiveAtlasOpen e k).1 ≤
      (projectiveAtlasOpen e k).1)
    (inf_le_right : projectiveSpace.topStd (Fin n) K i ⊓ projectiveSpace.topStd (Fin n) K k ≤
      projectiveSpace.topStd (Fin n) K k) eW (projectiveSpace.ratio K k' k)
  exact h1.trans ((congrArg _ hP).trans ((map_mul _ _ _).trans
    (congrArg₂ (· * ·) h2.symm h3.symm)))

/-- The pulled back ratios generate the functions of a chart over the base field. -/
theorem projectiveAtlasRatio_generate [X.Over (Spec (CommRingCat.of K))]
    (he : e ≫ polynomialProjectiveToBase n K = X ↘ Spec (CommRingCat.of K)) (i : Fin n) :
    Function.Surjective (eval₂Hom
      ((X.presheaf.map (homOfLE (le_top : (projectiveAtlasOpen e i).1 ≤ ⊤)).op).hom.comp
        (schemeBaseScalars K X))
      (projectiveAtlasRatio e i)) := by
  intro t
  obtain ⟨s, rfl⟩ := e.app_surjective (projectiveSpace.topStd (Fin n) K i)
    (projectiveSpace.isAffineOpen_topStd (σ := Fin n) (A := K) i) t
  obtain ⟨p, rfl⟩ := polynomialProjective_ratio_generate i s
  refine ⟨p, ?_⟩
  have hscal : schemeBaseScalars K X =
      e.appTop.hom.comp (polynomialProjectiveScalars K n) := by
    unfold schemeBaseScalars polynomialProjectiveScalars
    rw [← he, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_assoc]
  have hres : (e.app (projectiveSpace.topStd (Fin n) K i)).hom.comp
      ((polynomialProjectiveScheme n K).presheaf.map
        (homOfLE (le_top : projectiveSpace.topStd (Fin n) K i ≤ ⊤)).op).hom =
      (X.presheaf.map (homOfLE (le_top : (projectiveAtlasOpen e i).1 ≤ ⊤)).op).hom.comp
        e.appTop.hom := by
    have h := schemeHom_appLE_comp_restrict_top e (projectiveSpace.topStd (Fin n) K i)
      (e ⁻¹ᵁ projectiveSpace.topStd (Fin n) K i) le_rfl
    rw [Scheme.Hom.appLE_eq_app] at h
    exact h
  have hk : (e.app (projectiveSpace.topStd (Fin n) K i)).hom.comp
      (((polynomialProjectiveScheme n K).presheaf.map
          (homOfLE (le_top : projectiveSpace.topStd (Fin n) K i ≤ ⊤)).op).hom.comp
        (polynomialProjectiveScalars K n)) =
      (X.presheaf.map (homOfLE (le_top : (projectiveAtlasOpen e i).1 ≤ ⊤)).op).hom.comp
        (schemeBaseScalars K X) := by
    rw [hscal, ← RingHom.comp_assoc, hres]
    rfl
  have h := congrArg (fun φ : MvPolynomial (Fin n) K →+*
      Γ(X, e ⁻¹ᵁ projectiveSpace.topStd (Fin n) K i) => φ p)
    (OAI.PiExponentSeshadri.Projective.coordinates_eval_natural
      (e.app (projectiveSpace.topStd (Fin n) K i)).hom
      (((polynomialProjectiveScheme n K).presheaf.map
          (homOfLE (le_top : projectiveSpace.topStd (Fin n) K i ≤ ⊤)).op).hom.comp
        (polynomialProjectiveScalars K n))
      (fun k => projectiveSpace.ratio K k i))
  rw [RingHom.comp_apply, hk] at h
  exact h.symm

end Atlas

end MixedFujita
