module

public import MixedFujita.CartierSectionSNCNonzero
public import MixedFujita.CartierEquationFrameGenerator

/-!
Identify the ideal of the actual global zero subscheme with the principal ideal generated by
the coefficient of the section on every nonempty affine trivializing open. The proof uses the
actual generator of the negative Cartier sheaf, so it preserves the scheme structure and
multiplicity. Its support is consequently the intrinsic zero locus used by the SNC charts.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open TauCeti.AlgebraicGeometry.Scheme

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true

universe u

variable {X : Scheme.{u}}

/-- In a frame, the image of a map to the structure sheaf is the ideal of its generator image. -/
theorem moduleStructureHom_local_image (M : X.Modules)
    (φ : M ⟶ SheafOfModules.unit X.ringCatSheaf) (U : X.Opens)
    (e : M.restrict U.ι ≅ SheafOfModules.unit (U : Scheme).ringCatSheaf) :
    moduleStructureImageIdeal φ U = Ideal.span
      ({Scheme.Modules.Hom.app φ U (moduleOpenFrameGenerator M U e)} : Set Γ(X, U)) := by
  apply SetLike.coe_injective
  ext a
  change (∃ s, Scheme.Modules.Hom.app φ U s = a) ↔
    a ∈ Ideal.span ({Scheme.Modules.Hom.app φ U (moduleOpenFrameGenerator M U e)} : Set Γ(X, U))
  rw [Ideal.mem_span_singleton']
  constructor
  · rintro ⟨s, rfl⟩
    refine ⟨moduleOverFrameCoefficient M U (moduleRestrictFrameOverIso M U e) U le_rfl s, ?_⟩
    conv_rhs => rw [moduleOpenFrameGenerator_generates M U e U le_rfl s]
    rw [Scheme.Modules.Hom.app_smul]
    simp only [homOfLE_refl, op_id, M.presheaf.map_id, ConcreteCategory.id_apply, smul_eq_mul]
  · rintro ⟨r, hr⟩
    refine ⟨r • moduleOpenFrameGenerator M U e, ?_⟩
    rw [Scheme.Modules.Hom.app_smul]
    exact hr

variable [IsIntegral X]

/-- An effective Cartier ideal has its usual principal equation on a trivializing affine open. -/
theorem effectiveCartierIdealSheaf_ideal_eq_span (D : CartierDivisor X) (hD : D.IsEffective)
    (U : X.affineOpens) [Nonempty U.1] (a : Γ(X, U.1)) (ha : a ≠ 0)
    (hEq : rationalUnitClass X U.1
      (Additive.ofMul (regularEquationRationalUnit X U.1 a ha)) = D |_ U.1) :
    (effectiveCartierIdealSheaf D hD).ideal U = Ideal.span ({a} : Set Γ(X, U.1)) := by
  change moduleStructureImageIdeal (negativeCartierToUnit X D hD) U.1 = _
  rw [moduleStructureHom_local_image (-D).sheaf _ U.1
    (negativeCartierRegularEquationFrame D U.1 a ha hEq),
    negativeCartierRegularEquationFrameGenerator_image]

variable {K : Type u} [Field K] [X.Over (Spec (CommRingCat.of K))]

attribute [local instance] cartierGlobalStalkAlgebra cartierBaseGlobalAlgebra
  cartierBaseLocalAlgebra cartierBaseOpenAlgebra

/-- The regular coefficient represents the equation times the rational global section. -/
theorem cartierGlobalOpenCoefficient_image (D : CartierDivisor X) (U : X.Opens) [Nonempty U]
    (f : X.functionFieldˣ) (hf : rationalUnitClass X U (Additive.ofMul f) = D |_ U)
    (s : Γ(D.sheaf, ⊤)) :
    X.germToFunctionField U (cartierGlobalOpenCoefficient (K := K) D U f hf s) =
      (f : X.functionField) * cartierSectionRational D s := by
  obtain ⟨⟨x, hx⟩⟩ := (inferInstance : Nonempty U)
  have h := cartierLocalCoefficient_image D x f
    (CartierDivisor.isLocalEquationAt_of_rationalUnitClass_eq hf hx) s
  rw [← cartierGlobalOpenCoefficient_germ (K := K) D U f hf x hx,
    X.algebraMap_germ_eq_germToFunctionField hx] at h
  exact h

/-- Nonzero global sections have nonzero coefficients on every nonempty trivializing open. -/
theorem cartierGlobalOpenCoefficient_ne_zero (D : CartierDivisor X) (U : X.Opens) [Nonempty U]
    (f : X.functionFieldˣ) (hf : rationalUnitClass X U (Additive.ofMul f) = D |_ U)
    (s : Γ(D.sheaf, ⊤)) (hs : s ≠ 0) :
    cartierGlobalOpenCoefficient (K := K) D U f hf s ≠ 0 := by
  obtain ⟨⟨x, hx⟩⟩ := (inferInstance : Nonempty U)
  exact (cartierOpenCoefficient_ne_zero_iff D U f hf x hx s).mpr hs

/-- The coefficient is an actual regular local equation of the zero Cartier divisor. -/
theorem cartierSectionZeroDivisor_coefficient_equation (D : CartierDivisor X)
    (U : X.Opens) [Nonempty U] (f : X.functionFieldˣ)
    (hf : rationalUnitClass X U (Additive.ofMul f) = D |_ U)
    (s : Γ(D.sheaf, ⊤)) (hs : s ≠ 0) :
    rationalUnitClass X U (Additive.ofMul (regularEquationRationalUnit X U
      (cartierGlobalOpenCoefficient (K := K) D U f hf s)
      (cartierGlobalOpenCoefficient_ne_zero D U f hf s hs))) =
        (cartierSectionZeroDivisor D s hs) |_ U := by
  have hEq : regularEquationRationalUnit X U
      (cartierGlobalOpenCoefficient (K := K) D U f hf s)
      (cartierGlobalOpenCoefficient_ne_zero D U f hf s hs) =
        f * cartierSectionUnit D s hs := by
    apply Units.ext
    exact cartierGlobalOpenCoefficient_image D U f hf s
  rw [hEq]
  change rationalUnitClass X U (Additive.ofMul f + Additive.ofMul (cartierSectionUnit D s hs)) =
    (cartierDivisorSheaf X).1.map (homOfLE le_top).op
      (D + principalCartierDivisor X (cartierSectionUnit D s hs))
  rw [map_add, map_add, hf]
  change D |_ U + rationalUnitClass X U (Additive.ofMul (cartierSectionUnit D s hs)) =
    D |_ U + (principalCartierDivisor X (cartierSectionUnit D s hs)) |_ U
  rw [principalCartierDivisor_restrict]

/-- The global zero scheme has the principal coefficient ideal, with its scheme multiplicity. -/
theorem cartierSectionZeroIdeal_ideal_eq_span (D : CartierDivisor X)
    (s : Γ(D.sheaf, ⊤)) (hs : s ≠ 0) (U : X.affineOpens) [Nonempty U.1]
    (f : X.functionFieldˣ) (hf : rationalUnitClass X U.1 (Additive.ofMul f) = D |_ U.1) :
    (cartierSectionZeroIdeal D s hs).ideal U =
      Ideal.span ({cartierGlobalOpenCoefficient (K := K) D U.1 f hf s} : Set Γ(X, U.1)) :=
  effectiveCartierIdealSheaf_ideal_eq_span (cartierSectionZeroDivisor D s hs)
    (cartierSectionZeroDivisor_isEffective D s hs) U _
    (cartierGlobalOpenCoefficient_ne_zero D U.1 f hf s hs)
    (cartierSectionZeroDivisor_coefficient_equation D U.1 f hf s hs)

include K in
/-- The support of the actual global zero subscheme is the intrinsic zero locus. -/
theorem cartierSectionZeroIdeal_support (D : CartierDivisor X)
    (s : Γ(D.sheaf, ⊤)) (hs : s ≠ 0) :
    ((cartierSectionZeroIdeal D s hs).support : Set X) = cartierSectionZeroLocus D s := by
  ext x
  obtain ⟨f, hfx⟩ := D.exists_isLocalEquationAt x
  obtain ⟨V, hxV, hV⟩ := CartierDivisor.isLocalEquationAt_iff.mp hfx
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxV V.isOpen
  let : Nonempty U := ⟨⟨x, hxU⟩⟩
  let : Nonempty V := ⟨⟨x, hxV⟩⟩
  have hEq := CartierDivisor.rationalUnitClass_eq_of_le hUV hV
  change x ∈ (cartierSectionZeroIdeal D s hs).support ↔ x ∈ cartierSectionZeroLocus D s
  rw [(cartierSectionZeroIdeal D s hs).mem_support_iff_of_mem (U := ⟨U, hU⟩) hxU,
    cartierSectionZeroIdeal_ideal_eq_span (K := K) D s hs ⟨U, hU⟩ f hEq,
    Scheme.zeroLocus_span]
  have h := Set.ext_iff.mp (cartierSectionZeroLocus_inter (K := K) D U f hEq s) x
  simpa only [Set.mem_inter_iff, hxU, and_true] using h.symm

end MixedFujita
