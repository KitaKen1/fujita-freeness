module

public import MixedFujita.SNCModelPrimeOrders
public import MixedFujita.EffectiveCartierCoefficientSupport

/-!
The members of a simple normal crossing family as effective Cartier divisors (step 12).

Let X be an integral scheme, separated and locally of finite type over a field, with a simple
normal crossing family ξ_1, …, ξ_r of codimension-one points. The vanishing ideal sheaf of the
closure of ξ_i is generated on every simple normal crossing chart by the coordinate of ξ_i (a
coordinate ideal is radical), so it is invertible: it is the ideal sheaf of an effective Cartier
divisor E_i, with coefficient one at ξ_i and zero at every other codimension-one point.

Consequently the orders of the family along a prime divisor t of a smooth birational model
ρ : T → X are the coefficients of the pullbacks ρ*E_i at t: canonical numbers, which compute the
coefficient of the pullback of every Cartier divisor supported on the family and bound the log
discrepancy of t from below.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace
open TauCeti.AlgebraicGeometry
open TauCeti.AlgebraicGeometry.Scheme

namespace MixedFujita

attribute [local instance] Classical.propDecidable

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true

universe u

section IdealGenerator

variable {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]

/-- The coefficient of an effective Cartier divisor at a point is the order of any generator of
its ideal on an affine open neighbourhood of the point. -/
theorem cartierCoefficient_eq_ord_of_ideal_eq_span (D : CartierDivisor X) (hD : D.IsEffective)
    (U : X.affineOpens) [Nonempty U.1] (f : Γ(X, U.1))
    (hf : (effectiveCartierIdealSheaf D hD).ideal U = Ideal.span {f}) (x : X) (hx : x ∈ U.1) :
    cartierCoefficient D x = X.ord (X.germToFunctionField U.1 f) x := by
  obtain ⟨U', hxU', hne', a', ha', hEq'⟩ :=
    exists_affineOpen_regularEquation_of_isEffective D hD x
  obtain ⟨_, ⟨W, hW, rfl⟩, hxW, hWsub⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
    (show x ∈ ((U.1 ⊓ U'.1 : X.Opens) : Set X) from ⟨hx, hxU'⟩) (U.1 ⊓ U'.1).isOpen
  have hneW : Nonempty W := ⟨⟨x, hxW⟩⟩
  have hWle : W ≤ U.1 ⊓ U'.1 := hWsub
  have hWU : W ≤ U.1 := hWle.trans inf_le_left
  have hWU' : W ≤ U'.1 := hWle.trans inf_le_right
  obtain ⟨hb, hEqW⟩ := regularEquation_restrict D hWU' a' ha' hEq'
  have h1 : (effectiveCartierIdealSheaf D hD).ideal ⟨W, hW⟩ =
      Ideal.span {X.presheaf.map (homOfLE hWU').op a'} :=
    effectiveCartierIdealSheaf_ideal_eq_span D hD ⟨W, hW⟩ _ hb hEqW
  have h2 : (effectiveCartierIdealSheaf D hD).ideal ⟨W, hW⟩ =
      Ideal.span {X.presheaf.map (homOfLE hWU).op f} := by
    have hWU'' : (⟨W, hW⟩ : X.affineOpens) ≤ U := hWU
    have hm := (effectiveCartierIdealSheaf D hD).map_ideal hWU''
    rw [hf, Ideal.map_span, Set.image_singleton] at hm
    exact hm.symm
  obtain ⟨w, hw⟩ := Ideal.span_singleton_eq_span_singleton.mp (h1.symm.trans h2)
  have hinj := X.germToFunctionField_injective W
  have hbF : X.germToFunctionField W (X.presheaf.map (homOfLE hWU').op a') ≠ 0 := fun h =>
    hb (hinj (by rw [h, map_zero]))
  have hwF : X.germToFunctionField W (w : Γ(X, W)) ≠ 0 := fun h =>
    w.ne_zero (hinj (by rw [h, map_zero]))
  rw [cartierCoefficient_eq_ord
      (CartierDivisor.isLocalEquationAt_of_rationalUnitClass_eq hEqW hxW),
    regularEquationRationalUnit_val, ← germToFunctionField_restrict X hWU f, ← hw, map_mul,
    Scheme.ord_mul hbF hwF, X.ord_of_isUnit w.isUnit hxW, add_zero]

end IdealGenerator

section Components

variable {K : Type u} [Field K] {n : ℕ} {X : Scheme.{u}} [IsIntegral X]
  [X.Over (Spec (CommRingCat.of K))] [LocallyOfFiniteType (X ↘ Spec (CommRingCat.of K))]

/-- On a simple normal crossing chart, the vanishing ideal of the closure of a member of the
family is generated by the coordinate of the member, or is the unit ideal if the closure does not
meet the chart. -/
theorem vanishingIdeal_closure_ideal_sncChart (c : EtaleChart K X n) {r : ℕ} (ξ : Fin r → X)
    (σ : Fin r → Option (Fin n)) (hc : IsSNCChart c ξ σ) (i : Fin r) :
    (Scheme.IdealSheafData.vanishingIdeal
      (⟨closure ({ξ i} : Set X), isClosed_closure⟩ : Closeds X)).ideal ⟨c.U, c.isAffine⟩ =
      Ideal.span {(σ i).elim (1 : Γ(X, c.U)) (fun a => c.coords (MvPolynomial.X a))} := by
  rw [Scheme.IdealSheafData.vanishingIdeal_ideal]
  have hU : c.isAffine.fromSpec ⁻¹' (c.U : Set X) = Set.univ :=
    Set.eq_univ_of_forall fun p => by
      have : c.isAffine.fromSpec p ∈ Set.range c.isAffine.fromSpec := Set.mem_range_self p
      rwa [c.isAffine.range_fromSpec] at this
  have hpre : c.isAffine.fromSpec ⁻¹' (closure ({ξ i} : Set X)) =
      c.isAffine.fromSpec ⁻¹' (closure ({ξ i} : Set X) ∩ c.U) := by
    rw [Set.preimage_inter, hU, Set.inter_univ]
  have hset := hc.2 i
  change PrimeSpectrum.vanishingIdeal (c.isAffine.fromSpec ⁻¹' (closure ({ξ i} : Set X))) = _
  cases hσ : σ i with
  | none =>
    rw [hσ, Option.elim_none] at hset
    rw [hpre, hset, Set.preimage_empty, PrimeSpectrum.vanishingIdeal_empty, Option.elim_none,
      Ideal.span_singleton_one]
  | some a =>
    rw [hσ, Option.elim_some] at hset
    rw [hpre, hset, Set.preimage_inter, hU, Set.inter_univ,
      c.isAffine.fromSpec_preimage_zeroLocus, ← PrimeSpectrum.zeroLocus_span,
      PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
      (etaleChart_coordinate_span_isRadical c a).radical, Option.elim_some]

/-- The vanishing ideal sheaf of the closure of a member of a simple normal crossing family is
invertible. -/
theorem isInvertible_vanishingIdeal_closure_of_isSNCFamily {r : ℕ} (ξ : Fin r → X)
    (hsnc : IsSNCFamily K n ξ) (i : Fin r) :
    (Scheme.IdealSheafData.vanishingIdeal
      (⟨closure ({ξ i} : Set X), isClosed_closure⟩ : Closeds X)).IsInvertible := by
  intro x
  obtain ⟨c, σ, hx, hc⟩ := hsnc x
  refine ⟨⟨c.U, c.isAffine⟩, hx, (σ i).elim (1 : Γ(X, c.U)) (fun a => c.coords (MvPolynomial.X a)),
    ?_, vanishingIdeal_closure_ideal_sncChart c ξ σ hc i⟩
  apply mem_nonZeroDivisors_iff_ne_zero.mpr
  cases hσ : σ i with
  | none => exact one_ne_zero
  | some a => exact etaleChart_coordinate_ne_zero c a

variable [IsLocallyNoetherian X] [IsSeparated (X ↘ Spec (CommRingCat.of K))]

/-- The members of a simple normal crossing family are effective Cartier divisors: there are
effective Cartier divisors E_i whose ideal sheaf is the vanishing ideal sheaf of the closure of
ξ_i, with coefficient one at ξ_i and zero at every other codimension-one point. -/
theorem exists_snc_component_cartier {r : ℕ} (ξ : Fin r → X)
    (hξ : ∀ i, Order.coheight (ξ i) = 1) (hsnc : IsSNCFamily K n ξ) :
    ∃ E : Fin r → CartierDivisor X, ∃ hE : ∀ i, (E i).IsEffective,
      (∀ i, effectiveCartierIdealSheaf (E i) (hE i) = Scheme.IdealSheafData.vanishingIdeal
        (⟨closure ({ξ i} : Set X), isClosed_closure⟩ : Closeds X)) ∧
      ∀ (i : Fin r) (z : CodimensionOnePoint X),
        cartierCoefficient (E i) (z : X) = if (z : X) = ξ i then 1 else 0 := by
  have hex : ∀ i, ∃ (D : CartierDivisor X) (hD : D.IsEffective),
      effectiveCartierIdealSheaf D hD = Scheme.IdealSheafData.vanishingIdeal
        (⟨closure ({ξ i} : Set X), isClosed_closure⟩ : Closeds X) ∧
      ∀ z : CodimensionOnePoint X, cartierCoefficient D (z : X) = if (z : X) = ξ i then 1 else 0 := by
    intro i
    obtain ⟨D, hD, hDI, hD0⟩ := exists_effectiveCartier_of_invertibleIdeal_coefficient_of_overField
      (K := K) _ (isInvertible_vanishingIdeal_closure_of_isSNCFamily ξ hsnc i)
    refine ⟨D, hD, hDI, fun z => ?_⟩
    by_cases hz : (z : X) = ξ i
    · rw [ite_eq_left hz]
      obtain ⟨c, σ, hx, hc⟩ := hsnc (ξ i)
      have hmem : ξ i ∈ closure ({ξ i} : Set X) ∩ c.U := ⟨subset_closure rfl, hx⟩
      have hset := hc.2 i
      cases hσ : σ i with
      | none =>
        rw [hσ, Option.elim_none] at hset
        rw [hset] at hmem
        exact absurd hmem (Set.notMem_empty _)
      | some a =>
        have hgen : (effectiveCartierIdealSheaf D hD).ideal ⟨c.U, c.isAffine⟩ =
            Ideal.span {c.coords (MvPolynomial.X a)} := by
          rw [hDI, vanishingIdeal_closure_ideal_sncChart c ξ σ hc i, hσ, Option.elim_some]
        have : ∀ z : CodimensionOnePoint X, IsRegularLocalRing (X.presheaf.stalk (z : X)) :=
          fun z => isSNCFamily_stalk_regular hsnc (z : X)
        have hdvr : ∀ z : CodimensionOnePoint X,
            IsDiscreteValuationRing (X.presheaf.stalk (z : X)) := fun z => inferInstance
        have hord := isSNCChart_coordinate_ord c ξ hξ σ hc i a hσ ⟨ξ i, hξ i⟩ hx
        rw [ite_eq_left rfl] at hord
        rw [hz, cartierCoefficient_eq_ord_of_ideal_eq_span D hD ⟨c.U, c.isAffine⟩ _ hgen (ξ i) hx]
        exact hord
    · rw [ite_eq_right hz]
      apply hD0
      rw [← SetLike.mem_coe, Scheme.IdealSheafData.coe_support_vanishingIdeal]
      intro hmem
      exact hz ((scheme_codimensionOne_mem_closure_iff_eq (z : X) (ξ i) z.property (hξ i)).mp hmem)
  choose E hE hEI hEc using hex
  exact ⟨E, hE, hEI, hEc⟩

end Components

section Orders

attribute [local instance] cartierGlobalStalkAlgebra cartierGlobalStalkFunctionFieldTower
  cartierBaseGlobalAlgebra cartierBaseLocalAlgebra cartierBaseLocalScalarTower
  cartierBaseOpenAlgebra functionFieldBaseAlgebra

variable {K : Type u} [Field K] {n : ℕ} {X T : Scheme.{u}}
  [IsIntegral X] [IsIntegral T] [IsLocallyNoetherian X] [IsLocallyNoetherian T]
  [X.Over (Spec (CommRingCat.of K))] [T.Over (Spec (CommRingCat.of K))]
  [SmoothOfRelativeDimension n (X ↘ Spec (CommRingCat.of K))]
  [SmoothOfRelativeDimension n (T ↘ Spec (CommRingCat.of K))]
  (ρ : T ⟶ X) [IsDominant ρ] [ρ.IsOver (Spec (CommRingCat.of K))]
  (hρ : Function.Bijective (dominantFunctionFieldAlgHom (K := K) ρ))

/-- The orders of a simple normal crossing family along a prime divisor of a smooth birational
model are the coefficients of the pullbacks of the member divisors E_i: they are nonnegative,
vanish unless the closure of ξ_i contains the image of the prime, compute the coefficient of the
pullback of every Cartier divisor supported on the family, and bound the log discrepancy of the
prime from below for every boundary supported on the family. -/
theorem snc_component_orders_at_prime {r : ℕ} (ξ : Fin r → X) (hinj : Function.Injective ξ)
    (hξ : ∀ i, Order.coheight (ξ i) = 1) (hsnc : IsSNCFamily K n ξ) (E : Fin r → CartierDivisor X)
    (hEc : ∀ (i : Fin r) (z : CodimensionOnePoint X),
      cartierCoefficient (E i) (z : X) = if (z : X) = ξ i then 1 else 0)
    (t : CodimensionOnePoint T) :
    (∀ i, 0 ≤ cartierCoefficient (cartierPullback ρ (E i)) (t : T)) ∧
      (∀ i, cartierCoefficient (cartierPullback ρ (E i)) (t : T) ≠ 0 →
        ρ (t : T) ∈ closure ({ξ i} : Set X)) ∧
      (∀ B : CartierDivisor X, (∀ z : CodimensionOnePoint X, (z : X) ∉ Set.range ξ →
          cartierCoefficient B (z : X) = 0) →
        cartierCoefficient (cartierPullback ρ B) (t : T) =
          ∑ i, cartierCoefficient B (ξ i) * cartierCoefficient (cartierPullback ρ (E i)) (t : T)) ∧
      ∀ (c₀ : EtaleChart K X n) (f₀ : X.functionFieldˣ) (d : ℕ) (B : CartierDivisor X),
        (∀ z : CodimensionOnePoint X, (z : X) ∉ Set.range ξ →
          cartierCoefficient B (z : X) = 0) → ∀ c'₀ : EtaleChart K T n,
        (d : ℤ) * ∑ i, cartierCoefficient (cartierPullback ρ (E i)) (t : T) -
            ∑ i, cartierCoefficient B (ξ i) * cartierCoefficient (cartierPullback ρ (E i)) (t : T) ≤
          (d : ℤ) + cartierCoefficient (logDiscrepancyDivisor n ρ hρ c₀ f₀ d
            (d • (smoothCanonicalDivisor c₀ + principalCartierDivisor X f₀) + B)
            c'₀ etaleCharts_cover) (t : T) := by
  obtain ⟨o, ho, hosupp, hpull, hdisc⟩ := exists_snc_orders_at_prime ρ hρ ξ hinj hξ hsnc t
  have hEo : ∀ i, cartierCoefficient (cartierPullback ρ (E i)) (t : T) = o i := by
    intro i
    have hsupp : ∀ z : CodimensionOnePoint X, (z : X) ∉ Set.range ξ →
        cartierCoefficient (E i) (z : X) = 0 := by
      intro z hz
      rw [hEc i z, ite_eq_right fun h => hz ⟨i, h.symm⟩]
    rw [hpull (E i) hsupp, Finset.sum_eq_single i]
    · rw [hEc i ⟨ξ i, hξ i⟩, ite_eq_left rfl, one_mul]
    · intro j _ hji
      rw [hEc i ⟨ξ j, hξ j⟩, ite_eq_right fun h => hji (hinj h), zero_mul]
    · intro hi
      exact absurd (Finset.mem_univ i) hi
  simp only [hEo]
  exact ⟨ho, hosupp, hpull, hdisc⟩

end Orders

end MixedFujita
