module

public import MixedFujita.CartierSectionZeroIdeal
public import MixedFujita.CartierGlobalGenerationOperations
public import MixedFujita.MixedFujitaStatement
public import MixedFujita.ProjectiveSNCModelPrincipalization

/-!
The actual base ideal of a family of nonzero Cartier sections: in every affine frame it is
the ideal generated by their actual coefficients. Its support is the common zero locus.
Removing the zero divisor of a single section leaves a globally generated principal divisor.
-/

@[expose] public section
open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open TauCeti.AlgebraicGeometry.Scheme
namespace MixedFujita
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
universe u
variable {K : Type u} [Field K] {X : Scheme.{u}} [IsIntegral X]
  [X.Over (Spec (CommRingCat.of K))] {J : Type*}
attribute [local instance] cartierGlobalStalkAlgebra cartierBaseGlobalAlgebra
  cartierBaseLocalAlgebra cartierBaseOpenAlgebra functionFieldBaseAlgebra

noncomputable def cartierSectionBaseIdeal (D : CartierDivisor X)
    (s : J → Γ(D.sheaf, ⊤)) (hs : ∀ j, s j ≠ 0) : X.IdealSheafData :=
  ⨆ j, cartierSectionZeroIdeal D (s j) (hs j)

theorem cartierSectionBaseIdeal_ideal_eq_span (D : CartierDivisor X)
    (s : J → Γ(D.sheaf, ⊤)) (hs : ∀ j, s j ≠ 0) (U : X.affineOpens) [Nonempty U.1]
    (f : X.functionFieldˣ) (hf : rationalUnitClass X U.1 (Additive.ofMul f) = D |_ U.1) :
    (cartierSectionBaseIdeal D s hs).ideal U =
      Ideal.span (Set.range (fun j => cartierGlobalOpenCoefficient (K := K) D U.1 f hf (s j))) := by
  rw [cartierSectionBaseIdeal, Scheme.IdealSheafData.ideal_iSup, iSup_apply,
    Ideal.span_range_eq_iSup]
  exact iSup_congr fun j => cartierSectionZeroIdeal_ideal_eq_span D (s j) (hs j) U f hf

include K in
theorem cartierSectionBaseIdeal_support (D : CartierDivisor X)
    (s : J → Γ(D.sheaf, ⊤)) (hs : ∀ j, s j ≠ 0) :
    ((cartierSectionBaseIdeal D s hs).support : Set X) =
      ⋂ j, cartierSectionZeroLocus D (s j) := by
  rw [cartierSectionBaseIdeal, Scheme.IdealSheafData.support_iSup]
  ext x
  simp only [Closeds.coe_iInf, Set.mem_iInter]
  exact forall_congr' fun j => Set.ext_iff.mp (cartierSectionZeroIdeal_support (K := K)
    D (s j) (hs j)) x

theorem genericPoint_notMem_support_cartierSectionBaseIdeal [Nonempty J]
    (D : CartierDivisor X) (s : J → Γ(D.sheaf, ⊤)) (hs : ∀ j, s j ≠ 0) :
    genericPoint X ∉ ((cartierSectionBaseIdeal D s hs).support : Set X) := by
  exact genericPoint_notMem_support_iSup_effectiveCartierIdealSheaf
    (fun j => cartierSectionZeroDivisor D (s j) (hs j))
    (fun j => cartierSectionZeroDivisor_isEffective D (s j) (hs j))

omit [X.Over (Spec (CommRingCat.of K))] in
/-- A principal divisor has an explicit nowhere vanishing section. -/
theorem cartierIsGloballyGenerated_principal (f : X.functionFieldˣ) :
    CartierIsGloballyGenerated (principalCartierDivisor X f) := by
  apply (cartierIsGloballyGenerated_iff_local_frames _).mpr
  intro x g hg
  obtain ⟨v, hv⟩ := cartierLocalCoefficient_change_frame (principalCartierDivisor X f) x g f hg
    (CartierDivisor.isLocalEquationAt_principalCartierDivisor x f)
  refine ⟨principalUnitSection f, ?_⟩
  rw [hv, principalUnitSection_localCoefficient]
  exact v.isUnit.mul isUnit_one

omit [X.Over (Spec (CommRingCat.of K))] in
theorem cartierIsGloballyGenerated_sub_sectionZeroDivisor (D : CartierDivisor X)
    (s : Γ(D.sheaf, ⊤)) (hs : s ≠ 0) :
    CartierIsGloballyGenerated (D - cartierSectionZeroDivisor D s hs) := by
  have he : D - cartierSectionZeroDivisor D s hs =
      principalCartierDivisor X (cartierSectionUnit D s hs)⁻¹ := by
    rw [principalCartierDivisor_inv]
    simp only [cartierSectionZeroDivisor, neg_add_rev, sub_eq_add_neg]
    abel
  rw [he]
  exact cartierIsGloballyGenerated_principal _

end MixedFujita
