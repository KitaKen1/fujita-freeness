module

public import MixedFujita.LocalAdicOrder
public import Mathlib.RingTheory.MvPowerSeries.Order
public import Mathlib.RingTheory.MvPowerSeries.Trunc
public import Mathlib.RingTheory.Filtration

/-!
Germs of large weighted order lie in a monomial ideal (step 11, section 5.1 of the manuscript).

Let R be a Noetherian local algebra over a field K with a Taylor map T : R → K[[X]] sending
elements x_i of R to the variables and reflecting the powers of the maximal ideal (for example
the Taylor expansion at a rational point in completion coordinates). For weights w on the
variables, a germ a whose Taylor expansion has w-weighted order at least k lies in the ideal of R
generated by the monomials in the x_i of weight at least k: the truncations of the Taylor
expansion give elements of the ideal congruent to a modulo every power of the maximal ideal, and
ideals of a Noetherian local ring are closed (Krull). The weights may vanish on some variables.

Consequently, a function ν on a field containing R which is additive on products, satisfies
ν(f + g) ≥ min(ν f, ν g), is nonnegative on R and has ν(x_i) = w_i, satisfies ν(a) ≥ k: every
valuation taking the values w_i on the coordinates dominates the monomial valuation with weights
w. This is the inequality that makes a monomial Taylor test at a closed point a lower bound for
the order along the prime divisor extracted by the toric chart.
-/

@[expose] public section

namespace MixedFujita

variable {K : Type*} [Field K] {σ : Type*} [Fintype σ]

/-- The ideal generated by the monomials in x of weight at least k. -/
def monomialWeightIdeal {R : Type*} [CommRing R] (x : σ → R) (w : σ → ℕ) (k : ℕ) : Ideal R :=
  Ideal.span {m | ∃ α : σ →₀ ℕ, k ≤ Finsupp.weight w α ∧ m = ∏ i, x i ^ α i}

/-- A germ whose Taylor expansion has weighted order at least k lies in the ideal generated by
the monomials of weight at least k in the elements with Taylor expansions the variables. -/
theorem mem_monomialWeightIdeal_of_le_weightedOrder {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] [Algebra K R] (T : R →ₐ[K] MvPowerSeries σ K) (x : σ → R)
    (hx : ∀ i, T (x i) = MvPowerSeries.X i)
    (hT : ∀ (r : R) (d : ℕ), (d : ℕ∞) ≤ (T r).order → r ∈ IsLocalRing.maximalIdeal R ^ d)
    (w : σ → ℕ) (a : R) (k : ℕ) (hk : (k : ℕ∞) ≤ (T a).weightedOrder w) :
    a ∈ monomialWeightIdeal x w k := by
  classical
  -- approximation by elements of the ideal modulo the powers of the maximal ideal
  have happ : ∀ N : ℕ, ∃ b ∈ monomialWeightIdeal x w k,
      a - b ∈ IsLocalRing.maximalIdeal R ^ N := by
    intro N
    refine ⟨MvPolynomial.aeval x (MvPowerSeries.truncTotal N (T a)), ?_, ?_⟩
    · rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_eq']
      refine Ideal.sum_mem _ fun m hm =>
        Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨m, ?_, rfl⟩)
      by_contra hlt
      rw [not_le] at hlt
      apply MvPolynomial.mem_support_iff.mp hm
      rw [MvPowerSeries.coeff_truncTotal_eq_ite]
      split_ifs
      · exact MvPowerSeries.coeff_eq_zero_of_lt_weightedOrder w
          (lt_of_lt_of_le (by exact_mod_cast hlt) hk)
      · rfl
    · apply hT
      have hcomp : T.comp (MvPolynomial.aeval x) = MvPolynomial.coeToMvPowerSeries.algHom K := by
        apply MvPolynomial.algHom_ext
        intro i
        simp [hx]
      have hTP : T (MvPolynomial.aeval x (MvPowerSeries.truncTotal N (T a))) =
          ((MvPowerSeries.truncTotal N (T a) : MvPolynomial σ K) : MvPowerSeries σ K) := by
        have h := DFunLike.congr_fun hcomp (MvPowerSeries.truncTotal N (T a))
        simpa using h
      rw [map_sub, hTP]
      refine MvPowerSeries.nat_le_order fun d hd => ?_
      rw [map_sub, MvPolynomial.coeff_coe, MvPowerSeries.coeff_truncTotal _ hd, sub_self]
  -- ideals of a Noetherian local ring are closed
  have hbot := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (M := R ⧸ monomialWeightIdeal x w k)
    (IsLocalRing.maximalIdeal R) (IsLocalRing.maximalIdeal.isMaximal R).ne_top
  have hmem : Ideal.Quotient.mk (monomialWeightIdeal x w k) a ∈
      (⨅ i : ℕ, IsLocalRing.maximalIdeal R ^ i • ⊤ :
        Submodule R (R ⧸ monomialWeightIdeal x w k)) := by
    rw [Submodule.mem_iInf]
    intro N
    obtain ⟨b, hb, hab⟩ := happ N
    have h1 : Ideal.Quotient.mk (monomialWeightIdeal x w k) a =
        (a - b) • (1 : R ⧸ monomialWeightIdeal x w k) := by
      rw [Algebra.smul_def, mul_one]
      exact Ideal.Quotient.eq.mpr (by simpa using hb)
    rw [h1]
    exact Submodule.smul_mem_smul hab Submodule.mem_top
  rw [hbot] at hmem
  exact Ideal.Quotient.eq_zero_iff_mem.mp hmem

/-- A valuation-like function taking the values w on the elements x and nonnegative on the ring
is at least k on the ideal generated by the monomials of weight at least k. -/
theorem le_of_mem_monomialWeightIdeal {R F : Type*} [CommRing R] [Field F] (φ : R →+* F)
    (ν : F → ℤ) (hmul : ∀ f g : F, f ≠ 0 → g ≠ 0 → ν (f * g) = ν f + ν g)
    (hadd : ∀ f g : F, f ≠ 0 → g ≠ 0 → f + g ≠ 0 → min (ν f) (ν g) ≤ ν (f + g))
    (hnn : ∀ r : R, φ r ≠ 0 → 0 ≤ ν (φ r))
    (x : σ → R) (w : σ → ℕ) (hx0 : ∀ i, φ (x i) ≠ 0) (hxw : ∀ i, ν (φ (x i)) = (w i : ℤ))
    (k : ℕ) {a : R} (ha : a ∈ monomialWeightIdeal x w k) (ha0 : φ a ≠ 0) :
    (k : ℤ) ≤ ν (φ a) := by
  classical
  have h1 : ν 1 = 0 := by
    have h := hmul 1 1 one_ne_zero one_ne_zero
    rw [mul_one] at h
    omega
  have hpow : ∀ (f : F), f ≠ 0 → ∀ p : ℕ, ν (f ^ p) = (p : ℤ) * ν f := by
    intro f hf p
    induction p with
    | zero => simp [h1]
    | succ p ih =>
      rw [pow_succ, hmul _ _ (pow_ne_zero p hf) hf, ih]
      push_cast
      ring
  have hprod : ∀ (α : σ →₀ ℕ) (s : Finset σ),
      ν (∏ i ∈ s, φ (x i) ^ α i) = ∑ i ∈ s, (α i : ℤ) * (w i : ℤ) := by
    intro α s
    induction s using Finset.induction_on with
    | empty => simp [h1]
    | insert i s hi ih =>
      rw [Finset.prod_insert hi, Finset.sum_insert hi,
        hmul _ _ (pow_ne_zero _ (hx0 i))
          (Finset.prod_ne_zero_iff.mpr fun j _ => pow_ne_zero _ (hx0 j)),
        hpow _ (hx0 i), hxw i, ih]
  have hweight : ∀ α : σ →₀ ℕ, ((Finsupp.weight w α : ℕ) : ℤ) = ∑ i, (α i : ℤ) * (w i : ℤ) := by
    intro α
    rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun i => by simp)]
    simp only [smul_eq_mul]
    push_cast
    rfl
  change a ∈ Submodule.span R _ at ha
  induction ha using Submodule.span_induction with
  | mem m hm =>
    obtain ⟨α, hα, rfl⟩ := hm
    rw [map_prod]
    simp only [map_pow]
    rw [hprod α Finset.univ, ← hweight α]
    exact_mod_cast hα
  | zero => exact absurd (map_zero φ) ha0
  | add b c _ _ hb hc =>
    by_cases hb0 : φ b = 0
    · have hc0 : φ c ≠ 0 := by
        intro h
        apply ha0
        rw [map_add, hb0, h, add_zero]
      have h := hc hc0
      rwa [map_add, hb0, zero_add]
    by_cases hc0 : φ c = 0
    · have h := hb hb0
      rwa [map_add, hc0, add_zero]
    rw [map_add] at ha0 ⊢
    exact (le_min (hb hb0) (hc hc0)).trans (hadd _ _ hb0 hc0 ha0)
  | smul r b _ hb =>
    rw [smul_eq_mul, map_mul] at ha0 ⊢
    have hr0 : φ r ≠ 0 := left_ne_zero_of_mul ha0
    have hb0 : φ b ≠ 0 := right_ne_zero_of_mul ha0
    rw [hmul _ _ hr0 hb0]
    have h2 := hb hb0
    have h3 := hnn r hr0
    omega

end MixedFujita
