module

public import MixedFujita.MonomialIdealDomination
public import MixedFujita.ToricExtractionPrime
public import MixedFujita.PrimeDivisorTaylorTest
public import MixedFujita.SmoothPointInteriorWeight

/-!
The prime divisor extracted by the toric chart dominates the monomial Taylor test (step 11,
section 5.1 of the manuscript).

Let y be a point of a smooth variety X, c an étale chart at y and w ≠ 0 natural weights on the
coordinates of the chart, supported on the coordinates vanishing at y. The toric chart gives a
smooth birational model σ : U → X and a prime divisor e whose centre contains y, with
ord_e(x_a) = w'_a (w = g w') and ord_e of the Jacobian determinant Σ_a w'_a − 1.

* Domination. Let z be a specialization of y in the chart (for example z = y, or y the generic
  point of a stratum and z a closed point of it). In completion coordinates at z in which the
  Taylor expansion sends the coordinates of the chart to the variables, every nonzero germ a at z
  satisfies
  ord_e(σ^* a) ≥ (the w'-weighted order of the Taylor expansion of a): the germ lies in the ideal
  generated by the monomials of weight at least k, on which ord_e is at least k. The germ need
  not be a monomial times a unit; some weights may vanish.
* On a simple normal crossing chart for a family ξ, with weights on all the coordinates of the
  chart (not only on those cutting out members of the family): the coefficient at e of the
  pullback of a divisor supported on the family is Σ_j (coefficient at ξ_j) w'_{a(j)}, and d times
  the log discrepancy of e for a boundary B supported on the family with denominator d is
  d Σ_a w'_a − Σ_j (coefficient of B at ξ_j) w'_{a(j)}: the coordinates outside the family
  contribute their weights with log discrepancy one. Together with the domination.
* At a point with a K-valued point of the stalk there is a simple normal crossing chart all of
  whose coordinates vanish at the point and whose selected coordinates cut out exactly the members
  of the family through the point.

These are the inputs for the tangent variation of section 5.1: the valuation obtained from a
weight on a stratum by adding small weights in the directions along the stratum is a monomial
Taylor test at a closed point z of the stratum with all weights positive, and it is bounded below
by a scaled prime divisor over the base with the expected log discrepancy.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace
open TauCeti.AlgebraicGeometry
open TauCeti.AlgebraicGeometry.Scheme

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true

universe u

attribute [local instance] cartierGlobalStalkAlgebra cartierGlobalStalkFunctionFieldTower
  cartierBaseGlobalAlgebra cartierBaseLocalAlgebra cartierBaseLocalScalarTower
  cartierBaseOpenAlgebra functionFieldBaseAlgebra

variable {K : Type u} [Field K] {n : ℕ} {X : Scheme.{u}}
  [IsIntegral X] [IsLocallyNoetherian X] [X.Over (Spec (CommRingCat.of K))]
  [SmoothOfRelativeDimension n (X ↘ Spec (CommRingCat.of K))]

omit [IsLocallyNoetherian X] in
/-- The toric chart extracting the monomial valuation with weights w at a point y of an étale
chart, with the domination of the monomial Taylor test at every specialization z of y in the
chart: the order along the extracted prime of a nonzero germ at z is at least the weighted order of
its Taylor expansion. -/
theorem exists_toric_extraction_model_dominating (c : EtaleChart K X n) (y : X) (hy : y ∈ c.U)
    (w : Fin n → ℕ) (hw : w ≠ 0)
    (hwy : ∀ a, w a ≠ 0 → ¬ IsUnit (X.presheaf.germ c.U y hy (c.coords (MvPolynomial.X a)))) :
    ∃ (U : Scheme.{u}) (_ : IsIntegral U) (_ : IsLocallyNoetherian U)
      (_ : U.Over (Spec (CommRingCat.of K)))
      (_ : SmoothOfRelativeDimension n (U ↘ Spec (CommRingCat.of K)))
      (σ : U ⟶ X) (_ : IsDominant σ) (_ : σ.IsOver (Spec (CommRingCat.of K)))
      (_ : Function.Bijective (dominantFunctionFieldAlgHom (K := K) σ))
      (cU : EtaleChart K U n) (e : U) (g : ℕ) (w' : Fin n → ℕ),
      1 ≤ g ∧ (∀ a, w a = g * w' a) ∧ Order.coheight e = 1 ∧ e ∈ cU.U ∧
      y ∈ closure ({σ e} : Set X) ∧
      (∀ a, U.ord (dominantFunctionFieldAlgHom (K := K) σ
        (etaleChartFunctionFieldCoords c (MvPolynomial.X a))) e = (w' a : ℤ)) ∧
      U.ord (chartRelativeJacobianDet σ c cU) e = (∑ a, (w' a : ℤ)) - 1 ∧
      ∀ (z : X) (hz : z ∈ c.U), y ⤳ z →
      ∀ ez : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk z))
          (X.presheaf.stalk z) ≃ₐ[K] MvPowerSeries (Fin n) K,
        (∀ i, stalkTaylorExpansion z ez (etaleChartStalkCoords c z hz (MvPolynomial.X i)) =
          MvPowerSeries.X i) →
        ∀ (a : X.presheaf.stalk z) (k : ℕ), a ≠ 0 →
          (k : ℕ∞) ≤ (stalkTaylorExpansion z ez a).weightedOrder w' →
          (k : ℤ) ≤ U.ord (dominantFunctionFieldAlgHom (K := K) σ
            (algebraMap (X.presheaf.stalk z) X.functionField a)) e := by
  classical
  have hsm : Smooth (X ↘ Spec (CommRingCat.of K)) := SmoothOfRelativeDimension.smooth n _
  obtain ⟨U, hUint, hUnoeth, hUover, hUsm, σ, hσdom, hσover, hσbij, cU, e, g, w', hg, hww',
    hcoh, he, hclos, hord, hjac⟩ := exists_toric_extraction_model c y hy w hw hwy
  refine ⟨U, hUint, hUnoeth, hUover, hUsm, σ, hσdom, hσover, hσbij, cU, e, g, w', hg, hww',
    hcoh, he, hclos, hord, hjac, ?_⟩
  intro z hz hyz ez hez a k ha hk
  have hsmU : Smooth (U ↘ Spec (CommRingCat.of K)) := SmoothOfRelativeDimension.smooth n _
  have hdvr : IsDiscreteValuationRing (U.presheaf.stalk e) :=
    smoothOverField_codimensionOne_stalk_DVR (K := K) (⟨e, hcoh⟩ : CodimensionOnePoint U)
  have hnoeth : IsNoetherianRing (X.presheaf.stalk z) :=
    smoothScheme_stalk_isNoetherianRing (K := K) z
  have hsp : σ e ⤳ z := (specializes_iff_mem_closure.mpr hclos).trans hyz
  -- the germ lies in the ideal of the monomials of weight at least k
  have hmem := mem_monomialWeightIdeal_of_le_weightedOrder (stalkTaylorExpansion z ez)
    (fun i => etaleChartStalkCoords c z hz (MvPolynomial.X i)) hez
    (fun r d h => (completionCoordinates_mem_maximalIdeal_pow_iff ez.toRingEquiv r d).mp h)
    w' a k hk
  -- germs at z as rational functions on U
  obtain ⟨φ, hφdef⟩ : ∃ φ : X.presheaf.stalk z →+* U.functionField,
      ∀ r, φ r = dominantFunctionFieldAlgHom (K := K) σ
        (algebraMap (X.presheaf.stalk z) X.functionField r) :=
    ⟨(dominantFunctionFieldAlgHom (K := K) σ).toRingHom.comp
      (algebraMap (X.presheaf.stalk z) X.functionField), fun _ => rfl⟩
  have hφ0 : ∀ r, r ≠ 0 → φ r ≠ 0 := by
    intro r hr h
    rw [hφdef] at h
    exact hr (IsFractionRing.injective (X.presheaf.stalk z) X.functionField
      (((dominantFunctionFieldAlgHom (K := K) σ).toRingHom.injective) (by
        rw [map_zero]
        exact h) |>.trans (map_zero _).symm))
  have hX0 : ∀ i, etaleChartStalkCoords c z hz (MvPolynomial.X i) ≠ 0 := by
    intro i h
    have h1 := hez i
    rw [h, map_zero] at h1
    have h2 := congrArg (MvPowerSeries.coeff (Finsupp.single i 1)) h1
    rw [map_zero, MvPowerSeries.coeff_X, ite_eq_left rfl] at h2
    exact zero_ne_one h2
  rw [← hφdef]
  refine le_of_mem_monomialWeightIdeal φ (fun f => U.ord f e)
    (fun f g hf hg => Scheme.ord_mul hf hg) (fun f g _ _ hfg => Scheme.ord_add hfg) ?_
    (fun i => etaleChartStalkCoords c z hz (MvPolynomial.X i)) w' (fun i => hφ0 _ (hX0 i)) ?_ k
    hmem (hφ0 a ha)
  · intro r _
    rw [hφdef]
    apply scheme_ord_nonneg_of_mem_stalk
    refine ⟨σ.stalkMap e (X.presheaf.stalkSpecializes hsp r), ?_⟩
    rw [← dominantFunctionFieldMap_algebraMap, algebraMap_stalkSpecializes_functionField]
    rfl
  · intro i
    rw [hφdef, ← hord i]
    congr 2
    exact DFunLike.congr_fun (etaleChart_stalkFunctionField_comp_stalkCoords c z hz)
      (MvPolynomial.X i)

omit [IsIntegral X] [IsLocallyNoetherian X] in
/-- At a point with a K-valued point of the stalk, a simple normal crossing family has a chart all
of whose coordinates vanish at the point and whose selected coordinates cut out exactly the
members of the family through the point. -/
theorem exists_centered_snc_chart {r : ℕ} (ξ : Fin r → X) (hsnc : IsSNCFamily K n ξ) (z : X)
    (β : X.presheaf.stalk z →ₐ[K] K) :
    ∃ (c : EtaleChart K X n) (σc : Fin r → Option (Fin n)) (hz : z ∈ c.U), IsSNCChart c ξ σc ∧
      (∀ a, ¬ IsUnit (X.presheaf.germ c.U z hz (c.coords (MvPolynomial.X a)))) ∧
      (∀ j a, σc j = some a → z ∈ closure ({ξ j} : Set X)) ∧
      ∀ j, z ∈ closure ({ξ j} : Set X) → ∃ a, σc j = some a := by
  classical
  have hsm : Smooth (X ↘ Spec (CommRingCat.of K)) := SmoothOfRelativeDimension.smooth n _
  obtain ⟨c₀, σ₀, hz₀, hc₀⟩ := hsnc z
  -- shrink the chart away from the members not through z
  have hCclosed : IsClosed (⋃ j ∈ (Finset.univ.filter fun j => z ∉ closure ({ξ j} : Set X)),
      closure ({ξ j} : Set X)) :=
    isClosed_biUnion_finset fun j _ => isClosed_closure
  have hzC : z ∉ ⋃ j ∈ (Finset.univ.filter fun j => z ∉ closure ({ξ j} : Set X)),
      closure ({ξ j} : Set X) := by
    simp only [Set.mem_iUnion, Finset.mem_filter, Finset.mem_univ, true_and, not_exists]
    intro j hj hzj
    exact hj hzj
  obtain ⟨c₁, hz₁, hdisj, hc₁⟩ := exists_snc_chart_avoiding hc₀ hz₀ hCclosed hzC
  have hempty : ∀ j, z ∉ closure ({ξ j} : Set X) → closure ({ξ j} : Set X) ∩ c₁.U = ∅ := by
    intro j hj
    ext p
    simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
    intro hp hpU
    have hpC : p ∈ (c₁.U : Set X) ∩ ⋃ j ∈ (Finset.univ.filter
        fun j => z ∉ closure ({ξ j} : Set X)), closure ({ξ j} : Set X) := by
      refine ⟨hpU, ?_⟩
      simp only [Set.mem_iUnion, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨j, hj, hp⟩
    rw [hdisj] at hpC
    exact hpC
  -- the selection on the shrunk chart
  obtain ⟨σ₁, hσ₁⟩ : ∃ σ₁ : Fin r → Option (Fin n),
      ∀ j, σ₁ j = if z ∈ closure ({ξ j} : Set X) then σ₀ j else none := ⟨_, fun _ => rfl⟩
  have hσ₁some : ∀ j a, σ₁ j = some a → z ∈ closure ({ξ j} : Set X) ∧ σ₀ j = some a := by
    intro j a hja
    rw [hσ₁ j] at hja
    by_cases hzj : z ∈ closure ({ξ j} : Set X)
    · rw [ite_eq_left hzj] at hja
      exact ⟨hzj, hja⟩
    · rw [ite_eq_right hzj] at hja
      exact absurd hja (by simp)
  have hnu₁ : ∀ j a, σ₁ j = some a →
      ¬ IsUnit (X.presheaf.germ c₁.U z hz₁ (c₁.coords (MvPolynomial.X a))) := by
    intro j a hja hu
    obtain ⟨hzj, hja₀⟩ := hσ₁some j a hja
    have hmem : z ∈ closure ({ξ j} : Set X) ∩ c₁.U := ⟨hzj, hz₁⟩
    rw [hc₁.2 j, hja₀, Option.elim_some, Scheme.zeroLocus_singleton] at hmem
    exact hmem.1 ((X.mem_basicOpen _ z hz₁).mpr hu)
  have hα0 : ∀ j a, σ₁ j = some a →
      rationalAffineGermPoint z hz₁ β (c₁.coords (MvPolynomial.X a)) = 0 := by
    intro j a hja
    change β (X.presheaf.germ c₁.U z hz₁ (c₁.coords (MvPolynomial.X a))) = 0
    exact not_not.mp ((rationalLocalPoint_isUnit_iff β _).not.mp (hnu₁ j a hja))
  refine ⟨etaleChartCentered c₁ (rationalAffineGermPoint z hz₁ β), σ₁, hz₁, ⟨?_, ?_⟩,
    fun a => etaleChartCentered_germ_not_isUnit c₁ z hz₁ β a,
    fun j a hja => (hσ₁some j a hja).1, fun j hzj => ?_⟩
  · intro i j a hi hj
    exact hc₁.1 i j a (hσ₁some i a hi).2 (hσ₁some j a hj).2
  · intro j
    cases hσ : σ₁ j with
    | none =>
      change closure ({ξ j} : Set X) ∩ c₁.U = ∅
      by_cases hzj : z ∈ closure ({ξ j} : Set X)
      · have h := hc₁.2 j
        rw [hσ₁ j, ite_eq_left hzj] at hσ
        rw [hσ] at h
        exact h
      · exact hempty j hzj
    | some a =>
      obtain ⟨hzj, hja₀⟩ := hσ₁some j a hσ
      have h := hc₁.2 j
      rw [hja₀, Option.elim_some] at h
      change closure ({ξ j} : Set X) ∩ c₁.U =
        X.zeroLocus ({(centeredPolynomialChart c₁.coords (rationalAffineGermPoint z hz₁ β)
          (MvPolynomial.X a))} : Set Γ(X, c₁.U)) ∩ c₁.U
      rw [centeredPolynomialChart_variable, hα0 j a hσ, map_zero, sub_zero]
      exact h
  · cases hσ : σ₁ j with
    | none =>
      exfalso
      rw [hσ₁ j, ite_eq_left hzj] at hσ
      have hmem : z ∈ closure ({ξ j} : Set X) ∩ c₁.U := ⟨hzj, hz₁⟩
      rw [hc₁.2 j, hσ] at hmem
      exact hmem
    | some a => exact ⟨a, rfl⟩

/-- The extraction prime of a monomial valuation on a simple normal crossing chart, with weights
on all the coordinates of the chart: the members of the family have orders given by the weights of
their coordinates, the log discrepancy for every boundary supported on the family is given by the
weights (the coordinates outside the family count with log discrepancy one), and the order along
the prime dominates the monomial Taylor test at every specialization of the point in the chart. -/
theorem exists_snc_chart_extraction_prime {r : ℕ} (ξ : Fin r → X) (hinj : Function.Injective ξ)
    (hξ : ∀ i, Order.coheight (ξ i) = 1) (hsnc : IsSNCFamily K n ξ) (c : EtaleChart K X n)
    (σc : Fin r → Option (Fin n)) (hc : IsSNCChart c ξ σc) (y : X) (hy : y ∈ c.U)
    (w : Fin n → ℕ) (hw : w ≠ 0)
    (hwy : ∀ a, w a ≠ 0 → ¬ IsUnit (X.presheaf.germ c.U y hy (c.coords (MvPolynomial.X a)))) :
    ∃ (U : Scheme.{u}) (_ : IsIntegral U) (_ : IsLocallyNoetherian U)
      (_ : U.Over (Spec (CommRingCat.of K)))
      (_ : SmoothOfRelativeDimension n (U ↘ Spec (CommRingCat.of K)))
      (σ : U ⟶ X) (_ : IsDominant σ) (_ : σ.IsOver (Spec (CommRingCat.of K)))
      (hσ : Function.Bijective (dominantFunctionFieldAlgHom (K := K) σ))
      (cU : EtaleChart K U n) (e : CodimensionOnePoint U) (g : ℕ) (w' : Fin n → ℕ),
      1 ≤ g ∧ (∀ a, w a = g * w' a) ∧ y ∈ closure ({σ (e : U)} : Set X) ∧
      (∀ B : CartierDivisor X, (∀ t : CodimensionOnePoint X, (t : X) ∉ Set.range ξ →
          cartierCoefficient B (t : X) = 0) →
        cartierCoefficient (cartierPullback σ B) (e : U) =
          ∑ j, cartierCoefficient B (ξ j) * (((σc j).elim 0 w' : ℕ) : ℤ)) ∧
      (∀ (c₀ : EtaleChart K X n) (f₀ : X.functionFieldˣ) (d : ℕ) (B : CartierDivisor X),
        (∀ t : CodimensionOnePoint X, (t : X) ∉ Set.range ξ →
          cartierCoefficient B (t : X) = 0) →
        (d : ℤ) + cartierCoefficient (logDiscrepancyDivisor n σ hσ c₀ f₀ d
            (d • (smoothCanonicalDivisor c₀ + principalCartierDivisor X f₀) + B)
            cU etaleCharts_cover) (e : U) =
          (d : ℤ) * ∑ a, (w' a : ℤ) -
            ∑ j, cartierCoefficient B (ξ j) * (((σc j).elim 0 w' : ℕ) : ℤ)) ∧
      ∀ (z : X) (hz : z ∈ c.U), y ⤳ z →
      ∀ ez : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk z))
          (X.presheaf.stalk z) ≃ₐ[K] MvPowerSeries (Fin n) K,
        (∀ i, stalkTaylorExpansion z ez (etaleChartStalkCoords c z hz (MvPolynomial.X i)) =
          MvPowerSeries.X i) →
        ∀ (a : X.presheaf.stalk z) (k : ℕ), a ≠ 0 →
          (k : ℕ∞) ≤ (stalkTaylorExpansion z ez a).weightedOrder w' →
          (k : ℤ) ≤ U.ord (dominantFunctionFieldAlgHom (K := K) σ
            (algebraMap (X.presheaf.stalk z) X.functionField a)) (e : U) := by
  classical
  have : Smooth (X ↘ Spec (CommRingCat.of K)) := SmoothOfRelativeDimension.smooth n _
  have hnorm : ∀ t : X, IsIntegrallyClosed (X.presheaf.stalk t) :=
    isSNCFamily_stalk_isIntegrallyClosed hsnc
  have : ∀ t : CodimensionOnePoint X, IsRegularLocalRing (X.presheaf.stalk (t : X)) :=
    fun t => isSNCFamily_stalk_regular hsnc (t : X)
  have : ∀ t : CodimensionOnePoint X, IsDiscreteValuationRing (X.presheaf.stalk (t : X)) :=
    fun t => inferInstance
  obtain ⟨U, hUint, hUnoeth, hUover, hUsm, σ, hσdom, hσover, hσbij, cU, e, g, w', hg, hww',
    hcoh, he, hclos, hord, hjac, hdom⟩ := exists_toric_extraction_model_dominating c y hy w hw hwy
  have hσe : σ e ∈ c.U := (specializes_iff_mem_closure.mpr hclos).mem_open c.U.isOpen hy
  have hcomp : ∀ j, U.ord ((dominantFunctionFieldMap σ).hom
      (sncChartComponentEquation c σc j : X.functionField)) e =
        (((σc j).elim 0 w' : ℕ) : ℤ) := by
    intro j
    cases hσ : σc j with
    | none =>
      simp only [sncChartComponentEquation, hσ, Option.elim_none, Units.val_one, map_one,
        TauCeti.AlgebraicGeometry.Scheme.ord_one, Nat.cast_zero]
    | some a =>
      simp only [sncChartComponentEquation, hσ, Option.elim_some]
      exact hord a
  have hcoef : ∀ B : CartierDivisor X, (∀ t : CodimensionOnePoint X, (t : X) ∉ Set.range ξ →
      cartierCoefficient B (t : X) = 0) →
      cartierCoefficient (cartierPullback σ B) e =
        ∑ j, cartierCoefficient B (ξ j) * (((σc j).elim 0 w' : ℕ) : ℤ) := by
    intro B hsupport
    obtain ⟨f, hf, u, hu⟩ := normal_isSNCChart_boundary_local_product hnorm B c ξ hinj hξ σc
      hc hsupport (σ e) hσe
    rw [cartierPullback_coefficient_of_local_product σ B ⟨e, hcoh⟩ f hf u _ _ hu]
    exact Finset.sum_congr rfl fun j _ => by rw [hcomp j]
  refine ⟨U, hUint, hUnoeth, hUover, hUsm, σ, hσdom, hσover, hσbij, cU, ⟨e, hcoh⟩, g, w', hg,
    hww', hclos, hcoef, ?_, hdom⟩
  intro c₀ f₀ d B hsupport
  rw [logDiscrepancyDivisor_boundary_add, cartierCoefficient_sub, cartierCoefficient_nsmul,
    hcoef B hsupport]
  have hloc := relativeCanonicalDivisor_isLocalEquationAt σ c₀ etaleCharts_cover cU
    etaleCharts_cover (isUnit_chartRelativeJacobianDet_of_bijective σ hσbij c₀ cU) e c hσe cU he
  unfold birationalRelativeCanonicalDivisor
  rw [cartierCoefficient_eq_ord hloc, IsUnit.unit_spec, hjac]
  ring

end MixedFujita
