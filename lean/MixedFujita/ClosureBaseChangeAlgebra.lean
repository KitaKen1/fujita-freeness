module

public import Mathlib.RingTheory.IsTensorProduct
public import Mathlib.RingTheory.MvPolynomial.Tower
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.AlgebraicGeometry.Pullbacks
public import Mathlib.AlgebraicGeometry.AffineScheme

/-!
Base change of the image of a polynomial ring (step 10, R4-3).

* `isPushout_of_mvPolynomial_ker`: let `B` be an `A`-algebra and `C` a `K`-algebra, presented as
  quotients of polynomial rings over `A` and `K` in the same variables, with `B ↪ C` compatible with
  `A → K`. If the kernel of `K[X] → C` is generated by polynomials with coefficients in `A` (images
  of polynomials over `A` in the kernel), then `K ⊗[A] B ≅ C`, i.e. `Algebra.IsPushout A K B C`.
  The inverse `C → K ⊗[A] B` sends `X_i` to `1 ⊗ X_i`; it is well defined because the generators of
  the kernel come from `A[X]`, where they already die in `B ⊆ C`.
* `isPullback_of_isPushout_appTop`: a square of affine schemes whose global sections form a pushout
  of rings is a pullback (the converse of Mathlib's `isPushout_appTop_of_isPullback`).

In the application `C` is the ring of a chart of `T_K` and `B` the ring of the same chart of the
closure `T_A`; with the generators of the ideals of the charts of `T_K` in `A`, the closure is a
model: `T_K = T_A ×_A K`.
-/

@[expose] public section

open CategoryTheory Limits TensorProduct

namespace MixedFujita

universe u

section Pushout

variable {A K B C : Type u} [CommRing A] [CommRing K] [CommRing B] [CommRing C]
  [Algebra A K] [Algebra A B] [Algebra K C] [Algebra B C] [Algebra A C]
  [IsScalarTower A K C] [IsScalarTower A B C] {σ : Type*}

/-- The canonical map `K ⊗[A] B → C`. -/
noncomputable def tensorProductLiftAlgHom : K ⊗[A] B →ₐ[K] C :=
  Algebra.TensorProduct.lift (Algebra.ofId K C) (IsScalarTower.toAlgHom A B C)
    fun _ _ => Commute.all _ _

theorem tensorProductLiftAlgHom_tmul (k : K) (b : B) :
    tensorProductLiftAlgHom (k ⊗ₜ[A] b) = algebraMap K C k * algebraMap B C b :=
  Algebra.TensorProduct.lift_tmul _ _ _ k b

/-- **Base change of the image of a polynomial ring.** If `B = A[X]/I_A` embeds into
`C = K[X]/I_K` compatibly with `A → K`, and `I_K` is generated by polynomials with coefficients in
`A`, then `C = K ⊗[A] B`. -/
theorem isPushout_of_mvPolynomial_ker (ψ : MvPolynomial σ A →ₐ[A] B) (hψ : Function.Surjective ψ)
    (φ : MvPolynomial σ K →ₐ[K] C) (hφ : Function.Surjective φ)
    (hinj : Function.Injective (algebraMap B C))
    (hcomp : ∀ p, algebraMap B C (ψ p) = φ (MvPolynomial.map (algebraMap A K) p))
    (hker : RingHom.ker φ ≤ Ideal.span (MvPolynomial.map (algebraMap A K) ''
      {p | φ (MvPolynomial.map (algebraMap A K) p) = 0})) :
    Algebra.IsPushout A K B C := by
  let ν₀ : MvPolynomial σ K →ₐ[K] K ⊗[A] B :=
    MvPolynomial.aeval fun i => (1 : K) ⊗ₜ[A] ψ (MvPolynomial.X i)
  have hν₀ : ∀ p : MvPolynomial σ A,
      ν₀ (MvPolynomial.map (algebraMap A K) p) = (1 : K) ⊗ₜ[A] ψ p := by
    intro p
    have h : (MvPolynomial.aeval fun i => (1 : K) ⊗ₜ[A] ψ (MvPolynomial.X i) :
        MvPolynomial σ A →ₐ[A] K ⊗[A] B) = Algebra.TensorProduct.includeRight.comp ψ :=
      MvPolynomial.algHom_ext fun i => by simp
    change MvPolynomial.aeval _ (MvPolynomial.map (algebraMap A K) p) = _
    rw [MvPolynomial.aeval_map_algebraMap]
    exact AlgHom.congr_fun h p
  have hkerν : RingHom.ker φ ≤ RingHom.ker ν₀ := by
    refine hker.trans (Ideal.span_le.2 ?_)
    rintro _ ⟨p, hp, rfl⟩
    have h0 : ψ p = 0 := hinj (by rw [hcomp, map_zero]; exact hp)
    change ν₀ _ = 0
    rw [hν₀, h0, TensorProduct.tmul_zero]
  let ν : C →ₐ[K] K ⊗[A] B := AlgHom.liftOfSurjective φ hφ ν₀ hkerν
  have hν : ∀ p, ν (φ p) = ν₀ p := fun p => AlgHom.liftOfSurjective_apply φ hφ ν₀ hkerν p
  let μ : K ⊗[A] B →ₐ[K] C := tensorProductLiftAlgHom
  have hμb : ∀ b : B, μ ((1 : K) ⊗ₜ[A] b) = algebraMap B C b := by
    intro b
    rw [tensorProductLiftAlgHom_tmul, map_one, one_mul]
  have hμν : ∀ x, μ (ν x) = x := by
    intro x
    obtain ⟨p, rfl⟩ := hφ x
    rw [hν]
    have h : μ.comp ν₀ = φ := MvPolynomial.algHom_ext fun i => by
      rw [AlgHom.comp_apply]
      change μ (MvPolynomial.aeval _ (MvPolynomial.X i)) = _
      rw [MvPolynomial.aeval_X, hμb, hcomp, MvPolynomial.map_X]
    exact AlgHom.congr_fun h p
  have hνμ : ∀ y, ν (μ y) = y := by
    intro y
    induction y using TensorProduct.inductionOn with
    | tmul k b =>
      obtain ⟨p, rfl⟩ := hψ b
      rw [tensorProductLiftAlgHom_tmul, map_mul, AlgHom.commutes, hcomp, hν, hν₀,
        Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
        one_mul]
      rfl
    | add y z hy hz => rw [map_add, map_add, hy, hz]
  refine ⟨IsBaseChange.of_equiv (LinearEquiv.ofBijective μ.toLinearMap
    ⟨Function.LeftInverse.injective hνμ, Function.RightInverse.surjective hμν⟩) fun b => ?_⟩
  exact hμb b

end Pushout

section AffinePullback

open AlgebraicGeometry

/-- A square of affine schemes whose global sections form a pushout of rings is a pullback. -/
theorem isPullback_of_isPushout_appTop {P X Y Z : Scheme.{u}} [IsAffine P] [IsAffine X]
    [IsAffine Y] [IsAffine Z] (fst : P ⟶ X) (snd : P ⟶ Y) (f : X ⟶ Z) (g : Y ⟶ Z)
    (h : IsPushout f.appTop g.appTop fst.appTop snd.appTop) : IsPullback fst snd f g :=
  (isPullback_SpecMap_of_isPushout _ _ _ _ h).of_iso P.isoSpec.symm X.isoSpec.symm
    Y.isoSpec.symm Z.isoSpec.symm (Scheme.isoSpec_inv_naturality fst)
    (Scheme.isoSpec_inv_naturality snd) (Scheme.isoSpec_inv_naturality f)
    (Scheme.isoSpec_inv_naturality g)

end AffinePullback

end MixedFujita
