module

public import MixedFujita.GenericSmoothSpreading
public import Mathlib.RingTheory.RingHom.StandardSmooth
public import Mathlib.RingTheory.RingHom.Locally

/-!
Spreading out a cover by standard smooth localizations (step 10, R4-3).

Let `C` be an `S`-algebra generated by a finite set `Y`, covered by localizations `C[1/c]` that are
standard smooth of relative dimension `n` over `S` (the ring of an affine open of a smooth variety,
`RingHom.Locally`). There is a finitely generated `R`-subalgebra `A₀` of `S` such that for every
`A' ≥ A₀` and every `A'`-algebra `B` embedded in `C` over `A' → S`, generated by elements mapping
into `Y` and with image containing `Y`, the ring `B` is covered by localizations `B[1/b]`, standard
smooth of relative dimension `n` over `A'` (`exists_fg_forall_locally_isStandardSmooth`). The `b`
are preimages of the `c`, and they generate the unit ideal because a partition of unity of the `c`
comes from `B` once `A'` contains finitely many coefficients.

In the application `C` is the ring of a standard chart of `T_K` and `B` that of the same chart of
the closure `T_A` of `T_K` in projective space over `A`.
-/

@[expose] public section

namespace MixedFujita

universe u

section Localization

variable {R B : Type*} [CommRing R] [CommRing B] [Algebra R B]

theorem localizationAway_mk_eq_mul_invSelf_pow (b x : B) (k : ℕ) :
    IsLocalization.mk' (Localization.Away b) x (⟨b ^ k, k, rfl⟩ : Submonoid.powers b) =
      algebraMap B (Localization.Away b) x *
        (IsLocalization.Away.invSelf b : Localization.Away b) ^ k := by
  rw [IsLocalization.mk'_eq_iff_eq_mul]
  change _ = _ * _ * algebraMap B _ (b ^ k)
  rw [map_pow, mul_assoc, ← mul_pow, mul_comm (IsLocalization.Away.invSelf b : Localization.Away b),
    IsLocalization.Away.mul_invSelf, one_pow, mul_one]

/-- A localization `B[1/b]` is generated over `R` by `1/b` and the images of generators of `B`. -/
theorem adjoin_insert_invSelf_image_eq_top (X : Set B) (hX : Algebra.adjoin R X = ⊤) (b : B) :
    Algebra.adjoin R (insert (IsLocalization.Away.invSelf b : Localization.Away b)
      (algebraMap B (Localization.Away b) '' X)) = ⊤ := by
  rw [eq_top_iff]
  intro z _
  obtain ⟨⟨x, ⟨_, k, rfl⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers b) z
  change IsLocalization.mk' (Localization.Away b) x (⟨b ^ k, k, rfl⟩ : Submonoid.powers b) ∈ _
  rw [localizationAway_mk_eq_mul_invSelf_pow]
  refine mul_mem ?_ (pow_mem (Algebra.subset_adjoin (Set.mem_insert _ _)) k)
  have h1 : x ∈ Algebra.adjoin R X := by
    rw [hX]
    exact Algebra.mem_top
  have h2 : (IsScalarTower.toAlgHom R B (Localization.Away b)) x ∈
      (Algebra.adjoin R X).map (IsScalarTower.toAlgHom R B (Localization.Away b)) :=
    Subalgebra.mem_map.2 ⟨x, h1, rfl⟩
  rw [AlgHom.map_adjoin] at h2
  exact Algebra.adjoin_mono (Set.subset_insert _ _) h2

end Localization

section Spreading

variable {R : Type*} [CommRing R] {S : Type u} [CommRing S] [Algebra R S]
  {C : Type u} [CommRing C] [Algebra S C]

/-- **Spreading out a cover by standard smooth localizations.** If `C` is generated over `S` by
the finite set `Y` and covered by localizations that are standard smooth of relative dimension `n`
over `S`, there is a finitely generated `R`-subalgebra `A₀` of `S` such that for every `A' ≥ A₀`,
every `A'`-algebra `B` with an injective ring map `ρ : B → C` over `A' → S`, whose image contains
`Y` and which is generated over `A'` by `ρ⁻¹(Y)`, is covered by localizations `B[1/b]` that are
standard smooth of relative dimension `n` over `A'`. -/
theorem exists_fg_forall_locally_isStandardSmooth (n : ℕ)
    (hsm : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension n) (algebraMap S C))
    (Y : Finset C) (hY : Algebra.adjoin S (Y : Set C) = ⊤) :
    ∃ A₀ : Subalgebra R S, A₀.FG ∧ ∀ A' : Subalgebra R S, A₀ ≤ A' →
      ∀ (B : Type u) [CommRing B] [Algebra A' B] (ρ : B →+* C),
        ρ.comp (algebraMap A' B) = (algebraMap S C).comp (algebraMap A' S) →
        Function.Injective ρ → (Y : Set C) ⊆ Set.range ρ →
        Algebra.adjoin A' (ρ ⁻¹' (Y : Set C)) = ⊤ →
        ∃ t : Finset B, Ideal.span (t : Set B) = ⊤ ∧
          ∀ b ∈ t, Algebra.IsStandardSmoothOfRelativeDimension n A' (Localization.Away b) := by
  classical
  obtain ⟨s₁, hs₁, hsm⟩ := hsm
  obtain ⟨s, hss₁, hs⟩ := (Ideal.span_eq_top_iff_finite s₁).1 hs₁
  have hloc : ∀ c ∈ s, Algebra.IsStandardSmoothOfRelativeDimension n S (Localization.Away c) := by
    intro c hc
    have h := hsm c (hss₁ hc)
    rwa [← IsScalarTower.algebraMap_eq, RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
      at h
  -- generators of the localizations
  let γ : (c : C) → Finset (Localization.Away c) := fun c =>
    insert (IsLocalization.Away.invSelf c) (Y.image (algebraMap C (Localization.Away c)))
  have hγ : ∀ c : C, Algebra.adjoin S ((γ c : Finset (Localization.Away c)) :
      Set (Localization.Away c)) = ⊤ := by
    intro c
    simp only [γ, Finset.coe_insert, Finset.coe_image]
    exact adjoin_insert_invSelf_image_eq_top (Y : Set C) hY c
  -- the bases for the localizations
  have key : ∀ c : s, ∃ A₁ : Subalgebra R S, A₁.FG ∧ ∀ A' : Subalgebra R S, A₁ ≤ A' →
      ∀ (M : Type u) [CommRing M] [Algebra A' M] (φ : M →+* Localization.Away c.1),
        φ.comp (algebraMap A' M) = (algebraMap S (Localization.Away c.1)).comp
          (algebraMap A' S) →
        Function.Injective φ → ((γ c.1 : Finset _) : Set (Localization.Away c.1)) ⊆ Set.range φ →
        Algebra.adjoin A' (φ ⁻¹' ((γ c.1 : Finset _) : Set (Localization.Away c.1))) = ⊤ →
        Algebra.IsStandardSmoothOfRelativeDimension n A' M := by
    intro c
    have := hloc c.1 c.2
    exact exists_fg_forall_isStandardSmooth_of_injective (R := R) n (γ c.1) (hγ c.1)
  choose A₁ hA₁ hA₁' using key
  -- a partition of unity and the coefficients
  have h1 : (1 : C) ∈ Ideal.span (s : Set C) := by
    rw [hs]
    exact Submodule.mem_top
  obtain ⟨a, -, ha⟩ := Submodule.mem_span_finset.1 h1
  obtain ⟨F, hF⟩ := exists_finset_forall_mem_adjoinSubring (R := R) (X := (Y : Set C))
    (s ∪ s.image a) (fun c _ => by rw [hY]; exact Algebra.mem_top)
  choose u hu using fun c : s => hA₁ c
  let U : Finset S := (Finset.univ : Finset s).biUnion u ∪ F
  refine ⟨Algebra.adjoin R (U : Set S), ⟨U, rfl⟩, fun A' hA₀ => ?_⟩
  have hUA' : ∀ {z : S}, z ∈ U → z ∈ A' :=
    fun hz => hA₀ (Algebra.subset_adjoin (Finset.mem_coe.2 hz))
  have hA₁A' : ∀ c : s, A₁ c ≤ A' := by
    intro c
    rw [← hu c, Algebra.adjoin_le_iff]
    intro z hz
    exact hUA' (Finset.mem_union_left _ (Finset.mem_biUnion.2 ⟨c, Finset.mem_univ _, hz⟩))
  intro B _ _ ρ hρ hinj hYρ hgen
  have hρa : ∀ x : A', ρ (algebraMap A' B x) = algebraMap S C x :=
    fun x => RingHom.congr_fun hρ x
  have hsub : adjoinSubring A' (Y : Set C) ≤ ρ.range := by
    refine Subring.closure_le.2 (Set.union_subset ?_ ?_)
    · rintro _ ⟨x, hx, rfl⟩
      exact RingHom.mem_range.2 ⟨algebraMap A' B ⟨x, hx⟩, hρa ⟨x, hx⟩⟩
    · intro c hc
      exact RingHom.mem_range.2 (hYρ hc)
  have hrange : ∀ c ∈ s ∪ s.image a, c ∈ ρ.range := fun c hc =>
    hsub (hF A' (fun z hz => hUA' (Finset.mem_union_right _ (Finset.mem_coe.1 hz))) c hc)
  let T : C → B := fun c => if h : c ∈ ρ.range then (RingHom.mem_range.1 h).choose else 0
  have hT : ∀ c ∈ s ∪ s.image a, ρ (T c) = c := by
    intro c hc
    simp only [T, hrange c hc, ↓reduceDIte]
    exact (RingHom.mem_range.1 (hrange c hc)).choose_spec
  have hTs : ∀ c ∈ s, ρ (T c) = c := fun c hc => hT c (Finset.mem_union_left _ hc)
  have hTa : ∀ c ∈ s, ρ (T (a c)) = a c :=
    fun c hc => hT (a c) (Finset.mem_union_right _ (Finset.mem_image_of_mem a hc))
  refine ⟨s.image T, ?_, ?_⟩
  · -- the preimages generate the unit ideal
    rw [Ideal.eq_top_iff_one]
    have hsum : ∑ c ∈ s, T (a c) * T c = 1 := by
      apply hinj
      rw [map_sum, map_one, ← ha]
      refine Finset.sum_congr rfl fun c hc => ?_
      rw [map_mul, hTa c hc, hTs c hc, smul_eq_mul]
    rw [← hsum]
    exact Ideal.sum_mem _ fun c hc => Ideal.mul_mem_left _ _
      (Ideal.subset_span (Finset.mem_coe.2 (Finset.mem_image_of_mem T hc)))
  · -- each localization is standard smooth
    intro b hb
    obtain ⟨c, hc, rfl⟩ := Finset.mem_image.1 hb
    have hle : Submonoid.powers (T c) ≤ (Submonoid.powers c).comap ρ := by
      rw [Submonoid.powers_le]
      change ρ (T c) ∈ Submonoid.powers c
      rw [hTs c hc]
      exact Submonoid.mem_powers c
    let φ : Localization.Away (T c) →+* Localization.Away c :=
      IsLocalization.map (Localization.Away c) ρ hle
    have hφ : φ.comp (algebraMap A' (Localization.Away (T c))) =
        (algebraMap S (Localization.Away c)).comp (algebraMap A' S) := by
      refine RingHom.ext fun x => ?_
      change φ (algebraMap A' (Localization.Away (T c)) x) = algebraMap S _ (x : S)
      rw [IsScalarTower.algebraMap_apply A' B (Localization.Away (T c)), IsLocalization.map_eq,
        hρa, ← IsScalarTower.algebraMap_apply]
    have hφinj : Function.Injective φ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨x, ⟨_, k, rfl⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers (T c)) z
      change φ (IsLocalization.mk' _ x (⟨T c ^ k, k, rfl⟩ : Submonoid.powers (T c))) = 0 at hz
      rw [IsLocalization.map_mk', IsLocalization.mk'_eq_zero_iff] at hz
      obtain ⟨⟨_, j, rfl⟩, hj⟩ := hz
      change c ^ j * ρ x = 0 at hj
      rw [← hTs c hc, ← map_pow, ← map_mul] at hj
      have hj' : T c ^ j * x = 0 := hinj (by rw [hj, map_zero])
      change IsLocalization.mk' _ x (⟨T c ^ k, k, rfl⟩ : Submonoid.powers (T c)) = 0
      exact (IsLocalization.mk'_eq_zero_iff _ _).2 ⟨⟨T c ^ j, j, rfl⟩, hj'⟩
    have hinv : φ (IsLocalization.Away.invSelf (T c)) = IsLocalization.Away.invSelf c := by
      have h₀ : φ (algebraMap B (Localization.Away (T c)) (T c)) =
          algebraMap C (Localization.Away c) c := by
        rw [IsLocalization.map_eq hle, hTs c hc]
      have h₁ : algebraMap C (Localization.Away c) c * φ (IsLocalization.Away.invSelf (T c)) = 1 := by
        rw [← h₀, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
      have h₂ : (IsLocalization.Away.invSelf c : Localization.Away c) *
          algebraMap C (Localization.Away c) c = 1 := by
        rw [mul_comm, IsLocalization.Away.mul_invSelf]
      exact (left_inv_eq_right_inv h₂ h₁).symm
    refine hA₁' ⟨c, hc⟩ A' (hA₁A' ⟨c, hc⟩) (Localization.Away (T c)) φ hφ hφinj ?_ ?_
    · intro z hz
      simp only [γ, Finset.coe_insert, Finset.coe_image, Set.mem_insert_iff, Set.mem_image,
        Finset.mem_coe] at hz
      rcases hz with rfl | ⟨y, hy, rfl⟩
      · exact ⟨_, hinv⟩
      · obtain ⟨x, rfl⟩ := hYρ (Finset.mem_coe.2 hy)
        exact ⟨algebraMap B _ x, IsLocalization.map_eq hle x⟩
    · refine top_unique ?_
      rw [← adjoin_insert_invSelf_image_eq_top (R := A') (ρ ⁻¹' (Y : Set C)) hgen (T c)]
      refine Algebra.adjoin_mono ?_
      rintro z (rfl | ⟨x, hx, rfl⟩)
      · change φ _ ∈ ((γ c : Finset _) : Set _)
        rw [hinv]
        exact Finset.mem_coe.2 (Finset.mem_insert_self _ _)
      · change φ (algebraMap B _ x) ∈ ((γ c : Finset _) : Set _)
        rw [IsLocalization.map_eq hle x]
        exact Finset.mem_coe.2 (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hx))

end Spreading

end MixedFujita
