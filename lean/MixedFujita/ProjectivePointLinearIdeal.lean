module

public import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.Tactic.Ring

/-!
For normalized projective coordinates a_k = 1, substitution X_j -> a_j X_k
has kernel generated by the actual homogeneous linear relations X_j-a_j X_k.
Polynomial induction supplies the remainder in that ideal. This is an
explicit algebra calculation; actual closed projective points are connected
in subsequent modules.
-/

@[expose] public section
namespace MixedFujita
variable {n : ℕ} {R : Type*} [CommRing R]

noncomputable def normalizedProjectiveLinearIdeal (a : Fin n → R) (k : Fin n) :
    Ideal (MvPolynomial (Fin n) R) :=
  Ideal.span (Set.range fun j ↦ MvPolynomial.X j - MvPolynomial.C (a j) * MvPolynomial.X k)

noncomputable def normalizedProjectiveSubstitution (a : Fin n → R) (k : Fin n) :
    MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin n) R :=
  MvPolynomial.aeval fun j ↦ MvPolynomial.C (a j) * MvPolynomial.X k

theorem normalizedProjectiveLinearRelation_homogeneous (a : Fin n → R) (k j : Fin n) :
    (MvPolynomial.X j - MvPolynomial.C (a j) * MvPolynomial.X k).IsHomogeneous 1 :=
  (MvPolynomial.isHomogeneous_X R j).sub ((MvPolynomial.isHomogeneous_X R k).C_mul (a j))

theorem normalizedProjectiveLinearRelation_mem (a : Fin n → R) (k j : Fin n) :
    MvPolynomial.X j - MvPolynomial.C (a j) * MvPolynomial.X k ∈
      normalizedProjectiveLinearIdeal a k := Ideal.subset_span (Set.mem_range_self j)

theorem normalizedProjectiveSubstitution_relation (a : Fin n → R) (k : Fin n)
    (ha : a k = 1) (j : Fin n) :
    normalizedProjectiveSubstitution a k
      (MvPolynomial.X j - MvPolynomial.C (a j) * MvPolynomial.X k) = 0 := by
  simp [normalizedProjectiveSubstitution, ha]

theorem normalizedProjectiveSubstitution_remainder_mem (a : Fin n → R) (k : Fin n)
    (f : MvPolynomial (Fin n) R) :
    f - normalizedProjectiveSubstitution a k f ∈ normalizedProjectiveLinearIdeal a k := by
  induction f using MvPolynomial.induction_on with
  | C r => simp [normalizedProjectiveSubstitution]
  | add f g hf hg =>
    rw [map_add]
    convert (normalizedProjectiveLinearIdeal a k).add_mem hf hg using 1; ring
  | mul_X f j hf =>
    rw [map_mul]
    have hX : normalizedProjectiveSubstitution a k (MvPolynomial.X j) =
        MvPolynomial.C (a j) * MvPolynomial.X k := MvPolynomial.aeval_X _ _
    rw [hX]
    have h := (normalizedProjectiveLinearIdeal a k).add_mem
      ((normalizedProjectiveLinearIdeal a k).mul_mem_right (MvPolynomial.X j) hf)
      ((normalizedProjectiveLinearIdeal a k).mul_mem_left
        (normalizedProjectiveSubstitution a k f) (normalizedProjectiveLinearRelation_mem a k j))
    convert h using 1; ring

theorem normalizedProjectiveSubstitution_kernel (a : Fin n → R) (k : Fin n)
    (ha : a k = 1) :
    RingHom.ker (normalizedProjectiveSubstitution a k).toRingHom =
      normalizedProjectiveLinearIdeal a k := by
  apply le_antisymm
  · intro f hf
    have h := normalizedProjectiveSubstitution_remainder_mem a k f
    have hzero : normalizedProjectiveSubstitution a k f = 0 := hf
    simpa only [hzero, sub_zero] using h
  · rw [normalizedProjectiveLinearIdeal, Ideal.span_le]
    rintro f ⟨j, rfl⟩
    exact normalizedProjectiveSubstitution_relation a k ha j

theorem normalizedProjectiveSubstitution_monomial (a : Fin n → R) (k : Fin n)
    (p : Fin n →₀ ℕ) (r : R) :
    normalizedProjectiveSubstitution a k (MvPolynomial.monomial p r) =
      MvPolynomial.C (MvPolynomial.eval a (MvPolynomial.monomial p r)) *
        MvPolynomial.X k ^ p.degree := by
  classical
  simp only [normalizedProjectiveSubstitution, MvPolynomial.aeval_def,
    MvPolynomial.eval₂_monomial, MvPolynomial.eval_monomial, Finsupp.prod,
    mul_pow, Finset.prod_mul_distrib, ← map_pow, ← map_prod,
    Finset.prod_pow_eq_pow_sum, Finsupp.degree_apply, MvPolynomial.algebraMap_eq]
  rw [map_mul, mul_assoc]

theorem normalizedProjectiveSubstitution_homogeneous (a : Fin n → R) (k : Fin n)
    {d : ℕ} (f : MvPolynomial (Fin n) R) (hf : f.IsHomogeneous d) :
    normalizedProjectiveSubstitution a k f =
      MvPolynomial.C (MvPolynomial.eval a f) * MvPolynomial.X k ^ d := by
  classical
  calc
    normalizedProjectiveSubstitution a k f =
        ∑ p ∈ f.support, normalizedProjectiveSubstitution a k
          (MvPolynomial.monomial p (f.coeff p)) := by
      conv_lhs => rw [← f.support_sum_monomial_coeff]
      simp only [map_sum]
    _ = ∑ p ∈ f.support,
        MvPolynomial.C (MvPolynomial.eval a (MvPolynomial.monomial p (f.coeff p))) *
          MvPolynomial.X k ^ d := by
      apply Finset.sum_congr rfl
      intro p hp
      rw [normalizedProjectiveSubstitution_monomial]
      have hdegree : p.degree = d := by
        simpa only [Finsupp.degree_apply] using (hf.degree_eq_sum_deg_support hp).symm
      rw [hdegree]
    _ = MvPolynomial.C (MvPolynomial.eval a f) * MvPolynomial.X k ^ d := by
      rw [← Finset.sum_mul, ← map_sum, ← map_sum, f.support_sum_monomial_coeff]

theorem normalizedProjectiveLinearIdeal_mem_of_homogeneous_eval_zero
    (a : Fin n → R) (k : Fin n) (ha : a k = 1)
    {d : ℕ} (f : MvPolynomial (Fin n) R) (hf : f.IsHomogeneous d)
    (hzero : MvPolynomial.eval a f = 0) : f ∈ normalizedProjectiveLinearIdeal a k := by
  rw [← normalizedProjectiveSubstitution_kernel a k ha]
  change normalizedProjectiveSubstitution a k f = 0
  rw [normalizedProjectiveSubstitution_homogeneous a k f hf, hzero, map_zero, zero_mul]

end MixedFujita
