module

public import MixedFujita.EtaleCoordinateDifferentials
public import Mathlib.Algebra.Algebra.Epi
public import Mathlib.RingTheory.Noetherian.Nilpotent
public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic
public import Mathlib.RingTheory.Kaehler.Basic

/-!
Frobenius generation of étale charts (step 10, the `p`-basis of an étale chart).

Let `K` be a field of prime characteristic `p` and `S` a `K`-algebra of finite type with formally
étale coordinates `y : K[X_1, …, X_n] → S`. Then `S` is generated as a `K`-algebra by the
coordinates `y_j` and the `p`-th powers `S^p` (`frobeniusCoordinateSubalgebra_eq_top`). Hence every
element of `S` is a polynomial in the coordinates with coefficients in the subalgebra `K·S^p`
generated by the `p`-th powers (`exists_aeval_frobeniusSubalgebra_eq`), and every derivation of
`S` over `K` vanishes on `K·S^p` (`derivation_eq_zero_of_mem_frobeniusSubalgebra`).

The proof avoids `p`-bases of fields and the étale-local structure. Let `R` be the subalgebra
generated by the coordinates and `S^p`. Since the differentials `d y_j` span `Ω[S⁄K]`, they span the
image of `Ω[S⁄K] → Ω[S⁄R]`, but they vanish there, so `Ω[S⁄R] = 0`: the kernel `I` of the
multiplication `S ⊗[R] S → S` is idempotent. It is finitely generated by the elements
`1 ⊗ s - s ⊗ 1`, and `(1 ⊗ s - s ⊗ 1)^p = 1 ⊗ s^p - s^p ⊗ 1 = 0` because `s^p ∈ R`. A finitely
generated nil ideal is nilpotent, so `I = 0` and `R → S` is an epimorphism. It is finite, since
`S` is of finite type over `R` and `s` is a root of `X^p - s^p`. A finite epimorphism is surjective.
-/

@[expose] public section

open TensorProduct

namespace MixedFujita

universe u v

section Frobenius

/-- In a commutative ring in which the prime `p` vanishes, `(u - v)^p = u^p - v^p`. -/
theorem sub_pow_prime_of_natCast_eq_zero {A : Type*} [CommRing A] {p : ℕ} (hp : p.Prime)
    (hpA : (p : A) = 0) (u v : A) : (u - v) ^ p = u ^ p - v ^ p := by
  have h := add_pow_prime_eq hp (u - v) v
  rw [hpA, zero_mul, zero_mul, zero_mul, add_zero, sub_add_cancel] at h
  rw [h, add_sub_cancel_right]

end Frobenius

variable {K : Type u} [Field K] {S : Type v} [CommRing S] [Algebra K S] {n : ℕ}

/-- The subalgebra `K·S^p` generated by the `p`-th powers. -/
def frobeniusSubalgebra (K : Type u) [Field K] (S : Type v) [CommRing S] [Algebra K S] (p : ℕ) :
    Subalgebra K S :=
  Algebra.adjoin K (Set.range fun a : S => a ^ p)

/-- The subalgebra generated by the coordinates and the `p`-th powers. -/
def frobeniusCoordinateSubalgebra (p : ℕ) (y : MvPolynomial (Fin n) K →ₐ[K] S) : Subalgebra K S :=
  Algebra.adjoin K ((Set.range fun i => y (MvPolynomial.X i)) ∪ Set.range fun a : S => a ^ p)

theorem coordinate_mem_frobeniusCoordinateSubalgebra (p : ℕ) (y : MvPolynomial (Fin n) K →ₐ[K] S)
    (i : Fin n) : y (MvPolynomial.X i) ∈ frobeniusCoordinateSubalgebra p y :=
  Algebra.subset_adjoin (Or.inl ⟨i, rfl⟩)

theorem pow_mem_frobeniusCoordinateSubalgebra (p : ℕ) (y : MvPolynomial (Fin n) K →ₐ[K] S)
    (a : S) : a ^ p ∈ frobeniusCoordinateSubalgebra p y :=
  Algebra.subset_adjoin (Or.inr ⟨a, rfl⟩)

theorem pow_mem_frobeniusSubalgebra (p : ℕ) (a : S) : a ^ p ∈ frobeniusSubalgebra K S p :=
  Algebra.subset_adjoin ⟨a, rfl⟩

/-- The differentials of étale coordinates vanish relative to any subalgebra containing the
coordinates, so the relative differentials vanish. -/
theorem subsingleton_kaehlerDifferential_of_coordinates_mem (y : MvPolynomial (Fin n) K →ₐ[K] S)
    (hy : y.toRingHom.FormallyEtale) (R : Subalgebra K S)
    (hR : ∀ i, y (MvPolynomial.X i) ∈ R) : Subsingleton Ω[S⁄R] := by
  have hmap : KaehlerDifferential.map K R S S = 0 := by
    apply (etaleCoordinateBasis y hy).ext
    intro i
    rw [etaleCoordinateBasis_apply, KaehlerDifferential.map_D, LinearMap.zero_apply]
    have : algebraMap S S (y (MvPolynomial.X i)) = algebraMap R S ⟨_, hR i⟩ := rfl
    rw [this, Derivation.map_algebraMap]
  have hsurj := KaehlerDifferential.map_surjective K R S
  constructor
  intro a b
  obtain ⟨a', rfl⟩ := hsurj a
  obtain ⟨b', rfl⟩ := hsurj b
  rw [hmap, LinearMap.zero_apply, LinearMap.zero_apply]

/-- In `S ⊗[R] S` the generators `1 ⊗ s - s ⊗ 1` of the diagonal ideal are nilpotent when all
`p`-th powers lie in `R`. -/
theorem one_tmul_sub_tmul_one_pow_eq_zero (p : ℕ) [hp : Fact p.Prime] [CharP K p]
    (R : Subalgebra K S) (hR : ∀ a : S, a ^ p ∈ R) (s : S) :
    ((1 : S) ⊗ₜ[R] s - s ⊗ₜ[R] (1 : S)) ^ p = 0 := by
  have hpR : (p : R) = 0 := by
    rw [← map_natCast (algebraMap K R), CharP.cast_eq_zero, map_zero]
  have hpT : (p : S ⊗[R] S) = 0 := by
    rw [← map_natCast (algebraMap R (S ⊗[R] S)), hpR, map_zero]
  rw [sub_pow_prime_of_natCast_eq_zero hp.out hpT, Algebra.TensorProduct.tmul_pow,
    Algebra.TensorProduct.tmul_pow, one_pow, sub_eq_zero]
  have hs : s ^ p = (⟨s ^ p, hR s⟩ : R) • (1 : S) := by
    rw [Algebra.smul_def, mul_one]
    rfl
  rw [hs, TensorProduct.smul_tmul]

/-- **Frobenius generation.** A `K`-algebra of finite type with formally étale coordinates over a
field of characteristic `p` is generated by the coordinates and the `p`-th powers. -/
theorem frobeniusCoordinateSubalgebra_eq_top (p : ℕ) [hp : Fact p.Prime] [CharP K p]
    [Algebra.FiniteType K S] (y : MvPolynomial (Fin n) K →ₐ[K] S)
    (hy : y.toRingHom.FormallyEtale) : frobeniusCoordinateSubalgebra p y = ⊤ := by
  set R := frobeniusCoordinateSubalgebra p y
  have hΩ : Subsingleton Ω[S⁄R] :=
    subsingleton_kaehlerDifferential_of_coordinates_mem y hy R
      (coordinate_mem_frobeniusCoordinateSubalgebra p y)
  have hidem : IsIdempotentElem (KaehlerDifferential.ideal R S) :=
    (Ideal.cotangent_subsingleton_iff (KaehlerDifferential.ideal R S)).mp hΩ
  have : Algebra.FiniteType R S := Algebra.FiniteType.of_restrictScalars_finiteType K R S
  have hfg : (KaehlerDifferential.ideal R S).FG := KaehlerDifferential.ideal_fg R S
  have hnil : KaehlerDifferential.ideal R S ≤ nilradical (S ⊗[R] S) := by
    rw [← KaehlerDifferential.span_range_eq_ideal, Ideal.span_le]
    rintro _ ⟨s, rfl⟩
    exact ⟨p, one_tmul_sub_tmul_one_pow_eq_zero p R (pow_mem_frobeniusCoordinateSubalgebra p y) s⟩
  obtain ⟨k, hk⟩ := (hfg.isNilpotent_iff_le_nilradical).mpr hnil
  have hbot : KaehlerDifferential.ideal R S = ⊥ := by
    rw [← hidem.pow_succ_eq k, eq_bot_iff]
    calc KaehlerDifferential.ideal R S ^ (k + 1) ≤ KaehlerDifferential.ideal R S ^ k :=
          Ideal.pow_le_pow_right (Nat.le_succ k)
      _ = ⊥ := hk.trans Ideal.zero_eq_bot
  have hepi : Algebra.IsEpi R S := by
    rw [Algebra.isEpi_iff_forall_one_tmul_eq]
    intro s
    have h := KaehlerDifferential.one_smul_sub_smul_one_mem_ideal R s
    rw [hbot, Ideal.mem_bot, sub_eq_zero] at h
    exact h
  have hint : Algebra.IsIntegral R S := by
    refine ⟨fun s => ⟨Polynomial.X ^ p - Polynomial.C ⟨s ^ p, pow_mem_frobeniusCoordinateSubalgebra p y s⟩,
      Polynomial.monic_X_pow_sub_C _ hp.out.ne_zero, ?_⟩⟩
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero]
    rfl
  have : Module.Finite R S := Algebra.IsIntegral.finite
  have hsurj := (Algebra.isEpi_iff_surjective_algebraMap_of_finite).mp hepi
  rw [eq_top_iff]
  intro s _
  obtain ⟨r, rfl⟩ := hsurj s
  exact r.2

/-- **Coordinate expansion.** Every element of an étale chart in characteristic `p` is a polynomial
in the coordinates with coefficients in `K·S^p`. -/
theorem exists_aeval_frobeniusSubalgebra_eq (p : ℕ) [Fact p.Prime] [CharP K p]
    [Algebra.FiniteType K S] (y : MvPolynomial (Fin n) K →ₐ[K] S)
    (hy : y.toRingHom.FormallyEtale) (s : S) :
    ∃ q : MvPolynomial (Fin n) (frobeniusSubalgebra K S p),
      MvPolynomial.aeval (fun i => y (MvPolynomial.X i)) q = s := by
  have hle : frobeniusCoordinateSubalgebra p y ≤
      (Algebra.adjoin (frobeniusSubalgebra K S p)
        (Set.range fun i => y (MvPolynomial.X i))).restrictScalars K := by
    rw [frobeniusCoordinateSubalgebra, Algebra.adjoin_le_iff]
    rintro _ (⟨i, rfl⟩ | ⟨a, rfl⟩)
    · rw [SetLike.mem_coe, Subalgebra.mem_restrictScalars]
      exact Algebra.subset_adjoin ⟨i, rfl⟩
    · rw [SetLike.mem_coe, Subalgebra.mem_restrictScalars]
      exact Subalgebra.algebraMap_mem _ (⟨a ^ p, pow_mem_frobeniusSubalgebra p a⟩ :
        frobeniusSubalgebra K S p)
  have hs : s ∈ Algebra.adjoin (frobeniusSubalgebra K S p)
      (Set.range fun i => y (MvPolynomial.X i)) := by
    have hmem : s ∈ frobeniusCoordinateSubalgebra p y := by
      rw [frobeniusCoordinateSubalgebra_eq_top p y hy]
      trivial
    exact hle hmem
  rw [Algebra.adjoin_range_eq_range_aeval] at hs
  exact hs

/-- Every derivation of `S` over a field of characteristic `p` vanishes on `K·S^p`. -/
theorem derivation_eq_zero_of_mem_frobeniusSubalgebra (p : ℕ) [CharP K p] {M : Type*}
    [AddCommGroup M] [Module S M] [Module K M] [IsScalarTower K S M]
    (d : Derivation K S M) {c : S} (hc : c ∈ frobeniusSubalgebra K S p) : d c = 0 := by
  have hpS : (p : S) = 0 := by
    rw [← map_natCast (algebraMap K S), CharP.cast_eq_zero, map_zero]
  induction hc using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨a, rfl⟩ := hx
    rw [Derivation.leibniz_pow, ← Nat.cast_smul_eq_nsmul S, hpS, zero_smul]
  | algebraMap r => exact d.map_algebraMap r
  | add x z _ _ hx hz => rw [map_add, hx, hz, add_zero]
  | mul x z _ _ hx hz => rw [Derivation.leibniz, hx, hz, smul_zero, smul_zero, add_zero]

end MixedFujita
