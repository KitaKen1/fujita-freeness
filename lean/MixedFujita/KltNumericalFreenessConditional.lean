module

public import MixedFujita.KltIsolationGeneration
public import MixedFujita.KawamataNumericalFreenessStatement
public import MixedFujita.AmpleDivisibleGlobalGeneration
public import MixedFujita.PolynomialProjectiveScheme

/-!
K-NF from two explicit statements (steps 12 and 15).

`KltIsolationMinimizerData` is the output of sections 2 to 5 of the manuscript at a closed point
x of a klt pair, in the form used by section 6: a degree j divisible by m₀, nonzero sections s_i
of j L (with L = d P − D for K-NF), a smooth proper simple normal crossing model π : X → Y whose family supports the
crepant boundary and the pullbacks of the zero divisors of the s_i, and on X a positive vector c
and a profile q with c · q = 1 in the polytope of a point over x, satisfying the inequality (24)
and the point-centre property over x and the budget d j Σ c_i < 1.

* If these data exist at every closed point at which P is not generated by its global sections,
  for the m₀ given by ampleness, and the Kawamata–Viehweg statement holds, then P is globally
  generated.
* `KltMinimizerDataStatement` states that under the hypotheses of K-NF the data exist, for every
  m₀, at every closed point at which P is not generated. Together with the Kawamata–Viehweg
  statement it implies K-NF.

Neither of the two statements is proved here: the first is the vanishing theorem (step 10), the
second is the content of sections 2 to 5 and 7 of the manuscript (steps 8, 9 and 11).
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite Filter
open TauCeti.AlgebraicGeometry
open TauCeti.AlgebraicGeometry.Scheme

namespace MixedFujita

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true

universe u

attribute [local instance] Classical.propDecidable

attribute [local instance] cartierGlobalStalkAlgebra cartierGlobalStalkFunctionFieldTower
  cartierBaseGlobalAlgebra cartierBaseLocalAlgebra cartierBaseLocalScalarTower
  cartierBaseSectionScalarTower cartierBaseOpenAlgebra functionFieldBaseAlgebra

section Data

variable {K : Type u} [Field K] {n : ℕ} {Y : Scheme.{u}}
  [IsIntegral Y] [IsLocallyNoetherian Y] [Y.Over (Spec (CommRingCat.of K))]

/-- The data of the minimizer at the closed point x, in the form used by section 6: a degree j
divisible by m₀, nonzero sections s_i of j L (for K-NF, L = d P − D; for S-NF, L = A), a smooth
proper simple normal crossing model π : X → Y supporting the crepant boundary and the pullbacks of
the zero divisors of the s_i, and a positive vector c and a profile q with c · q = 1 in the
polytope of a point y over x, with the inequality (24) and the point-centre property over x and
the budget d j Σ c_i < 1. -/
def KltIsolationMinimizerData (cY : EtaleChart K Y n) (fY : Y.functionFieldˣ) (d : ℕ)
    (D L : CartierDivisor Y) (m₀ : ℕ) (x : Y) : Prop :=
  ∃ (j N : ℕ) (s : Fin N → Γ((j • L).sheaf, ⊤)) (hs : ∀ i, s i ≠ 0)
    (X : Scheme.{u}) (_ : IsIntegral X) (_ : IsLocallyNoetherian X)
    (_ : X.Over (Spec (CommRingCat.of K))) (_ : IsProper (X ↘ Spec (CommRingCat.of K)))
    (_ : SmoothOfRelativeDimension n (X ↘ Spec (CommRingCat.of K)))
    (π : X ⟶ Y) (_ : IsDominant π) (_ : π.IsOver (Spec (CommRingCat.of K))) (_ : IsProper π)
    (hπ : Function.Bijective (dominantFunctionFieldAlgHom (K := K) π)) (cX : EtaleChart K X n)
    (r : ℕ) (ξ : Fin r → X) (y : X) (c q : Fin N → ℝ),
    m₀ ∣ j ∧ Function.Injective ξ ∧ (∀ i, Order.coheight (ξ i) = 1) ∧ IsSNCFamily K n ξ ∧
    (∀ z : CodimensionOnePoint X, (z : X) ∉ Set.range ξ →
      cartierCoefficient (crepantBoundaryCartier π hπ cY fY d D cX etaleCharts_cover) (z : X) =
        0) ∧
    (∀ i, ∀ z : CodimensionOnePoint X, (z : X) ∉ Set.range ξ →
      cartierCoefficient (cartierPullback π
        (cartierSectionZeroDivisor (j • L) (s i) (hs i))) (z : X) = 0) ∧
    π y = x ∧ (∀ i, 0 < c i) ∧ ∑ i, c i * q i = 1 ∧
    InSNCProfilePolytope ξ d (crepantBoundaryCartier π hπ cY fY d D cX etaleCharts_cover)
      (fun i => cartierPullback π (cartierSectionZeroDivisor (j • L) (s i) (hs i)))
      q y ∧
    (∀ p ∈ π ⁻¹' ({x} : Set Y), InSNCProfilePolytope ξ d
        (crepantBoundaryCartier π hπ cY fY d D cX etaleCharts_cover)
        (fun i => cartierPullback π (cartierSectionZeroDivisor (j • L) (s i) (hs i)))
        q p →
      ∀ k, p ∈ closure ({ξ k} : Set X) →
        ∑ i, c i * (cartierCoefficient (cartierPullback π
            (cartierSectionZeroDivisor (j • L) (s i) (hs i))) (ξ k) : ℝ) ≤
          ((d : ℝ) - cartierCoefficient
            (crepantBoundaryCartier π hπ cY fY d D cX etaleCharts_cover) (ξ k)) / d) ∧
    (∀ p : X, (closure ({p} : Set X) ∩ π ⁻¹' ({x} : Set Y)).Nonempty →
      InSNCProfilePolytope ξ d
        (crepantBoundaryCartier π hπ cY fY d D cX etaleCharts_cover)
        (fun i => cartierPullback π (cartierSectionZeroDivisor (j • L) (s i) (hs i)))
        q p → p ∈ π ⁻¹' ({x} : Set Y)) ∧
    ((d * j : ℕ) : ℝ) * ∑ i, c i < 1

end Data

section Generation

variable {K : Type u} [Field K] [CharZero K] {n : ℕ} {Y : Scheme.{u}}
  [IsIntegral Y] [IsLocallyNoetherian Y] [Y.Over (Spec (CommRingCat.of K))]
  [LocallyOfFiniteType (Y ↘ Spec (CommRingCat.of K))]

/-- If the data of the minimizer exist, for every m₀, at every closed point of a klt pair with
effective boundary and d P − D ample at which P is not generated by its global sections, then the
Kawamata–Viehweg statement implies that P is globally generated. -/
theorem klt_cartierIsGloballyGenerated_of_minimizerData [CompactSpace Y]
    (hKV : KawamataViehwegVanishingSNC K n) (hn : 1 ≤ n)
    (hnormY : ∀ v : Y, IsIntegrallyClosed (Y.presheaf.stalk v))
    (hcov : CodimOneChartCovered n K Y)
    (cY : EtaleChart K Y n) (fY : Y.functionFieldˣ) (d : ℕ) (hd : 1 ≤ d) (D : CartierDivisor Y)
    (heff : LogPairBoundaryEffective cY fY d D) (hklt : LogPairIsKlt cY fY d D)
    (P : CartierDivisor Y) (hA : CartierIsAmpleProj K (d • P - D))
    (hdata : ∀ m₀ : ℕ, 1 ≤ m₀ → ∀ x : Y, IsClosed ({x} : Set Y) →
      (¬ ∃ (f : Y.functionFieldˣ) (hf : P.IsLocalEquationAt x f) (t : Γ(P.sheaf, ⊤)),
        IsUnit (cartierLocalCoefficient P x f hf t)) →
      KltIsolationMinimizerData cY fY d D (d • P - D) m₀ x) :
    CartierIsGloballyGenerated P := by
  obtain ⟨m₀, hm₀, hAgg⟩ :=
    cartierIsAmpleProj_exists_globallyGenerated_divisible_sequence (d • P - D) hA
  apply cartierIsGloballyGenerated_of_forall_isClosed
  intro x hx
  by_contra hgen
  obtain ⟨j, N, s, hs, X, hXi, hXN, hXo, hXp, hXs, π, hdom, hover, hprop, hπ, cX, r, ξ, y, c, q,
    hjm₀, hinj, hξ, hsnc, hBsupp, hDsupp, hy, hc, hcq, hqy, hpolyΦ, hcentre, hbudget⟩ :=
    hdata m₀ hm₀ x hx hgen
  apply hgen
  exact klt_exists_section_generating_of_minimizer_data hKV hn hnormY hcov cY fY d hd D heff hklt
    P hA m₀ hm₀ hAgg x hx j hjm₀ s hs π hπ cX ξ hinj hξ hsnc hBsupp hDsupp y hy hc hcq hqy hpolyΦ
    hcentre hbudget

end Generation

/-- The statement that, under the hypotheses of K-NF, the data of the minimizer exist, for every
m₀, at every closed point at which P is not generated by its global sections: the content of
sections 2 to 5 and 7 of the manuscript in the form used by section 6. -/
def KltMinimizerDataStatement : Prop :=
  ∀ (K : Type u) [Field K] [IsAlgClosed K] [CharZero K] [Uncountable K] (Y : Scheme.{u})
    [IsIntegral Y] [IsLocallyNoetherian Y] [Y.Over (Spec (CommRingCat.of K))]
    [LocallyOfFiniteType (Y ↘ Spec (CommRingCat.of K))] (n : ℕ),
    topologicalKrullDim Y = n → 1 ≤ n →
    (∀ y : Y, IsIntegrallyClosed (Y.presheaf.stalk y)) → CodimOneChartCovered n K Y →
    ∀ (c₀ : EtaleChart K Y n) (f₀ : Y.functionFieldˣ) (r : ℕ), 1 ≤ r →
    ∀ D : CartierDivisor Y, LogPairBoundaryEffective c₀ f₀ r D → LogPairIsKlt c₀ f₀ r D →
    ∀ P : CartierDivisor Y, CartierIsAmpleProj K (r • P - D) →
      (∃ δ : ℝ, 0 < δ ∧ ∀ᶠ j : ℕ in atTop,
        ((((r * (n + 1) : ℕ) : ℝ) ^ n + δ) * (j : ℝ) ^ n / n.factorial ≤
          cartierRestrictedDim K (j • (r • P - D)) (genericPoint Y))) →
      (∀ (η : Y) (d : ℕ), topologicalKrullDim (closure ({η} : Set Y)) = d → 1 ≤ d → d < n →
        ∀ ε : ℝ, 0 < ε → ∀ᶠ j : ℕ in atTop,
          ((((r * (n + 1) : ℕ) : ℝ) ^ d - ε) * (j : ℝ) ^ d / d.factorial ≤
            cartierRestrictedDim K (j • (r • P - D)) η)) →
      ∀ m₀ : ℕ, 1 ≤ m₀ → ∀ x : Y, IsClosed ({x} : Set Y) →
        (¬ ∃ (f : Y.functionFieldˣ) (hf : P.IsLocalEquationAt x f) (t : Γ(P.sheaf, ⊤)),
          IsUnit (cartierLocalCoefficient P x f hf t)) →
        KltIsolationMinimizerData c₀ f₀ r D (r • P - D) m₀ x

/-- K-NF follows from the Kawamata–Viehweg statement and the existence of the data of the
minimizer: sections 6 and the last step of section 7 of the manuscript. -/
theorem kawamataNumericalFreeness_of_kawamataViehweg_of_minimizerData
    (hKV : ∀ (K : Type u) [Field K] [IsAlgClosed K] [CharZero K] (n : ℕ),
      KawamataViehwegVanishingSNC K n)
    (hmin : KltMinimizerDataStatement.{u}) : KawamataNumericalFreeness.{u} := by
  intro K _ _ _ _ Y _ _ _ _ n hdim hn hnorm hcov c₀ f₀ r hr D heff hklt P hA hvol hsub
  have hcompact : CompactSpace Y := by
    obtain ⟨m, hm, v, e, hcl, he, -⟩ := hA
    have := polynomialProjectiveToBase_isProper v K
    have : QuasiCompact (Y ↘ Spec (CommRingCat.of K)) := by
      rw [← he]
      infer_instance
    exact QuasiCompact.compactSpace_of_compactSpace (Y ↘ Spec (CommRingCat.of K))
  exact klt_cartierIsGloballyGenerated_of_minimizerData (hKV K n) hn hnorm hcov c₀ f₀ r hr D heff
    hklt P hA
    (fun m₀ hm₀ x hx hgen => hmin K Y n hdim hn hnorm hcov c₀ f₀ r hr D heff hklt P hA hvol hsub
      m₀ hm₀ x hx hgen)

end MixedFujita
